    column_configs: [
      H.imports.column_config("deal_id", "deal_id", "number"),
      H.imports.column_config("deal_name", "deal_name", "text"),
      H.imports.column_config("deal_owner", "deal_owner", "text"),
      H.imports.column_config("deal_url", "deal_url", "text"),
      H.imports.column_config("is_won", "is_won", "truefalse"),
      H.imports.column_config("revenue_won", "revenue_won", "number"),
      H.imports.column_config("seats", "seats", "number"),
      H.imports.column_config("close_rate", "close_rate", "number"),
      H.imports.column_config("created_date", "created_date", "date"),
      H.imports.column_config("close_date", "close_date", "date"),
      H.imports.column_config("close_timestamp", "close_timestamp", "datetime"),
      H.imports.column_config("close_unix", "close_unix", "number"),
