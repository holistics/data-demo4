Dashboard amyra_test_dashboard {
  title: 'Amyra Test Dashboard'
  description: ''
  owner: 'hien.nt+demo4@holistics.io'

  view: CanvasLayout {
    label: 'View 1'
    width: 1000
    height: 340
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
    block f_test {
      position: pos(20, 20, 300, 80)
    }
    block v_l6zn {
      position: pos(20, 120, 960, 200)
    }
  }

  theme: DynamicPageTheme {
    light: H.themes.vanilla
    dark: H.themes.charcoal
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_test'
      to: [
        'v_l6zn'
      ]
      field: r(amyra_1.deal_search_label)
    }
  ]
  block f_test: FilterBlock {
    label: 'Deal'
    type: 'field'
    source: FieldFilterSource {
      dataset: amyra_test_dataset
      field: r(amyra_1.deal_search_label)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block v_l6zn: VizBlock {
    label: 'Raw data'
    viz: DataTable {
      dataset: amyra_test_dataset
      fields: [
        r(amyra_1.deal_id),
        VizFieldFull {
          ref: r(amyra_1.deal_name)
          action open_filtered_deal: VizAction {
            type: 'GoToUrl'
            label: 'Open filtered deal'
            url {
              ref: r(amyra_1.deal_dashboard_url)
              aggregation: 'min'
            }
          }
        },
        VizFieldFull {
          ref: r(amyra_1.deal_owner)
          action search_deal_owner_on_google: VizAction {
            type: 'GoToUrl'
            label: 'Search owner on Google'
            url {
              ref: r(amyra_1.deal_owner_google_search_url)
              aggregation: 'min'
            }
          }
          action email_deal_owner: VizAction {
            type: 'GoToUrl'
            label: 'Email example.com@gmail.com'
            url {
              ref: r(amyra_1.deal_owner_email_url)
              aggregation: 'min'
            }
          }
        },
        r(amyra_1.is_won),
        r(amyra_1.revenue_won),
        r(amyra_1.seats),
        r(amyra_1.close_rate)
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
}