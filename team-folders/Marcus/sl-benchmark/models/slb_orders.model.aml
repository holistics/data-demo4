Model slb_orders {
  type: 'table'
  label: 'SLB Orders'
  description: 'Benchmark copy of orders (testdb.ecommerce via demo_public). discount is a RATE 0..1.'
  data_source_name: 'demo_public'
  owner: 'dong.ln@holistics.io'
  table_name: '"ecommerce"."orders"'

  dimension id {
    label: 'Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.id }};;
  }
  dimension status {
    label: 'Status'
    type: 'text'
    definition: @sql {{ #SOURCE.status }};;
    description: 'delivered / cancelled / refunded'
  }
  dimension created_at {
    label: 'Created At'
    type: 'date'
    // Date (not datetime) on purpose: a datetime period filter gets shifted by the org
    // reporting timezone (compiles to a -08:00 boundary), moving boundary orders across the
    // year line and making calendar-period totals differ from the raw-SQL / dbt / Cube tiers
    // by ~0.08%. A date is timezone-neutral and matches them exactly. Every benchmark question
    // is day/month/year grain, so no time-of-day is lost.
    definition: @sql {{ #SOURCE.created_at }}::date;;
  }
  dimension created_date {
    label: 'Created Date'
    type: 'date'
    definition: @sql {{ #SOURCE.created_at }}::date;;
  }
  dimension user_id {
    label: 'User Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.user_id }};;
  }
  dimension discount {
    label: 'Discount Rate'
    type: 'number'
    definition: @sql {{ #SOURCE.discount }};;
    description: 'Order-level discount RATE, value 0..1'
  }
  dimension delivery_attempts {
    label: 'Delivery Attempts'
    type: 'number'
    definition: @sql {{ #SOURCE.delivery_attempts }};;
  }
}
