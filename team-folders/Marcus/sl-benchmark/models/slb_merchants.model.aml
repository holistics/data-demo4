Model slb_merchants {
  type: 'table'
  label: 'SLB Merchants'
  description: 'Merchants supplying products (Neon benchmark projection).'
  data_source_name: 'slb_ecommerce_neon_h4'
  owner: 'dong.ln@holistics.io'
  table_name: '"benchmark"."merchants"'

  dimension id {
    label: 'Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.id }};;
  }
  dimension name {
    label: 'Merchant Name'
    type: 'text'
    definition: @sql {{ #SOURCE.name }};;
  }
  dimension city_id {
    label: 'City Id'
    type: 'number'
    description: 'References slb_cities.id through an INACTIVE dataset relationship (the active path to slb_cities is slb_users.city_id). To attribute merchants to a city or country, activate it per measure: metric | with_relationships(slb_merchants.city_id > slb_cities.id).'
    definition: @sql {{ #SOURCE.city_id }};;
  }
}
