Dataset slb_ecommerce {
  label: 'SL Benchmark - Ecommerce'
  description: '''
Benchmark dataset for the AMQL-vs-other-SL comparison. Reads the Neon benchmark projection (via slb_ecommerce_neon_h4)
so all comparison tiers (Tier 0 raw SQL, Tier 1 dbt SL, Tier 2 Cube, Tier 3 AMQL) query identical data.

Governed definitions: the six metrics of the benchmark contract, the same set every compared semantic layer exposes.
- Orders placed and customers who placed an order: distinct orders and distinct customers, ALL statuses.
- GMV     = sum(quantity * price), ALL statuses.
- AOV     = GMV / orders placed.
- Revenue = 50% of discounted current-list-price item value from DELIVERED orders only, by order-placement date.
- Delivery attempts = sum of order-grain attempts, ALL statuses.

Geography roles: slb_cities and slb_countries are the customer's city and country (via slb_users.city_id).
slb_merchant_cities and slb_merchant_countries are the merchant's city and country (via slb_merchants.city_id).
Both roles read the same cities and countries tables.
'''
  data_source_name: 'slb_ecommerce_neon_h4'
  owner: 'dong.ln@holistics.io'

  models: [
    slb_orders,
    slb_order_items,
    slb_products,
    slb_users,
    slb_cities,
    slb_countries,
    slb_categories,
    slb_merchants,
    slb_merchant_cities,
    slb_merchant_countries,
  ]

  relationships: [
    relationship(slb_order_items.order_id > slb_orders.id, true),
    relationship(slb_order_items.product_id > slb_products.id, true),
    relationship(slb_orders.user_id > slb_users.id, true),
    relationship(slb_users.city_id > slb_cities.id, true),
    relationship(slb_cities.country_code > slb_countries.code, true),
    relationship(slb_products.category_id > slb_categories.id, true),
    relationship(slb_products.merchant_id > slb_merchants.id, true),
    relationship(slb_merchants.city_id > slb_merchant_cities.id, true),
    relationship(slb_merchant_cities.country_code > slb_merchant_countries.code, true),
  ]

  // ── governed metrics: the six-metric benchmark contract ───────────────────
  // Labels and descriptions match the contract and the other semantic layers in the benchmark.
  metric total_orders {
    label: 'Orders placed'
    type: 'number'
    definition: @aql count(slb_orders.id);;
    description: 'Distinct orders created in the selected period. Includes every recorded status.'
  }
  metric ordering_customers {
    label: 'Customers who placed an order'
    type: 'number'
    definition: @aql count_distinct(slb_orders.user_id);;
    description: 'Distinct customers who placed at least one order in the selected period. Includes every recorded status.'
  }
  metric gmv {
    label: 'Gross merchandise value (GMV)'
    type: 'number'
    definition: @aql slb_order_items | sum(slb_order_items.quantity * slb_products.price);;
    description: 'Current-list-price value of units on orders created in the selected period, before discounts. Includes every recorded status.'
  }
  metric aov {
    label: 'Average order value (AOV)'
    type: 'number'
    definition: @aql gmv / total_orders;;
    description: 'Average pre-discount current-list-price value of orders created in the selected period. Includes every recorded status.'
  }
  metric revenue {
    label: 'Platform commission revenue'
    type: 'number'
    definition: @aql (slb_order_items | sum(slb_order_items.quantity * slb_products.price * (1 - slb_orders.discount) * 0.50)) | where(slb_orders.status is 'delivered');;
    description: 'Amount retained from delivered orders after discounts at 50% of discounted current-list-price order value.'
  }
  metric total_delivery_attempts {
    label: 'Total delivery attempts'
    type: 'number'
    definition: @aql slb_orders | sum(slb_orders.delivery_attempts);;
    description: 'Recorded delivery attempts for orders created in the selected period. Includes every recorded status.'
  }
}
