Dataset slb_ecommerce {
  label: 'SL Benchmark - Ecommerce'
  description: '''
Benchmark dataset for the AMQL-vs-other-SL comparison. Reads the Neon benchmark projection (via slb_ecommerce_neon_h4)
so all comparison tiers (Tier 0 raw SQL, Tier 1 dbt SL, Tier 2 Cube, Tier 3 AMQL) query identical data.

Governed definitions (the whole point of the benchmark):
- GMV     = sum(quantity * price), ALL statuses.
- NMV     = sum(quantity * price * (1 - discount)) EXCLUDING cancelled/refunded. discount is a RATE 0..1.
- Revenue = 50% of discounted current-list-price item value from DELIVERED orders only, by order-placement date.
- AOV     = GMV / total_orders.
- Closing stock units = sum the latest product/location stock balance on or before the period end.
'''
  data_source_name: 'slb_ecommerce_neon_h4'
  owner: 'dong.ln@holistics.io'

  models: [
    slb_orders,
    slb_order_items,
    slb_products,
    slb_users,
    slb_cities,
    slb_countries,
    slb_categories,
    slb_merchants,
    slb_stock_snapshots,
    slb_stock_daily_balances,
  ]

  relationships: [
    relationship(slb_order_items.order_id > slb_orders.id, true),
    relationship(slb_order_items.product_id > slb_products.id, true),
    relationship(slb_orders.user_id > slb_users.id, true),
    relationship(slb_users.city_id > slb_cities.id, true),
    relationship(slb_cities.country_code > slb_countries.code, true),
    relationship(slb_products.category_id > slb_categories.id, true),
    relationship(slb_products.merchant_id > slb_merchants.id, true),
    relationship(slb_merchants.city_id > slb_cities.id, false),
    relationship(slb_stock_snapshots.product_id > slb_products.id, true),
    relationship(slb_stock_daily_balances.product_id > slb_products.id, true),
  ]

  // ── buyer/cohort dimensions (user grain) ──────────────────────────────────
  dimension total_orders_all_time {
    model: slb_users
    label: 'Total Orders (Users)'
    type: 'number'
    // delivered-only, to match the governed "buyer" definition (Q4 reconcile: 68.3%)
    definition: @aql total_orders | where(slb_orders.status is 'delivered') | dimensionalize(slb_users.id);;
  }
  dimension is_buyer {
    model: slb_users
    label: 'Is Buyer'
    type: 'truefalse'
    definition: @aql slb_users.total_orders_all_time > 0;;
  }
  dimension is_repeated_buyer {
    model: slb_users
    label: 'Is Repeated Buyer'
    type: 'truefalse'
    definition: @aql slb_users.total_orders_all_time > 1;;
  }
  dimension first_order_date {
    model: slb_users
    label: 'First Order Date'
    type: 'date'
    definition: @aql min(slb_orders.created_at) | dimensionalize(slb_users.id);;
  }

  // ── governed metrics ──────────────────────────────────────────────────────
  metric total_orders {
    label: 'Total Orders'
    type: 'number'
    definition: @aql count(slb_orders.id);;
    description: 'Count of orders, all statuses.'
  }
  metric total_delivery_attempts {
    label: 'Total Delivery Attempts'
    type: 'number'
    definition: @aql slb_orders | sum(slb_orders.delivery_attempts);;
    description: 'Delivery attempts recorded per order, across all statuses. Each order contributes its full attempts once to every product category it contains, and once overall. Category totals are not additive to the overall total. Time periods refer to when the order was placed.'
  }
  metric closing_stock_units {
    label: 'Closing Stock Units'
    type: 'number'
    definition: @aql
      unique(slb_stock_daily_balances.product_location_key)
        | select(
            product_location_key: slb_stock_daily_balances.product_location_key,
            latest_stock_units:
              sum(slb_stock_daily_balances.stock_units)
                | where(slb_stock_daily_balances.balance_date == max(slb_stock_daily_balances.balance_date))
          )
        | sum(latest_stock_units)
    ;;
    description: 'Semi-additive stock balance. Sum across products and stock locations, but across time use each product/location entity’s latest carried daily balance in the selected period. Daily balances are derived from sparse observed snapshots using latest observation on or before each date; observed zero balances remain zero.'
  }
  metric total_users {
    label: 'Total Users'
    type: 'number'
    definition: @aql count(slb_users.id);;
  }
  metric gmv {
    label: 'GMV (Gross Merchandise Value)'
    type: 'number'
    definition: @aql slb_order_items | sum(slb_order_items.quantity * slb_products.price);;
    description: 'Gross value of items ordered before discounts; includes all statuses.'
  }
  metric revenue_commission {
    label: 'Revenue Commission Rate'
    type: 'number'
    definition: @aql 0.5;;
    description: 'Fixed demo commission rate.'
  }
  metric nmv {
    label: 'NMV (Net Merchandise Value)'
    type: 'number'
    definition: @aql (slb_order_items | sum(slb_order_items.quantity * slb_products.price * (1 - slb_orders.discount))) | where(slb_orders.status not in ['cancelled', 'refunded']);;
    description: 'Realized fulfilled value after order-level discounts; excludes cancelled and refunded.'
  }
  metric revenue {
    label: 'Platform Commission Revenue'
    type: 'number'
    definition: @aql (nmv * revenue_commission) | where(slb_orders.status is 'delivered');;
    description: 'Platform commission from delivered orders only: 50% of item quantity times current product price after the order-level discount. Time periods refer to when the order was placed.'
  }
  metric aov {
    label: 'AOV (Average Order Value)'
    type: 'number'
    definition: @aql gmv / total_orders;;
    description: 'Average gross value per order.'
  }
  metric total_delivered_orders {
    label: 'Total Delivered Orders'
    type: 'number'
    definition: @aql total_orders | where(slb_orders.status is 'delivered');;
  }
  metric total_cancelled_orders {
    label: 'Total Cancelled Orders'
    type: 'number'
    definition: @aql total_orders | where(slb_orders.status is 'cancelled');;
  }
  metric total_refunded_orders {
    label: 'Total Refunded Orders'
    type: 'number'
    definition: @aql total_orders | where(slb_orders.status is 'refunded');;
  }
  metric total_buyers {
    label: 'Total Buyers'
    type: 'number'
    definition: @aql count(slb_users.id) | where(slb_users.is_buyer is true);;
    description: 'Users with at least one order.'
  }
  metric total_repeated_buyers {
    label: 'Total Repeat Buyers'
    type: 'number'
    definition: @aql count(slb_users.id) | where(slb_users.is_repeated_buyer is true);;
    description: 'Users with 2+ orders.'
  }
  metric repeat_buyer_rate {
    label: 'Repeat Buyer Rate'
    type: 'number'
    definition: @aql total_repeated_buyers * 1.0 / total_buyers;;
    description: 'Repeat buyers / buyers.'
  }
  metric refunded_gmv {
    label: 'Refunded GMV'
    type: 'number'
    definition: @aql gmv | where(slb_orders.status is 'refunded');;
    description: 'Gross value of refunded items (GMV restricted to refunded orders).'
  }
  metric refund_rate {
    label: 'Refund Rate'
    type: 'number'
    definition: @aql refunded_gmv / gmv;;
    description: 'Share of GMV that was refunded = refunded_gmv / gmv. Composes at any grain (e.g. by category), which lets a query filter categories by this measure inline.'
  }
}
