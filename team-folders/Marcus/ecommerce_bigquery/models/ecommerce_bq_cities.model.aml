Model ecommerce_bq_cities {
  type: 'table'
  label: 'Cities'
  description: 'Cities joined to their country and continent. Grain — one row per city.'
  data_source_name: 'demo_bigquery'
  table_name: 'ecommerce_cleaned.dim_cities'

  dimension city_id {
    label: 'City ID'
    type: 'number'
    description: 'City identifier.'
    primary_key: true
    definition: @sql {{ #SOURCE.city_id }};;
  }

  dimension city_name {
    label: 'City Name'
    type: 'text'
    description: 'City name.'
    definition: @sql {{ #SOURCE.city_name }};;
  }

  dimension country_code {
    label: 'Country Code'
    type: 'text'
    description: 'ISO 3166-1 alpha-2 country code.'
    definition: @sql {{ #SOURCE.country_code }};;
  }

  dimension country_name {
    label: 'Country Name'
    type: 'text'
    description: 'Country name.'
    definition: @sql {{ #SOURCE.country_name }};;
  }

  dimension continent_name {
    label: 'Continent Name'
    type: 'text'
    description: 'Continent name.'
    definition: @sql {{ #SOURCE.continent_name }};;
  }
}
