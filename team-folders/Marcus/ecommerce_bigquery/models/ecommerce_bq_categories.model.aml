Model ecommerce_bq_categories {
  type: 'table'
  label: 'Categories'
  data_source_name: 'demo_bigquery'
  table_name: 'ecommerce_cleaned.dim_categories'

  dimension category_id {
    label: 'Category ID'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.category_id }};;
  }

  dimension category_name {
    label: 'Category Name'
    type: 'text'
    definition: @sql {{ #SOURCE.category_name }};;
  }

  dimension parent_category_id {
    label: 'Parent Category ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.parent_category_id }};;
  }

  dimension parent_category_name {
    label: 'Parent Category Name'
    type: 'text'
    definition: @sql {{ #SOURCE.parent_category_name }};;
  }

  dimension category_group {
    label: 'Category Group'
    type: 'text'
    definition: @sql {{ #SOURCE.category_group }};;
  }

  dimension category_group_slug {
    label: 'Category Group Slug'
    type: 'text'
    hidden: true
    definition: @sql {{ #SOURCE.category_group_slug }};;
  }

  dimension min_price {
    label: 'Min Price'
    type: 'number'
    definition: @sql {{ #SOURCE.min_price }};;
  }

  dimension max_price {
    label: 'Max Price'
    type: 'number'
    definition: @sql {{ #SOURCE.max_price }};;
  }

  dimension category_image_url {
    label: 'Category Image URL'
    type: 'text'
    definition: @sql {{ #SOURCE.category_image_url }};;
  }
}
