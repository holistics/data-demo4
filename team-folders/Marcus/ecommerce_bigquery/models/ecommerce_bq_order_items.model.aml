Model ecommerce_bq_order_items {
  type: 'table'
  label: 'Order Items'
  data_source_name: 'demo_bigquery'
  table_name: 'ecommerce_cleaned.fct_order_items'

  dimension order_item_id {
    label: 'Order Item ID'
    type: 'text'
    hidden: true
    primary_key: true
    definition: @sql {{ #SOURCE.order_item_id }};;
  }

  dimension order_id {
    label: 'Order ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.order_id }};;
  }

