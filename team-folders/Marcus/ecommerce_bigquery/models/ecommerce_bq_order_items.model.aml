  }

  dimension cost {
    label: 'Cost'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.cost }};;
  }

  dimension gross_profit {
    label: 'Gross Profit'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.gross_profit }};;
  }

  dimension revenue_electronics {
    label: 'Revenue Electronics'
    type: 'number'
    hidden: true
