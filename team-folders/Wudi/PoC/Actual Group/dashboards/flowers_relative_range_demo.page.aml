Dashboard flowers_relative_range_demo {
  title: 'Relative Range Buttons (h-drill demo)'
  description: 'Proof that h-drill buttons can drive DYNAMIC/relative date ranges (Year to Date, Last 30 Days, Last Quarter, Last 12 Months) with no page reload. Each button maps to a precomputed row whose boundaries use the database current_date; clicking cross-filters range_label to select that row. The date window shown updates to prove the range is live.'
  owner: 'chukwudi@holistics.io'

  block v_range_picker: VizBlock {
    label: 'Select Range'
    viz: MarkdownViz {
      dataset: flowers_ranges_demo
      rows: [
        VizFieldFull {
          label: 'range_label'
          ref: r(flowers_ranges.range_label)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'sort_order'
          ref: r(flowers_ranges.sort_order)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        }
      ]
      content: @md <style>
.rg-wrap * { box-sizing: border-box; }
.rg-wrap { font-family: Arial, Helvetica, sans-serif; display: flex; align-items: center; gap: 10px; padding: 6px 4px; flex-wrap: wrap; }
.rg-label { font-size: 12px; color: #3f3f3f; font-weight: bold; letter-spacing: 1px; margin-right: 2px; }
.rg-cards { display: flex; gap: 8px; flex-wrap: wrap; }
.rg-card { display: inline-block; cursor: pointer; text-align: center; min-width: 132px; padding: 8px 16px; border: 1px solid #4f7a36; border-radius: 6px; background: #ffffff; color: #4f7a36; font-weight: bold; font-size: 13px; line-height: 1.15; transition: background .12s ease, color .12s ease; }
.rg-card:hover { background: #eef5e8; }
.rg-cards h-drill { text-decoration: none; }
.rg-cards .h-drill-selected .rg-card, .rg-cards .rg-card.h-drill-selected { background: #5fa845; color: #ffffff; border-color: #5fa845; }
</style>
<div class="rg-wrap">
  <span class="rg-label">SELECT RANGE</span>
  <div class="rg-cards">
    {% map(rows) %}<h-drill row="0" value="{{ `range_label`.raw }}"><span class="rg-card">{{ `range_label`.formatted }}</span></h-drill>{% end %}
  </div>
</div> ;;
    }
    settings {
      hide_label: true
    }
  }

  block v_kpis: VizBlock {
    label: 'KPIs'
    viz: MarkdownViz {
      dataset: flowers_ranges_demo
      rows: [
        VizFieldFull { label: 'range_label' ref: r(flowers_ranges.range_label) format { type: 'text' } },
        VizFieldFull { label: 'range_from'  ref: r(flowers_ranges.range_from) format { type: 'date' pattern: 'LLL d, yyyy' } },
        VizFieldFull { label: 'range_to'    ref: r(flowers_ranges.range_to)   format { type: 'date' pattern: 'LLL d, yyyy' } },
        VizFieldFull { label: 'placed'      ref: r(flowers_ranges.placed)      format { type: 'number' pattern: '#,##0' } },
        VizFieldFull { label: 'delivered'   ref: r(flowers_ranges.delivered)   format { type: 'number' pattern: '#,##0' } },
        VizFieldFull { label: 'delivery_rate' ref: r(flowers_ranges.delivery_rate) format { type: 'number' pattern: '#,##0.0%' } },
        VizFieldFull { label: 'revenue'     ref: r(flowers_ranges.revenue)     format { type: 'number' pattern: '$#,##0' } },
        VizFieldFull { label: 'avg_check'   ref: r(flowers_ranges.avg_check)   format { type: 'number' pattern: '$#,##0.00' } },
        VizFieldFull { label: 'active_merchants' ref: r(flowers_ranges.active_merchants) format { type: 'number' pattern: '#,##0' } }
      ]
      content: @md <style>
.kpi-wrap * { box-sizing: border-box; }
.kpi-wrap { font-family: Arial, Helvetica, sans-serif; padding: 6px 4px; }
.kpi-head { font-size: 15px; font-weight: bold; color: #1f3864; margin-bottom: 2px; }
.kpi-window { font-size: 12px; color: #5a5a5a; margin-bottom: 12px; }
.kpi-window b { color: #4f7a36; }
.kpi-grid { display: grid; grid-template-columns: repeat(3, minmax(150px, 1fr)); gap: 10px; }
.kpi-tile { border: 1px solid #d9e2d2; border-left: 4px solid #5fa845; border-radius: 6px; padding: 10px 14px; background: #fcfdfb; }
.kpi-tile .k { font-size: 11px; letter-spacing: .5px; text-transform: uppercase; color: #6b6b6b; }
.kpi-tile .v { font-size: 22px; font-weight: bold; color: #111; margin-top: 2px; }
</style>
<div class="kpi-wrap">
  <div class="kpi-head">{{ rows[0].`range_label`.formatted }}</div>
  <div class="kpi-window">Window: <b>{{ rows[0].`range_from`.formatted }}</b> &rarr; <b>{{ rows[0].`range_to`.formatted }}</b> <span style="color:#999;">(recomputed from today's date)</span></div>
  <div class="kpi-grid">
    <div class="kpi-tile"><div class="k">Orders Placed</div><div class="v">{{ rows[0].`placed`.formatted }}</div></div>
    <div class="kpi-tile"><div class="k">Delivered</div><div class="v">{{ rows[0].`delivered`.formatted }}</div></div>
    <div class="kpi-tile"><div class="k">Delivery Rate</div><div class="v">{{ rows[0].`delivery_rate`.formatted }}</div></div>
    <div class="kpi-tile"><div class="k">Revenue</div><div class="v">{{ rows[0].`revenue`.formatted }}</div></div>
    <div class="kpi-tile"><div class="k">Avg Check</div><div class="v">{{ rows[0].`avg_check`.formatted }}</div></div>
    <div class="kpi-tile"><div class="k">Active Merchants</div><div class="v">{{ rows[0].`active_merchants`.formatted }}</div></div>
  </div>
</div> ;;
    }
    settings {
      hide_label: true
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 420
    auto_expand_vertically: true
    block v_range_picker {
      position: pos(10, 10, 1200, 70)
    }
    block v_kpis {
      position: pos(10, 90, 1200, 300)
    }
    mobile {
      mode: 'auto'
    }
  }
}
