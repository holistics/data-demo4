          ref: r(flowers_monthly.a_units_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_cr'
          ref: r(flowers_monthly.a_cr)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_cr_cls'
          ref: r(flowers_monthly.a_cr_cls)
