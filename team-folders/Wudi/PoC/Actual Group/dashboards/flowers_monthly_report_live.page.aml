            pattern: 'LLLL yyyy'
          }
        }
      ]
      content: @md <style>
.rep-wrap * { box-sizing: border-box; margin: 0; padding: 0; }
.rep-wrap { width: 100%; display: flex; justify-content: center; background: #ffffff; padding: 8px 0; }
.rep-table { border-collapse: collapse; font-family: Arial, Helvetica, sans-serif; font-size: 12.5px; color: #000; }
.rep-table td { border: 1px solid #b7b7b7; padding: 2px 6px; height: 26px; white-space: nowrap; }
.rep-darkgreen { background: #4f7a36; color: #fff; font-weight: bold; text-align: center; }
.rep-medgreen { background: #5fa845; color: #fff; font-weight: bold; text-align: center; }
.rep-side-fl { background: #4cb050; color: #fff; font-weight: bold; text-align: center; writing-mode: vertical-rl; transform: rotate(180deg); letter-spacing: 2px; font-size: 15px; width: 22px; }
.rep-side-off { background: #111111; color: #fff; font-weight: bold; text-align: center; writing-mode: vertical-rl; transform: rotate(180deg); letter-spacing: 2px; font-size: 15px; width: 22px; }
.rep-hblue { background: #dae3f3; color: #1f3864; font-weight: bold; text-align: center; }
.rep-hwhite { background: #ffffff; color: #000; font-weight: bold; text-align: center; }
.rep-hpurple { background: #d9d2e9; color: #3c1361; font-weight: bold; text-align: center; }
.rep-greenrow { background: #c6e0b4; }
.rep-yellow { background: #ffff00; }
.rep-rownum { background: #4cb050; color: #fff; text-align: center; font-size: 11px; }
.rep-darkcell { background: #111111; }
.rep-greysub { background: #3f3f3f; }
.rep-num { text-align: center; }
.rep-bold { font-weight: bold; }
.rep-blue { color: #0070c0; font-weight: bold; }
.rep-red { color: #ff0000; font-weight: bold; }
.rep-upg { color: #00b050; font-weight: bold; }
.rep-title { background: #ffffff; color: #000; font-weight: bold; text-align: center; font-size: 14px; }
.rep-topbar { background: #4cb050; height: 6px; padding: 0; }
</style>
<div class="rep-wrap">
<table class="rep-table">
  <tr><td class="rep-topbar" colspan="9"></td></tr>
  <tr>
    <td class="rep-darkgreen" style="width:22px;"></td>
    <td class="rep-rownum" style="width:34px;"></td>
    <td class="rep-title" style="width:300px;"></td>
    <td class="rep-title" colspan="6">{{ rows[0].`v_ref_month`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-darkgreen"></td>
    <td class="rep-darkgreen" style="text-align:center;">1</td>
    <td class="rep-darkgreen" style="font-size:14px;letter-spacing:1px;">ORDERS</td>
    <td class="rep-darkgreen" style="width:88px;">FLOWERS</td>
    <td class="rep-medgreen" style="width:92px;">ONLINE</td>
    <td class="rep-medgreen" style="width:92px;">OFFLINE</td>
    <td class="rep-hblue" style="width:54px;">M/M</td>
    <td class="rep-hwhite" style="width:60px;">2025</td>
    <td class="rep-hpurple" style="width:64px;">Y/Y</td>
  </tr>
  <tr>
    <td class="rep-side-fl" rowspan="9">FLOWERS</td>
    <td class="rep-rownum">1.1</td>
    <td>Number placed</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_placed`.formatted }}</td>
    <td class="rep-num rep-yellow">{{ rows[0].`v_placed_on`.formatted }}</td>
    <td class="rep-num rep-yellow">{{ rows[0].`v_placed_off`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_placed_mom`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_placed_ly`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_placed_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-rownum">1.2</td>
    <td>Number cancelled</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_cancelled`.formatted }}</td>
    <td class="rep-num rep-yellow">{{ rows[0].`v_cancelled_on`.formatted }}</td>
    <td class="rep-num rep-yellow">{{ rows[0].`v_cancelled_off`.formatted }}</td>
    <td class="rep-num"></td>
    <td class="rep-num">{{ rows[0].`v_cancelled_ly`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_cancelled_yoy`.formatted }}</td>
  </tr>
  <tr class="rep-greenrow">
    <td class="rep-rownum">1.3</td>
    <td>Number paid &amp; delivered</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_delivered`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_delivered_on`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_delivered_off`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_delivered_mom`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_delivered_ly`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_delivered_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-rownum">1.4</td>
    <td>Share</td>
    <td class="rep-num">100%</td>
    <td class="rep-num">{{ rows[0].`v_share_on`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_share_off`.formatted }}</td>
    <td class="rep-num"></td>
    <td class="rep-num">100%</td>
    <td class="rep-num"></td>
  </tr>
  <tr>
    <td class="rep-rownum">1.5</td>
    <td>% paid &amp; delivered</td>
    <td class="rep-num">{{ rows[0].`v_pct_delivered`.formatted }}</td>
    <td class="rep-num">&ndash;%</td>
    <td class="rep-num">&ndash;%</td>
    <td class="rep-num"></td>
    <td class="rep-num">{{ rows[0].`v_pct_delivered_ly`.formatted }}</td>
    <td class="rep-num"></td>
  </tr>
  <tr class="rep-greenrow">
    <td class="rep-rownum">1.6</td>
    <td>Avg. check, paid &amp; delivered</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_avgcheck`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_avgcheck_on`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_avgcheck_off`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_avgcheck_mom`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_avgcheck_ly`.formatted }}</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_avgcheck_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-rownum">1.7</td>
    <td class="rep-bold">% profit</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_profit`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_profit_on`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_profit_off`.formatted }}</td>
    <td class="rep-num {{ rows[0].`a_profit_mom_cls`.formatted }}">{{ rows[0].`a_profit_mom`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_profit_ly`.formatted }}</td>
    <td class="rep-num {{ rows[0].`a_profit_yoy_cls`.formatted }}">{{ rows[0].`a_profit_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-rownum">1.8</td>
    <td>Cash refunds, qty</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_refunds_qty`.formatted }}</td>
    <td class="rep-num">&ndash;</td>
    <td class="rep-num">&ndash;</td>
    <td class="rep-num"></td>
    <td class="rep-num">{{ rows[0].`v_refunds_qty_ly`.formatted }}</td>
    <td class="rep-num {{ rows[0].`a_refunds_qty_yoy_cls`.formatted }}">{{ rows[0].`a_refunds_qty_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-rownum">1.9</td>
    <td>Cash refunds, %</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_refunds_pct`.formatted }}</td>
    <td class="rep-num">&ndash;%</td>
    <td class="rep-num">&ndash;%</td>
    <td class="rep-num {{ rows[0].`a_refunds_pct_mom_cls`.formatted }}">{{ rows[0].`a_refunds_pct_mom`.formatted }}</td>
    <td class="rep-num">{{ rows[0].`v_refunds_pct_ly`.formatted }}</td>
    <td class="rep-num {{ rows[0].`a_refunds_pct_yoy_cls`.formatted }}">{{ rows[0].`a_refunds_pct_yoy`.formatted }}</td>
  </tr>
  <tr>
    <td class="rep-side-off" rowspan="8">OFFLINE</td>
    <td class="rep-greysub"></td>
    <td class="rep-greysub"></td>
    <td class="rep-medgreen" colspan="3">FLOWERS</td>
    <td class="rep-greysub"></td>
    <td class="rep-greysub"></td>
    <td class="rep-greysub"></td>
  </tr>
  <tr>
    <td></td><td>New retail outlets opened (qty)</td>
    <td class="rep-num">{{ rows[0].`fr_new_outlets`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num"></td><td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td>Active retail outlets (qty)</td>
    <td class="rep-num">{{ rows[0].`fr_active`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num"></td><td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td>Number of orders</td>
    <td class="rep-num">{{ rows[0].`v_placed`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num rep-blue">{{ rows[0].`v_orders_mom`.formatted }}</td>
    <td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td>Avg. check</td>
    <td class="rep-num">{{ rows[0].`v_avgcheck`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num"></td><td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td>Avg. sales (units) per 1 active outlet</td>
    <td class="rep-num">{{ rows[0].`v_units_per_outlet`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num {{ rows[0].`a_units_cls`.formatted }}">{{ rows[0].`a_units`.formatted }}</td>
    <td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td>Active outlets growth (YoY)</td>
    <td class="rep-num rep-blue">{{ rows[0].`v_active_growth_yoy`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num"></td><td class="rep-num"></td><td class="rep-num"></td>
  </tr>
  <tr>
    <td></td><td class="rep-bold">%cr</td>
    <td class="rep-num rep-bold">{{ rows[0].`v_pct_delivered`.formatted }}</td>
    <td class="rep-darkcell" colspan="2"></td>
    <td class="rep-num {{ rows[0].`a_cr_cls`.formatted }}">{{ rows[0].`a_cr`.formatted }}</td>
    <td class="rep-num"></td><td class="rep-num"></td>
  </tr>
</table>
</div> ;;
    }
    settings {
      hide_label: true
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 810
    auto_expand_vertically: true
    block v_month_picker {
      position: pos(10, 10, 1200, 70)
    }
    block v_report {
      position: pos(0, 180, 1220, 620)
    }
    block f_ref_month {
      position: pos(710, 90, 300, 80)
    }
    mobile {
      mode: 'auto'
    }
  }
}