Dashboard flowers_monthly_report_live {
  title: 'Monthly Report (Live)'
  description: 'Live, month-selectable replica of the customer monthly scorecard on the demo ecommerce data. Pick a Reference Month; all values, M/M and Y/Y recompute. ONLINE/OFFLINE = Female/Male buyers (proxy); retail outlets = merchants.'
  owner: 'chukwudi@holistics.io'
  block f_ref_month: FilterBlock {
    label: 'Reference Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: flowers_scorecard
      field: r(flowers_monthly.ref_month)
    }
    settings {
      input_type: 'single'
    }
  }
  block v_month_picker: VizBlock {
    label: 'Select Month'
    viz: MarkdownViz {
      dataset: flowers_scorecard
      rows: [
        VizFieldFull {
          label: 'ref_month'
          ref: r(flowers_monthly.ref_month)
          format {
            type: 'date'
            pattern: 'LLLL yyyy'
          }
        },
        VizFieldFull {
          label: 'sort_order'
          ref: r(flowers_monthly.sort_order)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        }
      ]
      content: @md <style>
.mp-wrap * { box-sizing: border-box; }
.mp-wrap { font-family: Arial, Helvetica, sans-serif; display: flex; align-items: center; gap: 10px; padding: 6px 4px; flex-wrap: wrap; }
.mp-label { font-size: 12px; color: #3f3f3f; font-weight: bold; letter-spacing: 1px; margin-right: 2px; }
.mp-cards { display: flex; gap: 8px; }
.mp-card { display: inline-block; cursor: pointer; text-align: center; min-width: 104px; padding: 8px 16px; border: 1px solid #4f7a36; border-radius: 6px; background: #ffffff; color: #4f7a36; font-weight: bold; font-size: 13px; line-height: 1.15; transition: background .12s ease, color .12s ease; }
.mp-card:hover { background: #eef5e8; }
.mp-cards h-drill { text-decoration: none; }
.mp-cards .h-drill-selected .mp-card, .mp-cards .mp-card.h-drill-selected { background: #5fa845; color: #ffffff; border-color: #5fa845; }
</style>
<div class="mp-wrap">
  <span class="mp-label">SELECT MONTH</span>
  <div class="mp-cards">
    {% map(rows) %}<h-drill row="0" value="{{ `ref_month`.raw }}"><span class="mp-card">{{ `ref_month`.formatted }}</span></h-drill>{% end %}
  </div>
</div> ;;
    }
    settings {
      hide_label: true
    }
  }
  block v_report: VizBlock {
    label: 'Monthly Report'
    viz: MarkdownViz {
      dataset: flowers_scorecard
      rows: [
        VizFieldFull {
          label: 'fr_new_outlets'
          ref: r(flowers_monthly.fr_new_outlets)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'fr_active'
          ref: r(flowers_monthly.fr_active)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_placed'
          ref: r(flowers_monthly.v_placed)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_cancelled'
          ref: r(flowers_monthly.v_cancelled)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_delivered'
          ref: r(flowers_monthly.v_delivered)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_pct_delivered'
          ref: r(flowers_monthly.v_pct_delivered)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_avgcheck'
          ref: r(flowers_monthly.v_avgcheck)
          format {
            type: 'number'
            pattern: '#,##0.00'
          }
        },
        VizFieldFull {
          label: 'v_profit'
          ref: r(flowers_monthly.v_profit)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_refunds_qty'
          ref: r(flowers_monthly.v_refunds_qty)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_refunds_pct'
          ref: r(flowers_monthly.v_refunds_pct)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_placed_on'
          ref: r(flowers_monthly.v_placed_on)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_cancelled_on'
          ref: r(flowers_monthly.v_cancelled_on)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_delivered_on'
          ref: r(flowers_monthly.v_delivered_on)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_share_on'
          ref: r(flowers_monthly.v_share_on)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_avgcheck_on'
          ref: r(flowers_monthly.v_avgcheck_on)
          format {
            type: 'number'
            pattern: '#,##0.00'
          }
        },
        VizFieldFull {
          label: 'v_profit_on'
          ref: r(flowers_monthly.v_profit_on)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_placed_off'
          ref: r(flowers_monthly.v_placed_off)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_cancelled_off'
          ref: r(flowers_monthly.v_cancelled_off)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_delivered_off'
          ref: r(flowers_monthly.v_delivered_off)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_share_off'
          ref: r(flowers_monthly.v_share_off)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_avgcheck_off'
          ref: r(flowers_monthly.v_avgcheck_off)
          format {
            type: 'number'
            pattern: '#,##0.00'
          }
        },
        VizFieldFull {
          label: 'v_profit_off'
          ref: r(flowers_monthly.v_profit_off)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_placed_ly'
          ref: r(flowers_monthly.v_placed_ly)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_cancelled_ly'
          ref: r(flowers_monthly.v_cancelled_ly)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_delivered_ly'
          ref: r(flowers_monthly.v_delivered_ly)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_pct_delivered_ly'
          ref: r(flowers_monthly.v_pct_delivered_ly)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_avgcheck_ly'
          ref: r(flowers_monthly.v_avgcheck_ly)
          format {
            type: 'number'
            pattern: '#,##0.00'
          }
        },
        VizFieldFull {
          label: 'v_profit_ly'
          ref: r(flowers_monthly.v_profit_ly)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_refunds_qty_ly'
          ref: r(flowers_monthly.v_refunds_qty_ly)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'v_refunds_pct_ly'
          ref: r(flowers_monthly.v_refunds_pct_ly)
          format {
            type: 'number'
            pattern: '#,##0.00%'
          }
        },
        VizFieldFull {
          label: 'v_units_per_outlet'
          ref: r(flowers_monthly.v_units_per_outlet)
          format {
            type: 'number'
            pattern: '#,##0.00'
          }
        },
        VizFieldFull {
          label: 'v_active_growth_yoy'
          ref: r(flowers_monthly.v_active_growth_yoy)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_placed_mom'
          ref: r(flowers_monthly.v_placed_mom)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_placed_yoy'
          ref: r(flowers_monthly.v_placed_yoy)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_cancelled_yoy'
          ref: r(flowers_monthly.v_cancelled_yoy)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_delivered_mom'
          ref: r(flowers_monthly.v_delivered_mom)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_delivered_yoy'
          ref: r(flowers_monthly.v_delivered_yoy)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_avgcheck_mom'
          ref: r(flowers_monthly.v_avgcheck_mom)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_avgcheck_yoy'
          ref: r(flowers_monthly.v_avgcheck_yoy)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'v_orders_mom'
          ref: r(flowers_monthly.v_orders_mom)
          format {
            type: 'number'
            pattern: "+#,##0.0%;-#,##0.0%"
          }
        },
        VizFieldFull {
          label: 'a_profit_mom'
          ref: r(flowers_monthly.a_profit_mom)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_profit_mom_cls'
          ref: r(flowers_monthly.a_profit_mom_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_profit_yoy'
          ref: r(flowers_monthly.a_profit_yoy)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_profit_yoy_cls'
          ref: r(flowers_monthly.a_profit_yoy_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_qty_yoy'
          ref: r(flowers_monthly.a_refunds_qty_yoy)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_qty_yoy_cls'
          ref: r(flowers_monthly.a_refunds_qty_yoy_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_pct_mom'
          ref: r(flowers_monthly.a_refunds_pct_mom)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_pct_mom_cls'
          ref: r(flowers_monthly.a_refunds_pct_mom_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_pct_yoy'
          ref: r(flowers_monthly.a_refunds_pct_yoy)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_refunds_pct_yoy_cls'
          ref: r(flowers_monthly.a_refunds_pct_yoy_cls)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'a_units'
          ref: r(flowers_monthly.a_units)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
