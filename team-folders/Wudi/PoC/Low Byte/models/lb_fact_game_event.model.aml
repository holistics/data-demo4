Model lb_fact_game_event {
  type: 'table'
  label: 'Fact Game Event'
  description: ''
  data_source_name: 'demo_prospect_poc'
  owner: 'chukwudi@holistics.io'
  table_name: '"lowbyte_studio"."fact_game_event"'

  dimension game_event_key {
    label: 'Game Event Key'
    type: 'number'
    hidden: false
    primary_key: true
    definition: @sql {{ #SOURCE.game_event_key }};;
  }
