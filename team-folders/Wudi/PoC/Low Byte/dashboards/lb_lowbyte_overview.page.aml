Dashboard lb_lowbyte_overview {
  title: 'Lowbyte Studio — Game Analytics'
  description: 'Unified UA, engagement, retention, monetization & marketing dashboard for Lowbyte Studio.'
  owner: 'chukwudi@holistics.io'

  block flt_date: FilterBlock {
    label: 'Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: ref('lb_dim_date', 'full_date')
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block flt_game: FilterBlock {
    label: 'Game'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: ref('lb_dim_game', 'game_name')
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block flt_platform: FilterBlock {
    label: 'Platform'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: ref('lb_dim_platform', 'platform_name')
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block h1: TextBlock {
    content: @md <div style="height:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16px;background:linear-gradient(97deg,#E63329 0%,#C42A22 100%);border-radius:12px;padding:12px 22px;"><div><div style="color:#FFFFFF;font-size:26px;font-weight:700;font-family:Poppins,sans-serif;">Executive Overview</div><div style="color:#FFE3E0;font-size:14px;margin-top:4px;">Studio-wide KPIs across acquisition, engagement, retention & monetization — Lowbyte Studio</div></div><div style="background:#FFFFFF;border-radius:8px;padding:8px 14px;display:flex;align-items:center;flex:none;"><img src="data:image/png;base64," alt="Lowbyte Studio" style="height:36px;display:block;" /></div></div>;;
  }
  block k2: VizBlock {
    label: 'Installs'
    viz: MetricKpi {
      dataset: lb_lowbyte_studio
      value: VizFieldFull {
        label: ' '
        ref: 'installs'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        metric_value {
          font_size: 26
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block k3: VizBlock {
    label: 'Active Players'
    viz: MetricKpi {
      dataset: lb_lowbyte_studio
      value: VizFieldFull {
        label: ' '
        ref: 'active_players'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        metric_value {
          font_size: 26
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block k4: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: lb_lowbyte_studio
      value: VizFieldFull {
        label: ' '
        ref: 'total_revenue'
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        metric_value {
          font_size: 26
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
