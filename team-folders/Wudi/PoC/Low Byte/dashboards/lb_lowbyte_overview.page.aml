  block cp69: VizBlock {
    label: 'Cohort Retention % — Install Cohort × Periods Since Install'
    viz: PivotTable {
      dataset: lb_lowbyte_studio
      calculation retention_pct {
        label: 'Retention %'
        // Cohort base counts net-new players only (is_reinstall = false). The same
        // filter must apply to numerator and denominator, or reinstall players'
        // activity would be divided by a base that excludes them.
        formula: @aql safe_divide(
          active_players | where(lb_fact_install.is_reinstall is false),
          installs | where(lb_fact_install.is_reinstall is false) | of_all(lb_fact_player_activity_daily.periods_since_install, keep_filters: true)
        ) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      rows: [
        VizFieldFull {
          ref: r(lb_dim_acquisition_source.channel_group)
          format {
            type: 'text'
          }
          uname: 'lb_dim_acquisition_source_channel_group'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio, lb_fact_install.cohort_period)
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
          uname: 'lb_fact_install_cohort_period'
        }
      ]
      columns: [
        VizFieldFull {
          ref: r(lb_lowbyte_studio, lb_fact_player_activity_daily.periods_since_install)
          format {
            type: 'number'
          }
        }
      ]
      values: [
        VizFieldFull {
          label: 'Ret%'
          ref: 'retention_pct'
          format {
            type: 'number'
            pattern: '#,###%'
          }
          uname: 'custom_retention_pct'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'custom_retention_pct'
            // Dark-mode scale: runs dark -> bright so high retention reads as
            // the bright cell. A light-mode scale inverts here — a near-white
            // low end glows against the dark table and reads as the hot value.
            format: ScaleFormat {
              min {
                value: 0
                color: '#2A1613'
              }
              mid {
                value: 0.4
                color: '#8E2A22'
              }
              max {
                value: 1
                color: '#F4564A'
              }
            }
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        column_styles: [
          ColumnStyle {
            key: 'custom_retention_pct'
            width: 260
          },
          ColumnStyle {
            key: 'lb_dim_acquisition_source_channel_group'
            width: 178
          },
          ColumnStyle {
            key: 'lb_fact_install_cohort_period'
            width: 177
          }
        ]
      }
    }
  }
