  block v81: VizBlock {
    label: 'Unit Economics by Channel — LTV per Install vs CPI'
    description: 'Cohort-attributed LTV per install against cost per install, by acquisition channel. A channel is paying back where the LTV bar clears the CPI bar; the gap between them is contribution per install. Both series are cohort-linked, so the comparison is like-for-like.'
    viz: ColumnChart {
      dataset: lb_lowbyte_studio
      x_axis: VizFieldFull {
        ref: r(lb_dim_acquisition_source.channel_group)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.ltv_channel)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.cpi)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        sort {
          field_index: 0
          direction: 'desc'
          type: 'series'
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block v82: VizBlock {
    label: 'Channel Payback — ROAS by Acquisition Channel'
    description: 'Cohort-attributed return on ad spend per channel. Uses roas_channel (attributed revenue / spend) rather than blended ROAS, which is the only version valid to break down by channel.'
    viz: ColumnChart {
      dataset: lb_lowbyte_studio
      x_axis: VizFieldFull {
        ref: r(lb_dim_acquisition_source.channel_group)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.roas_channel)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        sort {
          field_index: 0
          direction: 'desc'
          type: 'series'
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block cp83: VizBlock {
    label: 'Channel Scorecard — Spend, Installs, Attributed Revenue, Payback'
    description: 'One row per acquisition channel with the full funnel from spend to payback. ROAS is conditionally shaded: dark below break-even, bright above it.'
    viz: PivotTable {
      dataset: lb_lowbyte_studio
      rows: [
        VizFieldFull {
          ref: r(lb_dim_acquisition_source.channel_group)
          format {
            type: 'text'
          }
          uname: 'ki_channel_group'
        }
      ]
      values: [
        VizFieldFull {
          ref: r(lb_lowbyte_studio.ua_spend)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_ua_spend'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.installs)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_installs'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.cpi)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_cpi'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.attributed_revenue)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_attributed_revenue'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.ltv_channel)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_ltv_channel'
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.roas_channel)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ki_roas_channel'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'ki_roas_channel'
            format: ScaleFormat {
              min {
                value: 0
                color: '#2A1613'
              }
              mid {
                value: 1
                color: '#8E2A22'
              }
              max {
                value: 3
                color: '#F4564A'
              }
            }
          }
        ]
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block v84: VizBlock {
    label: 'Revenue Mix by Game — IAP vs Ad'
    description: 'Where each title earns its revenue. A game leaning on ad revenue monetizes breadth of audience; a game leaning on IAP monetizes depth of a smaller payer base. The mix drives which levers move that title.'
    viz: ColumnChart {
      dataset: lb_lowbyte_studio
      x_axis: VizFieldFull {
        ref: r(lb_dim_game.game_name)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_stack_total: true
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.iap_revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.ad_revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block v85: VizBlock {
    label: 'Top Markets by Attributed Revenue'
    description: 'Cohort-attributed revenue by country — concentration risk in one chart. A long head means the business depends on a handful of markets.'
    viz: ColumnChart {
      dataset: lb_lowbyte_studio
      x_axis: VizFieldFull {
        ref: r(lb_dim_country.country_name)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(lb_lowbyte_studio.attributed_revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        sort {
          field_index: 0
          direction: 'desc'
          type: 'series'
        }
        aggregate_awareness {
          enabled: true
        }
      }
    }
  }
  block h86: TextBlock {
    content: @md <div style="height:100%;box-sizing:border-box;background:#2A2E38;border:1px solid #40454F;border-radius:12px;padding:18px 22px;font-family:Inter,sans-serif;"><div style="color:#F5F6F8;font-family:Poppins,sans-serif;font-size:15px;font-weight:600;margin-bottom:10px;">How to read this tab</div><div style="display:flex;gap:26px;color:#B3B8C2;font-size:13px;line-height:1.65;"><div style="flex:1;"><div style="color:#F4564A;font-weight:600;margin-bottom:2px;">Does UA pay back?</div>ROAS at <strong style="color:#F5F6F8;">1.0</strong> is break-even on ad spend. Read it per channel, not blended — blended ROAS hides a losing channel behind a winning one. Judge a channel on <strong style="color:#F5F6F8;">LTV per install vs CPI</strong>; the gap is contribution per install.</div><div style="flex:1;"><div style="color:#F4564A;font-weight:600;margin-bottom:2px;">Is revenue concentrated?</div>Check the game mix and the market head. Revenue leaning on one title or one country is the risk that does not show up in a headline total.</div><div style="flex:1;"><div style="color:#F4564A;font-weight:600;margin-bottom:2px;">Caveats</div>LTV is <strong style="color:#F5F6F8;">lifetime-to-date</strong>, not projected, so young cohorts understate it and recent-heavy periods drag ROAS down. Spend is paid-only, so organic installs inflate blended LTV per install.</div></div></div>;;
  }
