  block cp69: VizBlock {
    label: 'Cohort Retention % — Install Cohort × Weeks Since Install'
    viz: PivotTable {
      dataset: lb_lowbyte_studio
      calculation retention_pct {
        label: 'Retention %'
        formula: @aql safe_divide(active_players, installs | of_all(lb_fact_player_activity_daily.weeks_since_install_capped, keep_filters: true)) ;;
        calc_type: 'measure'
        data_type: 'number'
      }
      rows: [
        VizFieldFull {
          ref: r(lb_dim_acquisition_source.channel_group)
          format { type: 'text' }
        },
        VizFieldFull {
          ref: ref('lb_fact_install', 'cohort_period')
          format { type: 'date' pattern: 'yyyy-MM-dd' }
        },
      ]
      columns: [
        VizFieldFull {
          ref: r(lb_fact_player_activity_daily.weeks_since_install_capped)
          format { type: 'number' }
        },
      ]
      values: [
        VizFieldFull {
          label: 'Retention %'
          ref: 'retention_pct'
          uname: 'custom_retention_pct'
          format { type: 'number' pattern: '#,###%' }
        },
      ]
      settings {
        show_row_total: false
        show_column_total: false
        empty_cell_as_zero: false
        conditional_formats: [
          ConditionalFormat {
            key: 'custom_retention_pct'
            format: ScaleFormat {
              min {
                value: 0
                color: '#0E2036'
              }
              mid {
                value: 0.4
                color: '#1D6FB8'
              }
              max {
                value: 1
                color: '#22D3EE'
              }
            }
          }
        ]
        aggregate_awareness { enabled: true }
      }
    }
  }
