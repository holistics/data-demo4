  // Engagement-tab-local filters. Deliberately separate blocks from the
  // dashboard-level flt_platform / flt_date so their state is independent and
  // they only appear on (and drive) the Engagement & Retention tab.
  block flt_eng_platform: FilterBlock {
    label: 'Platform (Android / iOS)'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: r(lb_dim_platform.platform_name)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block flt_eng_start_month: FilterBlock {
    label: 'Month Started (Level 1 Cohort)'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: r(lb_fact_level_funnel.started_month)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block v74: VizBlock {
    label: 'Level Progression Funnel — Unique Players Starting at Level 1'
    description: 'Distinct players who started at level 1, tracked through each level milestone. Each step counts players who reached that level or beyond, so the percentages are true step-to-step conversion rates.'
    viz: ConversionFunnel {
      dataset: lb_lowbyte_studio
      values: [
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_01)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_02)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_03)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_04)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_05)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_10)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
