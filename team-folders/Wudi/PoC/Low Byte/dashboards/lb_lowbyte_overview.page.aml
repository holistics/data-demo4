          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_30)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_40)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(lb_lowbyte_studio.reached_level_50)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
