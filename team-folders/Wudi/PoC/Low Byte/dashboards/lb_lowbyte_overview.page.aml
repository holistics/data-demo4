        aggregate_awareness { enabled: true }
      }
    }
  }
  block v12: VizBlock {
    label: 'Revenue Trend — IAP vs Ad (monthly)'
    viz: LineChart {
      dataset: lb_lowbyte_studio
    x_axis: VizFieldFull {
      ref: r(lb_dim_date.full_date)
      transformation: 'datetrunc month'
      format { type: 'date' pattern: 'LLL yyyy' }
    }
      y_axis {
      settings { show_stack_total: true stack_series_by: 'value' }
      series {
        field: VizFieldFull {
          ref: r(lb_lowbyte_studio.iap_revenue)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      series {
        field: VizFieldFull {
          ref: r(lb_lowbyte_studio.ad_revenue)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      }
      settings {
      row_limit: 5000
      x_axis_show_null_datetime: false
      aggregate_awareness { enabled: true }
      }
    }
  }
  block v13: VizBlock {
    label: 'Installs by Month'
    viz: LineChart {
      dataset: lb_lowbyte_studio
    x_axis: VizFieldFull {
      ref: r(lb_dim_date.full_date)
      transformation: 'datetrunc month'
      format { type: 'date' pattern: 'LLL yyyy' }
    }
