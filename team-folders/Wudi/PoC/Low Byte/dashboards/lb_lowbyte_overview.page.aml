  }
  // ===================================================================
  // Key Insights tab (h75 / k76-k80 / v81-v85 / h86)
  // Exec-facing summary tab: leads with the unit-economics scorecard, then
  // the three questions the studio actually runs on — does UA pay back, per
  // channel; where is revenue concentrated; how deep does monetization go.
  // Every block reuses existing dataset metrics, so nothing here can drift
  // from the tabs it summarises.
  // ===================================================================
  block h75: TextBlock {
    content: @md <div style="height:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16px;background:linear-gradient(97deg,#E63329 0%,#C42A22 100%);border-radius:12px;padding:12px 22px;"><div><div style="color:#FFFFFF;font-size:26px;font-weight:700;font-family:Poppins,sans-serif;">Key Insights</div><div style="color:#FFE3E0;font-size:14px;margin-top:4px;">Unit economics, channel payback and revenue concentration — the studio scorecard</div></div><div style="background:#FFFFFF;border-radius:8px;padding:8px 14px;display:flex;align-items:center;flex:none;"><img src="data:image/png;base64," alt="Lowbyte Studio" style="height:36px;display:block;" /></div></div>;;
  }
  block k76: VizBlock {
    label: 'Total Revenue'
    viz: MetricKpi {
      dataset: lb_lowbyte_studio
