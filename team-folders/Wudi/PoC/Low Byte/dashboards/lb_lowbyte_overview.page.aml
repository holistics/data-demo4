      row_limit: 5000
      x_axis_show_null_datetime: false
      aggregate_awareness { enabled: true }
      }
    }
  }
  block v14: VizBlock {
    label: 'Total Revenue by Game'
    viz: ColumnChart {
      dataset: lb_lowbyte_studio
    x_axis: VizFieldFull {
      ref: r(lb_dim_game.game_name)
      format { type: 'text' }
    }
      y_axis {
      series {
        field: VizFieldFull {
          ref: r(lb_lowbyte_studio.total_revenue)
          format { type: 'number' pattern: 'inherited' }
        }
      }
      }
      settings {
      row_limit: 5000
      x_axis_show_null_datetime: false
      sort { field_index: 0 direction: 'desc' type: 'series' }
      aggregate_awareness { enabled: true }
      }
    }
  }
  block h15: TextBlock {
    content: @md <div style="height:100%;box-sizing:border-box;background:linear-gradient(97deg,#101B3A 0%,#1B2748 60%,#22305C 100%);border:1px solid #26324F;border-radius:12px;padding:12px 22px;"><div style="color:#E8EEFF;font-size:26px;font-weight:700;font-family:Space Grotesk,sans-serif;">User Acquisition</div><div style="color:#93A0C7;font-size:14px;margin-top:4px;">Where installs come from and what they cost</div></div>;;
