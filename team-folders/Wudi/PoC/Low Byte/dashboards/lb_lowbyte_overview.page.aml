  block h63: TextBlock {
    content: @md <div style="height:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16px;background:linear-gradient(97deg,#E63329 0%,#C42A22 100%);border-radius:12px;padding:12px 22px;"><div><div style="color:#FFFFFF;font-size:26px;font-weight:700;font-family:Poppins,sans-serif;">Cohorts</div><div style="color:#FFE3E0;font-size:14px;margin-top:4px;">Install-cohort retention (defaults to last 1 year) — switch granularity with the control; no date-drill needed</div></div><div style="background:#FFFFFF;border-radius:8px;padding:8px 14px;display:flex;align-items:center;flex:none;"><img src="data:image/png;base64," alt="Lowbyte Studio" style="height:36px;display:block;" /></div></div>;;
  }
  block flt_cohort_grain: FilterBlock {
    label: 'Cohort Granularity'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: r(lb_cohort_params.cohort_grain)
    }
    default {
      operator: 'is'
      value: 'Month'
    }
    settings {
      input_type: 'single'
    }
  }
  block flt_cohort_date: FilterBlock {
    label: 'Install Date (Cohort)'
    type: 'field'
    source: FieldFilterSource {
      dataset: lb_lowbyte_studio
      field: r(lb_fact_install.installed_at)
    }
    default {
      operator: 'matches'
      value: 'last 12 months until today'
    }
  }
