// External client portal over the SCSI collections dataset.
//
// SEPARATION OF INTERNAL AND EXTERNAL REPORTING:
// This portal exposes ONLY scsi_client_portal. The internal dashboard
// (scsi_collections_analytics) — collector leaderboards, cross-client recovery, agency
// operations — is deliberately not listed here and is unreachable from the portal.
//
// ROW-LEVEL SECURITY:
// Enforced by the `client_scope` permission on the `scsi` dataset (matches_user_attribute
// on `company_id` — a demo-grade choice; see the dataset for the collision it carries and
// the production fix). It is listed in `required_permissions` so the portal FAILS CLOSED:
// a token that does not carry `company_id` is rejected outright, rather than falling
// through to every provider's medical-debt portfolio.
//
// The rows behind this portal are PHI. SCSI is a HIPAA Business Associate of the placing
// provider, so the embed token must carry the scoping attribute on every request.
EmbedPortal scsi_portal {
  description: 'SCSI client portal — a creditor client sees only the accounts their own organisation placed, plus self-serve exploration and Ask AI over the same scoped data.'
  objects: [
    // Dashboards — external only
    scsi_client_portal,
    // Datasets (self-serve exploration + AI, row-scoped by client_scope)
    scsi,
  ]
  required_permissions: [
    scsi.permission.client_scope,
  ]
  initial_object: 'ai'
  ai {
    customization {
      global {
        assistant_name: 'SCSI Collections Assistant'
      }
      chat_page {
        intro {
          header: 'Ask about your placed accounts, recovery progress or collections activity.'
          body: @md
            ## 💰 Track recovery rate and amounts collected on your portfolio
            ## 📂 Drill by account status, aging bucket or placement date
            ## 📞 See the contact attempts made on your accounts
            ## 📌 Save any insight to your dashboard
          ;;
        }
        prompt_placeholder: 'e.g. What is my recovery rate by aging bucket this year?'
      }
    }
  }
}
