// PII / sensitive columns are masked through the `pii_access` user attribute (1 = may see).
// Column-level permission pattern: https://docs.holistics.io/docs/access-control/column-level-permission

Model teachers {
  type: 'table'
  label: "Teachers"
  description: "Teacher and staff user accounts. Contains PII (name, email) - restrict in BI."
  data_source_name: 'demo_nam_commonlit'
  table_name: '"commonlit"."dim_teachers"'

  dimension teacher_id {
    label: "Teacher Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.teacher_id }};;
    primary_key: true
  }

  dimension school_id {
    label: "School Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.school_id }};;
  }

  dimension first_name {
    label: "First Name"
    type: 'text'
    definition: @sql {{ #SOURCE.first_name }};;
  }

  dimension last_name {
    label: "Last Name"
    type: 'text'
    definition: @sql {{ #SOURCE.last_name }};;
  }

  dimension email {
    label: "Email"
    type: 'text'
    description: "PII. Masked unless the viewer has the pii_access user attribute = 1."
    definition: @sql ${commonlit_mask_text("email")};;
  }

  dimension role {
    label: "Role"
    type: 'text'
    definition: @sql {{ #SOURCE.role }};;
  }

  dimension subject {
    label: "Subject"
    type: 'text'
    definition: @sql {{ #SOURCE.subject }};;
  }

  dimension grade_band {
    label: "Grade Band"
    type: 'text'
    definition: @sql {{ #SOURCE.grade_band }};;
  }

  dimension primary_grade {
    label: "Primary Grade"
    type: 'number'
    definition: @sql {{ #SOURCE.primary_grade }};;
    format: '0'
  }

  dimension signup_date {
    label: "Signup Date"
    type: 'date'
    definition: @sql {{ #SOURCE.signup_date }};;
    format: 'LLL dd, yyyy'
  }

  dimension signup_source {
    label: "Signup Source"
    type: 'text'
    description: "How the teacher signed up (e.g. Google, Clever, email)."
    definition: @sql {{ #SOURCE.signup_source }};;
  }
}
