Model commonlit_fct_student_submissions {
  type: 'table'
  label: "Student Submissions"
  description: "One row per student per completed assignment. score_pct = questions_correct / questions_total. An \"active student\" = distinct student_id with a submission."
  data_source_name: 'demo_nam_commonlit'
  table_name: '"commonlit"."fct_student_submissions"'

  dimension submission_id {
    label: "Submission Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.submission_id }};;
    primary_key: true
  }

  dimension assignment_id {
    label: "Assignment Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.assignment_id }};;
  }

  dimension student_id {
    label: "Student Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.student_id }};;
  }

  dimension class_id {
    label: "Class Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.class_id }};;
  }

  dimension teacher_id {
    label: "Teacher Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.teacher_id }};;
  }

  dimension school_id {
    label: "School Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.school_id }};;
  }

  dimension content_id {
    label: "Content Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.content_id }};;
  }

  dimension submitted_date {
    label: "Submitted Date"
    type: 'date'
    definition: @sql {{ #SOURCE.submitted_date }};;
    format: 'LLL dd, yyyy'
  }

  dimension questions_total {
    label: "Questions Total"
    type: 'number'
    definition: @sql {{ #SOURCE.questions_total }};;
    format: '#,###'
  }

  dimension questions_correct {
    label: "Questions Correct"
    type: 'number'
    definition: @sql {{ #SOURCE.questions_correct }};;
    format: '#,###'
  }

  dimension score_pct {
    label: "Score %"
    type: 'number'
    description: "0-100. Discrete because lessons have 4-8 questions (15-20 for unit assessments)."
    definition: @sql {{ #SOURCE.score_pct }};;
    format: '#,###0.0\\%'
  }

  dimension time_spent_minutes {
    label: "Time Spent Minutes"
    type: 'number'
    definition: @sql {{ #SOURCE.time_spent_minutes }};;
    format: '#,###'
  }

  dimension is_late {
    label: "Is Late"
    type: 'truefalse'
    description: "Submitted after the assignment due date."
    definition: @sql {{ #SOURCE.is_late }};;
  }

  dimension used_read_aloud {
    label: "Used Read Aloud"
    type: 'truefalse'
    definition: @sql {{ #SOURCE.used_read_aloud }};;
  }

  dimension used_translation {
    label: "Used Translation"
    type: 'truefalse'
    definition: @sql {{ #SOURCE.used_translation }};;
  }

  dimension used_guided_reading {
    label: "Used Guided Reading"
    type: 'truefalse'
    definition: @sql {{ #SOURCE.used_guided_reading }};;
  }

  dimension received_ai_feedback {
    label: "Received AI Feedback"
    type: 'truefalse'
    definition: @sql {{ #SOURCE.received_ai_feedback }};;
  }

  dimension school_year {
    label: "School Year (derived)"
    type: 'text'
    description: "School year of submitted_date, derived with the same Jul 1 - Jun 30 rule as Dates.school_year. Used only to build the program-year key; filter on Dates.school_year instead."
    hidden: true
    definition: @sql case when extract(month from {{ #SOURCE.submitted_date }}) >= 7 then extract(year from {{ #SOURCE.submitted_date }})::int::text || '-' || lpad(((extract(year from {{ #SOURCE.submitted_date }})::int + 1) % 100)::text, 2, '0') else (extract(year from {{ #SOURCE.submitted_date }})::int - 1)::text || '-' || lpad((extract(year from {{ #SOURCE.submitted_date }})::int % 100)::text, 2, '0') end;;
  }

  dimension program_year_key {
    label: "Program Year Key"
    type: 'text'
    description: "school_id|school_year. Joins this fact to School Program Years (composite key school_id + school_year)."
    hidden: true
    definition: @sql {{ #SOURCE.school_id }}::text || '|' || (case when extract(month from {{ #SOURCE.submitted_date }}) >= 7 then extract(year from {{ #SOURCE.submitted_date }})::int::text || '-' || lpad(((extract(year from {{ #SOURCE.submitted_date }})::int + 1) % 100)::text, 2, '0') else (extract(year from {{ #SOURCE.submitted_date }})::int - 1)::text || '-' || lpad((extract(year from {{ #SOURCE.submitted_date }})::int % 100)::text, 2, '0') end);;
  }

  dimension score_bucket {
    label: "Score Bucket"
    type: 'number'
    description: "Score % rounded down to the nearest 10 (0, 10, ... 100). X-axis of the score histogram."
    definition: @sql floor({{ #SOURCE.score_pct }} / 10) * 10;;
    format: '0'
  }
}
