Model commonlit_fct_feature_usage_weekly {
  type: 'table'
  label: "Feature Usage (Weekly)"
  description: "PostHog-style feature usage: one row per teacher, week and feature used, with event count."
  data_source_name: 'demo_nam_commonlit'
  table_name: '"commonlit"."fct_feature_usage_weekly"'

  dimension week_start {
    label: "Week"
    type: 'date'
    definition: @sql {{ #SOURCE.week_start }};;
    format: 'LLL dd, yyyy'
  }

  dimension teacher_id {
    label: "Teacher Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.teacher_id }};;
  }

  dimension school_id {
    label: "School Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.school_id }};;
  }

  dimension feature_id {
    label: "Feature Id"
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.feature_id }};;
  }

  dimension event_count {
    label: "Event Count"
    type: 'number'
    definition: @sql {{ #SOURCE.event_count }};;
    format: '#,###'
  }

  dimension school_year {
    label: "School Year (derived)"
    type: 'text'
    description: "School year of week_start, derived with the same Jul 1 - Jun 30 rule as Dates.school_year. Used only to build the program-year key; filter on Dates.school_year instead."
    hidden: true
    definition: @sql case when extract(month from {{ #SOURCE.week_start }}) >= 7 then extract(year from {{ #SOURCE.week_start }})::int::text || '-' || lpad(((extract(year from {{ #SOURCE.week_start }})::int + 1) % 100)::text, 2, '0') else (extract(year from {{ #SOURCE.week_start }})::int - 1)::text || '-' || lpad((extract(year from {{ #SOURCE.week_start }})::int % 100)::text, 2, '0') end;;
  }

  dimension program_year_key {
    label: "Program Year Key"
    type: 'text'
    description: "school_id|school_year. Joins this fact to School Program Years (composite key school_id + school_year)."
    hidden: true
    definition: @sql {{ #SOURCE.school_id }}::text || '|' || (case when extract(month from {{ #SOURCE.week_start }}) >= 7 then extract(year from {{ #SOURCE.week_start }})::int::text || '-' || lpad(((extract(year from {{ #SOURCE.week_start }})::int + 1) % 100)::text, 2, '0') else (extract(year from {{ #SOURCE.week_start }})::int - 1)::text || '-' || lpad((extract(year from {{ #SOURCE.week_start }})::int % 100)::text, 2, '0') end);;
  }

  dimension usage_key {
    label: "Usage Key"
    type: 'text'
    description: "Surrogate primary key teacher_id|feature_id|week_start."
    hidden: true
    definition: @sql {{ #SOURCE.teacher_id }}::text || '|' || {{ #SOURCE.feature_id }}::text || '|' || {{ #SOURCE.week_start }}::text;;
    primary_key: true
  }
}
