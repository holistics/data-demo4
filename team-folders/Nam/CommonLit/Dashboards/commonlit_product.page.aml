Dashboard commonlit_product {
  title: 'CommonLit · Product Adoption'
  description: 'Feature adoption ramps for Product & Design: how quickly teachers pick up each new feature after launch.'
  theme: commonlit_theme

  block t_header: TextBlock {
    content: @md
# Product Adoption

How fast teachers adopt new features after launch, and which features they keep using.;;
  }

  block f_school_year: FilterBlock {
    label: 'School Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: commonlit_product_adoption
      field: r(dates.school_year)
    }
    default {
      operator: 'is'
      value: '2026-27'
    }
    theme: BlockTheme {
      background { bg_color: 'transparent' }
      border { border_width: 0 border_style: 'none' }
      shadow: 'none'
      padding: 0
    }
  }

  block f_state: FilterBlock {
    label: 'State'
    type: 'field'
    source: FieldFilterSource {
      dataset: commonlit_product_adoption
      field: r(states.state_name)
    }
    default {
      operator: 'is'
      value: []
    }
    theme: BlockTheme {
      background { bg_color: 'transparent' }
      border { border_width: 0 border_style: 'none' }
      shadow: 'none'
      padding: 0
    }
  }

  block f_district: FilterBlock {
    label: 'District'
    type: 'field'
    source: FieldFilterSource {
      dataset: commonlit_product_adoption
      field: r(districts.district_name)
    }
    default {
      operator: 'is'
      value: []
    }
    theme: BlockTheme {
      background { bg_color: 'transparent' }
      border { border_width: 0 border_style: 'none' }
      shadow: 'none'
      padding: 0
    }
  }

  block f_program: FilterBlock {
    label: 'Program Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: commonlit_product_adoption
      field: r(school_program_years.program_status)
    }
    default {
      operator: 'is'
      value: []
    }
    theme: BlockTheme {
      background { bg_color: 'transparent' }
      border { border_width: 0 border_style: 'none' }
      shadow: 'none'
      padding: 0
    }
  }

  block k_users: VizBlock {
    label: 'Teachers Using Any Feature'
    viz: MetricKpi {
      dataset: commonlit_product_adoption
      value: VizFieldFull {
        label: ' '
        ref: r(commonlit_product_adoption.feature_users)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block k_new: VizBlock {
    label: 'New Feature Adopters'
    viz: MetricKpi {
      dataset: commonlit_product_adoption
      value: VizFieldFull {
        label: ' '
        ref: r(commonlit_product_adoption.new_adopters)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block k_events: VizBlock {
    label: 'Feature Events'
    viz: MetricKpi {
      dataset: commonlit_product_adoption
      value: VizFieldFull {
        label: ' '
        ref: r(commonlit_product_adoption.feature_events)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block k_epu: VizBlock {
    label: 'Events per Teacher'
    viz: MetricKpi {
      dataset: commonlit_product_adoption
      value: VizFieldFull {
        label: ' '
        ref: r(commonlit_product_adoption.events_per_user)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block t_ramp: TextBlock {
    content: @md
## Adoption ramps

Cumulative teachers who have used each feature since launch (features launched since Aug 2025). Ignores the School Year filter so every ramp starts at launch.;;
  }

  block c_ramp: VizBlock {
    label: 'Adopters Since Launch: New Features'
    viz: LineChart {
      dataset: commonlit_product_adoption
      x_axis: VizFieldFull {
        ref: r(dates.date_day)
        transformation: 'datetrunc week'
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(product_features.feature_name)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(commonlit_product_adoption.adopters_since_launch)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      filter {
        field: r(product_features.feature_name)
        operator: 'is'
        value: ['Target Lessons', 'Assessment Reports 2.0', 'AI Writing Feedback', 'Lesson Planner']
      }
      settings {
        row_limit: 5000
      }
    }
  }

  block c_weekly: VizBlock {
    label: 'Weekly Active Users by Feature'
    viz: LineChart {
      dataset: commonlit_product_adoption
      x_axis: VizFieldFull {
        ref: r(dates.date_day)
        transformation: 'datetrunc week'
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(product_features.feature_name)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(commonlit_product_adoption.feature_users)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        row_limit: 5000
      }
    }
  }

  block tb_features: VizBlock {
    label: 'Feature Scorecard'
    viz: DataTable {
      dataset: commonlit_product_adoption
      fields: [
        r(product_features.feature_name),
        r(product_features.feature_area),
        r(product_features.launch_date),
        r(product_features.availability),
        r(commonlit_product_adoption.feature_users),
        r(commonlit_product_adoption.new_adopters),
        r(commonlit_product_adoption.events_per_user)
      ]
      settings {
        row_limit: 25
        wrap_header_text: true
        sorts: [
          SortSetting {
            key: 'feature_users'
            direction: 'desc'
          }
        ]
      }
    }
  }

  explicit_interactions: [
    FilterInteraction {
      from: 'f_school_year'
      to: ['k_users', 'k_new', 'k_events', 'k_epu', 'c_weekly', 'tb_features']
      field: r(dates.school_year)
    },
    FilterInteraction {
      from: 'f_state'
      to: ['k_users', 'k_new', 'k_events', 'k_epu', 'c_ramp', 'c_weekly', 'tb_features']
      field: r(states.state_name)
    },
    FilterInteraction {
      from: 'f_district'
      to: ['k_users', 'k_new', 'k_events', 'k_epu', 'c_ramp', 'c_weekly', 'tb_features']
      field: r(districts.district_name)
    },
    FilterInteraction {
      from: 'f_program'
      to: ['k_users', 'k_new', 'k_events', 'k_epu', 'c_ramp', 'c_weekly', 'tb_features']
      field: r(school_program_years.program_status)
    }
  ]

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 1820
    grid_size: 20
    auto_expand_vertically: true
    block t_header {
      position: pos(20, 20, 1180, 120)
    }
    block f_school_year {
      position: pos(20, 160, 285, 60)
    }
    block f_state {
      position: pos(325, 160, 285, 60)
    }
    block f_district {
      position: pos(630, 160, 285, 60)
    }
    block f_program {
      position: pos(935, 160, 265, 60)
    }
    block k_users {
      position: pos(20, 240, 285, 140)
    }
    block k_new {
      position: pos(325, 240, 285, 140)
    }
    block k_events {
      position: pos(630, 240, 285, 140)
    }
    block k_epu {
      position: pos(935, 240, 265, 140)
    }
    block t_ramp {
      position: pos(20, 420, 1180, 120)
    }
    block c_ramp {
      position: pos(20, 560, 1180, 400)
    }
    block c_weekly {
      position: pos(20, 980, 1180, 380)
    }
    block tb_features {
      position: pos(20, 1380, 1180, 400)
    }
  }

  settings {
    autorun_on_open: true
  }
}
