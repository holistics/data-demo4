      rows: [
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'dd LLL yyyy'
          }
          uname: 'so_date'
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Stage'
          ref: r(messi_matches.stage)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Result'
