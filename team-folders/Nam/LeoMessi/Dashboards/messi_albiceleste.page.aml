  .mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
  .mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
  .mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
  {% map(rows) %}<div class="mx mx-kpis">
  <div class="mx-kpi"><span class="l">Matches</span><span class="v">{{ values.`Matches`.formatted }}</span><span class="n">Meetings in the selection</span></div>
  <div class="mx-kpi"><span class="l">W–D–L</span><span class="v">{{ values.`W`.formatted }}–{{ values.`D`.formatted }}–{{ values.`L`.formatted }}</span><span class="n">Shootouts count as draws</span></div>
  <div class="mx-kpi"><span class="l">Messi goals</span><span class="v">{{ values.`Messi goals`.formatted }}</span><span class="n">Against this selection</span></div>
  <div class="mx-kpi"><span class="l">Goals per match</span><span class="v">{{ values.`Goals per match`.formatted }}</span><span class="n">Career rate: 0.60</span></div>
  </div>{% end %}
  ;;
      settings {
        pagination_size: 1
        row_limit: 1
      }
    }
  }
  block v4_tiles: VizBlock {
    label: 'Every meeting'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      rows: [
        VizFieldFull {
          ref: r(messi_matches.cap_no)
          label: 'Cap'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(messi_matches.match_date)
          label: 'Date'
          format {
            type: 'date'
            pattern: 'LLL dd, yyyy'
          }
        },
        VizFieldFull {
          ref: r(messi_matches.opponent)
          label: 'Opponent'
        },
        VizFieldFull {
          ref: r(messi_matches.scoreline)
          label: 'Score'
        },
        VizFieldFull {
          ref: r(messi_matches.result_label)
          label: 'Result'
        },
        VizFieldFull {
          ref: r(messi_matches.messi_goals)
          label: 'Goals'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      content: @md
<style>
.mx-rival-card { box-sizing: border-box; height: 340px; overflow: hidden; padding: 0.75rem; }
.mx-rival-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; }
.mx-rival-title { margin: 0; color: #0b2545; font: 800 20px/1 'Big Shoulders Display', Impact, sans-serif; letter-spacing: .02em; text-transform: uppercase; }
.mx-rival-subtitle { margin: 0.2rem 0 0; color: #5d7694; font: 400 11px/1.3 Rubik, sans-serif; }
.mx-rival-legend { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.38rem; color: #5d7694; font: 500 10px/1 'DM Mono', monospace; white-space: nowrap; }
.mx-rival-legend-item { display: inline-flex; align-items: center; gap: 0.2rem; }
.mx-rival-legend-dot { width: 0.45rem; height: 0.45rem; border-radius: 999px; }
.mx-rival-legend-win { background: #2a78d6; }.mx-rival-legend-draw { background: #b7c3d1; }.mx-rival-legend-loss { background: #eb6834; }
.mx-rival-grid-wrap { height: calc(100% - 3.1rem); overflow-y: auto; padding: 0.15rem 0.15rem 0.35rem; }
.mx-rival-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0.32rem; }
.mx-rival-tile { position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; aspect-ratio: 1 / 1; border: 1px solid rgba(11,37,69,.12); border-radius: 0.35rem; color: #fff; cursor: help; font: 600 12px/1 'DM Mono', monospace; box-shadow: inset 0 1px 0 rgba(255,255,255,.16); transition: transform .12s ease, box-shadow .12s ease; }
.mx-rival-tile:hover { transform: scale(1.1); box-shadow: 0 5px 12px rgba(11,37,69,.24); z-index: 5; }
.mx-rival-tile:after { content: attr(data-tooltip); position: absolute; left: 50%; bottom: calc(100% + 9px); z-index: 10; width: 190px; padding: 8px 10px; border-radius: 8px; background: #0b2545; color: #fff; box-shadow: 0 6px 18px rgba(11,37,69,.3); font: 500 10px/1.35 Rubik, sans-serif; letter-spacing: 0; text-align: left; white-space: normal; opacity: 0; pointer-events: none; transform: translate(-50%, 4px); transition: opacity .12s ease, transform .12s ease; visibility: hidden; }
.mx-rival-tile:hover:after { opacity: 1; transform: translate(-50%, 0); visibility: visible; }
.mx-rival-tile:nth-child(-n + 12):after { top: calc(100% + 9px); bottom: auto; transform: translate(-50%, -4px); }
.mx-rival-tile:nth-child(-n + 12):hover:after { transform: translate(-50%, 0); }
.mx-rival-result-Win { background: #2a78d6; }.mx-rival-result-Draw { background: #b7c3d1; color: #0b2545; }.mx-rival-result-Loss { background: #eb6834; }
.mx-rival-goals { position: absolute; right: 0.16rem; bottom: 0.13rem; min-width: 0.68rem; height: 0.68rem; padding: 0 0.12rem; border-radius: 999px; background: rgba(255,255,255,.94); color: #0b2545; font: 800 9px/.68rem 'DM Mono', monospace; text-align: center; }
.mx-rival-goals-0 { display: none; }
@media (max-width: 900px) { .mx-rival-grid { grid-template-columns: repeat(8, minmax(0, 1fr)); } }
@media (max-width: 560px) { .mx-rival-card { padding: 0.62rem; }.mx-rival-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }.mx-rival-heading { gap: 0.4rem; }.mx-rival-legend { gap: 0.25rem; } }
</style>
<section class="mx-rival-card">
  <header class="mx-rival-heading">
    <div>
      <h3 class="mx-rival-title">Every meeting</h3>
      <p class="mx-rival-subtitle">207 caps in chronological order · hover a tile for match detail</p>
    </div>
    <div class="mx-rival-legend" aria-label="Match result legend">
      <span class="mx-rival-legend-item"><i class="mx-rival-legend-dot mx-rival-legend-win"></i>Win</span>
      <span class="mx-rival-legend-item"><i class="mx-rival-legend-dot mx-rival-legend-draw"></i>Draw</span>
      <span class="mx-rival-legend-item"><i class="mx-rival-legend-dot mx-rival-legend-loss"></i>Loss</span>
    </div>
  </header>
  <div class="mx-rival-grid-wrap"><div class="mx-rival-grid">{% map(rows) %}<span class="mx-rival-tile mx-rival-result-{{ `Result`.raw }}" data-tooltip="Cap {{ `Cap`.formatted }} · {{ `Date`.formatted }} · Argentina vs {{ `Opponent`.raw }} · {{ `Score`.raw }} · {{ `Result`.raw }} · Messi goals: {{ `Goals`.formatted }}" title="Cap {{ `Cap`.formatted }} · {{ `Date`.formatted }} · Argentina vs {{ `Opponent`.raw }} · {{ `Score`.raw }} · {{ `Result`.raw }} · Messi goals: {{ `Goals`.formatted }}">{{ `Cap`.formatted }}<i class="mx-rival-goals mx-rival-goals-{{ `Goals`.raw }}">{{ `Goals`.formatted }}</i></span>{% end %}</div></div>
</section>
;;
      settings {
        sorts: [
          IndexBasedSortSetting {
            field_index: 0
            direction: 'asc'
          }
        ]
        pagination_size: 250
        row_limit: 250
      }
    }
  }
  block v4_conf: VizBlock {
    label: 'He beats every continent'
    description: 'Share of matches won, drawn and lost by opponent confederation. Click a bar to filter.'
    viz: BarChart {
      dataset: messi_argentina
      x_axis: VizFieldFull {
        label: 'Confederation'
        ref: r(messi_matches.opponent_confederation)
        format {
          type: 'text'
        }
      }
      legend: VizFieldFull {
        label: 'Result'
        ref: r(messi_matches.result_label)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_data_label_by: 'percentage'
          stack_series_by: 'percentage'
        }
        series {
          field: VizFieldFull {
            label: 'Caps'
            ref: r(messi_argentina.messi_caps)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            point {
              value: 'Win'
              color: '#2a78d6'
            }
            point {
              value: 'Draw'
              color: '#b7c3d1'
            }
            point {
              value: 'Loss'
              color: '#eb6834'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        x_axis_label: 'Confederation'
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v4_country: VizBlock {
    label: '36 countries, one shirt'
    description: 'Caps by the country the match was played in.'
    viz: BarChart {
      dataset: messi_argentina
      x_axis: VizFieldFull {
        label: 'Venue country'
        ref: r(messi_matches.country)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Caps'
            ref: r(messi_argentina.messi_caps)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#75aadb'
          }
        }
      }
      settings {
        row_limit: 40
        legend_label: 'hidden'
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
      }
    }
  }
  block v4_meetings: VizBlock {
    label: 'Every meeting, in order'
    viz: DataTable {
      dataset: messi_argentina
      fields: [
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'LLL dd yyyy'
          }
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Competition'
          ref: r(messi_matches.competition_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Result'
          ref: r(messi_matches.result_label)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Messi goals'
          ref: r(messi_matches.messi_goals)
          format {
            type: 'number'
            pattern: '0'
          }
        }
      ]
      settings {
        pagination_size: 12
        sorts: [
          IndexBasedSortSetting {
            field_index: 0
            direction: 'asc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Win'
              }
              text_color: '#ffffff'
              background_color: '#2a78d6'
            }
          },
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Draw'
              }
              text_color: '#0b2545'
              background_color: '#b7c3d1'
            }
          },
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Loss'
              }
              text_color: '#ffffff'
              background_color: '#eb6834'
            }
          }
        ]
      }
    }
  }
  block v5_finals: VizBlock {
    label: 'Nine finals'
    viz: MarkdownViz {
      dataset: messi_argentina
      filter {
        field: r(messi_matches.stage)
        operator: 'is'
        value: 'Final'
      }
      rows: [
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'dd LLL yyyy'
          }
          uname: 'final_date'
        },
        VizFieldFull {
          label: 'Tournament'
          ref: r(messi_tournaments.tournament_name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Year'
          ref: r(messi_tournaments.year)
          format {
            type: 'number'
            pattern: '#,###'
          }
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'City'
          ref: r(messi_matches.city)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Result'
          ref: r(messi_matches.result_incl_shootout)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Goals'
          ref: r(messi_matches.messi_goals)
          format {
            type: 'number'
            pattern: '0'
          }
        }
      ]
      content: @md <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
.mx * { box-sizing: border-box; }
.mx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; height: 100%; }
.mx-kpi { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); display: flex; flex-direction: column; }
.mx-kpi .l { font: 500 13px/1.2 Rubik, sans-serif; color: #5d7694; }
.mx-kpi .v { font: 900 52px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; margin: 6px 0 4px; }
.mx-kpi .n { font: 400 12px/1.35 Rubik, sans-serif; color: #5d7694; margin-top: auto; }
.mx-kpi.gold { background: #fff2cc; border-color: #e9b42a; }
.mx-kpi.gold .l, .mx-kpi.gold .v, .mx-kpi.gold .n { color: #3a2600; }
.mx-split { display: flex; height: 28px; border-radius: 999px; overflow: hidden; margin: 10px 0 8px; }
.mx-split span { display: flex; align-items: center; justify-content: center; font: 600 12px/1 'DM Mono', monospace; color: #fff; min-width: 28px; }
.mx-split .w { background: #2a78d6; } .mx-split .d { background: #b7c3d1; color: #0b2545; } .mx-split .l { background: #eb6834; }
.mx-legend { display: flex; flex-wrap: wrap; gap: 14px; font: 400 12px/1 Rubik, sans-serif; color: #5d7694; }
.mx-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
.mx-card { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 16px 18px; height: 100%; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); overflow: auto; }
.mx-card h3 { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 0 0 4px; color: #0b2545; }
.mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
.mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
.mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
.mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
<style>
.mx-finals { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
.mx-final { border-radius: 14px; padding: 14px; background: #e7f1fb; border: 1px solid #d3e3f3; color: #36506f; }
.mx-final.Win { background: #fff2cc; border-color: #e9b42a; color: #3a2600; }
.mx-final .yr { font: 900 44px/.9 'Big Shoulders Display', Impact, sans-serif; color: #9fb0c3; }
.mx-final.Win .yr { color: #f6b40e; }
.mx-final b { display: block; font: 700 15px/1.25 Rubik, sans-serif; color: #0b2545; margin: 6px 0 2px; }
.mx-final .score { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; }
.mx-tag { float: right; font: 600 11px/1 'DM Mono', monospace; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; background: #9fb0c3; color: #0b2545; }
.mx-final.Win .mx-tag { background: #f6b40e; color: #3a2600; }
</style>
<div class="mx mx-card"><h3>Nine finals</h3><p class="sub">Four finals lost. Then four won in a row.</p><div class="mx-finals">
{% map(rows) %}<div class="mx-final {{ `Result`.raw }}"><span class="mx-tag">{{ `Result`.formatted }}</span><span class="yr">{{ `Year`.formatted }}</span><b>{{ `Tournament`.formatted }}</b><span class="mx-mono">vs {{ `Opponent`.formatted }} · {{ `City`.formatted }}</span><div class="score" style="margin-top:8px">{{ `Score`.formatted }}</div><span class="mx-mono">{{ `Date`.formatted }} · Messi goals {{ `Goals`.formatted }}</span></div>{% end %}
</div></div> ;;
      settings {
        sorts: [
          SortSetting {
            key: 'final_date'
            direction: 'asc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    theme {
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      background {
        bg_color: 'transparent'
      }
      padding: 0
      shadow: 'none'
    }
  }
  block v5_shootouts: VizBlock {
    label: 'Nerves of steel'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      filter {
        field: r(messi_matches.went_to_shootout)
        operator: 'is'
        value: true
