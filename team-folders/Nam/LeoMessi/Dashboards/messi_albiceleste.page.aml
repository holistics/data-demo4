// Messi · Albiceleste 2005–2026 — five-chapter story of Messi's Argentina career, as an HTMLLayout.
// Built from the mockup "Messi · Albiceleste 2005–2026.html". Generated by a script: editorial
// content lives in the layout HTML; data blocks are placed with <h-block>. Every filter is
// wired explicitly to its own chapter's blocks.
Dashboard messi_albiceleste {
  title: 'Messi · Albiceleste 2005–2026'
  description: '''Lionel Messi's senior international career with Argentina in five chapters: the whole career, six World Cups, 125 goals, rivals, and nine finals. Reads dataset messi_argentina (data source demo_nam_leo_messi).'''
  owner: 'nam.tran@holistics.io'

  block f1_year: FilterBlock {
    label: 'Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_matches.year)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block f1_comp: FilterBlock {
    label: 'Competition'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_matches.competition_type)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block f1_coach: FilterBlock {
    label: 'Coach'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_matches.coach)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block k1_kpis: VizBlock {
    label: 'Career KPIs'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      rows: [

      ]
      values: [
        VizFieldFull {
          label: 'Caps'
          ref: r(messi_argentina.messi_caps)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Goals'
          ref: r(messi_argentina.messi_total_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Win rate'
          ref: r(messi_argentina.messi_win_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Per match'
          ref: r(messi_argentina.messi_goals_per_match)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Won'
          ref: r(messi_argentina.messi_wins)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Drawn'
          ref: r(messi_argentina.messi_draws)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Lost'
          ref: r(messi_argentina.messi_losses)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
  <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
  .mx * { box-sizing: border-box; }
  .mx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; height: 100%; }
  .mx-kpi { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); display: flex; flex-direction: column; }
  .mx-kpi .l { font: 500 13px/1.2 Rubik, sans-serif; color: #5d7694; }
  .mx-kpi .v { font: 900 52px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; margin: 6px 0 4px; }
  .mx-kpi .n { font: 400 12px/1.35 Rubik, sans-serif; color: #5d7694; margin-top: auto; }
  .mx-kpi.gold { background: #fff2cc; border-color: #e9b42a; }
  .mx-kpi.gold .l, .mx-kpi.gold .v, .mx-kpi.gold .n { color: #3a2600; }
  .mx-split { display: flex; height: 28px; border-radius: 999px; overflow: hidden; margin: 10px 0 8px; }
  .mx-split span { display: flex; align-items: center; justify-content: center; font: 600 12px/1 'DM Mono', monospace; color: #fff; min-width: 28px; }
  .mx-split .w { background: #2a78d6; } .mx-split .d { background: #b7c3d1; color: #0b2545; } .mx-split .l { background: #eb6834; }
  .mx-legend { display: flex; flex-wrap: wrap; gap: 14px; font: 400 12px/1 Rubik, sans-serif; color: #5d7694; }
  .mx-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .mx-card { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 16px 18px; height: 100%; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); overflow: auto; }
  .mx-card h3 { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 0 0 4px; color: #0b2545; }
  .mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
  .mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
  .mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
  {% map(rows) %}<div class="mx" style="display:grid;grid-template-rows:auto 1fr;gap:14px">
  <div class="mx-kpis">
  <div class="mx-kpi"><span class="l">Caps</span><span class="v">{{ values.`Caps`.formatted }}</span><span class="n">Matches in the selection</span></div>
  <div class="mx-kpi"><span class="l">Goals</span><span class="v">{{ values.`Goals`.formatted }}</span><span class="n">{{ values.`Per match`.formatted }} per match</span></div>
  <div class="mx-kpi"><span class="l">Win rate</span><span class="v">{{ values.`Win rate`.formatted }}</span><span class="n">After 90/120 minutes</span></div>
  <div class="mx-kpi gold"><span class="l">Assists</span><span class="v">65</span><span class="n">Career total, the provider too. Not filterable.</span></div>
  </div>
  <div class="mx-card"><h3>Won, drawn, lost</h3>
  <div class="mx-split"><span class="w" style="flex:{{ values.`Won`.raw }}">{{ values.`Won`.formatted }}</span><span class="d" style="flex:{{ values.`Drawn`.raw }}">{{ values.`Drawn`.formatted }}</span><span class="l" style="flex:{{ values.`Lost`.raw }}">{{ values.`Lost`.formatted }}</span></div>
  <div class="mx-legend"><span><i style="background:#2a78d6"></i>Won</span><span><i style="background:#b7c3d1"></i>Drawn</span><span><i style="background:#eb6834"></i>Lost</span><span>Shootouts count as draws</span></div>
  </div></div>{% end %}
  ;;
      settings {
        pagination_size: 1
        row_limit: 1
      }
    }
  }
  block v1_year: VizBlock {
    label: 'Every year, every goal'
    description: 'His best year: 18 goals in 2022, the year he won the World Cup. Click a column to filter the chapter.'
    viz: ColumnChart {
      dataset: messi_argentina
      x_axis: VizFieldFull {
        label: 'Year'
        ref: r(messi_matches.year)
        format {
          type: 'number'
          pattern: '0'
        }
      }
      legend: VizFieldFull {
        label: 'Competition'
        ref: r(messi_matches.competition_type)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Messi goals'
            ref: r(messi_argentina.messi_total_goals)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
        settings {
          stack_series_by: 'value'
        }
      }
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v1_coach: VizBlock {
    label: 'Nine coaches, one constant'
    viz: DataTable {
      dataset: messi_argentina
      fields: [
        VizFieldFull {
          label: 'Coach'
          ref: r(messi_matches.coach)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Caps'
          ref: r(messi_argentina.messi_caps)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Won'
          ref: r(messi_argentina.messi_wins)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Drawn'
          ref: r(messi_argentina.messi_draws)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Lost'
          ref: r(messi_argentina.messi_losses)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Win rate'
          ref: r(messi_argentina.messi_win_rate)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Messi goals'
          ref: r(messi_argentina.messi_total_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Goals / match'
          ref: r(messi_argentina.messi_goals_per_match)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        pagination_size: 10
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(messi_argentina.messi_win_rate)
            format: ScaleFormat {
              min {
                type: 'percentage'
                value: 0
                color: '#ffffff'
              }
              max {
                type: 'percentage'
                value: 1
                color: '#75aadb'
              }
            }
          }
        ]
      }
    }
  }
  block v1_log: VizBlock {
    label: 'The match log'
    viz: DataTable {
      dataset: messi_argentina
      fields: [
        VizFieldFull {
          label: 'Cap'
          ref: r(messi_matches.cap_no)
          format {
            type: 'number'
            pattern: '0'
          }
        },
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'LLL dd yyyy'
          }
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Competition'
          ref: r(messi_matches.competition_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Stage'
          ref: r(messi_matches.stage)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Result'
          ref: r(messi_matches.result_label)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Messi goals'
          ref: r(messi_matches.messi_goals)
          format {
            type: 'number'
            pattern: '0'
          }
        },
        VizFieldFull {
          label: 'Coach'
          ref: r(messi_matches.coach)
          format {
            type: 'text'
          }
        }
      ]
      settings {
        pagination_size: 15
        sorts: [
          IndexBasedSortSetting {
            field_index: 1
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Win'
              }
              text_color: '#ffffff'
              background_color: '#2a78d6'
            }
          },
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Draw'
              }
              text_color: '#0b2545'
              background_color: '#b7c3d1'
            }
          },
          ConditionalFormat {
            ref: r(messi_matches.result_label)
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Loss'
              }
              text_color: '#ffffff'
              background_color: '#eb6834'
            }
          }
        ]
      }
    }
  }
  block f2_wc: FilterBlock {
    label: 'World Cup'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_tournaments.world_cup)
    }
    default {
      operator: 'is'
      value: '2022 · Qatar'
    }
    settings {
      input_type: 'single'
    }
  }
  block f2_metric: FilterBlock {
    label: 'Compare by'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_params.metric_selector)
    }
    default {
      operator: 'is'
      value: [
        'Goals'
      ]
    }
    settings {
      input_type: 'single'
    }
  }
  block k2_kpis: VizBlock {
    label: 'World Cup KPIs'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      filter {
        field: r(messi_tournaments.tournament_name)
        operator: 'is'
        value: 'FIFA World Cup'
      }
      rows: [
        VizFieldFull {
          label: 'World Cup'
          ref: r(messi_tournaments.world_cup)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Finish'
          ref: r(messi_tournaments.argentina_finish)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Award'
          ref: r(messi_tournaments.messi_individual_awards)
          format {
            type: 'text'
          }
        }
      ]
      values: [
        VizFieldFull {
          label: 'Matches'
          ref: r(messi_argentina.messi_caps)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Goals'
          ref: r(messi_argentina.messi_total_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Penalties'
          ref: r(messi_argentina.messi_penalty_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
  <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
  .mx * { box-sizing: border-box; }
  .mx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; height: 100%; }
  .mx-kpi { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); display: flex; flex-direction: column; }
  .mx-kpi .l { font: 500 13px/1.2 Rubik, sans-serif; color: #5d7694; }
  .mx-kpi .v { font: 900 52px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; margin: 6px 0 4px; }
  .mx-kpi .n { font: 400 12px/1.35 Rubik, sans-serif; color: #5d7694; margin-top: auto; }
  .mx-kpi.gold { background: #fff2cc; border-color: #e9b42a; }
  .mx-kpi.gold .l, .mx-kpi.gold .v, .mx-kpi.gold .n { color: #3a2600; }
  .mx-split { display: flex; height: 28px; border-radius: 999px; overflow: hidden; margin: 10px 0 8px; }
  .mx-split span { display: flex; align-items: center; justify-content: center; font: 600 12px/1 'DM Mono', monospace; color: #fff; min-width: 28px; }
  .mx-split .w { background: #2a78d6; } .mx-split .d { background: #b7c3d1; color: #0b2545; } .mx-split .l { background: #eb6834; }
  .mx-legend { display: flex; flex-wrap: wrap; gap: 14px; font: 400 12px/1 Rubik, sans-serif; color: #5d7694; }
  .mx-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .mx-card { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 16px 18px; height: 100%; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); overflow: auto; }
  .mx-card h3 { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 0 0 4px; color: #0b2545; }
  .mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
  .mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
  .mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
  {% map(rows) %}<div class="mx mx-kpis">
  <div class="mx-kpi"><span class="l">Matches</span><span class="v">{{ values.`Matches`.formatted }}</span><span class="n">{{ `World Cup`.formatted }}</span></div>
  <div class="mx-kpi"><span class="l">Goals</span><span class="v">{{ values.`Goals`.formatted }}</span><span class="n">Argentina finish: {{ `Finish`.formatted }}</span></div>
  <div class="mx-kpi"><span class="l">Penalties</span><span class="v">{{ values.`Penalties`.formatted }}</span><span class="n">Of his goals at this World Cup</span></div>
  <div class="mx-kpi gold"><span class="l">Award</span><span class="v" style="font-size:30px;line-height:1.05">{{ `Award`.formatted }}</span><span class="n">Individual honours at the tournament</span></div>
  </div>{% end %}
  ;;
      settings {
        pagination_size: 1
        row_limit: 1
      }
    }
  }
  block v2_road: VizBlock {
    label: 'The road through the tournament'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      rows: [
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'dd LLL yyyy'
          }
          uname: 'road_date'
        },
        VizFieldFull {
          label: 'Stage'
          ref: r(messi_matches.stage)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'City'
          ref: r(messi_matches.city)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Result'
          ref: r(messi_matches.result_incl_shootout)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Messi goals'
          ref: r(messi_matches.messi_goals)
          format {
            type: 'number'
            pattern: '0'
          }
        }
      ]
      content: @md
  <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
  .mx * { box-sizing: border-box; }
  .mx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; height: 100%; }
  .mx-kpi { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); display: flex; flex-direction: column; }
  .mx-kpi .l { font: 500 13px/1.2 Rubik, sans-serif; color: #5d7694; }
  .mx-kpi .v { font: 900 52px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; margin: 6px 0 4px; }
  .mx-kpi .n { font: 400 12px/1.35 Rubik, sans-serif; color: #5d7694; margin-top: auto; }
  .mx-kpi.gold { background: #fff2cc; border-color: #e9b42a; }
  .mx-kpi.gold .l, .mx-kpi.gold .v, .mx-kpi.gold .n { color: #3a2600; }
  .mx-split { display: flex; height: 28px; border-radius: 999px; overflow: hidden; margin: 10px 0 8px; }
  .mx-split span { display: flex; align-items: center; justify-content: center; font: 600 12px/1 'DM Mono', monospace; color: #fff; min-width: 28px; }
  .mx-split .w { background: #2a78d6; } .mx-split .d { background: #b7c3d1; color: #0b2545; } .mx-split .l { background: #eb6834; }
  .mx-legend { display: flex; flex-wrap: wrap; gap: 14px; font: 400 12px/1 Rubik, sans-serif; color: #5d7694; }
  .mx-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .mx-card { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 16px 18px; height: 100%; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); overflow: auto; }
  .mx-card h3 { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 0 0 4px; color: #0b2545; }
  .mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
  .mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
  .mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
  <style>
  .mx-road { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .mx-step { background: #fff; border: 1px solid #d3e3f3; border-top: 5px solid #b7c3d1; border-radius: 12px; padding: 12px; }
  .mx-step.Win { border-top-color: #2a78d6; } .mx-step.Loss { border-top-color: #eb6834; }
  .mx-step b { display: block; font: 800 20px/1.05 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 6px 0 4px; }
  .mx-step .score { font: 900 30px/1 'Big Shoulders Display', Impact, sans-serif; }
  .mx-step .goals { font: 500 12px/1.3 Rubik, sans-serif; color: #3a2600; background: #fff2cc; border-radius: 6px; padding: 3px 6px; display: inline-block; margin-top: 6px; }
  </style>
  <div class="mx mx-card"><h3>The road through the tournament</h3><p class="sub">One card per match, coloured by the result after penalties.</p><div class="mx-road">
  {% map(rows) %}<div class="mx-step {{ `Result`.raw }}"><span class="mx-mono">{{ `Stage`.formatted }} · {{ `Date`.formatted }}</span><b>vs {{ `Opponent`.formatted }}</b><span class="score">{{ `Score`.formatted }}</span> <span class="mx-pill {{ `Result`.raw }}">{{ `Result`.formatted }}</span><br><span class="goals">Messi ⚽ {{ `Messi goals`.formatted }}</span><div class="mx-mono" style="margin-top:6px">{{ `City`.formatted }}</div></div>{% end %}
  </div></div>
  ;;
      settings {
        sorts: [
          SortSetting {
            key: 'road_date'
            direction: 'asc'
          }
        ]
        pagination_size: 10
        row_limit: 10
      }
    }
  }
  block v2_summers: VizBlock {
    label: 'Six summers side by side'
    description: 'Use "Compare by" to switch the metric. Not affected by the World Cup picker.'
    viz: ColumnChart {
      dataset: messi_argentina
      filter {
        field: r(messi_tournaments.tournament_name)
        operator: 'is'
        value: 'FIFA World Cup'
      }
      x_axis: VizFieldFull {
        label: 'World Cup'
        ref: r(messi_tournaments.world_cup)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Selected metric'
            ref: r(messi_argentina.messi_selected_metric)
            format {
              type: 'number'
              pattern: '#,##0.##'
            }
          }
          settings {
            color: '#0b2545'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block f3_comp: FilterBlock {
    label: 'Competition'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_matches.competition_type)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block f3_type: FilterBlock {
    label: 'Goal type'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_goals.goal_type)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block f3_opp: FilterBlock {
    label: 'Opponent'
    type: 'field'
    source: FieldFilterSource {
      dataset: messi_argentina
      field: r(messi_matches.opponent)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
  }
  block k3_kpis: VizBlock {
    label: 'Goal KPIs'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      rows: [

      ]
      values: [
        VizFieldFull {
          label: 'Goals'
          ref: r(messi_argentina.messi_total_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Penalties'
          ref: r(messi_argentina.messi_penalty_goals)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Hat-tricks or better'
          ref: r(messi_argentina.messi_hat_tricks)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Matches scored in'
          ref: r(messi_argentina.messi_matches_scored_in)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      content: @md
  <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
  .mx * { box-sizing: border-box; }
  .mx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; height: 100%; }
  .mx-kpi { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 14px 16px; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); display: flex; flex-direction: column; }
  .mx-kpi .l { font: 500 13px/1.2 Rubik, sans-serif; color: #5d7694; }
  .mx-kpi .v { font: 900 52px/1 'Big Shoulders Display', Impact, sans-serif; color: #0b2545; margin: 6px 0 4px; }
  .mx-kpi .n { font: 400 12px/1.35 Rubik, sans-serif; color: #5d7694; margin-top: auto; }
  .mx-kpi.gold { background: #fff2cc; border-color: #e9b42a; }
  .mx-kpi.gold .l, .mx-kpi.gold .v, .mx-kpi.gold .n { color: #3a2600; }
  .mx-split { display: flex; height: 28px; border-radius: 999px; overflow: hidden; margin: 10px 0 8px; }
  .mx-split span { display: flex; align-items: center; justify-content: center; font: 600 12px/1 'DM Mono', monospace; color: #fff; min-width: 28px; }
  .mx-split .w { background: #2a78d6; } .mx-split .d { background: #b7c3d1; color: #0b2545; } .mx-split .l { background: #eb6834; }
  .mx-legend { display: flex; flex-wrap: wrap; gap: 14px; font: 400 12px/1 Rubik, sans-serif; color: #5d7694; }
  .mx-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .mx-card { background: #fff; border: 1px solid #d3e3f3; border-radius: 14px; padding: 16px 18px; height: 100%; box-shadow: 0 1px 2px rgba(11,37,69,.06), 0 8px 24px -12px rgba(11,37,69,.18); overflow: auto; }
  .mx-card h3 { font: 800 22px/1 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; margin: 0 0 4px; color: #0b2545; }
  .mx-card .sub { font: 400 13px/1.4 Rubik, sans-serif; color: #5d7694; margin: 0 0 12px; }
  .mx-pill { display: inline-block; font: 600 11px/1 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .mx-pill.Win { background: #2a78d6; color: #fff; } .mx-pill.Draw { background: #b7c3d1; color: #0b2545; } .mx-pill.Loss { background: #eb6834; color: #fff; }
  .mx-mono { font: 500 11px/1.3 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; color: #5d7694; }</style>
  {% map(rows) %}<div class="mx mx-kpis"><div class="mx-kpi"><span class="l">Goals</span><span class="v">{{ values.`Goals`.formatted }}</span><span class="n">In the selection</span></div><div class="mx-kpi"><span class="l">Penalties</span><span class="v">{{ values.`Penalties`.formatted }}</span><span class="n">From the spot, in play</span></div><div class="mx-kpi"><span class="l">Hat-tricks or better</span><span class="v">{{ values.`Hat-tricks or better`.formatted }}</span><span class="n">Three or more in a match</span></div><div class="mx-kpi"><span class="l">Matches scored in</span><span class="v">{{ values.`Matches scored in`.formatted }}</span><span class="n">Caps with at least one goal</span></div></div>{% end %}
  ;;
      settings {
        pagination_size: 1
        row_limit: 1
      }
    }
  }
  block v3_heat: VizBlock {
    label: 'Twenty-one years of goals'
    description: 'Annual goals, stacked by competition. Hover a year to see the exact breakdown.'
    viz: CombinationChart {
      dataset: messi_argentina
      x_axis: VizFieldFull {
        ref: r(messi_matches.year)
        label: 'Year'
        format {
          type: 'number'
          pattern: '0'
        }
      }
      legend: VizFieldFull {
        ref: r(messi_matches.competition_type)
        label: 'Competition'
      }
      y_axis {
        label: 'Goals'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(messi_argentina.messi_total_goals)
            label: 'Goals'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        settings {
          stack_series_by: 'value'
        }
      }
      conditions: [
        "messi_matches.year > 2004",
        "messi_matches.year < 2027",
      ]
      settings {
        legend_label: 'bottom'
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v3_victims: VizBlock {
    label: 'His favourite victims'
    description: 'Top 15 opponents by Messi goals. Click a bar to filter the chapter.'
    viz: BarChart {
      dataset: messi_argentina
      x_axis: VizFieldFull {
        label: 'Opponent'
        ref: r(messi_matches.opponent)
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Messi goals'
            ref: r(messi_argentina.messi_total_goals)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        row_limit: 15
        legend_label: 'hidden'
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
      }
    }
  }
  block v3_climb: VizBlock {
    label: 'The climb to 125'
    description: 'Career goal number by date. Goal 55 (21 Jun 2016) passed Batistuta; goal 100 came against Curaçao in 2023.'
    viz: LineChart {
      dataset: messi_argentina
      calculation goal_no {
        label: 'Career goal no.'
        formula: @aql max(messi_goals.career_goal_no);;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Date'
        ref: r(messi_goals.match_date)
        transformation: 'datetrunc day'
        format {
          type: 'date'
          pattern: 'LLL dd yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Career goal no.'
            ref: 'goal_no'
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#2a78d6'
          }
        }
      }
      settings {
        legend_label: 'hidden'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }
  block v3_hat: VizBlock {
    label: 'Eleven hat-tricks'
    theme: BlockTheme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
        border_radius: 0
        border_style: 'none'
      }
      padding: 0
      shadow: 'none'
    }
    settings {
      hide_label: true
      hide_controls: true
    }
    viz: MarkdownViz {
      dataset: messi_argentina
      filter {
        field: r(messi_matches.is_hat_trick)
        operator: 'is'
        value: true
      }
      rows: [
        VizFieldFull {
          label: 'Date'
          ref: r(messi_matches.match_date)
          format {
            type: 'date'
            pattern: 'dd LLL yyyy'
          }
          uname: 'hat_date'
        },
        VizFieldFull {
          label: 'Opponent'
          ref: r(messi_matches.opponent)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Competition'
          ref: r(messi_matches.competition_type)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Score'
          ref: r(messi_matches.scoreline)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Goals'
          ref: r(messi_matches.messi_goals)
          format {
            type: 'number'
            pattern: '0'
          }
        }
      ]
      content: @md
  <style>.mx { font-family: Rubik, system-ui, sans-serif; color: #0b2545; box-sizing: border-box; height: 100%; }
