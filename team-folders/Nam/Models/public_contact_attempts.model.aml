Model public_contact_attempts {
  type: 'table'
  label: 'Contact Attempts'
  description: ''
  data_source_name: 'demo_scsi_nam'
  dimension account_id {
    label: 'Account Id'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.account_id }};;
  }
  dimension attempt_date {
    label: 'Attempt Date'
    type: 'date'
    hidden: false
    definition: @sql {{ #SOURCE.attempt_date }};;
  }
  dimension channel {
    label: 'Channel'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.channel }};;
  }
  dimension outcome {
    label: 'Outcome'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.outcome }};;
  }
  dimension attempt_id {
    label: 'Attempt Id'
    type: 'number'
    hidden: false
    definition: @sql {{ #SOURCE.attempt_id }};;
    primary_key: true
  }

  owner: 'nam.tran@holistics.io'
  table_name: '"public"."contact_attempts"'
}
