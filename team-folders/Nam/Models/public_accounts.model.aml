Model public_accounts {
  type: 'table'
  label: 'Accounts'
  description: ''
  data_source_name: 'demo_scsi_nam'
  dimension client_id {
    label: 'Client Id'
    type: 'number'
    description: "The **client_id** field contains the unique identifier assigned to each client associated with the account record.  \nThis identifier distinguishes clients within the dataset and enables tracking and analysis of accounts by client.  \nExamples of `client_id` values include `1`, `2`, `3`, `4`, `5`, `6`, `7`, `8`, `9`, and `10`."
    hidden: false
    definition: @sql {{ #SOURCE.client_id }};;
    primary_key: false
  }
  dimension collector_id {
    label: 'Collector Id'
    type: 'number'
    description: "The **Collector Id** identifies the specific collector responsible for managing or handling the account.  \nThis field contains numeric values representing different collectors assigned to accounts.  \nExamples include `3`, `6`, `5`, `8`, and `15`."
    hidden: false
    definition: @sql {{ #SOURCE.collector_id }};;
    primary_key: false
  }
  dimension debtor_state {
    label: 'Debtor State'
    type: 'text'
    description: "The **debtor_state** field contains the U.S. state abbreviation where the debtor is located.  \nIt identifies the geographic location of the debtor associated with the account.  \nExamples include `FL` for Florida, `TX` for Texas, `CA` for California, `NY` for New York, and `NC` for North Carolina."
    hidden: false
    definition: @sql {{ #SOURCE.debtor_state }};;
    primary_key: false
  }
  dimension original_balance {
    label: 'Original Balance'
    type: 'number'
    description: "The **original_balance** field contains the initial amount owed on an account before any payments or adjustments.  \nIt represents the starting debt value assigned to the account at placement or origination.  \nExamples include values such as `100.25`, `1010.50`, and `1320.10`."
    hidden: false
    definition: @sql {{ #SOURCE.original_balance }};;
    primary_key: false
  }
  dimension placement_date {
    label: 'Placement Date'
    type: 'date'
    description: "The **Placement Date** records the date when the account was assigned or placed for collection or management.  \nIt represents the starting point of the account\'s lifecycle in the collections process.  \nExamples of values include `2026-04-03`, `2025-08-31`, and `2025-12-12`."
    hidden: false
    definition: @sql {{ #SOURCE.placement_date }};;
    primary_key: false
  }
  dimension account_status {
    label: 'Account Status'
    type: 'text'
    description: "**Account Status** indicates the current condition or stage of the account within the collections process.  \nIt reflects whether the account is actively being worked on, has been paid in full, settled, placed under legal action, is new, or closed without recovery.  \nExamples of values include `Closed - No Recovery`, `Paid in Full`, `Working`, `Payment Plan`, `Legal`, `New`, and `Settled`."
    hidden: false
    definition: @sql {{ #SOURCE.account_status }};;
    primary_key: false
  }
  dimension aging_bucket {
    label: 'Aging Bucket'
    type: 'text'
    description: "The **aging_bucket** field categorizes accounts based on the length of time their balances have been outstanding.  \nIt segments accounts into time intervals representing how long the debt has aged since placement or last activity.  \nCommon values include `0-30`, `31-60`, `61-90`, `91-180`, and `180+` days.  \nFor example, an account with an aging bucket of `0-30` indicates the balance is between 0 and 30 days overdue, while `180+` indicates balances overdue for more than 180 days.  \nThis classification helps prioritize collection efforts and assess the risk level of outstanding accounts."
    hidden: false
    definition: @sql {{ #SOURCE.aging_bucket }};;
    primary_key: false
  }
  dimension account_id {
    label: 'Account Id'
    type: 'number'
    description: "The **Account Id** uniquely identifies each account record in the dataset.  \nIt serves as the primary key for referencing individual accounts in the system.  \nExamples include `1`, `10`, `100`, `101`, and `102`."
    hidden: false
    definition: @sql {{ #SOURCE.account_id }};;
    primary_key: true
  }

  owner: 'nam.tran@holistics.io'
  table_name: '"public"."accounts"'
}