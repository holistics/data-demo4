const scsi_client_portal_theme_tokens = {
  primary: "oklch(0.4698 0.1471 253.61)",
  secondary: "oklch(0.7446 0.1437 227.01)",
  mode: "light",
  background: "oklch(0.9735 0.0076 241.66)",
  canvas_bg: "oklch(0.9834 0.0042 236.50)",
  block_bg: "oklch(1 0 0)",
  text_primary: "oklch(0.3226 0.0660 246.25)",
  text_muted: "oklch(0.5345 0.0448 246.41)",
  text_subtle: "oklch(0.6031 0.0368 244.30)",
  border: "oklch(0.9190 0.0161 239.12)",
  focus_ring: "oklch(0.4698 0.1471 253.61)",
  semantic_success: "oklch(0.4462 0.0779 171.76)",
  semantic_danger: "oklch(0.4701 0.1425 24.45)",
  font_body: "Roboto, Arial, sans-serif",
  font_display: "Roboto, Arial, sans-serif",
  corner_style: "sharp",
  density: "comfortable",
  elevation: "hairline"
}

ColorPalette scsi_client_portal_palette {
  title: "State Collection Service · Client Portal"
  categorical {
    colors: [
      "oklch(0.60 0.17 254)",
      "oklch(0.68 0.16 299)",
      "oklch(0.63 0.18 344)",
      "oklch(0.57 0.17 29)",
      "oklch(0.65 0.15 74)",
      "oklch(0.62 0.17 119)",
      "oklch(0.61 0.14 164)",
      "oklch(0.63 0.15 209)"
    ]
  }
}

PageTheme scsi_client_portal_theme {
  title: "State Collection Service · Client Portal"
  color {
    data: scsi_client_portal_palette
  }
  background {
    bg_color: scsi_client_portal_theme_tokens("background")
  }
  canvas {
    background {
      bg_color: scsi_client_portal_theme_tokens("canvas_bg")
    }
    border {
      border_width: 0
      border_radius: 6
      border_color: scsi_client_portal_theme_tokens("border")
      border_style: "none"
    }
    shadow: "none"
    opacity: 1
  }
  block {
    background {
      bg_color: scsi_client_portal_theme_tokens("block_bg")
    }
    border {
      border_width: 1
      border_style: "solid"
      border_radius: 6
      border_color: scsi_client_portal_theme_tokens("border")
    }
    shadow: "none"
    padding: 16
    opacity: 1
    label {
      font_family: scsi_client_portal_theme_tokens("font_display")
      font_size: 14
      font_color: scsi_client_portal_theme_tokens("text_primary")
      font_weight: "semibold"
      font_style: "normal"
      letter_spacing: "0"
    }
    text {
      font_family: scsi_client_portal_theme_tokens("font_body")
      font_size: 13
      font_color: scsi_client_portal_theme_tokens("text_muted")
      font_weight: "normal"
      font_style: "normal"
    }
  }
  viz {
    table {
      general {
        bg_color: scsi_client_portal_theme_tokens("block_bg")
        font_color: scsi_client_portal_theme_tokens("text_muted")
        font_family: scsi_client_portal_theme_tokens("font_body")
        font_size: 13
        border_color: scsi_client_portal_theme_tokens("border")
        grid_color: scsi_client_portal_theme_tokens("border")
        border_width: 1
        hover_color: "oklch(0.9541 0.0246 222.58)"
        banding_color: "oklch(0.9834 0.0042 236.50)"
        cell_padding: DetailedSpacing {
          top: 10
          right: 16
          bottom: 10
          left: 16
        }
        borders {
          outer: true
          vertical: false
          horizontal: true
          header: true
          row_header: false
        }
      }
      header {
        bg_color: scsi_client_portal_theme_tokens("background")
        font_color: scsi_client_portal_theme_tokens("text_primary")
        font_size: 13
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "oklch(0.9834 0.0042 236.50)"
        font_color: scsi_client_portal_theme_tokens("text_muted")
        font_size: 13
        font_weight: "medium"
      }
      sub_title {
        font_color: scsi_client_portal_theme_tokens("text_subtle")
        font_size: 12
        font_weight: "medium"
      }
      sparkline {
        line {
          color: scsi_client_portal_theme_tokens("primary")
        }
        column {
          color: scsi_client_portal_theme_tokens("primary")
        }
      }
    }
    metric_kpi {
      alignment: "left"
      label {
        font_family: scsi_client_portal_theme_tokens("font_body")
        font_size: 18
        font_color: scsi_client_portal_theme_tokens("text_muted")
      }
      value {
        font_family: scsi_client_portal_theme_tokens("font_display")
        font_size: 36
        font_color: scsi_client_portal_theme_tokens("text_primary")
      }
      progress {
        indicator {
          bg_color: scsi_client_portal_theme_tokens("primary")
        }
        track {
          bg_color: scsi_client_portal_theme_tokens("border")
        }
        text {
          font_color: scsi_client_portal_theme_tokens("text_muted")
        }
      }
      trend {
        positive {
          text {
            font_color: scsi_client_portal_theme_tokens("semantic_success")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.9477 0.0225 175.95)"
          }
        }
        negative {
          text {
            font_color: scsi_client_portal_theme_tokens("semantic_danger")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.9478 0.0230 17.56)"
          }
        }
        neutral {
          text {
            font_color: scsi_client_portal_theme_tokens("text_muted")
            font_weight: "normal"
          }
          background {
            bg_color: "oklch(0.9735 0.0076 241.66)"
          }
        }
      }
    }
  }
  custom_css: @css
    @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap");
    .dac-text-block {
      font-family: Roboto, Arial, sans-serif;
      font-size: 14px;
      color: oklch(0.5345 0.0448 246.41);
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
      font-family: Roboto, Arial, sans-serif;
      color: oklch(0.3226 0.0660 246.25);
      line-height: 1.3;
      margin-top: 0;
      margin-bottom: 0.5em;
      font-weight: 600;
    }
  ;;
}
