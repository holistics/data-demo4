// Laasie page theme — deliberately a light, high-contrast, typographic look.
//
// Laasie's stated frustration with their current stack is "outdated visualizations", and this
// theme is the direct answer: generous white canvas, one confident violet accent instead of a
// rainbow default palette, a modern geometric typeface, soft borders rather than heavy grid
// lines, and KPI trend chips that read green/red at a glance for period-over-period movement.
//
// It is also built to survive embedding. External hotel users see this inside Laasie's own web
// app, so the palette is neutral enough to sit next to a client's chrome without clashing, and
// the light background matches the typical SaaS surface it will be iframed into.
PageTheme laasie_theme {
  title: "Laasie"
  background {
    bg_color: "#f4f2fa"
  }
  canvas {
    background {
      bg_color: "#f4f2fa"
    }
    border {
      border_radius: 12
      border_color: "#e7e3f3"
    }
    shadow: "none"
  }
  block {
    background {
      bg_color: "#ffffff"
    }
    label {
      font_family: "Plus Jakarta Sans, sans-serif"
      font_size: 11
      font_color: "#4c4368"
      font_weight: "semibold"
      letter_spacing: 1.2
      text_transform: "uppercase"
    }
    text {
      font_family: "Plus Jakarta Sans, sans-serif"
      font_color: "#5b5478"
    }
    border {
      border_radius: 12
      border_width: 1
      border_color: "#e7e3f3"
      border_style: "solid"
    }
    padding: 20
    shadow: "sm"
  }
  viz {
    table {
      general {
        bg_color: "#ffffff"
        hover_color: "#f4f2fa"
        banding_color: "#faf9fd"
        font_color: "#1e1b33"
        font_family: "Plus Jakarta Sans, sans-serif"
        border_color: "#e7e3f3"
        grid_color: "#eeebf7"
      }
      header {
        bg_color: "#ffffff"
        font_color: "#4c4368"
        font_size: 11
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "#faf9fd"
        font_color: "#4c4368"
        font_size: 11
      }
      sub_title {
        font_color: "#7a7396"
        font_size: 11
      }
    }
    metric_kpi {
      label {
        font_family: "Plus Jakarta Sans, sans-serif"
        font_size: 13
        font_color: "#7a7396"
        font_weight: "medium"
        letter_spacing: 0
      }
      value {
        font_family: "Plus Jakarta Sans, sans-serif"
        font_size: 34
        font_color: "#1e1b33"
        letter_spacing: -0.5
      }
      progress {
        text {
          font_family: "Plus Jakarta Sans, sans-serif"
          font_color: "#7a7396"
        }
        indicator {
          bg_color: "#7c3aed"
        }
        track {
          bg_color: "#eeebf7"
        }
      }
      trend {
        positive {
          text {
            font_color: "#047857"
          }
          background {
            bg_color: "#d1fae5"
          }
        }
        negative {
          text {
            font_color: "#be123c"
          }
          background {
            bg_color: "#ffe4e6"
          }
        }
        neutral {
          text {
            font_color: "#4c4368"
          }
          background {
            bg_color: "#eeebf7"
          }
        }
      }
    }
  }
  custom_css: @css
    @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");
  ;;
}
