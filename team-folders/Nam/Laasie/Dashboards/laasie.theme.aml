const laasie_theme_tokens = {
  primary: "oklch(0.3880 0.1950 263.75)",
  secondary: "oklch(0.8475 0.1456 79.52)",
  mode: "light",
  background: "oklch(0.9584 0.0131 71.33)",
  canvas_bg: "oklch(0.9858 0.0045 78.30)",
  block_bg: "oklch(1 0 0)",
  text_primary: "oklch(0.2010 0.1060 263.41)",
  text_muted: "oklch(0.3901 0.0303 284.91)",
  text_subtle: "oklch(0.4964 0.1020 272.71)",
  border: "oklch(0.9405 0.0161 286.09)",
  focus_ring: "oklch(0.3880 0.1950 263.75)",
  semantic_success: "oklch(0.4719 0.0940 150.91)",
  semantic_warning: "oklch(0.4972 0.1027 80.99)",
  semantic_danger: "oklch(0.5036 0.1792 21.04)",
  font_body: "Inter, Arial, sans-serif",
  font_display: "Inter, Arial, sans-serif",
  corner_style: "soft",
  density: "comfortable",
  elevation: "shadow"
}

ColorPalette laasie_palette {
  title: "Laasie · Lassie Categorical"
  categorical {
    colors: [
      "oklch(0.61 0.21 263)",
      "oklch(0.63 0.18 308)",
      "oklch(0.63 0.19 353)",
      "oklch(0.64 0.17 38)",
      "oklch(0.60 0.14 83)",
      "oklch(0.62 0.18 128)",
      "oklch(0.60 0.12 173)",
      "oklch(0.61 0.12 218)"
    ]
  }
}

PageTheme laasie_theme {
  title: "Laasie · Lassie"
  color {
    data: laasie_palette
  }
  background {
    bg_color: laasie_theme_tokens("background")
  }
  canvas {
    background {
      bg_color: laasie_theme_tokens("canvas_bg")
    }
    border {
      border_width: 0
      border_radius: 20
      border_color: laasie_theme_tokens("border")
      border_style: "none"
    }
    shadow: "none"
    opacity: 1
  }
  block {
    background {
      bg_color: laasie_theme_tokens("block_bg")
    }
    border {
      border_width: 0
      border_style: "none"
      border_radius: 20
      border_color: laasie_theme_tokens("border")
    }
    shadow: "sm"
    padding: 16
    opacity: 1
    label {
      font_family: laasie_theme_tokens("font_display")
      font_size: 14
      font_color: laasie_theme_tokens("text_primary")
      font_weight: "semibold"
      font_style: "normal"
      letter_spacing: "0"
    }
    text {
      font_family: laasie_theme_tokens("font_body")
      font_size: 13
      font_color: laasie_theme_tokens("text_muted")
      font_weight: "normal"
      font_style: "normal"
    }
  }
  viz {
    table {
      general {
        bg_color: laasie_theme_tokens("block_bg")
        font_color: laasie_theme_tokens("text_muted")
        font_family: laasie_theme_tokens("font_body")
        font_size: 13
        border_color: laasie_theme_tokens("border")
        grid_color: laasie_theme_tokens("border")
        border_width: 1
        hover_color: "oklch(0.9239 0.0387 247.05)"
        banding_color: "oklch(0.9858 0.0045 78.30)"
        cell_padding: DetailedSpacing {
          top: 10
          right: 16
          bottom: 10
          left: 16
        }
        borders {
          outer: true
          vertical: false
          horizontal: true
          header: true
          row_header: false
        }
      }
      header {
        bg_color: laasie_theme_tokens("background")
        font_color: laasie_theme_tokens("text_primary")
        font_size: 13
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "oklch(0.9858 0.0045 78.30)"
        font_color: laasie_theme_tokens("text_muted")
        font_size: 13
        font_weight: "medium"
      }
      sub_title {
        font_color: laasie_theme_tokens("text_subtle")
        font_size: 12
        font_weight: "medium"
      }
      sparkline {
        line {
          color: laasie_theme_tokens("primary")
        }
        column {
          color: laasie_theme_tokens("primary")
        }
      }
    }
    metric_kpi {
      alignment: "left"
      label {
        font_family: laasie_theme_tokens("font_body")
        font_size: 20
        font_color: laasie_theme_tokens("text_muted")
      }
      value {
        font_family: laasie_theme_tokens("font_display")
        font_size: 36
        font_color: laasie_theme_tokens("text_primary")
      }
      progress {
        indicator {
          bg_color: laasie_theme_tokens("primary")
        }
        track {
          bg_color: laasie_theme_tokens("border")
        }
        text {
          font_color: laasie_theme_tokens("text_muted")
        }
      }
      trend {
        positive {
          text {
            font_color: laasie_theme_tokens("semantic_success")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.9377 0.0594 115.75)"
          }
        }
        negative {
          text {
            font_color: laasie_theme_tokens("semantic_danger")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.9479 0.0264 11.86)"
          }
        }
        neutral {
          text {
            font_color: laasie_theme_tokens("text_muted")
            font_weight: "normal"
          }
          background {
            bg_color: "oklch(0.9626 0.0066 286.27)"
          }
        }
      }
    }
  }
  custom_css: @css
    .dac-text-block {
      font-family: Inter, Arial, sans-serif;
      font-size: 14px;
      color: oklch(0.3901 0.0303 284.91);
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
      font-family: Inter, Arial, sans-serif;
      color: oklch(0.2010 0.1060 263.41);
      line-height: 1.3;
      margin-top: 0;
      margin-bottom: 0.5em;
      font-weight: 600;
    }
  ;;
}
