Model ecommerce_users_copy {
  type: 'table'
  label: "Users"
  description: "Contains information about users in the ecommerce platform "
  data_source_name: "stg_data_source"

  dimension id {
    label: 'Id'
    type: 'number'
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.id }};;
    primary_key: true
  }

  dimension sign_up_date {
    label: "Sign Up Date"
    type: "date"
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.sign_up_date }};;
    primary_key: false
  }

  dimension email_user {
    label: 'Email User'
    type: 'text'
    description: ""
    hidden: false
    definition: @aql concat(
      'mailto:', ecommerce_users.email
    );;
    primary_key: false
  }

  dimension phone {
    label: 'Call User'
    type: 'text'
    description: ""
    hidden: false
    definition: @aql concat(
      'tel:', '5126329032'
    );;
    primary_key: false
  }

  dimension visit_time {
    label: 'Visit Time'
    type: 'text'
    description: ""
    hidden: false
    definition: @sql to_char({{ sign_up_date }}, 'Month') ;;
    primary_key: false
  }

  dimension sign_up_at {
    label: 'Sign Up At'
    type: 'datetime'
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.sign_up_at }};;
    primary_key: false
  }
  dimension first_name {
    label: "First Name"
    type: "text"
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.first_name }};;
    primary_key: false
  }
  dimension last_name {
    label: 'Last Name'
    type: 'text'
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.last_name }};;
    primary_key: false
  }
  dimension email {
    label: "Email"
    type: "text"
    description: ""
    hidden: true
    definition: @sql {{ #SOURCE.email }};;
    primary_key: false
  }


  dimension email_pii {
    label: 'Email'
    type: 'text'
    description: ""
    hidden: false
    definition: @sql ${pii};;
    primary_key: false
  }

  dimension birth_date {
    label: "Birth Date"
    type: "date"
    description: ""
    hidden: true
    definition: @sql {{ #SOURCE.birth_date }};;
    primary_key: false
  }

  dimension gender {
    label: 'Gender'
    type: 'text'
    description: ''
    hidden: false
    definition: @sql            case
  when {{#SOURCE.gender}} = 'f' then 'Female'
  when {{#SOURCE.gender}} = 'm' then 'Male' 
  else null
end;;
    primary_key: false
  }
  dimension city_id {
    label: 'City Id'
    type: 'number'
    description: ""
    hidden: true
    definition: @sql {{ #SOURCE.city_id }};;
    primary_key: false
  }

  dimension full_name {
    label: 'Full Name'
    type: 'text'
    description: ""
    hidden: false
    definition: @sql {{ #SOURCE.full_name }};;
    primary_key: false
  }


  // Custom fields
  dimension age {
    label: 'Age'
    type: 'number'
    description: ""
    hidden: false
    definition: @sql date_part('year', current_date) - date_part('year', {{ birth_date }});;
    primary_key: false
  }
  dimension age_group {
    label: "Age Demographic"
    type: "text"
    description: ""
    hidden: false
    definition: @sql case
  when {{ age }} < 20 then '1. Under 20'
  when {{ age }} >= 20 and {{ age }} < 30 then '2. From 20 to 29'
  when {{ age }} >= 30 then '3. 30 and above'
end;;
    primary_key: false
  }

  dimension date_datum {
    label: "Date Datum"
    type: "date"
    description: ""
    hidden: false
    definition: @sql   case
  when {{ id }} is not null then to_date('2022-11-25', 'YYYY-MM-DD')
  else to_date('2022-11-25', 'YYYY-MM-DD')
end;;
    primary_key: false
    format: "LLL dd yyyy"
  }

  measure users_signed_up_count {
    label: 'Users Signed Up'
    type: 'number'
    description: ""
    hidden: false
    definition: @aql count(ecommerce_users.id);;
    aggregation_type: "custom"
  }
  measure total_users {
    label: "Total Users"
    type: "number"
    description: ""
    hidden: false
    definition: @aql count(ecommerce_users.id);;
    aggregation_type: "custom"
  }

  measure date_datum_2 {
    label: "Date Datum 2"
    type: "date"
    description: ""
    hidden: false
    definition: @aql @2022-11-25;;
    aggregation_type: "custom"
    format: "LLL dd yyyy"
  }
  owner: "vincent+demo4@holistics.io"
  table_name: '\"ecommerce\".\"users\"'
}