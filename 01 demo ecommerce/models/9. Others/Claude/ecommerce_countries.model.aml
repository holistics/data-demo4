@tag('Endorsed')
Model ecommerce_countries_copy {
  type: 'table'
  label: 'Countries'
  description: ''
  data_source_name: 'demodb'
  table_name: '"ecommerce"."countries"'

  dimension code {
    label: 'Country Code'
    type: 'text'
    description: "   "
    hidden: false
    definition: @sql {{ #SOURCE.code }};;
    primary_key: false
  }
  dimension name {
    label: 'Country Name'
    type: 'text'
  }
  dimension continent_name {
    label: 'Continent Name'
    type: 'text'
    description: "   "
    hidden: false
    definition: @sql {{ #SOURCE.continent_name }};;
    primary_key: false
  }

  dimension origin {
    label: "Origin"
    type: "text"
    description: ""
    hidden: false
    definition: @sql  case
  when {{ name }} = 'India' then 'Singapore'
  when {{ name }} = 'South Korea' then 'Germany'
  when {{ name }} = 'United States' then 'Australia'
  when {{ name }} = 'Australia' then 'Indonesia'
  when {{ name }} = 'France' then 'Indonesia'
  when {{ name }} = 'South Korea' then 'Germany'
  when {{ name }} = 'Indonesia' then 'South Korea'
  when {{ name }} = 'Singapore' then 'India'
  when {{ name }} = 'Germany' then 'China'
  when {{ name }} = 'United Kingdom' then 'Vietnam'
  when {{ name }} = 'Vietnam' then 'United Sates'
end;;
    primary_key: false
  }
}