  block t6_howto: TextBlock {
    content: @md
### How this version works

No mapping model: each row is an **AQL metric** in the `pl_statement_aql` dataset.

- **Sections** filter the ledger by account group, e.g. `total_net_amount_eur | where(account_group_level_1 == 'Revenue')`.
- **Subtotals** are arithmetic on sections: `pnl_gross_margin = pnl_revenue + pnl_cogs`, `pnl_ebitda = pnl_gross_margin + pnl_opex`, `pnl_net_profit = pnl_ebitda + pnl_da + pnl_financial`.
- **Account lines** (A1, B2, C3…) are one metric each, so a new account needs a new metric and row.

F (Financial Expenses) shows €0: this demo ledger has no financial accounts. Numbers reconcile to the pivot version on the previous tab.
;;
  }
  view: TabLayout {
    label: 'P&L Statement'
    tab pl_statement: CanvasLayout {
      label: 'P&L Statement (Pivot)'
      width: 1320
      height: 1620
      grid_size: 20
      auto_expand_vertically: true
      block t5_title {
        position: pos(20, 20, 1280, 64)
      }
      block t5_date_filter {
        position: pos(20, 100, 360, 40)
      }
      block t5_dept_filter {
        position: pos(400, 100, 360, 40)
      }
      block t5_kpi_revenue {
        position: pos(20, 170, 300, 160)
      }
      block t5_kpi_gm {
        position: pos(340, 170, 300, 160)
      }
      block t5_kpi_ebitda {
        position: pos(660, 170, 300, 160)
      }
      block t5_kpi_net {
        position: pos(980, 170, 300, 160)
      }
      block t5_margin_trend {
        position: pos(20, 1120, 780, 460)
      }
      block t5_howto {
        position: pos(860, 1140, 460, 460)
      }
      block t5_statement {
        position: pos(20, 360, 1260, 740)
      }
      mobile {
        mode: 'auto'
      }
    }
    tab pl_metric_sheet: CanvasLayout {
      label: 'P&L Statement (Metric Sheet)'
      width: 1320
      height: 1100
      grid_size: 20
      auto_expand_vertically: true
      block t6_title {
        position: pos(20, 20, 1280, 64)
      }
      block t6_date_filter {
        position: pos(20, 100, 360, 40)
      }
      block t6_dept_filter {
        position: pos(400, 100, 360, 40)
      }
      block t6_sheet {
        position: pos(20, 160, 860, 900)
      }
      block t6_howto {
        position: pos(880, 100, 400, 520)
      }
      mobile {
        mode: 'auto'
      }
    }
  }
  theme: ICEYE
  explicit_interactions: [
    FilterInteraction {
      from: 't5_date_filter'
      to: [
        't5_kpi_revenue',
        't5_kpi_gm',
        't5_kpi_ebitda',
        't5_kpi_net',
        't5_statement',
        't5_margin_trend'
      ]
      field: r(iceye_fact_pl_statements.resolved_posting_date)
    },
    FilterInteraction {
      from: 't5_dept_filter'
      to: [
        't5_kpi_revenue',
        't5_kpi_gm',
        't5_kpi_ebitda',
        't5_kpi_net',
        't5_statement',
        't5_margin_trend'
      ]
      field: r(iceye_dim_departments.department_name)
    },
    FilterInteraction {
      from: 't6_date_filter'
      to: [
        't6_sheet'
      ]
      field: r(iceye_fact_pl_statements.resolved_posting_date)
    },
    FilterInteraction {
      from: 't6_dept_filter'
      to: [
        't6_sheet'
      ]
      field: r(iceye_dim_departments.department_name)
    }
  ]
}