  block rep_ltv_right: VizBlock {
    label: 'LTV — semantic layer'
    viz: PivotTable {
      dataset: ecom_cohort_analysis
      rows: [
        VizFieldFull {
          label: 'Cohort Period'
          ref: r(ecom_cohort_analysis, ecommerce_users.cohort_period)
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
          uname: 'ltvr_row'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Period'
          ref: r(ecom_cohort_analysis, ecommerce_orders.period_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'ltvr_col'
        }
      ]
      values: [
        VizFieldFull {
          label: 'LTV'
          ref: r(ecom_cohort_analysis.cohort_ltv)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
          uname: 'ltvr_val'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'ltvr_val'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FFFFFF'
              }
              mid {
                value: 500
                color: '#CCEDE0'
              }
              max {
                value: 1000
                color: '#7AD1AE'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'ltvr_row'
            direction: 'asc'
          },
          SortSetting {
            key: 'ltvr_col'
            direction: 'asc'
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 13
      }
    }
  }

