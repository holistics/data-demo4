  block rep_cat_right: VizBlock {
    label: 'LTV by Category — filter applied during cohort profiling'
    viz: PivotTable {
      dataset: ecom_cohort_analysis
      rows: [
        VizFieldFull {
          label: 'Category at Acquisition'
          ref: r(ecom_cohort_first_order_categories.parent_category)
          uname: 'catr_row'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Month'
          ref: r(ecom_cohort_analysis, ecommerce_orders.month_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'catr_col'
        }
      ]
      values: [
        VizFieldFull {
          label: 'LTV'
          ref: r(ecom_cohort_analysis.cohort_ltv)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
          uname: 'catr_val'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'catr_val'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FFFFFF'
              }
              mid {
                value: 500
                color: '#CCEDE0'
              }
              max {
                value: 1000
                color: '#7AD1AE'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'catr_row'
            direction: 'asc'
          },
          SortSetting {
            key: 'catr_col'
            direction: 'asc'
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 13
      }
    }
  }

