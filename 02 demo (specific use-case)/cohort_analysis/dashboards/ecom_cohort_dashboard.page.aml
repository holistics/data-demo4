      }
      block rep_sum_right {
        position: pos(20, 460, 1340, 500)
      }
      block rep_sum_wrong {
        position: pos(20, 980, 1340, 500)
      }
      block txt_sum_why {
        position: pos(20, 1500, 1340, 280)
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  // Each filter drives BOTH reports. The semantic-layer report resolves it
  // through relationships; the SQL model resolves it against a column its
  // query happened to SELECT. Same choice, two architectures.
  explicit_interactions: [
    FilterInteraction {
      from: 'f_ret_month'
      to: [
        CustomMapping {
          block: 'rep_ret_right'
          field: r(ecom_cohort_analysis, ecommerce_users.cohort_month)
