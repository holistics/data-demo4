Dashboard ecom_cohort_dashboard {
  title: 'Ecommerce Cohort Analysis'
  description: 'Cohort LTV, retention and repeat purchase by acquisition month, profileable by any first-order attribute. Every cohort-profile filter opens empty, so the dashboard loads as the all-users cohort until someone chooses otherwise. The lifecycle window defaults to months 0-12, which bounds the pivot axis only and excludes no cohort.'
  owner: 'chukwudi@holistics.io'

  block header: TextBlock {
    content: @md # Ecommerce Cohort Analysis

LTV, retention and repeat purchase by the month a user first ordered. **Leave the profile filters empty for all users**, or narrow the cohort by what was in their first order — every metric still counts each user's full lifetime, across every category.;;
  }

  block f_cohort_month: FilterBlock {
    label: 'Cohort Month (acquisition)'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecom_cohort_analysis, ecommerce_users.cohort_month)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block f_lifecycle_window: FilterBlock {
    label: 'Lifecycle Window (Month Number)'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecom_cohort_analysis, ecommerce_orders.month_number)
    }
    default {
      operator: 'between'
      value: [
        0,
        12
      ]
    }
  }

  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecommerce_countries.name)
    }
  }

  block f_category_at_acquisition: FilterBlock {
    label: 'Categories at Acquisition'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecom_cohort_first_order_categories.parent_category)
    }
  }

  block f_products_at_acquisition: FilterBlock {
    label: 'Products at Acquisition'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecom_cohort_first_order_categories.product_name)
    }
  }

  block f_units_band: FilterBlock {
    label: 'Units Band at Acquisition'
    type: 'field'
    source: FieldFilterSource {
      dataset: ecom_cohort_analysis
      field: r(ecom_cohort_analysis, ecommerce_users.first_order_units_band)
    }
  }

  block pivots_context: TextBlock {
    content: @md **Reading these.** Rows are acquisition cohorts, columns are months since acquisition. `LTV`, `Cumulative Revenue` and `Orders Per User` are running totals, so they accumulate over the lifecycle months **in scope** — a *range* window (0-12) is correct, but narrowing to a *single* month leaves the running total one month to accumulate and reports that month alone. `Retention` and `Active Users` are not running totals, so a blank cell means no orders that month; read it as zero.;;
  }

  block pivot_ltv: VizBlock {
    label: 'LTV by Cohort'
    viz: PivotTable {
      dataset: ecom_cohort_analysis
      rows: [
        VizFieldFull {
          label: 'Cohort'
          ref: r(ecom_cohort_analysis, ecommerce_users.cohort_month)
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'ltv_cohort'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Month'
          ref: r(ecom_cohort_analysis, ecommerce_orders.month_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'ltv_month'
        }
      ]
      values: [
        VizFieldFull {
          label: 'LTV'
          ref: r(ecom_cohort_analysis.cohort_ltv)
          uname: 'ltv_val'
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'ltv_val'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FFFFFF'
              }
              mid {
                value: 500
                color: '#CCEDE0'
              }
              max {
                value: 1000
                color: '#7AD1AE'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'ltv_cohort'
            direction: 'asc'
          },
          SortSetting {
            key: 'ltv_month'
            direction: 'asc'
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 15
      }
    }
  }

