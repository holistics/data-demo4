        position: pos(940, 240, 420, 90)
      }
      block f_sum_units {
        position: pos(20, 350, 440, 90)
      }
      block f_sum_category {
        position: pos(480, 350, 440, 90)
      }
      block f_sum_product {
        position: pos(940, 350, 420, 90)
      }
      block rep_sum_right {
        position: pos(20, 460, 1340, 500)
      }
      block rep_sum_wrong {
        position: pos(20, 980, 1340, 500)
      }
      block txt_sum_why {
        position: pos(20, 1500, 1340, 280)
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  // Each Category / Product filter drives BOTH reports on its tab, but lands on a
  // different field in each: the acquisition bridge above (choosing who is in the
  // cohort) and the line-item path below (trimming the finished numbers).
  interactions: [
    FilterInteraction {
      from: 'f_ret_category'
      to: [
        CustomMapping {
          block: 'rep_ret_right'
          field: r(ecom_cohort_first_order_categories.parent_category)
        },
        CustomMapping {
          block: 'rep_ret_wrong'
          field: r(map_categories.parent_category)
        }
      ]
    },
    FilterInteraction {
      from: 'f_ret_product'
      to: [
        CustomMapping {
          block: 'rep_ret_right'
          field: r(ecom_cohort_first_order_categories.product_name)
        },
        CustomMapping {
          block: 'rep_ret_wrong'
          field: r(ecommerce_products.name)
        }
      ]
    },
    FilterInteraction {
      from: 'f_ltv_category'
      to: [
        CustomMapping {
          block: 'rep_ltv_right'
          field: r(ecom_cohort_first_order_categories.parent_category)
