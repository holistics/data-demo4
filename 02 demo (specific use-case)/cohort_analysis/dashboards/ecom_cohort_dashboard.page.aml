  // Each filter drives BOTH reports. The semantic-layer report resolves it
  // through relationships; the SQL model resolves it against a column its
  // query happened to SELECT. Same choice, two architectures.
  explicit_interactions: [
    FilterInteraction {
      from: 'f_sum_grain'
      to: [
        CustomMapping {
          block: 'rep_sum_right'
          field: r(ecom_cohort_params.cohort_grain)
        }
      ]
    },
    FilterInteraction {
      from: 'f_cat_grain'
      to: [
        CustomMapping {
          block: 'rep_cat_right'
          field: r(ecom_cohort_params.cohort_grain)
        }
      ]
    },
    FilterInteraction {
      from: 'f_opu_grain'
      to: [
        CustomMapping {
          block: 'rep_opu_right'
          field: r(ecom_cohort_params.cohort_grain)
        }
