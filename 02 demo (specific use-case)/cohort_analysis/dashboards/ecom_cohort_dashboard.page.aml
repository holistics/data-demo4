          ref: r(ecom_cohort_analysis.cohort_user_count)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          label: 'Cohort Revenue'
          ref: r(ecom_cohort_analysis.cohort_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          label: 'Cohort Orders'
          ref: r(ecom_cohort_analysis.cohort_order_count)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          label: 'Cohort AOV'
          ref: r(ecom_cohort_analysis.cohort_aov)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        },
        VizFieldFull {
          label: 'LTV (to date)'
          ref: r(ecom_cohort_analysis.cohort_ltv_total)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'nsum_cohort'
            direction: 'asc'
          }
        ]
        pagination_size: 15
      }
    }
  }

  view: TabLayout {
    tab cohort: CanvasLayout {
      label: 'Cohort Analysis'
      width: 1380
      height: 4020
      grid_size: 20
      auto_expand_vertically: false

      block header {
        position: pos(20, 20, 1340, 140)
      }
      block f_cohort_month {
        position: pos(20, 180, 320, 80)
      }
      block f_lifecycle_window {
        position: pos(360, 180, 320, 80)
      }
      block f_country {
        position: pos(700, 180, 320, 80)
      }
      block f_units_band {
        position: pos(1040, 180, 320, 80)
      }
      block f_category_at_acquisition {
        position: pos(20, 280, 660, 80)
      }
      block f_products_at_acquisition {
        position: pos(700, 280, 660, 80)
      }
      block pivots_context {
        position: pos(20, 380, 1340, 120)
      }
      block pivot_ltv {
        position: pos(20, 520, 1340, 560)
      }
      block pivot_retention {
        position: pos(20, 1100, 1340, 560)
      }
      block pivot_cumulative_revenue {
        position: pos(20, 1680, 1340, 560)
      }
      block pivot_orders_per_user {
        position: pos(20, 2260, 1340, 560)
      }
      block multimembership_context {
        position: pos(20, 2840, 1340, 120)
      }
      block pivot_ltv_by_category {
        position: pos(20, 2980, 1340, 420)
      }
      block cohort_summary {
        position: pos(20, 3420, 1340, 560)
      }
      mobile {
        mode: 'auto'
      }
    }

    tab trap: CanvasLayout {
      label: 'The Trap (filter after cohort)'
      width: 1380
      height: 4020
      grid_size: 20
      auto_expand_vertically: false

      block header_naive {
        position: pos(20, 20, 1340, 180)
      }
      block f_cohort_month_n {
        position: pos(20, 220, 320, 80)
      }
      block f_lifecycle_window_n {
        position: pos(360, 220, 320, 80)
      }
      block f_naive_category {
        position: pos(700, 220, 320, 80)
      }
      block f_naive_product {
        position: pos(1040, 220, 320, 80)
      }
      block naive_context {
        position: pos(20, 320, 1340, 160)
      }
      block pivot_ltv_naive {
        position: pos(20, 500, 1340, 560)
      }
      block pivot_retention_naive {
        position: pos(20, 1080, 1340, 560)
      }
      block pivot_cumulative_revenue_naive {
        position: pos(20, 1660, 1340, 560)
      }
      block pivot_orders_per_user_naive {
        position: pos(20, 2240, 1340, 560)
      }
      block naive_category_context {
        position: pos(20, 2820, 1340, 120)
      }
      block pivot_ltv_by_category_naive {
        position: pos(20, 2960, 1340, 420)
      }
      block cohort_summary_naive {
        position: pos(20, 3400, 1340, 560)
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  settings {
    autorun_on_open: true
    allow_timezone_change: false
  }
  theme: holistics_brand
}