// ═══════════════════════════════════════════════════════════════════════════
// THE TRADITIONAL APPROACH
//
// A cohort report built the usual way: one SQL model with the cohort logic
// baked in — first order per customer, periods since acquisition, cohort size —
// pre-joined out to line grain so every attribute anyone might slice by is a
// COLUMN in the result set.
//
// Unfiltered it returns exactly what the semantic layer returns. The gap only
// opens when a question arrives that the query was not written for.
// ═══════════════════════════════════════════════════════════════════════════
Model ecom_cohort_sql {
  type: 'query'
  label: 'Cohort Fact (SQL model)'
  description: 'Hand-built cohort fact table, the conventional analyst approach. Grain: one row per (user, order, category) with cohort month, months since acquisition and cohort size carried along. Filtering any column slices the aggregate.'
  data_source_name: 'demodb'
  owner: 'chukwudi@holistics.io'

  models: [
    ecommerce_orders,
    ecommerce_order_items,
    ecommerce_products,
    map_categories,
    ecommerce_users,
    ecommerce_cities,
    ecommerce_countries
  ]

  // Every attribute anyone might filter by has to be SELECTED here. That is the
  // maintenance cost of the SQL approach: a new filter means editing this query
  // and re-running it, rather than adding one field to a model.
  query: @sql
    with first_order as (
      select
        {{ #o.user_id }} as user_id,
        min(date_trunc('month', (cast({{ #o.created_at }} as timestamptz) at time zone 'Etc/UTC'))) as cohort_month,
        cast(min(cast({{ #o.created_at }} as timestamptz) at time zone 'Etc/UTC') as date) as first_date
      from {{ #ecommerce_orders as o }}
      group by 1
    ),
    first_units as (
      select
        {{ #o3.user_id }} as user_id,
        sum({{ #oi2.quantity }}) as units
      from {{ #ecommerce_orders as o3 }}
      inner join first_order fo2
        on fo2.user_id = {{ #o3.user_id }}
       and cast(cast({{ #o3.created_at }} as timestamptz) at time zone 'Etc/UTC' as date) = fo2.first_date
      inner join {{ #ecommerce_order_items as oi2 }} on {{ #oi2.order_id }} = {{ #o3.id }}
      group by 1
    ),
    cohort_sizes as (
      -- counted from USERS, not orders, so customers who never purchased form
      -- their own (null) cohort instead of vanishing from the report
      select fo3.cohort_month as cohort_month, count(*) as cohort_size
      from {{ #ecommerce_users as u2 }}
      left join first_order fo3 on fo3.user_id = {{ #u2.id }}
      group by 1
    )
    select
      fo.cohort_month as cohort_month,
      case when {{ #o2.created_at }} is null then null else
        (date_part('year', date_trunc('month', (cast({{ #o2.created_at }} as timestamptz) at time zone 'Etc/UTC'))) - date_part('year', fo.cohort_month)) * 12
          + (date_part('month', date_trunc('month', (cast({{ #o2.created_at }} as timestamptz) at time zone 'Etc/UTC'))) - date_part('month', fo.cohort_month))
      end as month_number,
      {{ #u.id }} as user_id,
      {{ #o2.id }} as order_id,
      {{ #mc.parent_category }} as parent_category,
      {{ #p.name }} as product_name,
      {{ #ctry.name }} as country,
      case
        when fu.units is null then 'Never ordered'
        when fu.units = 1 then '01'
        when fu.units = 2 then '02'
        when fu.units = 3 then '03'
        when fu.units <= 5 then '04-05'
        when fu.units <= 10 then '06-10'
        when fu.units <= 20 then '11-20'
        else '21+'
      end as units_band,
      cs.cohort_size as cohort_size,
      sum(
        case when {{ #o2.status }} is not null and {{ #o2.status }} not in ('cancelled', 'refunded')
             then {{ #oi.quantity }} * {{ #p.price }} * (1 - {{ #o2.discount }})
             else 0 end
      ) as revenue
    from {{ #ecommerce_users as u }}
    left join first_order fo on fo.user_id = {{ #u.id }}
    left join cohort_sizes cs
      on cs.cohort_month = fo.cohort_month
      or (cs.cohort_month is null and fo.cohort_month is null)
    left join first_units fu on fu.user_id = {{ #u.id }}
    left join {{ #ecommerce_orders as o2 }} on {{ #o2.user_id }} = {{ #u.id }}
    left join {{ #ecommerce_order_items as oi }} on {{ #oi.order_id }} = {{ #o2.id }}
    left join {{ #ecommerce_products as p }} on {{ #p.id }} = {{ #oi.product_id }}
    left join {{ #map_categories as mc }} on {{ #mc.category_id }} = {{ #p.category_id }}
    left join {{ #ecommerce_cities as ci }} on {{ #ci.id }} = {{ #u.city_id }}
    left join {{ #ecommerce_countries as ctry }} on {{ #ctry.code }} = {{ #ci.country_code }}
    group by 1, 2, 3, 4, 5, 6, 7, 8, 9
  ;;

  dimension row_key {
    label: 'Row Key'
    type: 'text'
    hidden: true
    primary_key: true
    definition: @aql concat(cast(ecom_cohort_sql.user_id, 'text'), '||', coalesce(cast(ecom_cohort_sql.order_id, 'text'), '-'), '||', coalesce(ecom_cohort_sql.product_name, '-')) ;;
  }
  dimension cohort_month {
    label: 'Cohort Month (SQL)'
    type: 'date'
    definition: @sql {{ #SOURCE.cohort_month }};;
  }
  dimension month_number {
    label: 'Month Number (SQL)'
    type: 'number'
    definition: @sql {{ #SOURCE.month_number }};;
  }
  dimension user_id {
    label: 'User Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.user_id }};;
  }
  dimension order_id {
    label: 'Order Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.order_id }};;
  }
  dimension parent_category {
    label: 'Category (SQL model column)'
    type: 'text'
    definition: @sql {{ #SOURCE.parent_category }};;
    description: 'An output column of the SQL model. Filtering it slices the aggregate — it cannot mean "customers acquired by this category".'
  }
  dimension product_name {
    label: 'Product (SQL model column)'
    type: 'text'
    definition: @sql {{ #SOURCE.product_name }};;
  }
  dimension country {
    label: 'Country (SQL model column)'
    type: 'text'
    definition: @sql {{ #SOURCE.country }};;
  }
  dimension units_band {
    label: 'Units Band (SQL model column)'
    type: 'text'
    definition: @sql {{ #SOURCE.units_band }};;
  }
  dimension cohort_size_col {
    label: 'Cohort Size Column'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.cohort_size }};;
  }
  measure revenue {
    label: 'Revenue (SQL)'
    type: 'number'
    hidden: true
    definition: @aql sum(ecom_cohort_sql.revenue_col) ;;
  }
  dimension revenue_col {
    label: 'Revenue Col'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.revenue }};;
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// THE TRADITIONAL APPROACH
//
// This is how a cohort report gets built without a semantic layer: one SQL
// model with the cohort logic baked in — first order per user, months since
// acquisition, cohort size — pre-joined out to the line grain so that every
// attribute anyone might slice by is a COLUMN in the result set.
//
// It is correct, and unfiltered it returns exactly what the semantic layer
// returns. The difference only appears when someone filters: `parent_category`
// here is an output column, so a filter on it slices the aggregate. There is
// no way for it to mean "customers acquired by this category" — that
// distinction cannot be expressed once the logic is frozen into SQL.
// ═══════════════════════════════════════════════════════════════════════════
// The SQL model's own dataset.
//
// Deliberately standalone. It shares no models, relationships or fields with
// ecom_cohort_analysis — which is the point: this is the whole of what the
// traditional build gives you. One pre-aggregated fact table, and every
// question you can ask of it is a column that query already SELECTed.
// ═══════════════════════════════════════════════════════════════════════════
Dataset ecom_cohort_sql_analysis {
  label: 'Ecommerce Cohort Analysis (SQL model)'
  data_source_name: 'demodb'
  owner: 'chukwudi@holistics.io'
  description: '''
The conventional analyst build of the same cohort report, kept apart from the semantic-layer dataset so the two can be compared honestly.

One model, no relationships, no semantic layer. Cohort month, months since acquisition and cohort size were all computed inside the query and frozen. Every attribute anyone might filter by — category, product, country, units band — is a column the query had to SELECT in advance.

Unfiltered it returns exactly what the semantic dataset returns. Filter it and the cohort cannot change, because the cohort was decided before the filter existed.
  '''

  models: [
    ecom_cohort_sql
  ]

  // One model, so nothing to relate. A star schema needs relationships; a
  // pre-joined SQL fact table has already made every join decision for you.
  relationships: []

  // ── Metrics over the SQL cohort model (the traditional build) ──────────
  metric sql_cohort_size {
    label: 'Cohort Size (SQL model)'
    type: 'number'
    description: 'Cohort size as the SQL model computed it, carried on every row. Filtering a column does not change it — but it no longer matches the customers being counted above it.'
    definition: @aql max(ecom_cohort_sql.cohort_size_col) ;;
    format: '#,###0'
  }

  metric sql_active_users {
    label: 'Active Users (SQL model)'
    type: 'number'
    description: 'Distinct customers who placed an order in the period. Gated on order_id so the never-purchased population, which exists in this model as rows with no order, is not counted as active.'
    definition: @aql count_distinct(ecom_cohort_sql.user_id) | where(ecom_cohort_sql.order_id is not null) ;;
    format: '#,###0'
  }

  metric sql_retention {
    label: 'Retention (SQL model)'
    type: 'number'
    definition: @aql safe_divide(sql_active_users, sql_cohort_size) ;;
    format: '#,##0.0%'
  }

  metric sql_revenue {
    label: 'Cohort Revenue (SQL model)'
    type: 'number'
    definition: @aql sum(ecom_cohort_sql.revenue_col) ;;
    format: '[$$]#,###0'
  }

  metric sql_cumulative_revenue {
    label: 'Cumulative Revenue (SQL model)'
    type: 'number'
    definition: @aql running_total(sql_revenue, ecom_cohort_sql.month_number, fill_missing: true) ;;
    format: '[$$]#,###0'
  }

  metric sql_ltv {
    label: 'LTV (SQL model)'
    type: 'number'
    definition: @aql safe_divide(sql_cumulative_revenue, sql_cohort_size) ;;
    format: '[$$]#,###0.00'
  }

  metric sql_order_count {
    label: 'Cohort Orders (SQL model)'
    type: 'number'
    definition: @aql count_distinct(ecom_cohort_sql.order_id) ;;
    format: '#,###0'
  }

  metric sql_cumulative_orders {
    label: 'Cumulative Orders (SQL model)'
    type: 'number'
    definition: @aql running_total(sql_order_count, ecom_cohort_sql.month_number, fill_missing: true) ;;
    format: '#,###0'
  }

  metric sql_orders_per_user {
    label: 'Orders Per User (SQL model)'
    type: 'number'
    definition: @aql safe_divide(sql_cumulative_orders, sql_cohort_size) ;;
    format: '#,###0.00'
  }

  metric sql_aov {
    label: 'Cohort AOV (SQL model)'
    type: 'number'
    definition: @aql safe_divide(sql_revenue, sql_order_count) ;;
    format: '[$$]#,###0.00'
  }

  metric sql_ltv_total {
    label: 'LTV to date (SQL model)'
    type: 'number'
    definition: @aql safe_divide(sql_revenue, sql_cohort_size) ;;
    format: '[$$]#,###0.00'
  }

  view {
    group cohort_metrics {
      metric sql_cohort_size
      metric sql_active_users
      metric sql_retention
      metric sql_revenue
      metric sql_cumulative_revenue
      metric sql_ltv
      metric sql_order_count
      metric sql_cumulative_orders
      metric sql_orders_per_user
      metric sql_aov
      metric sql_ltv_total
    }

    model ecom_cohort_sql {
    }
  }
}
