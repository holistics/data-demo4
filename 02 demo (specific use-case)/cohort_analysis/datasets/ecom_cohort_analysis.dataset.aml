// ═══════════════════════════════════════════════════════════════════════════
// Cohort granularity control.
// ═══════════════════════════════════════════════════════════════════════════
Model ecom_cohort_params {
  type: 'query'
  label: 'Cohort Params'
  description: 'Parameter model powering the dynamic cohort-granularity selector.'
  data_source_name: 'demodb'
  owner: 'chukwudi@holistics.io'
  query: @sql select 1;;
  models: []

  param cohort_grain {
    label: 'Cohort Granularity'
    type: 'text'
    allowed_values: [
      'Day',
      'Week',
      'Month',
      'Quarter',
      'Year'
    ]
  }
}

Model ecom_cohort_first_order_categories {
  type: 'query'
  label: 'First Order Basket (Bridge)'
  description: '''
Bridge model: one row per user per distinct PRODUCT present in their first order, carrying that product's category alongside it.

This is the only query model in the cohort layer, and it drives both cohort-profile filters on the dashboard:

- **Categories at Acquisition** — multiselect on `parent_category`
- **Products at Acquisition** — multiselect on `product_name`

Both are multi-valued per user, which a dimension cannot represent: dimensions collapse to one value per user. A user whose first order contained Clothes AND Skin Care must appear under both categories, and a user who bought three different products must be reachable by any of the three. That needs a row per (user, product), which is exactly this grain.

**Selecting several values in one filter is OR** ("first order contained any of these"). Combining the two filters is AND, matched **within the same row** — so the selected product must itself sit in one of the selected categories. Picking Clothes plus a Groceries product returns nobody, by construction. Filtering categories alone, or products alone, is the common case and behaves exactly as expected.

**Fan-out.** Joined as the many side of `ecommerce_users`, so it only materialises when a query actually groups or filters on it. Holistics pre-aggregates the bridge to just the columns a query uses (`GROUP BY user_id, parent_category` when only the category is on the shelf), which collapses a user's multiple products within one category back to a single row — so grouping by category does not multiply that user's revenue. Verified against the previous per-category bridge: identical user counts and identical cohort spend.

**First order is defined at DAY grain**, matching `is_first_order` in the dataset. The source `orders.created_at` is a timestamp while the inherited `ecommerce_users.first_order_date` is typed `date`, so a timestamp-level comparison matches nothing (it only lands at midnight). Day grain also reads better commercially: the acquisition basket is what someone bought on the day they became a customer. 81 of 7,499 buying users (1.1%) placed more than one order on their first day, and every order of that day counts toward their first-order profile.
  '''
  data_source_name: 'demodb'
  owner: 'chukwudi@holistics.io'

  models: [
    ecommerce_orders,
    ecommerce_order_items,
    ecommerce_products,
    map_categories
  ]

  query: @sql
    with first_day as (
      select
        {{ #o.user_id }} as user_id,
        cast(min(cast({{ #o.created_at }} as timestamptz) at time zone 'Etc/UTC') as date) as first_date
      from {{ #ecommerce_orders as o }}
      group by 1
    )
    select distinct
      {{ #o2.user_id }} as user_id,
      {{ #p.id }} as product_id,
      {{ #p.name }} as product_name,
      {{ #mc.parent_category }} as parent_category,
      {{ #mc.category }} as category
    from {{ #ecommerce_orders as o2 }}
    inner join first_day fd
      on fd.user_id = {{ #o2.user_id }}
     and {{ #o2.created_at }}::date = fd.first_date
    inner join {{ #ecommerce_order_items as oi }}
      on {{ #oi.order_id }} = {{ #o2.id }}
    inner join {{ #ecommerce_products as p }}
      on {{ #p.id }} = {{ #oi.product_id }}
    inner join {{ #map_categories as mc }}
      on {{ #mc.category_id }} = {{ #p.category_id }}
  ;;

  dimension first_order_basket_key {
    label: 'First Order Basket Key'
    type: 'text'
    hidden: true
    primary_key: true
    definition: @aql concat(cast(ecom_cohort_first_order_categories.user_id, 'text'), '||', cast(ecom_cohort_first_order_categories.product_id, 'text')) ;;
    description: 'Composite key of the bridge grain.'
  }

  dimension user_id {
    label: 'User Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.user_id }};;
    description: 'User whose first order contained this product. Joins to Users.'
  }

  dimension product_id {
    label: 'Product Id at Acquisition'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.product_id }};;
    description: 'Kept for the composite key and for joining out to the product record; filter on Product at Acquisition instead.'
  }

  dimension product_name {
    label: 'Product at Acquisition'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.product_name }};;
    description: 'A product present in the user first order. Multiselect this to profile a cohort by the specific products people bought first — selecting several means "first order contained any of these". A user who bought several of the selected products is still counted once.'
  }

  dimension parent_category {
    label: 'Category at Acquisition'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.parent_category }};;
    description: 'The parent category of a product present in the user first order. Multiselect this to profile a cohort by first-order category — selecting several means "first order contained any of these". A user who bought two categories appears under both when this is used as a pivot row.'
  }

  dimension category {
    label: 'Sub-category at Acquisition'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.category }};;
    description: 'The leaf category of a product present in the user first order — a middle grain between Category at Acquisition and Product at Acquisition.'
  }
}

Dataset ecom_cohort_analysis {
  label: 'Ecommerce Cohort Analysis'
  data_source_name: 'demodb'
  owner: 'chukwudi@holistics.io'
  description: '''
Cohort LTV, retention and repeat purchase for the ecommerce demo, profileable by any attribute of the user first order.

**Standalone, not an `.extend()`.** It reuses the shared table models but declares its own relationships, fields and view, so it is fully decoupled from `demo_ecommerce_version_2`. That decoupling is deliberate: a `view` block inside an `.extend()` leaks into the base dataset and breaks every dashboard built on it, which is why the bridge fields could not be exposed while this was an extend. It also carries only the seven models the cohort question needs, rather than inheriting twelve.

The cost is that the handful of fields it shares with the base — `Cohort Month`, `Month Number`, `First Order Date`, and the revenue definition — are declared here rather than inherited, so a change to the base definition does not propagate. They are kept deliberately identical; `Cohort Revenue` is the base `nmv` definition inlined.

**Cohort membership lives at user grain, never in a parameter.** It arrives two ways, and the split is deliberate:

1. **Single-valued attributes are dimensions**, built with `dimensionalize()` — an aggregate over the many side collapsed to one value per user (`First Order Units`, `First Order Lines`, `First Order Value`).
2. **Multi-valued attributes are the bridge model** `ecom_cohort_first_order_categories` — category, sub-category and product of the acquisition basket. A dimension cannot hold these: AQL rejects a multi-valued attribute at user grain with a fan-out error.

Either way, filtering narrows WHO IS IN THE COHORT while every metric still counts that user whole lifetime. Filtering `Category` on the base product path instead restricts the line items being summed — that is the trap, and the dashboard's second tab demonstrates it live.

Consequences worth knowing:
- There is no `'All'` sentinel and no default that has to resolve to true. An unset field filter emits no predicate, so the unfiltered pivot IS the all-users cohort.
- There is one set of metrics. `LTV` is `LTV` whether or not a cohort filter is set — no `qualified_*` twin per metric.
- Adding a cohort attribute costs one dimension, or one column on the bridge, and zero metric changes. Nothing is hardcoded per category or per product.
- Multi-membership is correct: a user whose first order held Clothes AND Skin Care belongs to both cohorts, and is counted once.

**First order is defined at DAY grain.** `First Order Date` is a date while `orders.created_at` is a timestamp, so a timestamp comparison matches nothing. Day grain also reads better commercially — the acquisition basket is what someone bought on the day they became a customer. 81 of 7,499 buying users (1.1%) ordered more than once that day; all of it counts.

**What this dataset deliberately does NOT carry:** no margin/CM2 layer, because `ecommerce_products.cost` is `ROUND(price * 0.3)` and any gross margin would be revenue x 0.7; and no CAC/CM3/payback, because there is no marketing spend in this source.
  '''

  models: [
    ecommerce_users,
    ecommerce_orders,
    ecommerce_order_items,
    ecommerce_products,
    map_categories,
    ecommerce_cities,
    ecommerce_countries,
    ecom_cohort_first_order_categories,
    ecom_cohort_params
  ]

  relationships: [
    relationship(ecommerce_order_items.order_id > ecommerce_orders.id, true),
    relationship(ecommerce_orders.user_id > ecommerce_users.id, true),
    relationship(ecommerce_order_items.product_id > ecommerce_products.id, true),
    relationship(ecommerce_products.category_id > map_categories.category_id, true),
    relationship(ecommerce_users.city_id > ecommerce_cities.id, true),
    relationship(ecommerce_cities.country_code > ecommerce_countries.code, true),

    // Bridge: many side of users, so it only materialises when a query groups
    // or filters on Category / Product at Acquisition.
    relationship(ecom_cohort_first_order_categories.user_id > ecommerce_users.id, true),
  ]

  // ═══════════════════════════════════════════════════════════════════════════
  // COHORT AXIS
  // Declared here rather than inherited, and kept identical to the base.
  // ═══════════════════════════════════════════════════════════════════════════

  dimension cohort_month {
    model: ecommerce_users
    label: 'Cohort Month'
    type: 'date'
    description: 'The month the user first ordered. The cohort axis — use it as the pivot row.'
    definition: @aql min(ecommerce_orders.created_at | month()) | dimensionalize(ecommerce_users.id) ;;
  }

  dimension first_order_date {
    model: ecommerce_users
    label: 'First Order Date'
    type: 'date'
    description: 'The day the user first ordered. Date, not timestamp — see Is First Order.'
    definition: @aql min(ecommerce_orders.created_at) | dimensionalize(ecommerce_users.id) ;;
  }



  // ── Dynamic cohort granularity ──────────────────────────────────────────
  // Each grain is dimensionalized SEPARATELY, then case() picks between the
  // finished dates. Putting the aggregate inside the case (min(...) |
  // dimensionalize(...) per branch) compiles locally and is rejected at query
  // time — the case must choose between plain date columns, not aggregates.
  //
  // Both sides of every date_diff must be DATE-typed, or one side gets
  // timezone-converted and the diagonal shifts by a period.

  dimension first_order_day {
    model: ecommerce_users
    label: 'First Order Day'
    type: 'date'
    hidden: true
    definition: @aql min(ecommerce_orders.created_at | day()) | dimensionalize(ecommerce_users.id) ;;
  }
  dimension first_order_week {
    model: ecommerce_users
    label: 'First Order Week'
    type: 'date'
    hidden: true
    definition: @aql min(ecommerce_orders.created_at | week()) | dimensionalize(ecommerce_users.id) ;;
  }
  dimension first_order_month {
    model: ecommerce_users
    label: 'First Order Month'
    type: 'date'
    hidden: true
    definition: @aql min(ecommerce_orders.created_at | month()) | dimensionalize(ecommerce_users.id) ;;
  }
  dimension first_order_quarter {
    model: ecommerce_users
    label: 'First Order Quarter'
    type: 'date'
    hidden: true
    definition: @aql min(ecommerce_orders.created_at | quarter()) | dimensionalize(ecommerce_users.id) ;;
  }
  dimension first_order_year {
    model: ecommerce_users
    label: 'First Order Year'
    type: 'date'
    hidden: true
    definition: @aql min(ecommerce_orders.created_at | year()) | dimensionalize(ecommerce_users.id) ;;
  }


  dimension cohort_period {
    model: ecommerce_users
    label: 'Cohort Period'
    type: 'date'
    description: 'The period the customer was acquired in. Granularity switches with the Cohort Granularity control.'
    definition: @aql case(
        when: 'Day' in ecom_cohort_params.cohort_grain, then: ecommerce_users.first_order_day
      , when: 'Week' in ecom_cohort_params.cohort_grain, then: ecommerce_users.first_order_week
      , when: 'Quarter' in ecom_cohort_params.cohort_grain, then: ecommerce_users.first_order_quarter
      , when: 'Year' in ecom_cohort_params.cohort_grain, then: ecommerce_users.first_order_year
      , else: ecommerce_users.first_order_month
    ) ;;
  }

  // date_diff('week', ...) compiles to div(double precision, integer) on this
  // Postgres, which does not exist — it fails the whole case, not just the Week
  // branch, because every branch is present in the compiled SQL. Both sides are
  // already week-truncated, so day-difference over 7 is exact.
  dimension period_number {
    model: ecommerce_orders
    label: 'Period Number'
    type: 'number'
    description: 'Calendar periods between acquisition and the order, in the unit the Cohort Granularity control is set to, in lockstep with Cohort Period. Period 0 is always the acquisition period itself.'
    definition: @aql case(
        when: 'Day' in ecom_cohort_params.cohort_grain, then: date_diff('day', ecommerce_users.first_order_day, (ecommerce_orders.created_at | day()))
      , when: 'Week' in ecom_cohort_params.cohort_grain, then: date_diff('day', ecommerce_users.first_order_week, (ecommerce_orders.created_at | week())) / 7
      , when: 'Quarter' in ecom_cohort_params.cohort_grain, then: date_diff('quarter', ecommerce_users.first_order_quarter, (ecommerce_orders.created_at | quarter()))
      , when: 'Year' in ecom_cohort_params.cohort_grain, then: date_diff('year', ecommerce_users.first_order_year, (ecommerce_orders.created_at | year()))
      , else: date_diff('month', ecommerce_users.first_order_month, (ecommerce_orders.created_at | month()))
    ) ;;
  }

  dimension month_number {
    model: ecommerce_orders
    label: 'Month Number'
    type: 'number'
    description: 'Months since acquisition — the lifecycle axis. Derived from order rows, so it only exists where an order exists; a cohort with no orders in a month produces no column.'
    definition: @aql date_diff('month', ecommerce_users.cohort_month, (ecommerce_orders.created_at | month())) ;;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // FIRST-ORDER MEMBERSHIP (user grain)
  // ═══════════════════════════════════════════════════════════════════════════

  dimension is_first_order {
    model: ecommerce_orders
    label: 'Is First Order'
    type: 'truefalse'
    description: 'True for every order placed on the day the user first ordered. Day grain, not timestamp — see the dataset description. Cross-model, so it must live on the dataset rather than the model.'
    definition: @aql ecommerce_orders.created_date == ecommerce_users.first_order_date ;;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // FIRST-ORDER SHAPE (user grain)
  // ═══════════════════════════════════════════════════════════════════════════

  dimension first_order_units {
    model: ecommerce_users
    label: 'First Order Units'
    type: 'number'
    description: 'Total units bought on the acquisition day. NULL for users who never ordered.'
    definition: @aql sum(ecommerce_order_items.quantity)
      | where(ecommerce_orders.is_first_order)
      | dimensionalize(ecommerce_users.id) ;;
  }

  dimension first_order_units_band {
    model: ecommerce_users
    label: 'Units Band at Acquisition'
    type: 'text'
    description: 'First-order units bucketed. Bands are cut to the observed distribution, not to round numbers: 1 unit is 25% of buyers and 2 units another 19%, so the low end is split single-unit while the long tail is grouped.'
    definition: @aql case(
      when: ecommerce_users.first_order_units == 1, then: '01',
      when: ecommerce_users.first_order_units == 2, then: '02',
      when: ecommerce_users.first_order_units == 3, then: '03',
      when: ecommerce_users.first_order_units <= 5, then: '04-05',
      when: ecommerce_users.first_order_units <= 10, then: '06-10',
      when: ecommerce_users.first_order_units <= 20, then: '11-20',
      when: ecommerce_users.first_order_units > 20, then: '21+',
      else: 'Never ordered'
    ) ;;
  }

  dimension first_order_lines {
    model: ecommerce_users
    label: 'First Order Lines'
    type: 'number'
    description: 'Distinct order lines in the acquisition basket.'
    definition: @aql count(ecommerce_order_items.order_id)
      | where(ecommerce_orders.is_first_order)
      | dimensionalize(ecommerce_users.id) ;;
  }

  dimension first_order_value {
    model: ecommerce_users
    label: 'First Order Value'
    type: 'number'
    format: '[$$]#,###0'
    description: 'Gross value of the acquisition basket, before discount. Use it as a cohort dimension (band it first if you want a filter).'
    definition: @aql sum(ecommerce_order_items.quantity * ecommerce_products.price)
      | where(ecommerce_orders.is_first_order)
      | dimensionalize(ecommerce_users.id) ;;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // COHORT METRICS
  //
  // One set, no qualified_* twins. Every one of these respects any First Order
  // filter automatically, because the filter narrows the user population
  // upstream rather than being tested inside each metric.
  // ═══════════════════════════════════════════════════════════════════════════

  metric cohort_user_count {
    label: 'Cohort Size'
    type: 'number'
    description: 'Distinct users acquired in the cohort month, held CONSTANT across the lifecycle axis by of_all() so it is a valid denominator. If this drifts across Month Number, every ratio below is wrong.'
    definition: @aql count_distinct(ecommerce_users.id) | of_all(ecommerce_orders.period_number, keep_filters: true) ;;
    format: '#,###0'
  }

  metric cohort_active_users {
    label: 'Active Users'
    type: 'number'
    description: 'Distinct users from the cohort who ordered in that lifecycle month.'
    definition: @aql count_distinct(ecommerce_orders.user_id) ;;
    format: '#,###0'
  }

  metric cohort_retention {
    label: 'Retention'
    type: 'number'
    description: 'Active Users / Cohort Size. Month 0 must read exactly 100% — every acquired user orders in their acquisition month by definition.'
    definition: @aql cohort_active_users / cohort_user_count ;;
    format: '#,##0.0%'
  }

  metric cohort_revenue {
    label: 'Cohort Revenue'
    type: 'number'
    description: 'Net merchandise value booked by the cohort in that lifecycle month. Excludes cancelled and refunded orders.'
    definition: @aql (ecommerce_order_items | sum(ecommerce_order_items.quantity * ecommerce_products.price * (1 - ecommerce_orders.discount)))
      | where(ecommerce_orders.status not in ['cancelled', 'refunded']) ;;
    format: '[$$]#,###0'
  }


  // ── Running-total metrics: AXIS-BOUND ───────────────────────────────────
  // cumulative_cohort_revenue, cumulative_cohort_orders, cohort_ltv and
  // cohort_orders_per_user all use running_total(..., month_number,
  // fill_missing: true). fill_missing materialises the lifecycle axis, so these
  // may ONLY be placed on a report that carries Month Number as a dimension.
  // On a report without it (a summary table), SQL generation fails with
  // `Field ecommerce_orders->month_number not found in model aql__tNN`.
  // Use the axis-free cohort_ltv_total / cohort_aov there instead.
  metric cumulative_cohort_revenue {
    label: 'Cumulative Cohort Revenue'
    type: 'number'
    description: 'Running total of Cohort Revenue over the lifecycle axis. fill_missing fills lifecycle months in which the cohort happened to place no orders — without it the pivot axis skips those columns and a curve that jumps month 5 to month 11 looks contiguous.'
    definition: @aql running_total(cohort_revenue, ecommerce_orders.period_number, fill_missing: true) ;;
    format: '[$$]#,###0'
  }

  metric cohort_ltv {
    label: 'LTV'
    type: 'number'
    description: 'Cumulative Cohort Revenue / Cohort Size. Must increase monotonically across the lifecycle axis — a dip means the accumulation is broken. Reads correctly when the lifecycle window is a RANGE; filtering to a SINGLE month leaves the running total one month to accumulate and reports that month alone.'
    definition: @aql cumulative_cohort_revenue / cohort_user_count ;;
    format: '[$$]#,###0.00'
  }

  metric cohort_ltv_total {
    label: 'LTV (to date)'
    type: 'number'
    description: 'Net revenue per acquired user over whatever lifecycle months are in scope. AXIS-FREE: unlike LTV it uses no running_total, so it is safe on a report with no Month Number axis. With the lifecycle window cleared it equals the final LTV column.'
    definition: @aql cohort_revenue / cohort_user_count ;;
    format: '[$$]#,###0.00'
  }

  metric cohort_order_count {
    label: 'Cohort Orders'
    type: 'number'
    description: 'Orders placed by the cohort in that lifecycle month. Plain count(), not count_distinct — running_total() rejects count-distinct aggregation.'
    definition: @aql count(ecommerce_orders.id) ;;
    format: '#,###0'
  }

  metric cumulative_cohort_orders {
    label: 'Cumulative Cohort Orders'
    type: 'number'
    description: 'Running total of Cohort Orders over the lifecycle axis.'
    definition: @aql running_total(cohort_order_count, ecommerce_orders.period_number, fill_missing: true) ;;
    format: '#,###0'
  }

  metric cohort_orders_per_user {
    label: 'Orders Per User'
    type: 'number'
    description: 'Cumulative Cohort Orders / Cohort Size — the repeat-purchase curve.'
    definition: @aql cumulative_cohort_orders / cohort_user_count ;;
    format: '#,###0.00'
  }

  metric cohort_aov {
    label: 'Cohort AOV'
    type: 'number'
    description: 'Net revenue per order for the cohort, over whatever lifecycle months are in scope. AXIS-FREE: no running_total, so it is safe on a report that does not carry Month Number — see the note above cumulative_cohort_revenue.'
    definition: @aql cohort_revenue / cohort_order_count ;;
    format: '[$$]#,###0.00'
  }





  // ── Calendar-axis cohort (granularity prototype) ────────────────────────
  // Both axes are raw DATES, so the viz field's own datetrunc drives them.
  // Switching granularity re-cuts rows and columns together, natively, with no
  // param and no date_diff — the lifecycle offset is read off the diagonal
  // rather than numbered. The denominator is held constant with of_all() on
  // the activity date, exactly as the month version holds it across month_number.

  metric cohort_size_calendar {
    label: 'Cohort Size (calendar axis)'
    type: 'number'
    description: 'Distinct customers acquired in the row period, held constant across the activity axis so it stays a valid denominator at any granularity.'
    definition: @aql count_distinct(ecommerce_users.id) | of_all(ecommerce_orders.created_date) ;;
    format: '#,###0'
  }

  metric cohort_retention_calendar {
    label: 'Retention (calendar axis)'
    type: 'number'
    description: 'Active customers in the activity period over cohort size. Read the lifecycle off the diagonal: the leading cell of each row is the acquisition period itself and must be 100%.'
    definition: @aql safe_divide(cohort_active_users, cohort_size_calendar) ;;
    format: '#,##0.0%'
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // VIEW
  // Safe to declare now: this is a standalone dataset, so nothing leaks into
  // demo_ecommerce_version_2. This is what an extend could not do, and it is
  // what finally puts the bridge fields in the field picker.
  // ═══════════════════════════════════════════════════════════════════════════

  view {
    group cohort_metrics {
      metric cohort_user_count
      metric cohort_active_users
      metric cohort_retention
      metric cohort_revenue
      metric cumulative_cohort_revenue
      metric cohort_ltv
      metric cohort_order_count
      metric cumulative_cohort_orders
      metric cohort_orders_per_user
      metric cohort_aov
    }

    model ecommerce_users {
    }
    model ecommerce_orders {
    }
    model ecommerce_order_items {
    }
    model ecommerce_products {
    }
    model map_categories {
    }
    model ecommerce_cities {
    }
    model ecommerce_countries {
    }
    model ecom_cohort_first_order_categories {
    }
  }
}
