  interactions: [
    DateDrillInteraction {
      from: 'date_drill'
      to: [
        CustomMapping {
          block: [
            'stake_margin_trend',
            'margin_vs_expected'
          ]
          field: r(dabble_fact_bet.reporting_date)
        }
      ]
    },
    PopInteraction {
      from: 'period_comparison'
      to: [
        CustomMapping {
          block: [
            'kpi_actives',
            'kpi_bets',
            'kpi_stake',
            'kpi_gross_win_pct',
            'kpi_net_revenue',
            'kpi_rocket_boost'
          ]
          field: r(dabble_fact_bet.reporting_date)
        }
      ]
    }
  ]
  settings {
    autorun_on_open: true
  }
