Dashboard dabble_au_trading_performance_command_center {
  title: 'Dabble AU Trading Performance'
  description: 'Trading performance for the Australian book: turnover and margin pulse, realised margin against the priced book, sport and competition drivers, and customer risk exposure.'
  theme: dabble_light

  block header_executive_pulse: block_dabble_page_header(
    'Executive Pulse',
    'Turnover and margin against last year, at a glance',
    'AU Book'
  )
  block header_monthly_scorecard: block_dabble_page_header(
    'Monthly Trading Scorecard',
    'Month-by-month scale, profitability, customer economics and risk',
    'AU Book'
  )
  block header_sport_drivers: block_dabble_page_header(
    'Sport & Competition Drivers',
    'Where realised margin diverges from the priced book',
    'AU Book'
  )
  block header_customer_risk: block_dabble_page_header(
    'Customer, Rocket & Risk',
    'Risk brackets, Rocket incentives and customer profitability',
    'AU Book'
  )
  block reporting_date_filter: FilterBlock {
    label: 'Settled Date (financials)'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_fact_bet.reporting_date)
    }
    default {
      operator: 'matches'
      value: 'last 13 weeks - 26 jul'
    }
  }
  block fixture_start_filter: FilterBlock {
    label: 'Event Date (fixtures)'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_fixture.advertised_start)
    }
    default {
      operator: 'matches'
      value: 'last 12 months - today'
    }
  }
  block sport_filter: FilterBlock {
    label: 'Sport'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_sport.sport_name)
    }
    default {
      operator: 'is'
      value: []
    }
    settings {
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block competition_filter: FilterBlock {
    label: 'Competition'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_competition.competition_name)
    }
    default {
      operator: 'is'
      value: []
    }
    settings {
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block fixture_filter: FilterBlock {
    label: 'Fixture'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_fixture.fixture_name)
    }
    default {
      operator: 'is'
      value: []
    }
    settings {
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block date_drill: DateDrillBlock {
    label: 'Date Drill'
  }
  block period_comparison: PopBlock {
    label: 'Compare'
    default {
      type: 'relative'
      duration: 1
      granularity: 'year'
    }
  }

  block kpi_actives: VizBlock {
    label: 'Actives'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.actives)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }
  block kpi_bets: VizBlock {
    label: 'Bets'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.bets)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }
  block kpi_stake: VizBlock {
    label: 'Combined Stake'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.combined_stake)
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,"K"'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }
  block kpi_gross_win_pct: VizBlock {
    label: 'Gross Win %'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.gross_win_pct)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }
  block kpi_net_revenue: VizBlock {
    label: 'Trading Net Revenue'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.trading_net_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,"K"'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
      }
    }
    settings {
      hide_label: true
    }
  }
  block kpi_rocket_boost: VizBlock {
    label: 'Rocket Boost'
    viz: MetricKpi {
      dataset: dabble_trading
      value: VizFieldFull {
        ref: r(dabble_trading.rocket_boost)
        format {
          type: 'number'
          pattern: '[$$]#,###0.00,"K"'
        }
      }
      compare_value: VizPopSettings {
        field: r(dabble_fact_bet.reporting_date)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        alignment: 'center'
        compare_value {
          reverse_color: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  block stake_margin_trend: VizBlock {
    label: 'Stake & Margin Trend'
    viz: CombinationChart {
      dataset: dabble_trading
      x_axis: VizFieldFull {
        ref: r(dabble_fact_bet.reporting_date)
        transformation: 'datetrunc week'
        format {
          type: 'date'
          pattern: 'dd LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Combined Stake'
            ref: r(dabble_trading.combined_stake)
            format {
              type: 'number'
              pattern: '[$$]#,###0.00,"K"'
            }
          }
          settings {
            color: '#8A5DFF'
          }
        }
      }
      y_axis {
        settings {
          alignment: 'right'
          axis_min: 0.15
          axis_max: 0.35
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Win %'
            ref: r(dabble_trading.gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#28AC26'
            line_interpolation: 'smooth'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Win % (4-period avg)'
            ref: r(dabble_trading.gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
            analytic: MovingCalculationField {
              type: 'avg'
              order: 'row'
              range {
                previous: 3
                next: 0
              }
              null_if_not_enough_values: true
            }
          }
          settings {
            color: '#180666'
            line_style: 'dashed'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Average Gross Win %'
            ref: r(dabble_trading.gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
            analytic: ReferenceLine {
              type: 'avg'
            }
          }
          settings {
            color: '#8B8B8B'
            line_style: 'dotted'
          }
        }
      }
      settings {
        x_axis_show_null_datetime: false
        show_data_points: true
        legend_label: 'bottom'
        row_limit: 5000
      }
    }
  }
  block channel_mix_donut: VizBlock {
    label: 'Stake Mix: Racing vs Sport'
    viz: PieChart {
      dataset: dabble_trading
      legend: VizFieldFull {
        label: 'Category'
        ref: r(dabble_dim_sport.sport_category)
      }
      series {
        field: VizFieldFull {
          label: 'Combined Stake'
          ref: r(dabble_trading.combined_stake)
          format {
            type: 'number'
            pattern: '[$$]#,###0.00,"K"'
          }
        }
      }
      settings {
        display_as_donut: true
        row_limit: 5000
        legend_label: 'hidden'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }

  block key_competition_cards: VizBlock {
    label: 'Key Competitions - click a card to filter the scorecard (double-click to clear)'
    viz: CustomChart {
      dataset: dabble_trading
      custom_chart: dabble_competition_cards
      // The three named competitions in the AU book. Everything else in
      // dim_competition is generic filler, so pinning the card row here keeps
      // the shortcut meaningful without a hard-coded list inside the chart def.
      filter {
        field: r(dabble_dim_competition.competition_name)
        operator: 'is'
        value: [
          'AFL Matches',
          'Brownlow Medal',
          'UFC'
        ]
      }
      field entity: VizFieldFull {
        ref: r(dabble_dim_competition.competition_name)
        format {
          type: 'text'
        }
      }
      field headline: VizFieldFull {
        ref: r(dabble_trading.combined_stake)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field stat_left: VizFieldFull {
        ref: r(dabble_trading.gross_win_pct)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      field stat_right: VizFieldFull {
        ref: r(dabble_trading.bets)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        row_limit: 10
      }
    }
  }
  block executive_metric_sheet: VizBlock {
    label: 'Monthly Trading Scorecard'
    viz: MetricSheet {
      dataset: dabble_trading
      theme {
        table {
          general {
            bg_color: '#FFFFFFFF'
            hover_color: '#EEE9FA'
            font_size: 13
            font_color: '#21099B'
            border_color: '#DDD8EA'
            grid_color: '#DDD8EA'
            borders {
              outer: true
              vertical: true
              header: true
            }
          }
          header {
            bg_color: '#21099B'
            font_size: 13
            font_weight: 'semibold'
            font_color: '#FFFFFFFF'
          }
          sub_header {
            bg_color: '#EEE9FA'
            font_size: 13
            font_weight: 'bold'
            font_color: '#180666'
          }
        }
      }
      date_field: VizFieldFull {
        ref: r(dabble_fact_bet.reporting_date)
        transformation: 'datetrunc week'
        format {
          type: 'date'
          pattern: 'wwww'
        }
      }
      rows: [
        MetricHeading {
          label: 'Trading scale'
          settings {
            background_color: '#EEE9FA'
            text_color: '#180666'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.actives)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.bets)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.combined_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.combined_stake_yoy_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricHeading {
          label: 'Profitability'
          settings {
            background_color: '#EEE9FA'
            text_color: '#180666'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.gross_win)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.expected_gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.margin_variance_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.trading_net_win)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.trading_net_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.trading_net_revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.trading_net_revenue_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.trading_net_revenue_yoy_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricHeading {
          label: 'Customer economics'
          settings {
            background_color: '#EEE9FA'
            text_color: '#180666'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.avg_bet_size)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.avg_stake_per_active)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricHeading {
          label: 'Risk and incentives'
          settings {
            background_color: '#EEE9FA'
            text_color: '#180666'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.restricted_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.restricted_stake_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.bonus_cash_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.bonus_cash_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.rocket_boost)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricHeading {
          label: 'Racing, sport and copy mix'
          settings {
            background_color: '#EEE9FA'
            text_color: '#180666'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.racing_combined_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.racing_gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.sport_combined_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.sport_gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.copy_combined_stake)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.copy_rocket_boost)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
          }
        },
        MetricSeries {
          field: VizFieldFull {
            ref: r(dabble_trading.copy_gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            indent: 8
            mark_type: 'line'
          }
        }
      ]
      settings {
        max_column: 12
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block yoy_scorecard: VizBlock {
    label: 'Stake & Net Revenue vs Last Year'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        VizFieldFull {
          ref: r(dabble_trading.combined_stake)
          uname: 'combined_stake'
        },
        VizFieldFull {
          ref: r(dabble_trading.combined_stake_prior_year)
          uname: 'combined_stake_prior_year'
        },
        VizFieldFull {
          ref: r(dabble_trading.combined_stake_yoy_pct)
          uname: 'combined_stake_yoy_pct'
        },
        VizFieldFull {
          ref: r(dabble_trading.trading_net_revenue)
          uname: 'trading_net_revenue'
        },
        VizFieldFull {
          ref: r(dabble_trading.trading_net_revenue_prior_year)
          uname: 'trading_net_revenue_prior_year'
        },
        VizFieldFull {
          ref: r(dabble_trading.trading_net_revenue_yoy_pct)
          uname: 'trading_net_revenue_yoy_pct'
        }
      ]
      settings {
        wrap_header_text: true
      }
    }
  }
  block data_notes: TextBlock {
    content: @md <div style="border-left:6px solid #5C3BC4;padding:12px 18px;background:#FFFFFF;"><h2 style="color:#21099B;margin:0 0 8px 0;">Metric definitions and assumptions</h2><p style="margin:0;">This dashboard runs on deterministic synthetic data and contains no direct customer PII - source user IDs and aliases are generated. Financial measures are allocated to bet legs so sport and event totals stay additive. Prior-year comparison in this table is fixed at one year and does not follow the Compare control. Restricted stake, weighted dividend, expected margin overrounds, Rocket categories, active users and the Australian settled reporting date are documented assumptions pending Dabble confirmation.</p></div>;;
  }

  block margin_vs_expected: VizBlock {
    label: 'Realised vs Priced Margin'
    viz: CombinationChart {
      dataset: dabble_trading
      x_axis: VizFieldFull {
        ref: r(dabble_fact_bet.reporting_date)
        transformation: 'datetrunc week'
        format {
          type: 'date'
          pattern: 'dd LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Margin Variance (pts)'
            ref: r(dabble_trading.margin_variance_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#DDD8EA'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Gross Win % (realised)'
            ref: r(dabble_trading.gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#28AC26'
            line_interpolation: 'smooth'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Expected Gross Win % (priced)'
            ref: r(dabble_trading.expected_gross_win_pct)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
