  view: TabLayout {
    tab executive_pulse: CanvasLayout {
      label: 'Executive Pulse'
      width: 1300
      height: 820
      grid_size: 10
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
      block header_executive_pulse {
        position: pos(0, 0, 1300, 110)
      }
      block reporting_date_filter {
        position: pos(20, 130, 300, 70)
      }
      block date_drill {
        position: pos(340, 130, 190, 70)
      }
      block period_comparison {
        position: pos(550, 130, 190, 70)
      }
      block sport_filter {
        position: pos(760, 130, 300, 70)
      }
      block kpi_actives {
        position: pos(20, 220, 200, 140)
      }
      block kpi_bets {
        position: pos(232, 220, 200, 140)
      }
      block kpi_stake {
        position: pos(444, 220, 200, 140)
      }
      block kpi_gross_win_pct {
        position: pos(656, 220, 200, 140)
      }
      block kpi_net_revenue {
        position: pos(868, 220, 200, 140)
      }
