  block stake_bet_type: VizBlock {
    label: 'Stake by Bet Type'
    viz: PieChart {
      dataset: dabble_trading
      legend: r(dabble_fact_bet.bet_type)
      series {
        field: r(dabble_trading.combined_stake)
      }
      settings {
        display_as_donut: true
        data_label_position: 'none'
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block margin_by_bet_legs: VizBlock {
    label: 'Margin by Bet Leg Count'
    viz: PivotTable {
      dataset: dabble_trading
      rows: [
        VizFieldFull {
          ref: r(dabble_fact_bet.leg_count)
          uname: 'dabble_fact_bet_leg_count'
        }
      ]
      columns: [
        r(dabble_fact_bet.bet_type)
      ]
      values: [
        VizFieldFull {
          ref: r(dabble_trading.actives)
          uname: 'custom_actives'
        },
        VizFieldFull {
          ref: r(dabble_trading.bets)
          uname: 'custom_bets'
        },
        VizFieldFull {
          ref: r(dabble_trading.combined_stake)
          uname: 'custom_combined_stake'
        },
        VizFieldFull {
          ref: r(dabble_trading.gross_win)
          uname: 'custom_gross_win'
        },
        VizFieldFull {
          ref: r(dabble_trading.gross_win_pct)
          uname: 'custom_gross_win_pct'
        }
      ]
      settings {
        wrap_header_text: true
        show_column_total: true
        conditional_formats: [
          ConditionalFormat {
            key: 'custom_gross_win'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#BF0E08'
              background_color: '#FAD2D1'
            }
          },
          ConditionalFormat {
            key: 'custom_gross_win'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#328159'
              background_color: '#B5E3CD'
            }
          },
          ConditionalFormat {
            key: 'custom_gross_win_pct'
            format: SingleFormat {
              condition {
                operator: 'less_than'
                value: 0
              }
              text_color: '#BF0E08'
              background_color: '#FAD2D1'
            }
          },
          ConditionalFormat {
            key: 'custom_gross_win_pct'
            format: SingleFormat {
              condition {
                operator: 'greater_than_equal'
                value: 0
              }
              text_color: '#328159'
              background_color: '#B5E3CD'
            }
          }
        ]
        row_limit: 500
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        column_styles: [
          ColumnStyle {
            key: 'dabble_fact_bet_leg_count'
            width: 113
          },
          ColumnStyle {
            key: 'custom_actives'
            width: 116
          },
          ColumnStyle {
            key: 'custom_bets'
            width: 98
          },
          ColumnStyle {
            key: 'custom_combined_stake'
            width: 157
          },
          ColumnStyle {
            key: 'custom_gross_win'
            width: 122
          },
          ColumnStyle {
            key: 'custom_gross_win_pct'
            width: 137
          }
        ]
      }
    }
  }
  block actives_state: VizBlock {
    label: 'Actives by State'
    viz: BarChart {
      dataset: dabble_trading
      x_axis: r(dabble_dim_user.home_state)
      y_axis {
        series {
          field: r(dabble_trading.actives)
        }
      }
      settings {
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block yoy_enhancement: VizBlock {
    label: 'Holistics-native Enhancement — Year-over-year Comparison'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_trading.combined_stake),
        r(dabble_trading.combined_stake_prior_year),
        r(dabble_trading.combined_stake_yoy_pct),
        r(dabble_trading.trading_net_revenue),
        r(dabble_trading.trading_net_revenue_prior_year),
        r(dabble_trading.trading_net_revenue_yoy_pct)
      ]
      settings {
        wrap_header_text: true
      }
    }
  }
  block about_sample: TextBlock {
    content: @md <div style="border-left:6px solid #5C3BC4;padding:12px 18px;background:#FFFFFF;"><h2 style="color:#21099B;">About this sample</h2><p>This prototype uses deterministic synthetic data and contains no direct customer PII. Source user IDs and aliases are generated. Financial measures are allocated to bet legs so sport and event totals remain additive. Restricted stake, weighted dividend, Rocket categories, active users, Australian settled reporting date and period comparisons are explicitly demo assumptions pending Dabble confirmation.</p></div>;;
  }

