  view: TabLayout {
    tab au_kpi_overview: CanvasLayout {
      label: 'AU - KPI Overview'
      width: 1300
      height: 4250
      grid_size: 10
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
      block hero_header_with_logo {
        position: pos(20, 20, 1260, 160)
      }
      block reporting_date_filter {
        position: pos(20, 200, 400, 80)
      }
      block overview_disclaimer {
        position: pos(440, 200, 840, 80)
      }
