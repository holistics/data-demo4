  block customers_profitable: VizBlock {
    label: 'Top Most Profitable Customers'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_dim_user.source_user_id),
        r(dabble_dim_user.display_alias),
        r(dabble_trading.bets),
        r(dabble_trading.combined_stake),
        VizFieldFull {
          ref: r(dabble_trading.trading_net_revenue)
          uname: 'profit'
        }
      ]
      settings {
        wrap_header_text: true
        row_limit: 10
        sorts: [
          SortSetting {
            key: 'profit'
            direction: 'desc'
          }
        ]
      }
    }
  }
  block customers_least_profitable: VizBlock {
    label: 'Top Least Profitable Customers'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_dim_user.source_user_id),
        r(dabble_dim_user.display_alias),
        r(dabble_trading.bets),
        r(dabble_trading.combined_stake),
        VizFieldFull {
          ref: r(dabble_trading.trading_net_revenue)
          uname: 'profit'
        }
      ]
      settings {
        wrap_header_text: true
        row_limit: 10
        sorts: [
          SortSetting {
            key: 'profit'
            direction: 'asc'
          }
        ]
      }
    }
  }

