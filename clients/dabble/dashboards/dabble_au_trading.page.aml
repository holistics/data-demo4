Dashboard dabble_au_trading_kpi_prototype {
  title: 'Dabble AU Trading KPI Prototype'
  description: 'Privacy-safe synthetic prototype reproducing the supplied AU Trading KPI and Sport Overview report structure. Financials use allocated bet-leg grain; metric semantics are demo assumptions pending Dabble confirmation.'
  theme: dabble_light

  block reporting_date_filter: FilterBlock {
    label: 'Reporting Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_fact_bet.reporting_date)
    }
    default {
      operator: 'matches'
      value: 'last 2 years to today'
    }
  }
  block fixture_start_filter: FilterBlock {
    label: 'Fixture Start'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_fixture.advertised_start)
    }
    default {
      operator: 'matches'
      value: 'last 2 years to today'
    }
  }
  block sport_filter: FilterBlock {
    label: 'Sport'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_sport.sport_name)
    }
    default {
      operator: 'is'
      value: []
    }
  }
  block competition_filter: FilterBlock {
    label: 'Competition'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_competition.competition_name)
    }
    default {
      operator: 'is'
      value: []
    }
  }
  block fixture_filter: FilterBlock {
    label: 'Fixture'
    type: 'field'
    source: FieldFilterSource {
      dataset: dabble_trading
      field: r(dabble_dim_fixture.fixture_name)
    }
    default {
      operator: 'is'
      value: []
    }
  }

  block overview_disclaimer: TextBlock {
    content: @md <div style="border-left:6px solid #5C3BC4;padding:10px 16px;background:#EEE9FA;"><strong>Conversation prototype</strong> — all values and customer aliases are synthetic. Metric definitions are assumptions to confirm with Dabble.</div>;;
  }
  block sport_disclaimer: TextBlock {
    content: @md <div style="border-left:6px solid #5C3BC4;padding:10px 16px;background:#EEE9FA;"><strong>Sport Overview</strong> — allocated bet-leg financials make sport, fixture and market totals additive. Risk and dividend semantics are demo assumptions.</div>;;
  }

  block trading_summary: VizBlock {
    label: 'Trading Summary'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_trading.actives),
        r(dabble_trading.bets),
        r(dabble_trading.combined_stake),
        r(dabble_trading.gross_win),
        r(dabble_trading.gross_win_pct)
      ]
      settings {
        wrap_header_text: true
      }
    }
  }
  block racing_summary: VizBlock {
    label: 'Racing Summary'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_trading.racing_actives),
        r(dabble_trading.racing_bets),
        r(dabble_trading.racing_combined_stake),
        r(dabble_trading.racing_gross_win),
        r(dabble_trading.racing_gross_win_pct)
      ]
      settings {
        wrap_header_text: true
      }
    }
  }
  block sport_summary: VizBlock {
    label: 'Sport Summary'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_trading.sport_actives),
        r(dabble_trading.sport_bets),
        r(dabble_trading.sport_combined_stake),
        r(dabble_trading.sport_gross_win),
        r(dabble_trading.sport_gross_win_pct)
      ]
      settings {
        wrap_header_text: true
      }
    }
  }
  block copy_summary: VizBlock {
    label: 'Copy / Rocket Summary'
    viz: DataTable {
      dataset: dabble_trading
      fields: [
        r(dabble_trading.copy_actives),
        r(dabble_trading.copy_bets),
        r(dabble_trading.copy_combined_stake),
        r(dabble_trading.copy_rocket_boost),
        r(dabble_trading.copy_gross_win_pct)
      ]
      settings {
        wrap_header_text: true
      }
    }
  }

