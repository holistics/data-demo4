Model dabble_dim_sport {
  type: 'table'
  label: 'Sports'
  data_source_name: 'dabble_neon'
  table_name: '"dabble_demo"."dim_sport"'

  dimension sport_id {
    label: 'Sport ID'
    type: 'number'
    primary_key: true
    hidden: true
    definition: @sql {{ #SOURCE.sport_id }};;
  }
  dimension source_sport_id {
    label: 'Source Sport ID'
    type: 'text'
    hidden: true
    definition: @sql {{ #SOURCE.source_sport_id }};;
  }
  dimension sport_name {
    label: 'Sport'
    type: 'text'
    definition: @sql {{ #SOURCE.sport_name }};;
  }
  dimension is_racing {
    label: 'Is Racing'
    type: 'truefalse'
    hidden: true
    definition: @sql {{ #SOURCE.is_racing }};;
    description: 'Demo classification used to separate racing and sport summaries. Hidden from reporting because the raw boolean renders as true/false; use Sport Category instead.'
  }
  dimension sport_category {
    label: 'Sport Category'
    type: 'text'
    definition: @sql case when {{ #SOURCE.is_racing }} then 'Racing' else 'Sport' end;;
    description: 'Reporting-friendly label for the racing/sport split. Use this wherever the split is shown to a user.'
  }
}
