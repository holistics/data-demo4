// This is a library dashboard block. For more details, visit https://docs.holistics.io/docs/canvas-dashboard/guides/build-library-blocks
// Branded page header for the Dabble AU dashboards.
//   - Dabble wordmark embedded as base64 so the block is self-contained and does
//     not depend on dabble.com being reachable from the customer tenant.
//     Source: Dabble primary wordmark, white on brand purple #7742FF, alpha-cut
//     so it sits on the gradient band rather than on a purple rectangle.
//   - Brand purple gradient band (#180666 -> #21099B -> #7742FF) matching the
//     dabble_light page theme in clients/dabble/dabble.theme.aml.
//   - Sits full-bleed at the top of every tab, so the block theme is stripped
//     back to transparent with no padding, border or shadow.
@template(
  title='Dabble - Page Header',
  description='Branded page header: Dabble wordmark, tab title, subtitle and a status pill.',
  thumbnail='',
  metadata={
    group: 'Dabble'
    block_width: 1300
    block_height: 110
  }
)
Func block_dabble_page_header(
  tab_title: String = 'Dashboard',
  tab_subtitle: String = '',
  status_pill: String = 'AU Book',
) {
  TextBlock {
    content: @md <div style="display:flex; align-items:center; justify-content:space-between; gap:24px; height:100%; width:100%; box-sizing:border-box; padding:0 28px; border-radius:0 0 16px 16px; background:linear-gradient(100deg, #180666 0%, #21099B 46%, #7742FF 100%); font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;">
  <div style="display:flex; align-items:center; gap:20px; min-width:0;">
    <img src="data:image/png;base64," alt="Dabble" style="height:34px; width:auto; display:block; flex:0 0 auto;" />
    <span style="display:block; flex:0 0 auto; width:1px; height:40px; background:rgba(255,255,255,0.28);"></span>
    <div style="min-width:0;">
      <div style="color:#FFFFFF; font-size:20px; font-weight:700; letter-spacing:-0.2px; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${tab_title}</div>
      <div style="color:rgba(255,255,255,0.72); font-size:12.5px; font-weight:400; line-height:1.4; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${tab_subtitle}</div>
    </div>
  </div>
  <div style="flex:0 0 auto; text-align:right;">
    <span style="display:inline-block; padding:4px 12px; border:1px solid rgba(255,255,255,0.34); border-radius:999px; color:#FFFFFF; font-size:11px; font-weight:600; letter-spacing:0.06em; text-transform:uppercase;">${status_pill}</span>
    <div style="color:rgba(255,255,255,0.62); font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase; margin-top:7px;">Trading Performance &middot; Synthetic Data</div>
  </div>
</div>;;
    theme: BlockTheme {
      padding: 0
      background {
        bg_color: 'transparent'
      }
      border {
        border_color: 'transparent'
        border_width: '0px'
        border_radius: 0
      }
      shadow: 'none'
    }
  }
}
