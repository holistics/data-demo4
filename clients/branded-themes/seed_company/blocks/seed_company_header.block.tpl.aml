// This is a library dashboard block. For more details, visit https://docs.holistics.io/docs/canvas-dashboard/guides/build-library-blocks
// Branded dashboard header for Seed Company.
//   - Eyebrow / subtitle in Red Hat Mono, uppercase + tracked, mirroring the
//     small page furniture in the 2026 Brand Guide.
//   - Title in Gotham (Montserrat web fallback), Black #323232.
//   - Primary logo embedded as base64 so the block is self-contained and does
//     not depend on seedcompany.com being reachable from the customer tenant.
//     Source: 2026-Seed-Company-logo-primary-web-1024x164.png
// Sits on the white card supplied by `theme: seed_company`.
@template(
  title='Seed Company - Dashboard Header',
  description='Branded dashboard header: title, eyebrow line and Seed Company logo.',
  thumbnail='',
  metadata={
    group: 'Seed Company'
    block_width: 1400
    block_height: 110
  }
)
Func block_seed_company_header(dashboard_title: String, dashboard_subtitle: String) {
  TextBlock {
    content: @md <div style="display:flex; justify-content:space-between; align-items:center; height:100%; width:100%; padding:0 8px; box-sizing:border-box;">
  <div style="display:flex; flex-direction:column; justify-content:center; gap:6px;">
    <span style="font-family:'Red Hat Mono', ui-monospace, Menlo, monospace; font-size:11px; font-weight:500; letter-spacing:0.14em; text-transform:uppercase; color:#636466;">${dashboard_subtitle}</span>
    <span style="font-family:Gotham, Montserrat, 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:34px; font-weight:700; line-height:1.05; color:#323232;">${dashboard_title}</span>
  </div>
  <img src="data:image/png;base64," alt="Seed Company" style="margin:0 !important; display:block; height:32px !important; width:auto !important;"/>
</div>;;
  }
}
