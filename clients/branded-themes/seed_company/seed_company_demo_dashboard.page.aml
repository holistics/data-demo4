// =====================================================================
// Seed Company — SAMPLE DASHBOARD
// Demonstrates the seed_company theme + branded header/footer on real data.
// Built on `demo_ecommerce_version_2` because it is the demo dataset with a
// continent dimension, which is what lets the regional brand palette show.
// When this goes into Seed Company's own tenant, swap the dataset and field
// refs; the theme, header and footer carry over untouched.
//
// Note on colour: this page uses the default `seed_company_palette`. If a
// chart breaks down specifically BY WORLD REGION, switch the theme's
// `color.data` to `seed_company_regions_palette` so each region keeps its own
// brand colour (Africa=Sun, Americas=Forest, Asia=Coral, EU&ME=Dusk,
// Pacific=Sea) consistently across every dashboard.
// =====================================================================
Dashboard seed_company_demo_dashboard {
  title: 'Seed Company — Portfolio Overview (Sample)'
  description: 'Sample dashboard showing the Seed Company brand theme, header and footer.'
  theme: seed_company

  block t_header: block_seed_company_header(
    'Portfolio Overview',
    'Sample - FY2026 - updated daily'
  )

  block kpi_gmv: VizBlock {
    label: 'Total Funding'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(demo_ecommerce_version_2.gmv)
        label: 'Total Funding'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Engagements'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(demo_ecommerce_version_2.total_orders)
        label: 'Engagements'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_users: VizBlock {
    label: 'Partner Contacts'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(demo_ecommerce_version_2.total_users)
        label: 'Partner Contacts'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_aov: VizBlock {
    label: 'Avg per Engagement'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(demo_ecommerce_version_2.aov)
        label: 'Avg per Engagement'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block v_by_region: VizBlock {
    label: 'Funding by Region'
    viz: PieChart {
      dataset: demo_ecommerce_version_2
      legend: VizFieldFull {
        ref: r(ecommerce_countries.continent_name)
        label: 'Region'
      }
      series {
        field: VizFieldFull {
          ref: r(demo_ecommerce_version_2.gmv)
          label: 'Funding'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      }
      settings {
        display_as_donut: true
        legend_label: 'right'
        show_data_label: true
        show_percentage: true
        data_label_position: 'outside'
        row_limit: 5000
      }
    }
  }

  block v_trend: VizBlock {
    label: 'Funding Trend by Month'
    viz: ColumnChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        ref: r(ecommerce_orders.created_at)
        transformation: 'datetrunc month'
        label: 'Month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(demo_ecommerce_version_2.gmv)
            label: 'Funding'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color_palette: 0
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
      }
    }
  }

  block v_top_countries: VizBlock {
    label: 'Top Countries by Net Funding'
    viz: BarChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        ref: r(ecommerce_countries.name)
        label: 'Country'
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(demo_ecommerce_version_2.nmv)
            label: 'Net Funding'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color_palette: 1
          }
        }
      }
      settings {
        row_limit: 10
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
      }
    }
  }

  block v_detail: VizBlock {
    label: 'Regional Detail'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      fields: [
        VizFieldFull {
          ref: r(ecommerce_countries.continent_name)
          label: 'Region'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_countries.name)
          label: 'Country'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.gmv)
          label: 'Funding'
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_orders)
          label: 'Engagements'
          format {
            type: 'number'
            pattern: '#,##0'
          }
        }
      ]
      settings {
        row_limit: 500
        show_row_number: false
      }
    }
  }

  block t_footer: block_seed_company_footer(
    'Sample data - demo_ecommerce_version_2',
    'Data Analytics'
  )

  view: CanvasLayout {
    label: 'View 1'
    width: 1400
    height: 1140
    grid_size: 20
    block t_header {
      position: pos(0, 0, 1400, 110)
    }
    block kpi_gmv {
      position: pos(0, 130, 320, 120)
    }
    block kpi_orders {
      position: pos(360, 130, 320, 120)
    }
    block kpi_users {
      position: pos(720, 130, 320, 120)
    }
    block kpi_aov {
      position: pos(1080, 130, 320, 120)
    }
    block v_by_region {
      position: pos(0, 270, 460, 380)
    }
    block v_trend {
      position: pos(480, 270, 920, 380)
    }
    block v_top_countries {
      position: pos(0, 670, 690, 360)
    }
    block v_detail {
      position: pos(710, 670, 690, 360)
    }
    block t_footer {
      position: pos(0, 1050, 1400, 60)
    }
    mobile {
      mode: 'auto'
    }
  }
}
