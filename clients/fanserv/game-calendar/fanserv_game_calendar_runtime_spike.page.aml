// DISPOSABLE RUNTIME HARNESS — Canvas-only evidence, not a customer dashboard.
Dashboard fanserv_game_calendar_runtime_spike {
  title: '[DISPOSABLE SPIKE] FanServ Game Calendar Runtime'
  description: '''
Temporary Canvas runtime checks for native filters, a seven-column Dynamic Content calendar,
h-drill, CSS-only interaction, reduced motion, and no-JS rendering. Uses imported FanServ CSV extracts.
GamePulse is a directional score, not an impression forecast, and is Not scored when absent.
'''

  block spike_filter_date: FilterBlock {
    label: 'Game Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: fanserv_game_calendar_mock
      field: r(fanserv_mock_games.game_date)
    }
  }

  block spike_filter_league: FilterBlock {
    label: 'League'
    type: 'field'
    source: FieldFilterSource {
      dataset: fanserv_game_calendar_mock
      field: r(fanserv_mock_games.league_code)
    }
  }

  block spike_filter_team: FilterBlock {
    label: 'Team'
    type: 'field'
    source: FieldFilterSource {
      dataset: fanserv_game_calendar_mock
      field: r(fanserv_game_team_bridge.team_name)
    }
  }

  block spike_filter_game: FilterBlock {
    label: 'Game'
    type: 'field'
    source: FieldFilterSource {
      dataset: fanserv_game_calendar_mock
      field: r(fanserv_mock_games.game_selector_label)
    }
  }

  block spike_game_cards: VizBlock {
    label: 'Dynamic Content runtime probe'
    viz: MarkdownViz {
      dataset: fanserv_game_calendar_mock
      filter {
        field: r(fanserv_game_calendar_mock.day_game_order)
        operator: 'less_than'
        value: 3
      }
      rows: [
        VizFieldFull {
          label: 'Game ID'
          ref: r(fanserv_mock_games.game_id)
          format {
            type: 'text'
          }
          uname: 'spike_card_game_id'
        },
        VizFieldFull {
          label: 'Game Date'
          ref: r(fanserv_mock_games.game_date)
          format {
            type: 'date'
            pattern: 'dd LLL yyyy'
          }
          uname: 'spike_card_game_date'
        },
        VizFieldFull {
          label: 'Sort Key'
          ref: r(fanserv_mock_games.deterministic_sort_key)
          uname: 'spike_card_sort'
          hidden: true
        },
        VizFieldFull {
          label: 'Grid Column'
          ref: r(fanserv_mock_games.board_grid_column)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'Grid Row'
          ref: r(fanserv_mock_games.board_grid_row)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'League'
          ref: r(fanserv_mock_games.league_code)
          format {
            type: 'text'
          }
          uname: 'spike_card_league'
        },
        VizFieldFull {
          label: 'Away Code'
          ref: r(fanserv_mock_games.away_team_code)
        },
        VizFieldFull {
          label: 'Away Logo'
          ref: r(fanserv_mock_games.away_team_logo_url)
        },
        VizFieldFull {
          label: 'Home Code'
          ref: r(fanserv_mock_games.home_team_code)
        },
        VizFieldFull {
          label: 'Home Logo'
          ref: r(fanserv_mock_games.home_team_logo_url)
        },
        VizFieldFull {
          label: 'Matchup'
          ref: r(fanserv_mock_games.matchup_label)
          format {
            type: 'text'
          }
          uname: 'spike_card_matchup'
        },
        VizFieldFull {
          label: 'Status'
          ref: r(fanserv_mock_games.status)
          format {
            type: 'text'
          }
          uname: 'spike_card_status'
        },
        VizFieldFull {
          label: 'GamePulse'
          ref: r(fanserv_mock_games.gamepulse_band)
          format {
            type: 'text'
          }
          uname: 'spike_card_gamepulse_band'
        },
        VizFieldFull {
          label: 'Primary Network'
          ref: r(fanserv_mock_games.primary_network)
          format {
            type: 'text'
          }
          uname: 'spike_card_primary_network'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Day Order'
          ref: r(fanserv_game_calendar_mock.day_game_order)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'Day Count'
          ref: r(fanserv_game_calendar_mock.day_game_count)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        },
        VizFieldFull {
          label: 'Overflow'
          ref: r(fanserv_game_calendar_mock.day_game_overflow_count)
          format {
            type: 'number'
            pattern: '#,##0'
          }
        }
      ]
      content: @md
<style>
  .fs-rt-card-scroll {
    inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .fs-rt-card-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: 2.25rem repeat(6, 7.25rem);
    gap: 0.5rem;
    min-inline-size: 70rem;
    padding: 0.5rem;
    border: 1px solid #C8D5CF;
    border-radius: 0.75rem;
    background: #F7FAF8;
  }

  .fs-rt-weekday {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: #E7F3EC;
    color: #005249;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fs-rt-card-grid h-drill {
    display: block;
    min-inline-size: 0;
    align-self: start;
  }

  .fs-rt-card-grid h-drill.week-1 { grid-row: 2; }
  .fs-rt-card-grid h-drill.week-2 { grid-row: 3; }
  .fs-rt-card-grid h-drill.week-3 { grid-row: 4; }
  .fs-rt-card-grid h-drill.week-4 { grid-row: 5; }
  .fs-rt-card-grid h-drill.week-5 { grid-row: 6; }
  .fs-rt-card-grid h-drill.week-6 { grid-row: 7; }
  .fs-rt-card-grid h-drill.rank-2 { margin-block-start: 5rem; }
  .fs-rt-card-grid h-drill:not(.rank-1):not(.rank-2) { display: none; }

  .fs-rt-card {
    box-sizing: border-box;
    block-size: 4.75rem;
    inline-size: 100%;
    min-inline-size: 0;
    padding: 0.375rem 0.5rem;
    border: 1px solid #C8D5CF;
    border-radius: 0.625rem;
    background: #FFFFFF;
    color: #12332E;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .fs-rt-card:hover {
    border-color: #00AB55;
    transform: translateY(-0.125rem);
  }

  .h-drill-selected.fs-rt-card {
    border-color: #005249;
    outline: 0.1875rem solid #C8FACD;
    outline-offset: 0.125rem;
  }

  .fs-rt-card-head,
  .fs-rt-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .fs-rt-card-head {
    font-size: 0.625rem;
    font-weight: 700;
    color: #516A65;
  }

  .fs-rt-card-match {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-block-start: 0.25rem;
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .fs-rt-team {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .fs-rt-team span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fs-rt-logo {
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
    object-fit: contain;
  }

  .fs-rt-logo[src=""] {
    display: none;
  }

  .fs-rt-vs {
    flex: none;
    color: #6C7F74;
  }

  .fs-rt-card-foot {
    margin-block-start: 0.25rem;
    color: #365B54;
    font-size: 0.5625rem;
  }

  .fs-rt-card-head span,
  .fs-rt-card-foot span {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fs-rt-overflow {
    display: none;
    inline-size: 100%;
    min-block-size: 1.75rem;
    border: 1px dashed #84A9FF;
    border-radius: 0.5rem;
    background: #F2F6FF;
    color: #1939B7;
    cursor: pointer;
    font: inherit;
    font-size: 0.625rem;
    font-weight: 800;
  }

  .fs-rt-card-grid h-drill.rank-2 .fs-rt-card { display: none; }
  .fs-rt-card-grid h-drill.rank-2 .fs-rt-overflow { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .fs-rt-card {
      transition: none;
    }

    .fs-rt-card:hover {
      transform: none;
    }
  }
</style>

<div class="fs-rt-card-scroll" role="region" aria-label="Six-week game calendar. Scroll horizontally on narrow screens." tabindex="0">
<div class="fs-rt-card-grid">
<div class="fs-rt-weekday" style="grid-column:1;grid-row:1">Mon</div>
<div class="fs-rt-weekday" style="grid-column:2;grid-row:1">Tue</div>
<div class="fs-rt-weekday" style="grid-column:3;grid-row:1">Wed</div>
<div class="fs-rt-weekday" style="grid-column:4;grid-row:1">Thu</div>
<div class="fs-rt-weekday" style="grid-column:5;grid-row:1">Fri</div>
<div class="fs-rt-weekday" style="grid-column:6;grid-row:1">Sat</div>
<div class="fs-rt-weekday" style="grid-column:7;grid-row:1">Sun</div>
{% map(rows) %}
  <h-drill row="0" value="{{ `Game ID`.raw }}" class="week-{{ `Grid Row`.formatted }} rank-{{ values.`Day Order`.formatted }}" style="grid-column:{{ `Grid Column`.formatted }};">
    <button type="button" class="fs-rt-card" aria-label="Select {{ `Matchup`.raw }} on {{ `Game Date`.formatted }}. GamePulse {{ `GamePulse`.formatted }}.">
      <div class="fs-rt-card-head">
        <span>{{ `League`.formatted }} · {{ `Game Date`.formatted }}</span>
        <span>{{ `Status`.formatted }}</span>
      </div>
      <div class="fs-rt-card-match">
        <span class="fs-rt-team"><img class="fs-rt-logo" src="{{ `Away Logo`.raw }}" alt="" width="16" height="16" loading="lazy" decoding="async"><span>{{ `Away Code`.formatted }}</span></span>
        <span class="fs-rt-vs" aria-hidden="true">@</span>
        <span class="fs-rt-team"><img class="fs-rt-logo" src="{{ `Home Logo`.raw }}" alt="" width="16" height="16" loading="lazy" decoding="async"><span>{{ `Home Code`.formatted }}</span></span>
      </div>
      <div class="fs-rt-card-foot">
        <span>GamePulse · {{ `GamePulse`.formatted }}</span>
        <span>{{ `Primary Network`.formatted }}</span>
      </div>
    </button>
    <button type="button" class="fs-rt-overflow" aria-label="Select the next listed game on {{ `Game Date`.formatted }}">+{{ values.`Overflow`.formatted }} more · select</button>
  </h-drill>
{% end %}
</div>
</div>
      ;;
      settings {
        sorts: [
          SortSetting {
            key: 'spike_card_game_date'
            direction: 'asc'
          },
          SortSetting {
            key: 'spike_card_sort'
            direction: 'asc'
          },
          SortSetting {
            key: 'spike_card_game_id'
            direction: 'asc'
          }
        ]
        pagination_size: 84
        row_limit: 84
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
      hide_controls: true
    }
  }

  block spike_game_audit_table: VizBlock {
    label: 'Filter propagation audit table'
    viz: DataTable {
      dataset: fanserv_game_calendar_mock
      fields: [
        VizFieldFull {
          label: 'Game Date'
          ref: r(fanserv_mock_games.game_date)
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
          uname: 'spike_table_game_date'
        },
        VizFieldFull {
          label: 'Game'
          ref: r(fanserv_mock_games.matchup_label)
          format {
            type: 'text'
          }
          uname: 'spike_table_matchup'
        },
        VizFieldFull {
          label: 'Status'
          ref: r(fanserv_mock_games.status)
          format {
            type: 'text'
          }
          uname: 'spike_table_status'
        },
        VizFieldFull {
          label: 'GamePulse'
          ref: r(fanserv_mock_games.gamepulse_score)
          format {
            type: 'number'
            pattern: '#,##0'
          }
          uname: 'spike_table_gamepulse_score'
        }
      ]
      settings {
        pagination_size: 20
        sorts: [
          SortSetting {
            key: 'spike_table_game_date'
            direction: 'asc'
          },
          SortSetting {
            key: 'spike_table_matchup'
            direction: 'asc'
          }
        ]
        row_limit: 20
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }

  // Cloud runtime gate, 2026-07-16: demo4's Development compiler reports
  // "Cannot find type 'HTMLLayout'". Keep this Canvas fallback disposable: it
  // proves the independent block primitives without pretending h-block works.
  block spike_canvas_shell: TextBlock {
    content: @md
<style>
  .fs-rt-spike {
    --fs-rt-green: #00AB55;
    --fs-rt-green-dark: #005249;
    --fs-rt-green-tint: #C8FACD;
    --fs-rt-blue: #3366FF;
    --fs-rt-ink: #12332E;
    --fs-rt-muted: #516A65;
    --fs-rt-rule: #C8D5CF;
    max-inline-size: 90rem;
    margin-inline: auto;
    padding: 1.25rem;
    color: var(--fs-rt-ink);
    font-family: Inter, Manrope, system-ui, sans-serif;
  }

  .fs-rt-spike header,
  .fs-rt-spike section,
  .fs-rt-spike aside {
    box-sizing: border-box;
  }

  .fs-rt-spike-header {
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: var(--fs-rt-green-dark);
    color: #FFFFFF;
  }

  .fs-rt-spike-header h1 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .fs-rt-spike-header p {
    max-inline-size: 72ch;
    margin: 0.625rem 0 0;
    line-height: 1.5;
  }

  .fs-rt-spike-disposable {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.75rem;
    margin-block-end: 0.75rem;
    padding-inline: 0.625rem;
    border: 1px solid #FFFFFF;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .fs-rt-checks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1rem;
  }

  .fs-rt-check {
    min-block-size: 8.5rem;
    padding: 0.875rem;
    border: 1px solid var(--fs-rt-rule);
    border-radius: 0.625rem;
    background: #FFFFFF;
  }

  .fs-rt-check strong {
    display: block;
    margin-block-end: 0.25rem;
  }

  .fs-rt-check p,
  .fs-rt-target-probe p {
    margin: 0;
    color: var(--fs-rt-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .fs-rt-probe-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    margin-block-start: 1rem;
  }

  .fs-rt-target-probe {
    min-block-size: 7rem;
    margin: 0;
    padding: 1rem;
    border: 2px dashed var(--fs-rt-blue);
    border-radius: 0.625rem;
    background: #F2F6FF;
  }

  .fs-rt-target-probe:target {
    border-style: solid;
    border-color: var(--fs-rt-green-dark);
    background: var(--fs-rt-green-tint);
  }

  .fs-rt-target-active {
    display: none;
  }

  .fs-rt-target-probe:target .fs-rt-target-idle {
    display: none;
  }

  .fs-rt-target-probe:target .fs-rt-target-active {
    display: inline;
  }

  .fs-rt-target-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  .fs-rt-target-links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2rem;
    padding-inline: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    color: var(--fs-rt-green-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .fs-rt-target-links a:focus-visible {
    outline: 0.1875rem solid var(--fs-rt-blue);
    outline-offset: 0.125rem;
  }

  .fs-rt-motion-marker {
    display: inline-block;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: 0.375rem;
    border-radius: 50%;
    background: var(--fs-rt-green);
    animation: fs-rt-spike-pulse 900ms ease-in-out infinite alternate;
  }

  @keyframes fs-rt-spike-pulse {
    from {
      opacity: 0.35;
      transform: scale(0.75);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .fs-rt-shell-check {
    min-block-size: 7rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--fs-rt-rule);
    border-radius: 0.625rem;
    background: #F7FAF8;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 64rem) {
    .fs-rt-checks,
    .fs-rt-probe-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 42rem) {
    .fs-rt-spike {
      padding: 0.75rem;
    }

    .fs-rt-checks,
    .fs-rt-probe-row {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-rt-motion-marker {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .fs-rt-target-links a {
      transition: none;
    }
  }
</style>

<main class="fs-rt-spike">
  <header class="fs-rt-spike-header">
    <div class="fs-rt-spike-disposable">TEST HARNESS · NOT CUSTOMER DASHBOARD</div>
    <h1>FanServ Game Calendar runtime checks</h1>
    <p>Imported FanServ schedule data. GamePulse is a directional score, not an impression forecast, and remains Not scored when absent. HTML Layout is unavailable on this tenant; this Canvas harness is not customer-facing product work.</p>
  </header>

  <section class="fs-rt-checks" aria-label="Runtime check instructions">
    <div class="fs-rt-check">
      <strong>PASS-CHECK · native filters</strong>
      <p>Clear filters between tests. A date must leave only that date. League, exact participating-team, and game selections must make cards and table agree. The Team filter must match either home or away. FAIL-CHECK: either block ignores a filter or the results disagree.</p>
    </div>
    <div class="fs-rt-check">
      <strong>PASS-CHECK · weekly grid + h-drill</strong>
      <p>The board must show Monday through Sunday across six week rows. Each date shows its first game and a visible +N more row when needed. Clicking either row must apply the selected outline and expose native drill behavior.</p>
    </div>
    <div class="fs-rt-check">
      <strong>PASS-CHECK · external logos</strong>
      <p>Source-provided team crests must load from the public CloudFront media host. Team codes remain visible when a logo URL is absent. FAIL-CHECK: CSP blocks the images, broken-image placeholders appear, or a missing logo removes the team label.</p>
    </div>
    <div class="fs-rt-check">
      <strong>PASS-CHECK · reduced motion</strong>
      <p><span class="fs-rt-motion-marker" aria-hidden="true"></span>The dot moves normally. Emulate “prefers reduced motion: reduce”; the dot and card hover transforms must stop while content remains visible. FAIL-CHECK: motion continues or content disappears.</p>
    </div>
  </section>

<div class="fs-rt-probe-row">
<section id="fs-rt-target-probe" class="fs-rt-target-probe" aria-live="polite">
<strong>PASS-CHECK · CSS :target — <span class="fs-rt-target-idle">standby</span><span class="fs-rt-target-active">target active</span></strong>
<p>Activate the fragment link. This panel must switch from dashed blue to solid green and say “target active”; Reset must restore standby. FAIL-CHECK: URL changes but the visual state does not.</p>
<nav class="fs-rt-target-links" aria-label="CSS target probe controls">
<a href="#fs-rt-target-probe">Activate :target</a>
<a href="#">Reset</a>
</nav>
</section>
<div class="fs-rt-shell-check">
<strong>LIMITATION · HTML Layout and signed embed</strong><br>
HTML Layout is not released on this tenant. This Canvas harness uses no custom JavaScript; layout sizing, reflow, and fragment behavior inside a signed embed remain outside this test.
</div>
</div>
</main>
    ;;
    theme {
      background {
        bg_color: 'transparent'
      }
      border {
        border_width: 0
      }
      padding: 0
      shadow: 'none'
    }
  }

  view: TabLayout {
    label: 'View 1'
    tab view_1: CanvasLayout {
      label: 'Tab 1'
      width: 1440
      height: 1980
      auto_expand_vertically: true
      block spike_canvas_shell {
        position: pos(0, 0, 1440, 610)
      }
      block spike_filter_date {
        position: pos(20, 620, 340, 100)
        layer: 1
      }
      block spike_filter_league {
        position: pos(380, 620, 340, 100)
        layer: 1
      }
      block spike_filter_team {
        position: pos(730, 620, 340, 100)
        layer: 1
      }
      block spike_filter_game {
        position: pos(1090, 620, 340, 100)
        layer: 1
      }
      block spike_game_cards {
        position: pos(20, 750, 1400, 820)
        layer: 1
      }
      block spike_game_audit_table {
        position: pos(20, 1600, 1400, 360)
        layer: 1
      }
      mobile {
        mode: 'none'
      }
      default_zoom: 0.8
    }
    tab tab_ifup: CanvasLayout {
      label: 'Tab 2'
      width: 1300
      height: 800
      grid_size: 20
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
    }
  }
}
