// Toast item and kitchen metrics for the Scorecard Operating tab (top sellers,
// campaigns, Average Fulfillment Time). Kept apart from maman_toast_metrics
// because the weekly sales dataset does not carry these models. Needs
// maman_toast_fact_order_selections and maman_toast_kitchen_coverage_daily.
PartialDataset maman_toast_operations_metrics {
  metric toast_item_units {
    label: 'Toast Item Units'
    type: 'number'
    description: 'Units sold on primary (non-modifier), non-voided item lines. Use for top sellers and campaign units, by Item Name or Sales Category.'
    definition: @aql sum(maman_toast_fact_order_selections.quantity) | where(maman_toast_fact_order_selections.is_primary_item == true, maman_toast_fact_order_selections.is_voided == false);;
  }
  metric toast_item_sales {
    label: 'Toast Item Sales'
    type: 'number'
    description: 'Item-line sales in USD: line price after discounts on primary, non-voided item lines. Not the check-level Toast Net Sales KPI, so the totals do not tie exactly.'
    definition: @aql sum(maman_toast_fact_order_selections.price) | where(maman_toast_fact_order_selections.is_primary_item == true, maman_toast_fact_order_selections.is_voided == false);;
  }
  metric toast_kitchen_tickets_covered {
    label: 'Kitchen Tickets (covered days)'
    type: 'number'
    description: 'Kitchen tickets on COVERED store-days only. Denominator of Average Fulfillment Time.'
    definition: @aql sum(maman_toast_kitchen_coverage_daily.kitchen_ticket_count) | where(maman_toast_kitchen_coverage_daily.coverage_status == 'COVERED');;
  }
  metric toast_avg_fulfillment_seconds {
    label: 'Average Fulfillment Time (seconds)'
    type: 'number'
    description: 'Kitchen fulfillment seconds / kitchen tickets, COVERED store-days only, in seconds (the Scorecard shows 7m 18s). Kitchen-station time, not the full order-to-guest time. For period comparisons the app should keep stores covered in both periods.'
    definition: @aql safe_divide(sum(maman_toast_kitchen_coverage_daily.total_fulfillment_seconds) | where(maman_toast_kitchen_coverage_daily.coverage_status == 'COVERED'), toast_kitchen_tickets_covered);;
  }
  metric toast_covered_store_days {
    label: 'Kitchen Covered Store-Days'
    type: 'number'
    description: 'Number of store-days with COVERED kitchen data. Use to check coverage before comparing fulfillment times.'
    definition: @aql count(maman_toast_kitchen_coverage_daily.business_date) | where(maman_toast_kitchen_coverage_daily.coverage_status == 'COVERED');;
  }
}
