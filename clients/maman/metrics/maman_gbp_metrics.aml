// Google Business Profile review metrics. Needs maman_gbp_agg_listing_daily
// and maman_gbp_fact_review_terms.
PartialDataset maman_gbp_metrics {
  metric gbp_reviews_received {
    label: 'Google Reviews Received'
    type: 'number'
    description: 'Google reviews posted in the range. Additive across days and stores.'
    definition: @aql sum(maman_gbp_agg_listing_daily.reviews_received);;
  }
  metric gbp_avg_rating_received {
    label: 'Google Average Rating (reviews received)'
    type: 'number'
    description: 'Average stars of reviews posted in the range: summed stars / reviews received. The Scorecard week rating.'
    definition: @aql safe_divide(sum(maman_gbp_agg_listing_daily.rating_sum_received), gbp_reviews_received);;
  }
  metric gbp_4_5_star_share {
    label: 'Google 4-5 Star Share'
    type: 'number'
    description: 'Share of reviews posted in the range with 4 or 5 stars: summed 4-5 star reviews / reviews received.'
    definition: @aql safe_divide(sum(maman_gbp_agg_listing_daily.reviews_4_5_star), gbp_reviews_received);;
  }
  metric gbp_total_reviews {
    label: 'Google Total Reviews (end of range)'
    type: 'number'
    description: 'Cumulative review count on the last day of the range (end of the selected week), summed across stores. Semi-additive: never summed over days.'
    definition: @aql sum(maman_gbp_agg_listing_daily.total_review_count) | where(maman_gbp_agg_listing_daily.date == max(maman_gbp_agg_listing_daily.date));;
  }
  metric gbp_overall_rating {
    label: 'Google Overall Rating (end of range)'
    type: 'number'
    description: 'Overall Google rating as of the last day of the range. For one store it is the listing rating; across stores it is weighted by each store’s total reviews. Semi-additive.'
    definition: @aql safe_divide(sum(maman_gbp_agg_listing_daily.overall_rating * maman_gbp_agg_listing_daily.total_review_count) | where(maman_gbp_agg_listing_daily.date == max(maman_gbp_agg_listing_daily.date)), gbp_total_reviews);;
  }
  metric gbp_low_star_reviews_mentioning {
    label: 'Low-Star Reviews Mentioning Term'
    type: 'number'
    description: 'Distinct 1 to 3 star reviews that mention a term. Group by Review Term to rank recurring complaints, normally over a trailing eight-week window.'
    definition: @aql count_distinct(maman_gbp_fact_review_terms.review_id);;
  }
}
