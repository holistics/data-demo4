Model maman_catalog_store_crosswalk {
  type: 'table'
  label: 'Store'
  description: 'Toast-anchored store crosswalk from the semantic catalog. One row per store or business line (about 78). It is the shared store dimension: every fact reaches it through its own source ID (Toast restaurant GUID, Harri location ID, MarginEdge unit ID, NetSuite location ID, Datarails store ID, Google listing ID). A NULL source ID means that source is unmatched for the store, so its figures show as missing, not zero.'
  data_source_name: 'demo_bigquery'
  table_name: 'maman_demo.catalog_store_crosswalk'

  dimension store_id { label: 'Store ID' type: 'text' primary_key: true definition: @sql {{ #SOURCE.store_id }};; description: 'Catalog store key, for example S001. Primary key; the forecast and closure tables join on it.' }
  dimension store_name { label: 'Store' type: 'text' definition: @sql {{ #SOURCE.store_name }};; description: 'Official store or business-line name, for example Maman 545 Madison. Use as the Scorecard location label.' }
  dimension short_name { label: 'Store Short Name' type: 'text' definition: @sql {{ #SOURCE.short_name }};; description: "Short store name Ryan uses in the weekly sales report, for example 545 Madison." }
  dimension store_format { label: 'Store Format' type: 'text' definition: @sql {{ #SOURCE.store_format }};; description: 'Business line: Cafe, Catering, Retail & E-Commerce, Mgmt Contract or Commissary. Ryan and the Finance tab exclude Mgmt Contract.' }
  dimension market { label: 'Market' type: 'text' definition: @sql {{ #SOURCE.market }};; description: 'Operating market: Manhattan, Tri-State, DMV, FL, NC, TX or Canada. The region grouping in Ryan’s report and the forecast bridge.' }
  dimension state { label: 'State' type: 'text' definition: @sql {{ #SOURCE.state }};; description: 'US state or Canadian province of the store.' }
  dimension timezone { label: 'Timezone' type: 'text' definition: @sql {{ #SOURCE.timezone }};; description: 'IANA timezone of the store, for example America/New_York. Toast business dates are already local; timestamps are UTC.' }
  dimension opening_date { label: 'Opening Date' type: 'date' definition: @sql {{ #SOURCE.opening_date }};; description: 'First trading date of the store. Drives the L4L rule (open 365 or more days before the week starts) and the opening cohort. A date after today means the store is not open yet.' }
  dimension closing_date { label: 'Closing Date' type: 'date' definition: @sql {{ #SOURCE.closing_date }};; description: 'Permanent closing date. NULL while the store is open. Temporary closures are in Store Closures.' }
  dimension is_finance_scope { label: 'Is Finance Scope' type: 'truefalse' definition: @sql {{ #SOURCE.is_finance_scope }};; description: 'True for Cafe, Catering and Retail & E-Commerce in the US. The Scorecard Finance tab and its All locations total use only these stores, so All locations is not the full US P&L.' }
  dimension trades_weekends { label: 'Trades Weekends' type: 'truefalse' definition: @sql {{ #SOURCE.trades_weekends }};; description: 'False for office-district cafes that close on Saturday and Sunday (for example 545 Madison). Their weekend sales share is 0% by design.' }
  dimension toast_restaurant_guid { label: 'Toast Restaurant GUID' type: 'text' hidden: true definition: @sql {{ #SOURCE.toast_restaurant_guid }};; description: 'Toast restaurant ID mapped to this store. Join key for all Toast facts. NULL when the store has no Toast match.' }
  dimension harri_location_id { label: 'Harri Location ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.harri_location_id }};; description: 'Harri location ID mapped to this store. Join key for Harri clocks, salaried cost and employees. NULL when unmatched.' }
  dimension marginedge_unit_id { label: 'MarginEdge Unit ID' type: 'text' hidden: true definition: @sql {{ #SOURCE.marginedge_unit_id }};; description: 'MarginEdge restaurant unit mapped to this store. Join key for MarginEdge invoices. NULL when unmatched.' }
  dimension netsuite_location_id { label: 'NetSuite Location ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.netsuite_location_id }};; description: 'NetSuite location mapped to this store. Join key for GL lines. NULL when unmatched; the Finance coverage table counts Toast stores without one.' }
  dimension datarails_store_id { label: 'Datarails Store ID' type: 'text' hidden: true definition: @sql {{ #SOURCE.datarails_store_id }};; description: 'Datarails store mapped to this store. Join key for Datarails monthly sales. NULL when unmatched.' }
  dimension gbp_listing_id { label: 'Google Listing ID' type: 'text' hidden: true definition: @sql {{ #SOURCE.gbp_listing_id }};; description: 'Google Business Profile listing mapped to this store. Join key for reviews. NULL when unmatched.' }
  dimension opening_cohort { label: 'Opening Cohort' type: 'text' definition: @sql CASE WHEN {{ #SOURCE.opening_date }} IS NULL THEN 'Unknown' WHEN {{ #SOURCE.opening_date }} < DATE '2025-01-01' THEN 'Pre-2025 opening' WHEN {{ #SOURCE.opening_date }} < DATE '2026-01-01' THEN '2025 opening' ELSE CONCAT(CAST(EXTRACT(YEAR FROM {{ #SOURCE.opening_date }}) AS STRING), ' opening') END;; description: "Store cohort by calendar year of opening: Pre-2025 opening, 2025 opening, 2026 opening and so on. Static, so it does not depend on the selected week. Ryan's bridge buckets (2025 NSOs, 2026 NSOs, NC, Not open) build on it in the app. Week-level L4L (open 365 or more days before the week starts) is a filter, Opening Date on or before Week Start Date minus 365 days, which the app computes for the selected week." }
}
