Model maman_gbp_fact_review_terms {
  type: 'table'
  label: 'Google Low-Star Review Terms'
  description: 'Recurring terms in 1 to 3 star Google reviews. One row per term per review. Rank terms by distinct reviews mentioning them, normally over a trailing eight-week window.'
  data_source_name: 'demo_bigquery'
  table_name: 'maman_demo.gbp_fact_review_terms'

  dimension review_id { label: 'Review ID' type: 'text' hidden: true definition: @sql {{ #SOURCE.review_id }};; description: 'Review that mentions the term. Count it distinct.' }
  dimension gbp_listing_id { label: 'Google Listing ID' type: 'text' hidden: true definition: @sql {{ #SOURCE.gbp_listing_id }};; description: 'Listing reviewed. Joins to Store through the crosswalk.' }
  dimension review_date { label: 'Term Review Date' type: 'date' definition: @sql {{ #SOURCE.review_date }};; description: 'Date of the review. Joins to the Fiscal Calendar.' }
  dimension star_rating { label: 'Term Star Rating' type: 'number' definition: @sql {{ #SOURCE.star_rating }};; description: 'Stars of the review, 1 to 3.' }
  dimension term { label: 'Review Term' type: 'text' definition: @sql {{ #SOURCE.term }};; description: 'Term found in the review, for example wait time or cold food.' }
}
