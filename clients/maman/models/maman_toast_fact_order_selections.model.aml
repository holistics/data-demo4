Model maman_toast_fact_order_selections {
  type: 'table'
  label: 'Toast Item Selections'
  description: 'Toast item lines. One row per item line or direct modifier. Source of item units and item sales for top sellers and campaigns. Item sales use the line price, not the check-level Toast Net Sales KPI, so the two do not tie exactly.'
  data_source_name: 'demo_bigquery'
  table_name: 'maman_demo.toast_fact_order_selections'

  dimension selection_guid { label: 'Selection GUID' type: 'text' primary_key: true hidden: true definition: @sql {{ #SOURCE.selection_guid }};; description: 'Toast selection ID. Primary key.' }
  dimension check_guid { label: 'Check GUID' type: 'text' hidden: true definition: @sql {{ #SOURCE.check_guid }};; description: 'Toast check the line belongs to.' }
  dimension order_guid { label: 'Order GUID' type: 'text' hidden: true definition: @sql {{ #SOURCE.order_guid }};; description: 'Toast order the line belongs to.' }
  dimension restaurant_guid { label: 'Toast Restaurant GUID' type: 'text' hidden: true definition: @sql {{ #SOURCE.restaurant_guid }};; description: 'Toast restaurant of the line. Joins to Store through the crosswalk.' }
  dimension business_date { label: 'Selection Business Date' type: 'date' definition: @sql {{ #SOURCE.business_date }};; description: 'Toast business date of the line. Joins to the Fiscal Calendar.' }
  dimension item_name { label: 'Item Name' type: 'text' definition: @sql {{ #SOURCE.item_name }};; description: 'Menu item name, lower case, for example classic chocolate chip cookie or latte. Campaign Items match on it.' }
  dimension menu_group { label: 'Menu Group' type: 'text' definition: @sql {{ #SOURCE.menu_group }};; description: 'Toast menu group of the item.' }
  dimension sales_category { label: 'Sales Category' type: 'text' definition: @sql {{ #SOURCE.sales_category }};; description: 'Food, NA Beverage, Retail or Catering. Top sellers rank Food and NA Beverage separately.' }
  dimension is_primary_item { label: 'Is Primary Item' type: 'truefalse' definition: @sql {{ #SOURCE.is_primary_item }};; description: 'True for the main item line, false for modifiers. Item units and item sales keep primary lines only.' }
  dimension quantity { label: 'Quantity (row)' type: 'number' hidden: true definition: @sql {{ #SOURCE.quantity }};; description: 'Units on the line.' }
  dimension price { label: 'Line Price ($, row)' type: 'number' hidden: true definition: @sql {{ #SOURCE.price }};; description: 'Line price in USD after discounts. Line prices on a check add up to about the check subtotal.' }
  dimension is_voided { label: 'Selection Is Voided' type: 'truefalse' definition: @sql {{ #SOURCE.is_voided }};; description: 'True when the line was voided. Voided lines are excluded from item metrics.' }
}
