// Ryan's weekly sales report: ERP actual vs forecast vs last year, and
// matched Toast traffic. Shares the models and the Toast and NetSuite metric
// partials with maman_store_scorecard; adds the weekly-sales partial.
//
// Join design matches the Scorecard: facts join Store through their own source
// ID and the Fiscal Calendar on their own date. The Toast metrics read the
// daily aggregate maman_toast_agg_store_daypart_daily; the Toast detail models
// stay for ad hoc questions. Extra relationships join GL lines, the Toast
// aggregate, Toast checks and Toast orders to calendar.ly_date. They are
// inactive, so default queries use the actual date; only the last-year metrics
// activate them (GL lines and the aggregate) with with_relationships().
// Datarails monthly sales has no date column; its model adds the fiscal period
// end date, so its rows join the calendar on the last day of each period.
// Store closures join Store only: list them with their own closed_from and
// closed_to dates, not calendar filters (calendar to closures has no direct
// join).
//
// A PartialDataset has no .extend(), so the chain starts from an anonymous
// Dataset that holds the models and joins, then adds each metric partial.
Dataset maman_weekly_sales = Dataset {
  label: 'Maman - Weekly Sales'
  description: "Ryan's weekly sales report dataset. ERP Actual Sales (NetSuite 4xxxx by transaction date), Forecast Sales, ERP Sales Last Year (same fiscal days, date - 364) and Toast orders, net sales, Events $ and average ticket, this year and last year. Group by Store Market, Format and Opening Cohort; select weeks with Fiscal Calendar fields. L4L (open 365 or more days before the week starts), closures and the other cohort rules are applied in the app. Management contracts are excluded by filtering Store Format."
  data_source_name: 'demo_bigquery'
  models: [
    maman_catalog_fiscal_calendar,
    maman_catalog_store_crosswalk,
    maman_catalog_store_closures,
    maman_planning_forecast_weekly,
    maman_toast_dim_restaurants,
    maman_toast_agg_store_daypart_daily,
    maman_toast_fact_orders,
    maman_toast_fact_order_checks,
    maman_netsuite_dim_accounts,
    maman_netsuite_dim_locations,
    maman_netsuite_dim_regions,
    maman_netsuite_fact_gl_lines,
    maman_datarails_dim_store,
    maman_datarails_fact_monthly_sales,
  ]
  relationships: [
    // Source dimensions hang off the crosswalk
    relationship(maman_catalog_store_crosswalk.toast_restaurant_guid - maman_toast_dim_restaurants.restaurant_guid, true),
    relationship(maman_catalog_store_crosswalk.netsuite_location_id - maman_netsuite_dim_locations.netsuite_location_id, true),
    relationship(maman_netsuite_dim_locations.region_id > maman_netsuite_dim_regions.region_id, true),
    relationship(maman_catalog_store_crosswalk.datarails_store_id - maman_datarails_dim_store.datarails_store_id, true),

    // Catalog and planning
    relationship(maman_catalog_store_closures.store_id > maman_catalog_store_crosswalk.store_id, true),
    relationship(maman_planning_forecast_weekly.store_id > maman_catalog_store_crosswalk.store_id, true),
    relationship(maman_planning_forecast_weekly.week_end_date > maman_catalog_fiscal_calendar.date, true),

    // Toast daily aggregate: the shared Toast metrics read it
    relationship(maman_toast_agg_store_daypart_daily.restaurant_guid > maman_catalog_store_crosswalk.toast_restaurant_guid, true),
    relationship(maman_toast_agg_store_daypart_daily.business_date > maman_catalog_fiscal_calendar.date, true),

    // Toast detail, kept for ad hoc questions
    relationship(maman_toast_fact_orders.restaurant_guid > maman_catalog_store_crosswalk.toast_restaurant_guid, true),
    relationship(maman_toast_fact_orders.business_date > maman_catalog_fiscal_calendar.date, true),
    relationship(maman_toast_fact_order_checks.restaurant_guid > maman_catalog_store_crosswalk.toast_restaurant_guid, true),
    relationship(maman_toast_fact_order_checks.business_date > maman_catalog_fiscal_calendar.date, true),
    relationship(maman_toast_fact_order_checks.order_guid > maman_toast_fact_orders.order_guid, true),

    // NetSuite
    relationship(maman_netsuite_fact_gl_lines.netsuite_location_id > maman_catalog_store_crosswalk.netsuite_location_id, true),
    relationship(maman_netsuite_fact_gl_lines.transaction_date > maman_catalog_fiscal_calendar.date, true),
    relationship(maman_netsuite_fact_gl_lines.account_id > maman_netsuite_dim_accounts.account_id, true),

    // Datarails: monthly rows sit on the fiscal period end date
    relationship(maman_datarails_fact_monthly_sales.datarails_store_id > maman_catalog_store_crosswalk.datarails_store_id, true),
    relationship(maman_datarails_fact_monthly_sales.period_end_date > maman_catalog_fiscal_calendar.date, true),

    // Last year: inactive, activated only by the *_ly metrics (the two Toast
    // detail ones are kept for ad hoc last-year queries on the detail tables)
    relationship(maman_netsuite_fact_gl_lines.transaction_date > maman_catalog_fiscal_calendar.ly_date, false),
    relationship(maman_toast_agg_store_daypart_daily.business_date > maman_catalog_fiscal_calendar.ly_date, false),
    relationship(maman_toast_fact_order_checks.business_date > maman_catalog_fiscal_calendar.ly_date, false),
    relationship(maman_toast_fact_orders.business_date > maman_catalog_fiscal_calendar.ly_date, false),
  ]

  metric datarails_net_sales {
    label: 'Datarails Net Sales (Board)'
    type: 'number'
    description: 'Board-reported FP&A net sales in USD from Datarails, Actuals scenario: in house, third-party delivery, catering, online ordering, events, retail and e-commerce, other income and service fees, minus discounts. Monthly by fiscal period: rows sit on the period end date, so use it with fiscal period or year filters, never a single week. Differs from ERP and Toast sales by design.'
    definition: @aql sum(maman_datarails_fact_monthly_sales.net_sales) | where(maman_datarails_fact_monthly_sales.scenario == 'Actuals');;
  }

  // Field list for Explore and dashboard builders. Models come first, listed
  // directly under view with an empty body (all their fields): Store and
  // Fiscal Calendar, then by source system. Metrics sit in flat groups that
  // follow Ryan's report (ERP sales, forecast, Toast this year and last year,
  // Datarails), then the other shared Toast and NetSuite metrics. AML allows
  // no group inside a group and a metric must be in a group. The UI shows each
  // group's name title-cased and ignores label, so each name carries the
  // section and the source. Every model and metric is listed exactly once, so
  // nothing is hidden from the curated view.
  view {
    model maman_catalog_store_crosswalk { }
    model maman_catalog_fiscal_calendar { }
    model maman_catalog_store_closures { }
    model maman_toast_dim_restaurants { }
    model maman_toast_agg_store_daypart_daily { }
    model maman_toast_fact_orders { }
    model maman_toast_fact_order_checks { }
    model maman_netsuite_dim_locations { }
    model maman_netsuite_dim_regions { }
    model maman_netsuite_dim_accounts { }
    model maman_netsuite_fact_gl_lines { }
    model maman_planning_forecast_weekly { }
    model maman_datarails_dim_store { }
    model maman_datarails_fact_monthly_sales { }

    group erp_sales_netsuite {
      metric erp_actual_sales
      metric erp_sales_ly
      metric erp_var_ly
      metric erp_var_ly_pct
      metric erp_var_forecast
      metric erp_var_forecast_pct
    }
    group forecast_planning {
      metric forecast_sales
    }
    group toast_traffic_this_year {
      metric toast_net_sales
      metric toast_orders
      metric toast_events_sales
      metric toast_average_ticket_ex_events
    }
    group toast_traffic_last_year {
      metric toast_net_sales_ly
      metric toast_orders_ly
      metric toast_events_sales_ly
      metric toast_average_ticket_ex_events_ly
    }
    group datarails_board_sales {
      metric datarails_net_sales
    }
    group toast_other_metrics {
      metric toast_transactions
      metric toast_average_check
      metric toast_trading_stores
      metric toast_breakfast_sales_share
      metric toast_lunch_sales_share
      metric toast_weekend_sales_share
    }
    group netsuite_pnl_dollars {
      metric netsuite_sales
      metric netsuite_cogs
      metric netsuite_salary
      metric netsuite_hourly
      metric netsuite_other_wages
      metric netsuite_benefits_payroll_taxes
      metric netsuite_other_labor
      metric netsuite_total_labor
      metric netsuite_prime_margin
    }
    group netsuite_pnl_pct_of_sales {
      metric netsuite_cogs_pct
      metric netsuite_salary_pct
      metric netsuite_hourly_pct
      metric netsuite_other_wages_pct
      metric netsuite_benefits_payroll_taxes_pct
      metric netsuite_other_labor_pct
      metric netsuite_total_labor_pct
      metric netsuite_prime_margin_pct
    }
    group netsuite_coverage {
      metric netsuite_locations_with_sales
      metric netsuite_locations_with_cogs
      metric netsuite_locations_with_labor
    }
  }
}.extend(maman_toast_metrics).extend(maman_netsuite_metrics).extend(maman_weekly_sales_metrics)
