Model brainstorm_speakup_events {
  type: 'table'
  label: 'SpeakUp events (internal)'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."speakup_events"'
  dimension id { label: 'Event ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; }
  dimension speakup_id { label: 'SpeakUp ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.speakup_id }};; }
  dimension event_type { label: 'Event type' type: 'text' hidden: true definition: @sql {{ #SOURCE.event_type }};; }
  dimension created_at { label: 'Event time' type: 'datetime' hidden: true definition: @sql {{ #SOURCE.created_at }};; }
}
