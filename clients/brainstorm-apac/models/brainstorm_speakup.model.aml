Model brainstorm_speakup {
  type: 'table'
  label: 'SpeakUp'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."speakup"'
  dimension id { label: 'SpeakUp ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; description: 'Unique SpeakUp ticket identifier. Use for distinct ticket counts and record-level joins; do not display as a business label.' }
  dimension company_id { label: 'Company ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.company_id }};; description: 'Company that owns the SpeakUp ticket. Use for joins and tenant access rules; use Company for display.' }
  dimension manager_id { label: 'Manager ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.manager_id }};; description: 'Manager assigned to the SpeakUp ticket. Use for joins; use SpeakUp manager to group or display results.' }
  dimension submitted_at { label: 'Submitted at' type: 'datetime' definition: @sql {{ #SOURCE.submitted_at }};; description: 'UTC date and time when the SpeakUp ticket was submitted. Use for precise sequencing and time-of-day analysis.' }
  dimension submitted_date { label: 'Submitted date' type: 'date' definition: @sql {{ #SOURCE.submitted_at }}::date;; description: 'Calendar date when the SpeakUp ticket was submitted. Use for date filters and daily, monthly or yearly submission trends.' }
  dimension status { label: 'Current status' type: 'text' definition: @sql {{ #SOURCE.status }};; description: 'Source-system status currently stored on the ticket. Use for operational status breakdowns; use Lifecycle state for cutoff-aware open versus closed analysis.' }
  dimension anonymous { label: 'Anonymous' type: 'truefalse' definition: @sql {{ #SOURCE.anonymous }};; description: 'Whether the reporter submitted without an identified identity. Use for true or false filters; use Identity type for readable labels.' }
  dimension identity_type { label: 'Identity type' type: 'text' definition: @sql case when {{ #SOURCE.anonymous }} then 'Anonymous' else 'Identified' end;; description: 'Readable reporter identity category derived from Anonymous. Use to compare Anonymous and Identified submission volume.' }
  dimension speakup_type { label: 'Feedback type' type: 'text' definition: @sql {{ #SOURCE.speakup_type }};; description: 'Business category assigned to the SpeakUp ticket. Use to filter or compare submissions and outcomes by feedback type.' }
}
