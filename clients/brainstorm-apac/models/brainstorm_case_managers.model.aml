Model brainstorm_case_managers {
  type: 'table'
  label: 'Case managers'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."case_managers"'
  dimension id { label: 'Manager ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; description: 'Unique case manager identifier. Use for joins to Cases; use Case manager for display.' }
  dimension company_id { label: 'Company ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.company_id }};; description: 'Company that the case manager belongs to. Use for joins and tenant access checks.' }
  dimension manager { label: 'Case manager' type: 'text' definition: @sql {{ #SOURCE.synthetic_manager_code }};; description: 'Synthetic, non-personal manager code. Use to group or compare case workload and outcomes by manager.' }
  dimension role { label: 'Role' type: 'text' definition: @sql {{ #SOURCE.role_code }};; description: 'Case manager role code. Use to filter or compare case performance by operational role.' }
  dimension status { label: 'Manager status' type: 'text' definition: @sql {{ #SOURCE.status }};; description: 'Current account or employment status of the case manager. Use to distinguish active and inactive managers.' }
}
