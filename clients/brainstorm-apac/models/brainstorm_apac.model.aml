Model brainstorm_speakup {
  type: 'table'
  label: 'SpeakUp'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."speakup"'
  dimension id { label: 'SpeakUp ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; }
  dimension company_id { label: 'Company ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.company_id }};; }
  dimension manager_id { label: 'Manager ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.manager_id }};; }
  dimension submitted_at { label: 'Submitted at' type: 'datetime' definition: @sql {{ #SOURCE.submitted_at }};; }
  dimension submitted_date { label: 'Submitted date' type: 'date' definition: @sql {{ #SOURCE.submitted_at }}::date;; }
  dimension status { label: 'Current status' type: 'text' definition: @sql {{ #SOURCE.status }};; }
  dimension anonymous { label: 'Anonymous' type: 'truefalse' definition: @sql {{ #SOURCE.anonymous }};; }
  dimension identity_type { label: 'Identity type' type: 'text' definition: @sql case when {{ #SOURCE.anonymous }} then 'Anonymous' else 'Identified' end;; }
  dimension speakup_type { label: 'Feedback type' type: 'text' definition: @sql {{ #SOURCE.speakup_type }};; }
}

Model brainstorm_speakup_events {
  type: 'table'
  label: 'SpeakUp events (internal)'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."speakup_events"'
  dimension id { label: 'Event ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; }
  dimension speakup_id { label: 'SpeakUp ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.speakup_id }};; }
  dimension event_type { label: 'Event type' type: 'text' hidden: true definition: @sql {{ #SOURCE.event_type }};; }
  dimension created_at { label: 'Event time' type: 'datetime' hidden: true definition: @sql {{ #SOURCE.created_at }};; }
}

Model brainstorm_adoption_snapshot {
  type: 'query'
  label: 'Adoption snapshots'
  data_source_name: 'brainstorm_apac_runsql'
  models: [brainstorm_company_snapshots]
  query: @sql
    select
      {{ #s.snapshot_key }} as snapshot_key
      , {{ #s.company_id }} as company_id
      , {{ #s.snapshot_month }} as snapshot_month
      , {{ #s.headcount }} as headcount
      , {{ #s.app_user_hc }} as app_user_hc
      , {{ #s.app_user_hc }}::numeric / nullif({{ #s.headcount }}, 0) as adoption_rate
      , lag({{ #s.headcount }}) over (partition by {{ #s.company_id }} order by {{ #s.snapshot_month }}) as previous_headcount
      , lag({{ #s.app_user_hc }}) over (partition by {{ #s.company_id }} order by {{ #s.snapshot_month }}) as previous_app_user_hc
      , lag({{ #s.app_user_hc }}::numeric / nullif({{ #s.headcount }}, 0)) over (partition by {{ #s.company_id }} order by {{ #s.snapshot_month }}) as previous_adoption_rate
      , {{ #s.snapshot_month }} = date '2026-07-01' as is_latest_snapshot
    from {{ #brainstorm_company_snapshots as s }};;
  dimension snapshot_key { label: 'Snapshot key' type: 'text' primary_key: true hidden: true definition: @sql {{ #SOURCE.snapshot_key }};; }
  dimension company_id { label: 'Company ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.company_id }};; }
  dimension snapshot_month { label: 'Snapshot month' type: 'date' definition: @sql {{ #SOURCE.snapshot_month }};; }
  dimension headcount { label: 'Headcount' type: 'number' definition: @sql {{ #SOURCE.headcount }};; }
  dimension app_user_hc { label: 'App users' type: 'number' definition: @sql {{ #SOURCE.app_user_hc }};; }
  dimension adoption_rate { label: 'Adoption rate' type: 'number' definition: @sql {{ #SOURCE.adoption_rate }};; }
  dimension previous_headcount { label: 'Previous headcount' type: 'number' hidden: true definition: @sql {{ #SOURCE.previous_headcount }};; }
  dimension previous_app_user_hc { label: 'Previous app users' type: 'number' hidden: true definition: @sql {{ #SOURCE.previous_app_user_hc }};; }
  dimension previous_adoption_rate { label: 'Previous adoption rate' type: 'number' hidden: true definition: @sql {{ #SOURCE.previous_adoption_rate }};; }
  dimension adoption_pop { label: 'Adoption PoP' type: 'number' definition: @sql {{ #SOURCE.adoption_rate }} - {{ #SOURCE.previous_adoption_rate }};; }
  dimension is_latest_snapshot { label: 'Latest snapshot' type: 'truefalse' hidden: true definition: @sql {{ #SOURCE.is_latest_snapshot }};; }
}

Model brainstorm_case_lifecycle {
  type: 'query'
  label: 'Case lifecycle'
  data_source_name: 'brainstorm_apac_runsql'
  models: [brainstorm_cases, brainstorm_case_events]
  query: @sql
    select
      {{ #c.id }} as case_id
      , count(*) filter (where {{ #e.event_type }} = 'reopen' and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00') as reopen_count
      , max({{ #e.created_at }}) filter (
          where {{ #e.event_type }} = 'close'
            and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00'
            and not exists (
              select 1 from {{ #brainstorm_case_events as r }}
              where {{ #r.case_id }} = {{ #c.id }}
                and {{ #r.event_type }} = 'reopen'
                and {{ #r.created_at }} > {{ #e.created_at }}
                and {{ #r.created_at }} <= timestamp '2026-07-01 00:00:00'
            )
        ) as final_closed_at
      , extract(epoch from (coalesce(max({{ #e.created_at }}) filter (where {{ #e.event_type }} = 'close' and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00' and not exists (select 1 from {{ #brainstorm_case_events as r2 }} where {{ #r2.case_id }} = {{ #c.id }} and {{ #r2.event_type }} = 'reopen' and {{ #r2.created_at }} > {{ #e.created_at }} and {{ #r2.created_at }} <= timestamp '2026-07-01 00:00:00')), timestamp '2026-07-01 00:00:00') - {{ #c.created_at }})) / 86400.0 as lifecycle_days
    from {{ #brainstorm_cases as c }}
    left join {{ #brainstorm_case_events as e }} on {{ #e.case_id }} = {{ #c.id }}
      and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00'
    where {{ #c.created_at }} < timestamp '2026-07-01 00:00:00'
    group by {{ #c.id }}, {{ #c.created_at }};;
  dimension case_id { label: 'Case ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.case_id }};; }
  dimension reopen_count { label: 'Reopenings' type: 'number' definition: @sql {{ #SOURCE.reopen_count }};; }
  dimension final_closed_at { label: 'Final close' type: 'datetime' definition: @sql {{ #SOURCE.final_closed_at }};; }
  dimension lifecycle_days { label: 'Lifecycle days' type: 'number' definition: @sql {{ #SOURCE.lifecycle_days }};; }
  dimension current_state { label: 'Lifecycle state' type: 'text' definition: @sql case when {{ #SOURCE.final_closed_at }} is null then 'In progress' else 'Closed' end;; }
}

Model brainstorm_speakup_lifecycle {
  type: 'query'
  label: 'SpeakUp lifecycle'
  data_source_name: 'brainstorm_apac_runsql'
  models: [brainstorm_speakup, brainstorm_speakup_events]
  query: @sql
    select
      {{ #s.id }} as speakup_id
      , min({{ #e.created_at }}) filter (where {{ #e.event_type }} = 'manager_response' and {{ #e.created_at }} >= {{ #s.submitted_at }} and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00') as first_manager_response_at
      , count(*) filter (where {{ #e.event_type }} = 'reopen' and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00') as reopen_count
      , max({{ #e.created_at }}) filter (
          where {{ #e.event_type }} = 'close'
            and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00'
            and not exists (
              select 1 from {{ #brainstorm_speakup_events as r }}
              where {{ #r.speakup_id }} = {{ #s.id }}
                and {{ #r.event_type }} = 'reopen'
                and {{ #r.created_at }} > {{ #e.created_at }}
                and {{ #r.created_at }} <= timestamp '2026-07-01 00:00:00'
            )
        ) as final_closed_at
      , extract(epoch from (min({{ #e.created_at }}) filter (where {{ #e.event_type }} = 'manager_response' and {{ #e.created_at }} >= {{ #s.submitted_at }} and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00') - {{ #s.submitted_at }})) / 3600.0 as first_response_hours
      , extract(epoch from (max({{ #e.created_at }}) filter (where {{ #e.event_type }} = 'close' and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00' and not exists (select 1 from {{ #brainstorm_speakup_events as r2 }} where {{ #r2.speakup_id }} = {{ #s.id }} and {{ #r2.event_type }} = 'reopen' and {{ #r2.created_at }} > {{ #e.created_at }} and {{ #r2.created_at }} <= timestamp '2026-07-01 00:00:00')) - {{ #s.submitted_at }})) / 86400.0 as final_close_days
      , extract(epoch from (coalesce(max({{ #e.created_at }}) filter (where {{ #e.event_type }} = 'close' and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00' and not exists (select 1 from {{ #brainstorm_speakup_events as r3 }} where {{ #r3.speakup_id }} = {{ #s.id }} and {{ #r3.event_type }} = 'reopen' and {{ #r3.created_at }} > {{ #e.created_at }} and {{ #r3.created_at }} <= timestamp '2026-07-01 00:00:00')), timestamp '2026-07-01 00:00:00') - {{ #s.submitted_at }})) / 86400.0 as lifecycle_days
    from {{ #brainstorm_speakup as s }}
    left join {{ #brainstorm_speakup_events as e }} on {{ #e.speakup_id }} = {{ #s.id }}
      and {{ #e.created_at }} <= timestamp '2026-07-01 00:00:00'
    where {{ #s.submitted_at }} < timestamp '2026-07-01 00:00:00'
    group by {{ #s.id }}, {{ #s.submitted_at }};;
  dimension speakup_id { label: 'SpeakUp ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.speakup_id }};; }
  dimension first_manager_response_at { label: 'First manager response' type: 'datetime' definition: @sql {{ #SOURCE.first_manager_response_at }};; }
  dimension first_response_hours { label: 'First response hours' type: 'number' definition: @sql {{ #SOURCE.first_response_hours }};; }
  dimension reopen_count { label: 'Reopenings' type: 'number' definition: @sql {{ #SOURCE.reopen_count }};; }
  dimension final_closed_at { label: 'Final close' type: 'datetime' definition: @sql {{ #SOURCE.final_closed_at }};; }
  dimension final_close_days { label: 'Final close days' type: 'number' definition: @sql {{ #SOURCE.final_close_days }};; }
  dimension lifecycle_days { label: 'Lifecycle days' type: 'number' definition: @sql {{ #SOURCE.lifecycle_days }};; }
  dimension current_state { label: 'Lifecycle state' type: 'text' definition: @sql case when {{ #SOURCE.final_closed_at }} is null then 'In progress' else 'Closed' end;; }
}
