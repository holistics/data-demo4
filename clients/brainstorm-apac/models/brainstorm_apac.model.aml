Model brainstorm_companies {
  type: 'table'
  label: 'Companies'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."companies"'
  dimension id { label: 'Company ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; }
  dimension name { label: 'Company' type: 'text' definition: @sql {{ #SOURCE.name }};; }
  dimension country { label: 'Country' type: 'text' definition: @sql {{ #SOURCE.country }};; }
}

Model brainstorm_company_snapshots {
  type: 'table'
  label: 'Company snapshots'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."company_snapshots"'
  dimension snapshot_key { label: 'Snapshot key' type: 'text' primary_key: true hidden: true definition: @sql concat({{ #SOURCE.company_id }}, '-', {{ #SOURCE.snapshot_month }}::text);; }
  dimension company_id { label: 'Company ID' type: 'number' hidden: true definition: @sql {{ #SOURCE.company_id }};; }
  dimension snapshot_month { label: 'Snapshot month' type: 'date' definition: @sql {{ #SOURCE.snapshot_month }}::date;; }
  dimension headcount { label: 'Headcount' type: 'number' definition: @sql {{ #SOURCE.headcount }};; }
  dimension app_user_hc { label: 'App users' type: 'number' definition: @sql {{ #SOURCE.app_user_hc }};; }
}

