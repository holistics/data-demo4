Model brainstorm_companies {
  type: 'table'
  label: 'Companies'
  data_source_name: 'brainstorm_apac_runsql'
  table_name: '"public"."companies"'
  dimension id { label: 'Company ID' type: 'number' primary_key: true hidden: true definition: @sql {{ #SOURCE.id }};; description: 'Unique company identifier. Use for joins, tenant access rules and company-level filtering; use Company for display.' }
  dimension name { label: 'Company' type: 'text' definition: @sql {{ #SOURCE.name }};; description: 'Company display name. Use to filter, group or compare results by customer company.' }
  dimension country { label: 'Country' type: 'text' definition: @sql {{ #SOURCE.country }};; description: 'Country assigned to the company. Use to filter or compare results by market; values in this POC are VN and BD.' }
}
