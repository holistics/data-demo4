// Record layouts for View Underlying Data (right-click a metric value).
const rockinfo_ud_candidate = [
  r(rockinfo_candidates.candidate_id),
  r(rockinfo_candidates.candidate_name),
  r(rockinfo_candidates.email),
  r(rockinfo_candidates.segment),
  r(rockinfo_candidates.country),
  r(rockinfo_partners.partner_name),
  r(rockinfo_candidates.registered_date),
]

const rockinfo_ud_enrolment = [
  r(rockinfo_candidates.candidate_id),
  r(rockinfo_candidates.candidate_name),
  r(rockinfo_courses.course_name),
  r(rockinfo_enrolments.enrolled_date),
  r(rockinfo_enrolments.status),
  r(rockinfo_enrolments.progress_pct),
  r(rockinfo_enrolments.final_score),
  r(rockinfo_enrolments.days_to_complete),
]

const rockinfo_ud_attempt = [
  r(rockinfo_candidates.candidate_id),
  r(rockinfo_candidates.candidate_name),
  r(rockinfo_exams.exam_name),
  r(rockinfo_exam_attempts.attempted_date),
  r(rockinfo_exam_attempts.attempt_number),
  r(rockinfo_exam_attempts.score),
  r(rockinfo_exam_attempts.result),
  r(rockinfo_exam_attempts.voucher_id),
]

const rockinfo_ud_credential = [
  r(rockinfo_candidates.candidate_id),
  r(rockinfo_candidates.candidate_name),
  r(rockinfo_candidates.email),
  r(rockinfo_programs.program_name),
  r(rockinfo_credentials.credential_code),
  r(rockinfo_credentials.issued_date),
  r(rockinfo_credentials.expires_at),
  r(rockinfo_credentials.credential_status),
]

const rockinfo_ud_voucher = [
  r(rockinfo_vouchers.order_id),
  r(rockinfo_vouchers.voucher_code),
  r(rockinfo_partners.partner_name),
  r(rockinfo_exams.exam_name),
  r(rockinfo_vouchers.voucher_type),
  r(rockinfo_vouchers.issued_date),
  r(rockinfo_vouchers.voucher_status),
  r(rockinfo_vouchers.redeemed_date),
  r(rockinfo_vouchers.net_price_usd),
]

Dataset rockinfo_credentialing {
  label: 'Rockinfo - Credentialing Analytics'
  description: '''
Governed dataset for Rockinfo clients (technology vendors running certification programs) embedded in the Rockinfo platform.
Covers candidates, course learning, exams, credentials and recertification, and exam vouchers sold through partners.

- Tenant isolation: every row is scoped by the rockinfo_client_id user attribute (row-level permission client_access).
- Activity dates: the shared Date field filters enrolments by enrolled date, exam attempts by attempted date, credentials by issued date, vouchers by issued date and candidates by registered date.
- Revenue: voucher sales are cash booked at issue; recognised revenue is booked at redemption; breakage is the value of vouchers that expired unused.
- Rates are ratios of counts. Never average a rate across rows; recompute it from its numerator and denominator.
'''
  data_source_name: 'rockinfo_neon'
  owner: 'vincent@holistics.io'

  models: [
    rockinfo_clients,
    rockinfo_programs,
    rockinfo_courses,
    rockinfo_exams,
    rockinfo_partners,
    rockinfo_candidates,
    rockinfo_enrolments,
    rockinfo_exam_attempts,
    rockinfo_credentials,
    rockinfo_vouchers,
    rockinfo_candidate_milestones,
    rockinfo_dates,
  ]

  // Every model reaches rockinfo_clients by one unique shortest path, so the
  // tenant permission propagates without ambiguity.
  relationships: [
    relationship(rockinfo_programs.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_partners.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_candidates.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_enrolments.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_exam_attempts.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_credentials.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_vouchers.client_id > rockinfo_clients.client_id, true),
    relationship(rockinfo_candidate_milestones.client_id > rockinfo_clients.client_id, true),

    relationship(rockinfo_courses.program_id > rockinfo_programs.program_id, true),
    relationship(rockinfo_exams.program_id > rockinfo_programs.program_id, true),
    relationship(rockinfo_candidates.partner_id > rockinfo_partners.partner_id, true),

    relationship(rockinfo_enrolments.candidate_id > rockinfo_candidates.candidate_id, true),
    relationship(rockinfo_enrolments.course_id > rockinfo_courses.course_id, true),
    relationship(rockinfo_exam_attempts.candidate_id > rockinfo_candidates.candidate_id, true),
    relationship(rockinfo_exam_attempts.exam_id > rockinfo_exams.exam_id, true),
    relationship(rockinfo_credentials.candidate_id > rockinfo_candidates.candidate_id, true),
    relationship(rockinfo_credentials.program_id > rockinfo_programs.program_id, true),
    relationship(rockinfo_vouchers.partner_id > rockinfo_partners.partner_id, true),
    relationship(rockinfo_vouchers.exam_id > rockinfo_exams.exam_id, true),
    relationship(rockinfo_candidate_milestones.candidate_id > rockinfo_candidates.candidate_id, true),

    relationship(rockinfo_candidates.registered_date > rockinfo_dates.date_day, true),
    relationship(rockinfo_enrolments.enrolled_date > rockinfo_dates.date_day, true),
    relationship(rockinfo_exam_attempts.attempted_date > rockinfo_dates.date_day, true),
    relationship(rockinfo_credentials.issued_date > rockinfo_dates.date_day, true),
    relationship(rockinfo_vouchers.issued_date > rockinfo_dates.date_day, true),
  ]

  // ── Tenant isolation ────────────────────────────────────────────────────
  // Number user attribute rockinfo_client_id, passed by the Rockinfo app in the
  // signed embed token. Not enforced for Admins or Analysts with data-source access.
  permission client_access {
    field: r(rockinfo_clients.client_id)
    operator: 'matches_user_attribute'
    value: 'rockinfo_client_id'
  }

  // ── Portal header (one dashboard, branded per tenant) ───────────────────
  metric portal_client_name {
    label: 'Portal Client'
    type: 'text'
    definition: @aql case(
        when: count_distinct(rockinfo_clients.client_id) == 1, then: max(rockinfo_clients.client_name)
      , else: 'All Rockinfo clients'
    );;
    description: 'Name of the client the viewer is scoped to, or All Rockinfo clients when the token grants several. Drives the dashboard header.'
  }
  metric portal_brand_color {
    label: 'Portal Brand Color'
    type: 'text'
    definition: @aql case(
        when: count_distinct(rockinfo_clients.client_id) == 1, then: max(rockinfo_clients.brand_color)
      , else: '#1F2A44'
    );;
    description: 'Accent colour of the scoped client, or Rockinfo navy for multi-client viewers. Drives the dashboard header.'
  }
  metric portal_client_industry {
    label: 'Portal Client Industry'
    type: 'text'
    definition: @aql case(
        when: count_distinct(rockinfo_clients.client_id) == 1, then: max(rockinfo_clients.industry)
      , else: concat(cast(count_distinct(rockinfo_clients.client_id), 'text'), ' clients')
    );;
    description: 'Industry of the scoped client, or the number of clients for multi-client viewers.'
  }

  // ── Candidates ──────────────────────────────────────────────────────────
  metric total_candidates {
    label: 'Candidates'
    type: 'number'
    definition: @aql count_distinct(rockinfo_candidates.candidate_id);;
    description: 'Distinct candidates registered. With a Date filter, counts candidates who registered in the period.'
    format: '#,###0'
  }

  // ── Learning ────────────────────────────────────────────────────────────
  metric enrolments {
    label: 'Course Enrolments'
    type: 'number'
    definition: @aql count(rockinfo_enrolments.enrolment_id);;
    description: 'Course enrolments started, by enrolled date.'
    format: '#,###0'
  }
  metric course_completions {
    label: 'Course Completions'
    type: 'number'
    definition: @aql count(rockinfo_enrolments.enrolment_id) | where(rockinfo_enrolments.status == 'Completed');;
    description: 'Enrolments that reached completion, by enrolled date.'
    format: '#,###0'
  }
  metric completion_rate {
    label: 'Completion Rate'
    type: 'number'
    definition: @aql safe_divide(course_completions, enrolments);;
    description: 'Course Completions / Course Enrolments for the same enrolment cohort.'
    format: '#,##0.0%'
  }
  metric active_learners {
    label: 'Active Learners'
    type: 'number'
    definition: @aql count_distinct(rockinfo_enrolments.candidate_id) | where(rockinfo_enrolments.status == 'In progress');;
    description: 'Distinct candidates with a course in progress (activity in the last 120 days).'
    format: '#,###0'
  }
  metric avg_course_score {
    label: 'Avg Course Score'
    type: 'number'
    definition: @aql avg(rockinfo_enrolments.final_score);;
    description: 'Average final course assessment score of completed enrolments, out of 100.'
    format: '#,##0.0'
  }

  // ── Exams ───────────────────────────────────────────────────────────────
  metric exam_attempts {
    label: 'Exam Attempts'
    type: 'number'
    definition: @aql count(rockinfo_exam_attempts.attempt_id);;
    description: 'Exam sittings, first attempts and retakes, by attempted date.'
    format: '#,###0'
  }
  metric exams_passed {
    label: 'Exams Passed'
    type: 'number'
    definition: @aql count(rockinfo_exam_attempts.attempt_id) | where(rockinfo_exam_attempts.result == 'Pass');;
    description: 'Exam sittings with a Pass result.'
    format: '#,###0'
  }
  metric pass_rate {
    label: 'Pass Rate'
    type: 'number'
    definition: @aql safe_divide(exams_passed, exam_attempts);;
    description: 'Exams Passed / Exam Attempts, all attempts.'
    format: '#,##0.0%'
  }
  metric first_attempt_pass_rate {
    label: 'First-Attempt Pass Rate'
    type: 'number'
    definition: @aql safe_divide(
      count(rockinfo_exam_attempts.attempt_id) | where(rockinfo_exam_attempts.attempt_number == 1 and rockinfo_exam_attempts.result == 'Pass'),
      count(rockinfo_exam_attempts.attempt_id) | where(rockinfo_exam_attempts.attempt_number == 1)
    );;
    description: 'Share of first attempts that passed. The cleanest read of exam difficulty and candidate readiness.'
    format: '#,##0.0%'
  }
  metric avg_exam_score {
    label: 'Avg Exam Score'
    type: 'number'
    definition: @aql avg(rockinfo_exam_attempts.score);;
    description: 'Average exam score out of 100 across attempts.'
    format: '#,##0.0'
  }

  // ── Credentials ─────────────────────────────────────────────────────────
  metric credentials_issued {
    label: 'Credentials Issued'
    type: 'number'
    definition: @aql count(rockinfo_credentials.credential_id);;
    description: 'Credentials issued, initial and recertification, by issued date.'
    format: '#,###0'
  }
  metric newly_certified {
    label: 'Newly Certified Candidates'
    type: 'number'
    definition: @aql count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.is_first_credential == true);;
    description: 'Candidates earning their first credential, by issued date.'
    format: '#,###0'
  }
  metric recertifications {
    label: 'Recertifications'
    type: 'number'
    definition: @aql count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.is_recertification == true);;
    description: 'Credentials issued as a renewal of an earlier credential.'
    format: '#,###0'
  }
  metric active_credentials {
    label: 'Active Credentials'
    type: 'number'
    definition: @aql count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.credential_status in ['Active', 'Expiring within 90 days']);;
    description: 'Credentials valid today, including those expiring within 90 days. Ignore the Date filter for a point-in-time count.'
    format: '#,###0'
  }
  metric expiring_90d {
    label: 'Expiring in 90 Days'
    type: 'number'
    definition: @aql count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.credential_status == 'Expiring within 90 days');;
    description: 'Valid credentials that expire within the next 90 days and have not been renewed. The recertification outreach list.'
    format: '#,###0'
  }
  metric recertification_rate {
    label: 'Recertification Rate'
    type: 'number'
    definition: @aql safe_divide(
      count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.credential_status == 'Renewed'),
      count(rockinfo_credentials.credential_id) | where(rockinfo_credentials.credential_status in ['Renewed', 'Expired'])
    );;
    description: 'Of credentials whose renewal decision is settled (renewed or lapsed), the share that were renewed.'
    format: '#,##0.0%'
  }

  // ── Vouchers and revenue ────────────────────────────────────────────────
  metric vouchers_issued {
    label: 'Vouchers Issued'
    type: 'number'
    definition: @aql count(rockinfo_vouchers.voucher_id);;
    description: 'Exam vouchers sold, by issued date.'
    format: '#,###0'
  }
  metric vouchers_redeemed {
    label: 'Vouchers Redeemed'
    type: 'number'
    definition: @aql count(rockinfo_vouchers.voucher_id) | where(rockinfo_vouchers.voucher_status == 'Redeemed');;
    description: 'Vouchers used to book an exam.'
    format: '#,###0'
  }
  metric vouchers_outstanding {
    label: 'Vouchers Outstanding'
    type: 'number'
    definition: @aql count(rockinfo_vouchers.voucher_id) | where(rockinfo_vouchers.voucher_status == 'Unredeemed');;
    description: 'Vouchers sold, still valid and not yet redeemed.'
    format: '#,###0'
  }
  metric vouchers_expired {
    label: 'Vouchers Expired'
    type: 'number'
    definition: @aql count(rockinfo_vouchers.voucher_id) | where(rockinfo_vouchers.voucher_status == 'Expired');;
    description: 'Vouchers that expired unused.'
    format: '#,###0'
  }
  metric redemption_rate {
    label: 'Redemption Rate'
    type: 'number'
    definition: @aql safe_divide(vouchers_redeemed, vouchers_issued);;
    description: 'Vouchers Redeemed / Vouchers Issued for the same issue cohort.'
    format: '#,##0.0%'
  }
  metric voucher_sales {
    label: 'Voucher Sales'
    type: 'number'
    definition: @aql sum(rockinfo_vouchers.net_price_usd);;
    description: 'Net value of vouchers sold (after discount), USD, booked at issue.'
    format: '[$$]#,###0'
  }
  metric recognised_revenue {
    label: 'Recognised Revenue'
    type: 'number'
    definition: @aql sum(rockinfo_vouchers.net_price_usd) | where(rockinfo_vouchers.voucher_status == 'Redeemed');;
    description: 'Net value of redeemed vouchers, USD. Revenue is recognised on redemption.'
    format: '[$$]#,###0'
  }
  metric deferred_revenue {
    label: 'Deferred Revenue'
    type: 'number'
    definition: @aql sum(rockinfo_vouchers.net_price_usd) | where(rockinfo_vouchers.voucher_status == 'Unredeemed');;
    description: 'Net value of sold vouchers not yet redeemed or expired, USD. The open liability.'
    format: '[$$]#,###0'
  }
  metric breakage {
    label: 'Breakage'
    type: 'number'
    definition: @aql sum(rockinfo_vouchers.net_price_usd) | where(rockinfo_vouchers.voucher_status == 'Expired');;
    description: 'Net value of vouchers that expired unused, USD.'
    format: '[$$]#,###0'
  }
  metric avg_discount {
    label: 'Avg Discount'
    type: 'number'
    definition: @aql safe_divide(sum(rockinfo_vouchers.list_price_usd) - sum(rockinfo_vouchers.net_price_usd), sum(rockinfo_vouchers.list_price_usd));;
    description: 'Discount given as a share of list value, weighted by voucher value.'
    format: '#,##0.0%'
  }

  // ── Candidate journey cohort ────────────────────────────────────────────
  dimension cohort_period {
    model: rockinfo_candidates
    label: 'Registration Cohort'
    type: 'date'
    description: 'Period the candidate registered in. Granularity follows the Cohort Granularity control.'
    definition: @aql case(
        when: 'Week' in rockinfo_clients.cohort_grain, then: rockinfo_candidates.registered_date | week()
      , when: 'Quarter' in rockinfo_clients.cohort_grain, then: rockinfo_candidates.registered_date | quarter()
      , when: 'Year' in rockinfo_clients.cohort_grain, then: rockinfo_candidates.registered_date | year()
      , else: rockinfo_candidates.registered_date | month()
    );;
  }
  dimension period_number {
    model: rockinfo_candidate_milestones
    label: 'Periods Since Registration'
    type: 'number'
    description: 'Calendar periods between registration and the milestone, in the Cohort Granularity unit. Period 0 is the registration period.'
    definition: @aql case(
        when: 'Week' in rockinfo_clients.cohort_grain, then: date_diff('day', rockinfo_candidates.registered_date | week(), rockinfo_candidate_milestones.event_at | week()) / 7
      , when: 'Quarter' in rockinfo_clients.cohort_grain, then: date_diff('quarter', rockinfo_candidates.registered_date | quarter(), rockinfo_candidate_milestones.event_at | quarter())
      , when: 'Year' in rockinfo_clients.cohort_grain, then: date_diff('year', rockinfo_candidates.registered_date | year(), rockinfo_candidate_milestones.event_at | year())
      , else: date_diff('month', rockinfo_candidates.registered_date | month(), rockinfo_candidate_milestones.event_at | month())
    );;
  }
  metric cohort_size {
    label: 'Cohort Size'
    type: 'number'
    definition: @aql count_distinct(rockinfo_candidates.candidate_id) | of_all(rockinfo_candidate_milestones.period_number, keep_filters: true);;
    description: 'Candidates registered in the cohort period, held constant across the lifecycle axis so it is a valid denominator.'
    format: '#,###0'
  }
  metric cohort_milestone_reached {
    label: 'Reached Milestone'
    type: 'number'
    definition: @aql case(
        when: 'Started a course' in rockinfo_clients.cohort_milestone, then: count(rockinfo_candidate_milestones.milestone_key) | where(rockinfo_candidate_milestones.milestone == 'Started a course')
      , when: 'Completed a course' in rockinfo_clients.cohort_milestone, then: count(rockinfo_candidate_milestones.milestone_key) | where(rockinfo_candidate_milestones.milestone == 'Completed a course')
      , when: 'Sat an exam' in rockinfo_clients.cohort_milestone, then: count(rockinfo_candidate_milestones.milestone_key) | where(rockinfo_candidate_milestones.milestone == 'Sat an exam')
      , else: count(rockinfo_candidate_milestones.milestone_key) | where(rockinfo_candidate_milestones.milestone == 'Certified')
    );;
    description: 'Candidates first reaching the milestone chosen in Cohort Milestone (Certified when none is chosen) in that period. Each candidate reaches each milestone at most once.'
    format: '#,###0'
  }
  metric cohort_milestone_cumulative {
    label: 'Reached Milestone (cumulative)'
    type: 'number'
    definition: @aql running_total(cohort_milestone_reached, rockinfo_candidate_milestones.period_number, fill_missing: true);;
    description: 'Running total of Reached Milestone across the lifecycle axis. Use only on a report that has Periods Since Registration.'
    format: '#,###0'
  }
  metric cohort_conversion {
    label: 'Cohort Conversion'
    type: 'number'
    definition: @aql cohort_milestone_cumulative / cohort_size;;
    description: 'Cumulative share of the registration cohort that has reached the chosen milestone by each period. Rises monotonically; read across a row to see time-to-milestone.'
    format: '#,##0.0%'
  }

  // ── Voucher redemption cohort ───────────────────────────────────────────
  dimension voucher_cohort_period {
    model: rockinfo_vouchers
    label: 'Voucher Issue Cohort'
    type: 'date'
    description: 'Period the voucher was sold in. Granularity follows the Cohort Granularity control.'
    definition: @aql case(
        when: 'Week' in rockinfo_clients.cohort_grain, then: rockinfo_vouchers.issued_date | week()
      , when: 'Quarter' in rockinfo_clients.cohort_grain, then: rockinfo_vouchers.issued_date | quarter()
      , when: 'Year' in rockinfo_clients.cohort_grain, then: rockinfo_vouchers.issued_date | year()
      , else: rockinfo_vouchers.issued_date | month()
    );;
  }
  dimension voucher_period_number {
    model: rockinfo_vouchers
    label: 'Periods Since Issue'
    type: 'number'
    description: 'Calendar periods between sale and redemption, in the Cohort Granularity unit. Empty for vouchers not redeemed.'
    definition: @aql case(
        when: 'Week' in rockinfo_clients.cohort_grain, then: date_diff('day', rockinfo_vouchers.issued_date | week(), rockinfo_vouchers.redeemed_date | week()) / 7
      , when: 'Quarter' in rockinfo_clients.cohort_grain, then: date_diff('quarter', rockinfo_vouchers.issued_date | quarter(), rockinfo_vouchers.redeemed_date | quarter())
      , when: 'Year' in rockinfo_clients.cohort_grain, then: date_diff('year', rockinfo_vouchers.issued_date | year(), rockinfo_vouchers.redeemed_date | year())
      , else: date_diff('month', rockinfo_vouchers.issued_date | month(), rockinfo_vouchers.redeemed_date | month())
    );;
  }
  metric voucher_cohort_size {
    label: 'Vouchers in Cohort'
    type: 'number'
    definition: @aql count(rockinfo_vouchers.voucher_id) | of_all(rockinfo_vouchers.voucher_period_number);;
    description: 'Vouchers sold in the issue cohort, including unredeemed ones, held constant across the lifecycle axis.'
    format: '#,###0'
  }
  metric voucher_cohort_redeemed_cumulative {
    label: 'Redeemed (cumulative)'
    type: 'number'
    definition: @aql running_total(vouchers_redeemed, rockinfo_vouchers.voucher_period_number, fill_missing: true);;
    description: 'Running total of redeemed vouchers across periods since issue. Use only on a report that has Periods Since Issue.'
    format: '#,###0'
  }
  metric voucher_cohort_redemption {
    label: 'Cumulative Redemption'
    type: 'number'
    definition: @aql voucher_cohort_redeemed_cumulative / voucher_cohort_size;;
    description: 'Share of the issue cohort redeemed by each period since issue. The gap to 100 percent at 12 periods is breakage plus stock still outstanding.'
    format: '#,##0.0%'
  }

  view {
    group overview {
      metric total_candidates
    }
    group learning {
      metric enrolments
      metric course_completions
      metric completion_rate
      metric active_learners
      metric avg_course_score
    }
    group exam_metrics {
      metric exam_attempts
      metric exams_passed
      metric pass_rate
      metric first_attempt_pass_rate
      metric avg_exam_score
    }
    group credential_metrics {
      metric credentials_issued
      metric newly_certified
      metric recertifications
      metric active_credentials
      metric expiring_90d
      metric recertification_rate
    }
    group voucher_metrics {
      metric vouchers_issued
      metric vouchers_redeemed
      metric vouchers_outstanding
      metric vouchers_expired
      metric redemption_rate
      metric voucher_sales
      metric recognised_revenue
      metric deferred_revenue
      metric breakage
      metric avg_discount
    }
    group cohorts {
      metric cohort_size
      metric cohort_milestone_reached
      metric cohort_milestone_cumulative
      metric cohort_conversion
      metric voucher_cohort_size
      metric voucher_cohort_redeemed_cumulative
      metric voucher_cohort_redemption
    }
    model rockinfo_dates {}
    model rockinfo_clients {}
    model rockinfo_programs {}
    model rockinfo_courses {}
    model rockinfo_exams {}
    model rockinfo_partners {}
    model rockinfo_candidates {}
    model rockinfo_enrolments {}
    model rockinfo_exam_attempts {}
    model rockinfo_credentials {}
    model rockinfo_vouchers {}
    model rockinfo_candidate_milestones {}
  }

  context {
    analysis {
      underlying_data {
        metric total_candidates {
          view candidate_records { label: 'Candidate records' fields: rockinfo_ud_candidate }
        }
        metric enrolments {
          view enrolment_records { label: 'Enrolment records' fields: rockinfo_ud_enrolment }
          view candidate_records { label: 'Candidate records' fields: rockinfo_ud_candidate }
        }
        metric course_completions {
          view enrolment_records { label: 'Enrolment records' fields: rockinfo_ud_enrolment }
        }
        metric completion_rate {
          view enrolment_records { label: 'Enrolment records' fields: rockinfo_ud_enrolment }
        }
        metric exam_attempts {
          view attempt_records { label: 'Exam attempt records' fields: rockinfo_ud_attempt }
        }
        metric pass_rate {
          view attempt_records { label: 'Exam attempt records' fields: rockinfo_ud_attempt }
        }
        metric first_attempt_pass_rate {
          view attempt_records { label: 'Exam attempt records' fields: rockinfo_ud_attempt }
        }
        metric credentials_issued {
          view credential_records { label: 'Credential records' fields: rockinfo_ud_credential }
        }
        metric active_credentials {
          view credential_records { label: 'Credential records' fields: rockinfo_ud_credential }
        }
        metric expiring_90d {
          view credential_records { label: 'Recertification outreach list' fields: rockinfo_ud_credential }
        }
        metric vouchers_issued {
          view voucher_records { label: 'Voucher records' fields: rockinfo_ud_voucher }
        }
        metric vouchers_redeemed {
          view voucher_records { label: 'Voucher records' fields: rockinfo_ud_voucher }
        }
        metric vouchers_outstanding {
          view voucher_records { label: 'Outstanding vouchers' fields: rockinfo_ud_voucher }
        }
        metric voucher_sales {
          view voucher_records { label: 'Voucher records' fields: rockinfo_ud_voucher }
        }
        metric recognised_revenue {
          view voucher_records { label: 'Voucher records' fields: rockinfo_ud_voucher }
        }
        metric deferred_revenue {
          view voucher_records { label: 'Outstanding vouchers' fields: rockinfo_ud_voucher }
        }
        metric breakage {
          view voucher_records { label: 'Expired vouchers' fields: rockinfo_ud_voucher }
        }
      }
    }
  }
}
