  block t_cohort_intro: TextBlock {
    content: @md
<div style="padding: 4px 8px">

### Candidate journey cohort

Candidates grouped by **when they registered**. Each cell is the share of that cohort that has reached the selected **milestone** by that many periods after registering. Switch the **granularity** and **milestone** to re-cut the same cohort; partner, segment and region filters change *who is in the cohort*.
</div>;;
  }
  block f_grain: FilterBlock {
    label: 'Cohort Granularity'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_clients.cohort_grain)
    }
    default {
      operator: 'is'
      value: 'Month'
    }
    settings {
      input_type: 'single'
    }
  }
  block f_milestone: FilterBlock {
    label: 'Cohort Milestone'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_clients.cohort_milestone)
    }
    default {
      operator: 'is'
      value: 'Certified'
    }
    settings {
      input_type: 'single'
    }
  }
  block f_cohort_window: FilterBlock {
    label: 'Lifecycle Window (Periods)'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_credentialing, rockinfo_candidate_milestones.period_number)
    }
    default {
      operator: 'between'
      value: [0, 12]
    }
  }
  block f_partner_type: FilterBlock {
    label: 'Partner Type'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_type)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_segment: FilterBlock {
    label: 'Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.segment)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block p_candidate_cohort: VizBlock {
    label: 'Candidate journey cohort - cumulative % reaching the selected milestone'
    viz: PivotTable {
      dataset: rockinfo_credentialing
      rows: [
        VizFieldFull {
          label: 'Registration Cohort'
          ref: r(rockinfo_credentialing, rockinfo_candidates.cohort_period)
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
          uname: 'cr'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Period'
          ref: r(rockinfo_credentialing, rockinfo_candidate_milestones.period_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'cc'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Conversion'
          ref: r(rockinfo_credentialing.cohort_conversion)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'cv'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'cv'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FFFFFF'
              }
              mid {
                value: 0.4
                color: '#C7E3D4'
              }
              max {
                value: 0.9
                color: '#2E8B57'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'cr'
            direction: 'asc'
          },
          SortSetting {
            key: 'cc'
            direction: 'asc'
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 25
      }
    }
  }
  block t_voucher_cohort_intro: TextBlock {
    content: @md
<div style="padding: 4px 8px">

### Voucher redemption cohort

Vouchers grouped by **when they were sold**. Each cell is the cumulative share redeemed by that many periods after sale. Slow curves flag partners sitting on stock that will turn into breakage.
</div>;;
  }
  block f_v_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_v_channel: FilterBlock {
    label: 'Sales Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_vouchers.sales_channel)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block p_voucher_cohort: VizBlock {
    label: 'Voucher redemption cohort - cumulative % redeemed'
    viz: PivotTable {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentialing, rockinfo_vouchers.voucher_period_number)
        operator: 'between'
        value: [0, 12]
      }
      rows: [
        VizFieldFull {
          label: 'Issue Cohort'
          ref: r(rockinfo_credentialing, rockinfo_vouchers.voucher_cohort_period)
          format {
            type: 'date'
            pattern: 'yyyy-MM-dd'
          }
          uname: 'cr'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Period'
          ref: r(rockinfo_credentialing, rockinfo_vouchers.voucher_period_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'cc'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Redeemed'
          ref: r(rockinfo_credentialing.voucher_cohort_redemption)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'cv'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'cv'
            format: ScaleFormat {
              min {
                value: 0
                color: '#FFFFFF'
              }
              mid {
                value: 0.4
                color: '#C7E3D4'
              }
              max {
                value: 0.9
                color: '#2E8B57'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'cr'
            direction: 'asc'
          },
          SortSetting {
            key: 'cc'
            direction: 'asc'
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 25
      }
    }
  }

