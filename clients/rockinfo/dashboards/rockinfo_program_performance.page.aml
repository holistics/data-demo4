        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.recertifications)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }

      }
    }
  }
  block k_sales: VizBlock {
    label: 'Voucher Sales'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
