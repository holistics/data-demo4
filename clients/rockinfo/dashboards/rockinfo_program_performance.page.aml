            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 've_rr'
            format: ScaleFormat {
              min {
                value: 0.6
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.7
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.85
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 've_name'
            width: 380
          }
        ]
        wrap_header_text: true
      }
    }
  }

  block t_cohort_intro: TextBlock {
    content: @md
<div style="padding: 2px 6px">

#### Candidate journey cohort

<span style="opacity:.75">Candidates grouped by <b>when they registered</b>. Each cell is the share of that cohort that has reached the selected <b>milestone</b> by that many periods after registering. Read across a row for time-to-milestone; read down a column to see whether newer cohorts move faster.</span>
</div>;;
  }

  block f_grain: FilterBlock {
    label: 'Cohort Granularity'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_clients.cohort_grain)
    }
    default {
      operator: 'is'
      value: 'Month'
    }
    settings {
      input_type: 'single'
    }
  }

  block f_milestone: FilterBlock {
    label: 'Cohort Milestone'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_clients.cohort_milestone)
    }
    default {
      operator: 'is'
      value: 'Certified'
    }
    settings {
      input_type: 'single'
    }
  }

  block f_cohort_window: FilterBlock {
    label: 'Periods Shown'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_credentialing, rockinfo_candidate_milestones.period_number)
    }
    default {
      operator: 'between'
      value: [0, 12]
    }
  }

  block f_partner_type: FilterBlock {
    label: 'Partner Type'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_type)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_segment: FilterBlock {
    label: 'Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.segment)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block p_candidate_cohort: VizBlock {
    label: 'Cumulative % of each registration cohort reaching the milestone'
    description: 'Rows: the period candidates registered. Columns: periods since registering. Cells: cumulative share of that cohort that has reached the milestone chosen in Cohort Milestone.'
    viz: PivotTable {
      dataset: rockinfo_credentialing
      rows: [
        VizFieldFull {
          label: 'Registered'
          ref: r(rockinfo_credentialing, rockinfo_candidates.cohort_period)
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'cr'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Periods after'
          ref: r(rockinfo_credentialing, rockinfo_candidate_milestones.period_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'cc'
        }
      ]
      values: [
        VizFieldFull {
          label: '%'
          ref: r(rockinfo_credentialing.cohort_conversion)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'cv'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'cv'
            format: ScaleFormat {
              min {
                value: 0
                color: 'rgba(46, 158, 91, 0.02)'
              }
              mid {
                value: 0.4
                color: 'rgba(46, 158, 91, 0.28)'
              }
              max {
                value: 0.85
                color: 'rgba(46, 158, 91, 0.62)'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'cr'
            direction: 'asc'
          },
          SortSetting {
            key: 'cc'
            direction: 'asc'
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'cr'
            width: 130
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 25
      }
    }
  }

  block t_voucher_cohort_intro: TextBlock {
    content: @md
<div style="padding: 2px 6px">

#### Voucher redemption cohort

<span style="opacity:.75">Vouchers grouped by <b>when they were sold</b>. Each cell is the cumulative share redeemed by that many periods after sale. Slow rows flag partner stock that is drifting towards breakage.</span>
</div>;;
  }

  block f_v_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_v_channel: FilterBlock {
    label: 'Sales Channel'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_vouchers.sales_channel)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block p_voucher_cohort: VizBlock {
    label: 'Cumulative % of each sales cohort redeemed'
    description: 'Rows: the period vouchers were sold. Columns: periods since the sale. Cells: cumulative share of those vouchers redeemed. The gap to 100% is breakage plus stock still outstanding.'
    viz: PivotTable {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentialing, rockinfo_vouchers.voucher_period_number)
        operator: 'between'
        value: [0, 12]
      }
      rows: [
        VizFieldFull {
          label: 'Sold'
          ref: r(rockinfo_credentialing, rockinfo_vouchers.voucher_cohort_period)
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'cr'
        }
      ]
      columns: [
        VizFieldFull {
          label: 'Periods after'
          ref: r(rockinfo_credentialing, rockinfo_vouchers.voucher_period_number)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'cc'
        }
      ]
      values: [
        VizFieldFull {
          label: '%'
          ref: r(rockinfo_credentialing.voucher_cohort_redemption)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'cv'
        }
      ]
      settings {
        conditional_formats: [
          ConditionalFormat {
            key: 'cv'
            format: ScaleFormat {
              min {
                value: 0
                color: 'rgba(46, 158, 91, 0.02)'
              }
              mid {
                value: 0.4
                color: 'rgba(46, 158, 91, 0.28)'
              }
              max {
                value: 0.85
                color: 'rgba(46, 158, 91, 0.62)'
              }
            }
          }
        ]
        sorts: [
          SortSetting {
            key: 'cr'
            direction: 'asc'
          },
          SortSetting {
            key: 'cc'
            direction: 'asc'
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'cr'
            width: 130
          }
        ]
        frozen_columns: 1
        wrap_header_text: false
        pagination_size: 25
      }
    }
  }

  block s_act_now: TextBlock {
    content: @md
<div style="padding: 2px 6px">

#### Act now

<span style="opacity:.75">Point-in-time lists that ignore the Activity Date filter: who to contact this quarter.</span>
</div>;;
  }


  block h_welcome: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Welcome to Rockinfo Analytics <span class="accent">&middot;</span> start here</h3>
<p style="margin:0 0 6px">Rockinfo Analytics shows how your certification program is performing: who is signing up, how far candidates get through your courses, how they do on exams, which credentials are due for renewal, and what your exam vouchers are worth. It lives inside your Rockinfo platform and uses the same sign-in.</p>
<p class="sub" style="margin:0">&#128274; <b>Your data only.</b> Every chart, export and Rocky AI answer is limited to your organisation. Nobody at another Rockinfo client can see your numbers, and you cannot see theirs. &nbsp;&#9432; New to a term? Hover the info icon on any chart, or open the <b>Glossary</b> tab.</p>
</div>;;
  }

  block h_tabs: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Find your way</h3>
<p class="sub">Each tab answers one set of questions. Start on Overview; go to the others when something there needs a closer look.</p>
<div class="grid">
<div class="card"><b>&#128202; Overview</b><span>How is the program doing this year compared with last? The candidate journey funnel shows where people drop off; the program scorecard and partner leaderboard show which programs and partners drive results.</span></div>
<div class="card"><b>&#127891; Learning &amp; Certification</b><span>Which courses do candidates stall on? How many pass first time? Who is due to recertify in the next 90 days, and how many renewals are coming each month?</span></div>
<div class="card"><b>&#127915; Vouchers &amp; Revenue</b><span>What has been sold, earned, still owed (deferred) and lost to expiry (breakage)? Which partners hold vouchers about to expire? Reconcile each partner and exam.</span></div>
<div class="card"><b>&#128200; Cohorts</b><span>How quickly do new candidates reach a milestone, and are newer groups getting there faster? How quickly do partners use the vouchers they buy?</span></div>
<div class="card"><b>&#129309; Partner Detail</b><span>Opens when you click a partner name. One partner: candidates, pass rate, voucher orders for invoice reconciliation, and vouchers at risk.</span></div>
<div class="card"><b>&#128100; Candidate Record</b><span>Opens when you click a candidate. One person: every course, exam attempt and credential. Search any candidate by name or ID at the top.</span></div>
</div>
</div>;;
  }

  block h_read: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Read a page in four steps</h3>
<ol>
<li><b>Set the filters at the top.</b> Activity Date starts at the last 12 months. Narrow by Program, Partner or Candidate Region; every chart on the tab follows.</li>
<li><b>Scan the KPI cards.</b> The big number is the selected period; the arrow and % compare it with the same period last year. For most cards up is good; for Breakage, Deferred Revenue and Avg Discount, lower is usually better.</li>
<li><b>Hover anything.</b> &#9432; next to a title explains the chart. Hovering a bar, line or cell shows its exact value.</li>
<li><b>Act on the Act now lists.</b> They show who to contact today (credentials about to lapse, vouchers about to expire), so they ignore the date filter on purpose.</li>
</ol>
</div>;;
  }

  block h_dig: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Dig deeper</h3>
<ul>
<li><b>See the records behind a number.</b> Right-click any KPI, bar or table value &rarr; <i>View underlying data</i> to list the candidates, enrolments, exam attempts, credentials or vouchers it counts.</li>
<li><b>Open a partner.</b> Click a partner name in any partner table to go to Partner Detail.</li>
<li><b>Open a candidate.</b> Click a candidate (shown as <i>Name (#ID)</i>) to go to the Candidate Record, or search for one there by name or ID.</li>
</ul>
</div>;;
  }

  block h_more: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Beyond the dashboard</h3>
<p class="sub">What you can do depends on your organisation's Rockinfo Analytics plan and on your role. Ask your Rockinfo account manager to change either.</p>
<table><thead><tr><th>Feature</th><th>What it does</th><th class="c">Program Dashboards<br/><span style="text-transform:none;letter-spacing:0">included</span></th><th class="c">Analytics Studio<br/><span style="text-transform:none;letter-spacing:0">add-on</span></th><th class="c">Studio Enterprise<br/><span style="text-transform:none;letter-spacing:0">premium</span></th></tr></thead><tbody>
<tr><td class="t">Rockinfo dashboards</td><td>Program Performance, Partner Detail and Candidate Record, plus your Team reports.</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td></tr>
<tr><td class="t">PDF and scheduled emails</td><td>Save a dashboard as PDF, or get it in your inbox every week or month.</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td></tr>
<tr><td class="t">Ask Rocky AI</td><td>Ask in plain English, e.g. <i>Which partners have the most unredeemed vouchers older than 6 months?</i> For every user, Viewers included.</td><td class="c no">&ndash;</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td></tr>
<tr><td class="t">Explore and My reports</td><td>Creators build their own charts from the same governed data and keep them in My reports.</td><td class="c no">&ndash;</td><td class="c yes">&#10003;</td><td class="c yes">&#10003;</td></tr>
<tr><td class="t">Publish to Team reports</td><td>Share a report with everyone in your organisation.</td><td class="c no">&ndash;</td><td class="c">Every Creator</td><td class="c">Publishers your admin names</td></tr>
<tr><td class="t">Data Export</td><td>CSV or Excel of the rows behind a table, for the users your admin chooses.</td><td class="c" colspan="3">Add-on on any plan</td></tr>
</tbody></table>
<p style="margin:12px 0 0"><b>Roles.</b> <b>Viewer</b> (free, unlimited): opens dashboards and Team reports, and asks Rocky AI on Analytics Studio or Studio Enterprise. <b>Creator</b> (paid seat): also builds in Explore and keeps My reports. <b>Publisher</b> (Studio Enterprise): decides what goes to Team reports; other Creators build privately until a Publisher shares their work.</p>
</div>;;
  }

  block h_first: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Your first 15 minutes</h3>
<ol>
<li>On <b>Overview</b>, find the step in the candidate journey funnel where most people drop off.</li>
<li>Pick the program with the lowest First-Attempt Pass in the scorecard, then check its courses on <b>Learning &amp; Certification</b>.</li>
<li>Open the <b>Recertification outreach</b> list on Learning &amp; Certification: these are the candidates to remind this quarter.</li>
<li>On <b>Vouchers &amp; Revenue</b>, click the top partner in the <i>Act now</i> list to see which orders are about to expire.</li>
<li>Ask Rocky AI one question you get asked every month.</li>
</ol>
</div>;;
  }

  block h_help: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Need a hand?</h3>
<ul>
<li><b>What does a number mean?</b> Hover its &#9432;, or open the <b>Glossary</b> tab.</li>
<li><b>Why does it not match my other report?</b> Check the Activity Date filter and which date the number uses (sold vs redeemed, enrolled vs completed). The Glossary lists each one.</li>
<li><b>Ask Rocky AI</b> to explain a term or a change: <i>Why did pass rate drop last quarter?</i></li>
<li><b>Still stuck?</b> Contact your Rockinfo customer success manager.</li>
</ul>
</div>;;
  }

  block g_intro: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Glossary <span class="accent">&middot;</span> the words on these dashboards</h3>
<p class="sub" style="margin:0">Every number in Rockinfo Analytics comes from one governed set of definitions, so a KPI card, a table, an export and a Rocky AI answer always agree. Hover the <b>&#9432;</b> next to any chart title for its definition in place; come here for the full list. The <i>Exact definition</i> column is read live from the metric itself, so it never drifts from what the numbers compute.</p>
</div>;;
  }

  block g_core: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>The building blocks</h3>
<p class="sub">How your certification business is laid out in the data.</p>
<table><thead><tr><th>Term</th><th>What it means</th></tr></thead><tbody>
<tr><td class="t">Client</td><td>Your organisation. You only ever see your own data; other Rockinfo clients never appear, in dashboards, exports or AI answers.</td></tr>
<tr><td class="t">Program</td><td>Something a candidate can earn: <span class="tag">Certification</span><span class="tag">Micro-credential</span><span class="tag">CPD</span><span class="tag">Learning Path</span>. Most certifications end in a paid exam; some credentials need no exam.</td></tr>
<tr><td class="t">Course</td><td>A learning module inside a program. Courses run in a set order (<b>Step</b> 1, 2, 3 &hellip;) and are Self-paced, Virtual instructor-led or Blended.</td></tr>
<tr><td class="t">Candidate</td><td>A learner registered with you. Each candidate comes in through one partner (or Direct) and has a segment and a region.</td></tr>
<tr><td class="t">Enrolment</td><td>One candidate in one course. Status is Completed, In progress (active in the last 120 days) or Withdrawn.</td></tr>
<tr><td class="t">Exam attempt</td><td>One sitting of an exam. <b>Attempt 1</b> is the first attempt; 2 and 3 are <b>retakes</b>. Result is Pass or Fail against the exam passing score.</td></tr>
<tr><td class="t">Credential</td><td>What a candidate receives on certifying, with a public credential number for verification. Most expire after a set number of months and must be renewed (<b>recertification</b>).</td></tr>
<tr><td class="t">Partner</td><td>Who brought the candidate or bought the vouchers: <span class="tag">Training Partner</span><span class="tag">Reseller</span><span class="tag">Corporate Account</span><span class="tag">Academic</span><span class="tag">Direct</span>. Direct is your own channel and is named after you.</td></tr>
<tr><td class="t">Voucher</td><td>A prepaid code that books one exam. Partners buy them in bulk orders; candidates also buy single vouchers in the web store. A voucher is valid for 12 months from sale.</td></tr>
</tbody></table>
</div>;;
  }

  block g_learning: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Candidates and learning</h3>
<p class="sub">Where candidates come in and how far they get through the courses.</p>
<table><thead><tr><th>Term</th><th>In plain words</th><th>Exact definition</th></tr></thead><tbody>
<tr><td class="t">New Candidates</td><td>People who signed up in the period.</td><td class="x">${rockinfo_credentialing.metric.total_candidates.description}</td></tr>
<tr><td class="t">Course Enrolments</td><td>Times a candidate started a course.</td><td class="x">${rockinfo_credentialing.metric.enrolments.description}</td></tr>
<tr><td class="t">Course Completions</td><td>Of those enrolments, how many were finished.</td><td class="x">${rockinfo_credentialing.metric.course_completions.description}</td></tr>
<tr><td class="t">Course Completion Rate</td><td>Out of every 100 enrolments, how many finished.</td><td class="x">${rockinfo_credentialing.metric.completion_rate.description}</td></tr>
<tr><td class="t">Avg Course Score</td><td>Typical final score on a completed course.</td><td class="x">${rockinfo_credentialing.metric.avg_course_score.description}</td></tr>
<tr><td class="t">Active Learners</td><td>People studying right now.</td><td class="x">${rockinfo_credentialing.metric.active_learners.description}</td></tr>
</tbody></table>
</div>;;
  }

  block g_exams: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Exams and credentials</h3>
<p class="sub">Whether candidates pass, earn a credential and keep it current.</p>
<table><thead><tr><th>Term</th><th>In plain words</th><th>Exact definition</th></tr></thead><tbody>
<tr><td class="t">Exam Attempts</td><td>Exams sat, including retakes.</td><td class="x">${rockinfo_credentialing.metric.exam_attempts.description}</td></tr>
<tr><td class="t">Exam Pass Rate</td><td>Out of every 100 sittings, how many passed.</td><td class="x">${rockinfo_credentialing.metric.pass_rate.description}</td></tr>
<tr><td class="t">First-Attempt Pass Rate</td><td>How many pass first time. Low means candidates reach the exam under-prepared.</td><td class="x">${rockinfo_credentialing.metric.first_attempt_pass_rate.description}</td></tr>
<tr><td class="t">Credentials Issued</td><td>Credentials handed out, new and renewed.</td><td class="x">${rockinfo_credentialing.metric.credentials_issued.description}</td></tr>
<tr><td class="t">Newly Certified</td><td>People certified for the very first time.</td><td class="x">${rockinfo_credentialing.metric.newly_certified.description}</td></tr>
<tr><td class="t">Recertifications</td><td>Credentials renewed by someone already certified.</td><td class="x">${rockinfo_credentialing.metric.recertifications.description}</td></tr>
<tr><td class="t">Recertification Rate</td><td>When a credential came up for renewal, how often the holder renewed.</td><td class="x">${rockinfo_credentialing.metric.recertification_rate.description}</td></tr>
<tr><td class="t">Active Credentials</td><td>Credentials that are valid today.</td><td class="x">${rockinfo_credentialing.metric.active_credentials.description}</td></tr>
<tr><td class="t">Due for Recertification (90 days)</td><td>People to contact now, before their credential lapses.</td><td class="x">${rockinfo_credentialing.metric.expiring_90d.description}</td></tr>
</tbody></table>
</div>;;
  }

  block g_vouchers: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Vouchers and revenue</h3>
<p class="sub">Voucher money is <b>received</b> at sale, <b>earned</b> when a candidate uses the voucher, and <b>kept as breakage</b> if it expires unused. So Voucher Sales = Recognised + Deferred + Breakage.</p>
<table><thead><tr><th>Term</th><th>In plain words</th><th>Exact definition</th></tr></thead><tbody>
<tr><td class="t">Vouchers Issued</td><td>Vouchers sold.</td><td class="x">${rockinfo_credentialing.metric.vouchers_issued.description}</td></tr>
<tr><td class="t">Vouchers Redeemed</td><td>Vouchers used to book an exam.</td><td class="x">${rockinfo_credentialing.metric.vouchers_redeemed.description}</td></tr>
<tr><td class="t">Vouchers Outstanding</td><td>Vouchers sold and still waiting to be used.</td><td class="x">${rockinfo_credentialing.metric.vouchers_outstanding.description}</td></tr>
<tr><td class="t">Vouchers Expired</td><td>Vouchers that ran out unused.</td><td class="x">${rockinfo_credentialing.metric.vouchers_expired.description}</td></tr>
<tr><td class="t">Voucher Redemption Rate</td><td>Out of every 100 vouchers sold, how many were used.</td><td class="x">${rockinfo_credentialing.metric.redemption_rate.description}</td></tr>
<tr><td class="t">Voucher Sales</td><td>Money taken for vouchers.</td><td class="x">${rockinfo_credentialing.metric.voucher_sales.description}</td></tr>
<tr><td class="t">Recognised Revenue</td><td>Money earned: the exam has been booked.</td><td class="x">${rockinfo_credentialing.metric.recognised_revenue.description}</td></tr>
<tr><td class="t">Deferred Revenue</td><td>Money taken for exams not booked yet. You still owe the candidate an exam.</td><td class="x">${rockinfo_credentialing.metric.deferred_revenue.description}</td></tr>
<tr><td class="t">Breakage</td><td>Money kept from vouchers nobody used.</td><td class="x">${rockinfo_credentialing.metric.breakage.description}</td></tr>
<tr><td class="t">Breakage at Risk (90 days)</td><td>Deferred revenue about to become breakage. Chase these partners now.</td><td class="x">${rockinfo_credentialing.metric.breakage_at_risk_90d.description}</td></tr>
<tr><td class="t">Avg Discount</td><td>How far below list price vouchers sold, on average.</td><td class="x">${rockinfo_credentialing.metric.avg_discount.description}</td></tr>
</tbody></table>
</div>;;
  }

  block g_status: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Statuses and categories</h3>
<p class="sub">The values you will see in filters, table columns and chart legends.</p>
<table><thead><tr><th>Term</th><th>What it means</th></tr></thead><tbody>
<tr><td class="t">Credential status</td><td><b>Active</b> valid &middot; <b>Expiring</b> within 90 days &middot; <b>Expired</b> lapsed without renewal &middot; <b>Renewed</b> replaced by a recertification &middot; <b>Revoked</b> withdrawn.</td></tr>
<tr><td class="t">Voucher status</td><td><b>Redeemed</b> used for an exam &middot; <b>Unredeemed</b> still valid (deferred revenue) &middot; <b>Expired</b> unused past 12 months (breakage).</td></tr>
<tr><td class="t">Voucher type</td><td><b>Standard</b>, or <b>Retake</b>: an extra 50-point discount for a candidate re-sitting an exam (total discount capped at 60%).</td></tr>
<tr><td class="t">Sales channel</td><td><b>Partner order</b> bulk purchase by a partner &middot; <b>Web store</b> single purchase by a candidate.</td></tr>
<tr><td class="t">Partner tier</td><td><b>Platinum</b> 25% &middot; <b>Gold</b> 15% &middot; <b>Silver</b> 10% &middot; <b>Direct</b> 0% voucher discount.</td></tr>
<tr><td class="t">Segment</td><td><b>Individual</b> &middot; <b>Employer-sponsored</b> (via a corporate account) &middot; <b>Student</b> (via an academic partner).</td></tr>
<tr><td class="t">Activity Date</td><td>The date filter. Each number uses its own natural date: registered for candidates, enrolled for courses, sat for exams, issued for credentials, sold for vouchers. Default: last 12 months.</td></tr>
<tr><td class="t">vs last year</td><td>The arrow on a KPI card compares the selected period with the same period one year earlier.</td></tr>
<tr><td class="t">Point in time</td><td><b>Act now</b> lists, <i>Due for Recertification</i>, <i>Breakage at Risk</i> and the renewal pipeline describe today, so they ignore the Activity Date filter.</td></tr>
</tbody></table>
</div>;;
  }

  block g_cohort: TextBlock {
    content: @md
<style>
.rkg{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:inherit;padding:4px 8px;font-size:13px;line-height:1.55}
.rkg h3{font-size:17px;font-weight:700;margin:2px 0 4px}
.rkg .sub{opacity:.72;margin:0 0 12px}
.rkg table{border-collapse:collapse;width:100%}
.rkg th,.rkg td{border-bottom:1px solid rgba(128,128,128,.22);padding:8px 10px;vertical-align:top;text-align:left}
.rkg th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.65;font-weight:600}
.rkg td.t{font-weight:600;white-space:nowrap;width:190px}
.rkg td.x{opacity:.72;font-size:12px;width:42%}
.rkg .tag{display:inline-block;font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;border:1px solid rgba(128,128,128,.35);margin:0 4px 4px 0;white-space:nowrap}
.rkg .accent{color:#DC1F34}
.rkg .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.rkg .card{border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:12px 14px}
.rkg .card b{display:block;font-size:14px;margin-bottom:4px}
.rkg .card span{opacity:.75;font-size:12.5px}
.rkg ol,.rkg ul{margin:4px 0 0 0;padding-left:20px}
.rkg li{margin:0 0 7px}
.rkg .yes{color:#4CB851;font-weight:700}
.rkg .no{opacity:.4}
.rkg td.c{text-align:center;width:13%}
</style>
<div class="rkg">
<h3>Cohorts</h3>
<p class="sub">Used on the Cohorts tab to see how fast groups of candidates, or batches of vouchers, move.</p>
<table><thead><tr><th>Term</th><th>What it means</th></tr></thead><tbody>
<tr><td class="t">Cohort</td><td>A group that started together: candidates who <b>registered</b> in the same month (or week, quarter, year), or vouchers <b>sold</b> in the same period.</td></tr>
<tr><td class="t">Milestone</td><td>The step you are tracking: <span class="tag">Started a course</span><span class="tag">Completed a course</span><span class="tag">Sat an exam</span><span class="tag">Certified</span>. Each candidate reaches each milestone once.</td></tr>
<tr><td class="t">Periods after</td><td>How many weeks, months, quarters or years after joining the cohort. 0 is the period they joined.</td></tr>
<tr><td class="t">Cell %</td><td>Candidate cohort: ${rockinfo_credentialing.metric.cohort_conversion.description}<br/>Voucher cohort: ${rockinfo_credentialing.metric.voucher_cohort_redemption.description}</td></tr>
<tr><td class="t">How to read it</td><td>Read <b>across a row</b> to see how long one cohort takes to get there. Read <b>down a column</b> to see whether newer cohorts move faster than older ones.</td></tr>
</tbody></table>
</div>;;
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping { block: ['c_expiry_forecast', 'k_breakage_risk', 'k_expiring', 'k_recert_rate', 't_breakage_risk', 't_expiring'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_program'
