  block t_voucher_exam: VizBlock {
    label: 'Vouchers by exam'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_exams.exam_name)
        },
        VizFieldFull {
          ref: r(rockinfo_exams.list_price_usd)
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 've_issued'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.redemption_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 've_issued'
            direction: 'desc'
          }
        ]
      }
    }
