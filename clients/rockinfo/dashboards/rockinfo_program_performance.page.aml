        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_outstanding: VizBlock {
    label: 'Vouchers Outstanding'
    description: 'Vouchers sold in the period that are still valid and not used yet.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_outstanding)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }

  block k_avg_disc: VizBlock {
    label: 'Avg Discount'
    description: 'Average discount off list price, weighted by voucher value. Partner tier sets the discount; retake vouchers get an extra discount.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.avg_discount)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  block c_voucher_trend: VizBlock {
    label: 'Voucher sales by issue month and current status'
    description: 'Voucher value by month of sale, coloured by what has happened to those vouchers since: redeemed, still unredeemed or expired.'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Issue Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      legend: VizFieldFull {
        ref: r(rockinfo_vouchers.voucher_status)
      }
      y_axis {
        settings {
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.voucher_sales)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            point {
              value: 'Redeemed'
              color: '#2E9E5B'
            }
            point {
              value: 'Unredeemed'
              color: '#F5A524'
            }
            point {
              value: 'Expired'
              color: '#DC1F34'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }

  block c_outstanding_age: VizBlock {
    label: 'Deferred revenue by voucher age'
    description: 'Unredeemed vouchers by days since sale. Vouchers expire 12 months after sale, so the oldest band is the next breakage.'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_vouchers.voucher_status)
        operator: 'is'
        value: 'Unredeemed'
      }
      x_axis: VizFieldFull {
        label: 'Days since sale'
        ref: r(rockinfo_vouchers.outstanding_age_band)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.deferred_revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
          settings {
            point {
              value: '0-90 days'
              color: '#3B82F6'
            }
            point {
              value: '91-180 days'
              color: '#3B82F6'
            }
            point {
              value: '181-270 days'
              color: '#F5A524'
            }
            point {
              value: '271-365 days'
              color: '#DC1F34'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.vouchers_outstanding)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Youngest (days)'
            ref: r(rockinfo_vouchers.days_outstanding)
            aggregation: 'min'
          }
        }
      ]
      settings {
        legend_label: 'hidden'
        sort {
          type: 'tooltip'
          field_index: 1
          direction: 'asc'
        }
      }
    }
  }

  block t_breakage_risk: VizBlock {
    label: 'Act now - partners holding vouchers that expire in the next 90 days'
    description: 'Partners holding unused vouchers that expire in the next 90 days. Nudge them to get candidates booked before the value turns into breakage. Ignores the Activity Date filter.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentialing.vouchers_expiring_90d)
        operator: 'greater_than'
        value: 0
      }
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 'b_name'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
          uname: 'b_tier'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
          uname: 'b_region'
        },
        VizFieldFull {
          label: 'Expiring in 90 Days'
          ref: r(rockinfo_credentialing.vouchers_expiring_90d)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'b_n'
        },
        VizFieldFull {
          label: 'Value at Risk'
          ref: r(rockinfo_credentialing.breakage_at_risk_90d)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'b_usd'
        },
        VizFieldFull {
          label: 'All Outstanding'
          ref: r(rockinfo_credentialing.vouchers_outstanding)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'b_out'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.deferred_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'b_def'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'b_usd'
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'b_usd'
            format: ScaleFormat {
              min {
                value: 0
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 4000
                color: 'rgba(220, 31, 52, 0.22)'
              }
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'b_name'
            width: 260
          },
          ColumnStyle {
            key: 'b_tier'
            width: 110
          },
          ColumnStyle {
            key: 'b_region'
            width: 140
          },
          ColumnStyle {
            key: 'b_n'
            width: 140
          },
          ColumnStyle {
            key: 'b_usd'
            width: 160
          },
          ColumnStyle {
            key: 'b_out'
            width: 140
          },
          ColumnStyle {
            key: 'b_def'
            width: 140
          }
        ]
        wrap_header_text: true
        pagination_size: 10
      }
    }
  }

