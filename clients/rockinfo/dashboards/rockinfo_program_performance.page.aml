      }
    }
  }
  block c_cred_status: VizBlock {
    label: 'Credential status today'
    viz: PieChart {
      dataset: rockinfo_credentialing
      legend: r(rockinfo_credentials.credential_status)
      series {
        field: r(rockinfo_credentialing.credentials_issued)
      }
      settings {
        display_as_donut: true
      }
    }
  }
  block t_expiring: VizBlock {
    label: 'Recertification outreach - expiring in the next 90 days'
    viz: DataTable {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentials.credential_status)
        operator: 'is'
        value: 'Expiring within 90 days'
      }
      fields: [
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_id)
          uname: 'e_id'
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_name)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.email)
        },
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.credential_code)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.expires_at)
          uname: 'e_exp'
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.days_to_expiry)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'e_exp'
            direction: 'asc'
          }
        ]
      }
    }
  }
  block c_recert_trend: VizBlock {
    label: 'New vs renewed credentials'
    viz: ColumnChart {
