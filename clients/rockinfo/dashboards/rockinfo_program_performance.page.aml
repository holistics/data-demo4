  view: TabLayout {
    tab overview: CanvasLayout {
      label: 'Overview'
      width: 1220
      height: 1900
      grid_size: 20
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
      block t_header {
        position: pos(20, 20, 1180, 120)
      }
      block f_date {
        position: pos(20, 160, 280, 80)
      }
      block f_program {
        position: pos(320, 160, 280, 80)
      }
      block f_partner {
        position: pos(620, 160, 280, 80)
