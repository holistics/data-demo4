Dashboard rockinfo_program_performance {
  title: 'Program Performance'
  description: 'Client-facing program dashboard embedded in the Rockinfo platform. Every number is scoped to the signed-in client by row-level permission.'
  owner: 'vincent@holistics.io'

  block t_header: TextBlock {
    content: @md
<div style="padding: 4px 8px">

## Program Performance

Live view of your candidates, learning, exams, credentials and vouchers. Right-click any number to **view the underlying records**, or click a partner or candidate to **drill through** to its detail page.
</div>;;
  }
  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_region: FilterBlock {
    label: 'Candidate Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.region)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k_candidates: VizBlock {
    label: 'New Candidates'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.total_candidates)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_completions: VizBlock {
    label: 'Course Completions'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.course_completions)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_pass_rate: VizBlock {
    label: 'Exam Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block k_credentials: VizBlock {
    label: 'Credentials Issued'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.credentials_issued)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_active_creds: VizBlock {
    label: 'Active Credentials (today)'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.active_credentials)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_expiring: VizBlock {
    label: 'Expiring in 90 Days'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.expiring_90d)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_recognised: VizBlock {
    label: 'Recognised Revenue'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recognised_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }
  block k_redemption: VizBlock {
    label: 'Voucher Redemption Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.redemption_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block c_activity_trend: VizBlock {
    label: 'Monthly activity'
    viz: LineChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.enrolments)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.exam_attempts)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.credentials_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }

      }
    }
  }
  block c_creds_by_program: VizBlock {
    label: 'Credentials issued by program'
    viz: BarChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_programs.program_name)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.credentials_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }

      }
    }
  }
  block t_partner_board: VizBlock {
    label: 'Partner leaderboard - click a partner to drill through'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 'p_name'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_type)
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
        },
        VizFieldFull {
          label: 'New Candidates'
          ref: r(rockinfo_credentialing.total_candidates)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'p_cand'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.pass_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.redemption_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'p_sales'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'p_sales'
            direction: 'desc'
          }
        ]
      }
    }
  }
  block c_candidates_region: VizBlock {
    label: 'New candidates by region and segment'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_candidates.region)
      }
      legend: VizFieldFull {
        ref: r(rockinfo_candidates.segment)
      }
      y_axis {
        settings {
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.total_candidates)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }

      }
    }
  }
  block k_completion_rate: VizBlock {
    label: 'Course Completion Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.completion_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block k_avg_score: VizBlock {
    label: 'Avg Course Score'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
