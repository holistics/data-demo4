Dashboard rockinfo_program_performance {
  title: 'Program Performance'
  description: 'Client-facing program dashboard embedded in the Rockinfo platform. Every number is scoped to the signed-in client by row-level permission. KPIs compare the selected period with the same period a year earlier; Act now lists are point in time and ignore the Activity Date filter.'
  owner: 'vincent@holistics.io'

  block t_header: VizBlock {
    label: 'Client header'
    viz: MarkdownViz {
      dataset: rockinfo_credentialing
      values: [
        VizFieldFull {
          label: 'Client'
          ref: r(rockinfo_credentialing.portal_client_name)
        },
        VizFieldFull {
          label: 'Color'
          ref: r(rockinfo_credentialing.portal_brand_color)
        },
        VizFieldFull {
          label: 'Industry'
          ref: r(rockinfo_credentialing.portal_client_industry)
        }
      ]
      content: @md <div style="display:flex;align-items:center;gap:18px;height:100%;padding:6px 12px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;border-left:6px solid {{ rows[0].values.`Color`.raw }};box-sizing:border-box">
      <div style="width:56px;height:56px;border-radius:14px;background:{{ rows[0].values.`Color`.raw }};color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;flex:none">&#127891;</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:inherit;opacity:.6;line-height:1.6">{{ rows[0].values.`Industry` }}</div>
        <div style="font-size:24px;font-weight:700;color:inherit;font-family:'Inter Tight',Inter,sans-serif;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ rows[0].values.`Client` }} <span style="color:{{ rows[0].values.`Color`.raw }}">&middot;</span> Certification Program Performance</div>
        <div style="font-size:13px;color:inherit;opacity:.75;line-height:1.5">Last 12 months vs the 12 before. Right-click any number for the records behind it, Drill down from program to course or segment to partner to candidate, or drill through on a program, course, partner or candidate.</div>
      </div>
      <div style="font-size:11px;color:inherit;opacity:.5;text-align:right;flex:none;line-height:1.5">Powered by Rockinfo<br/>Analytics</div>
    </div>;;
    }
    settings {
      hide_label: true
    }
  }

  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }

  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_region: FilterBlock {
    label: 'Candidate Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.region)
    }
    settings {
      input_type: 'multiple'
    }
  }

  block k_candidates: VizBlock {
    label: 'New Candidates'
    description: 'Candidates who registered in the selected period. The arrow compares with the same period a year earlier.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.total_candidates)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_completions: VizBlock {
    label: 'Course Completions'
    description: 'Course enrolments started in the period that have since been completed. Compared with the same period a year earlier.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.course_completions)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_pass_rate: VizBlock {
    label: 'Exam Pass Rate'
    description: 'Exams passed divided by exam attempts sat in the period, first attempts and retakes together. Compared with a year earlier.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_credentials: VizBlock {
    label: 'Credentials Issued'
    description: 'Credentials issued in the period, first-time credentials and renewals (recertifications) together. Compared with a year earlier.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.credentials_issued)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_recognised: VizBlock {
    label: 'Recognised Revenue'
    description: 'Net value (after discount, USD) of vouchers used to book an exam. Voucher revenue is earned when the candidate redeems the voucher, not when it is sold.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recognised_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_redemption: VizBlock {
    label: 'Voucher Redemption Rate'
    description: 'Share of vouchers sold in the period that have been used to book an exam.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.redemption_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_expiring: VizBlock {
    label: 'Due for Recertification (90 days)'
    description: 'Valid credentials that expire in the next 90 days and have not been renewed yet. Point in time: ignores the Activity Date filter. The contact list is on the Learning & Certification tab.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.expiring_90d)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }

  block k_breakage_risk: VizBlock {
    label: 'Breakage at Risk (90 days)'
    description: 'Value (USD) of unused vouchers that expire in the next 90 days. It turns into breakage unless candidates book an exam. Point in time: ignores the Activity Date filter.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.breakage_at_risk_90d)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }

  block c_journey_funnel: VizBlock {
    label: 'Candidate journey - where candidates drop off'
    description: 'Candidates who registered in the period, and how many of them have since started a course, completed one and earned a credential. Right-click a step for the candidate records.'
    viz: ConversionFunnel {
      dataset: rockinfo_credentialing
      values: [
        VizFieldFull {
          label: 'Registered'
          ref: r(rockinfo_credentialing.total_candidates)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          label: 'Started a course'
          ref: r(rockinfo_credentialing.candidates_started_course)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          label: 'Completed a course'
          ref: r(rockinfo_credentialing.candidates_completed_course)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          label: 'Certified'
          ref: r(rockinfo_credentialing.candidates_certified)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        columns_color: '#3B82F6'
        show_label: true
      }
    }
  }

  block c_activity_trend: VizBlock {
    label: 'Monthly activity'
    description: 'Enrolments, exam attempts and credentials issued per month, each counted on its own date (enrolled, sat, issued).'
    viz: CombinationChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      y_axis {
        label: 'Enrolments'
        series {
          mark_type: 'column'
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.enrolments)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: 'rgba(59, 130, 246, 0.35)'
          }
        }
      }
      y_axis {
        label: 'Exams and credentials'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.exam_attempts)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#F5A524'
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.credentials_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#2E9E5B'
          }
        }
        settings {
          alignment: 'right'
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
        show_data_points: true
      }
    }
  }

  block t_program_scorecard: VizBlock {
    label: 'Program scorecard'
    description: 'One row per program. Completion Rate = completions / enrolments. First-Attempt Pass = share of first exam attempts that passed. Right-click any value for the records behind it.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
          uname: 'ps_name'
        },
        VizFieldFull {
          ref: r(rockinfo_programs.program_type)
          uname: 'ps_type'
        },
        VizFieldFull {
          label: 'Enrolments'
          ref: r(rockinfo_credentialing.enrolments)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'ps_enr'
        },
        VizFieldFull {
          label: 'Completion Rate'
          ref: r(rockinfo_credentialing.completion_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'ps_cr'
        },
        VizFieldFull {
          label: 'Exam Attempts'
          ref: r(rockinfo_credentialing.exam_attempts)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'ps_att'
        },
        VizFieldFull {
          label: 'First-Attempt Pass'
          ref: r(rockinfo_credentialing.first_attempt_pass_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'ps_fapr'
        },
        VizFieldFull {
          label: 'Credentials'
          ref: r(rockinfo_credentialing.credentials_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'ps_cred'
        },
        VizFieldFull {
          label: 'Voucher Sales'
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'ps_sales'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'ps_cred'
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'ps_cr'
            format: ScaleFormat {
              min {
                value: 0.7
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.82
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.92
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          },
          ConditionalFormat {
            key: 'ps_fapr'
            format: ScaleFormat {
              min {
                value: 0.55
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.67
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.8
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'ps_name'
            width: 320
          },
          ColumnStyle {
            key: 'ps_type'
            width: 140
          },
          ColumnStyle {
            key: 'ps_enr'
            width: 110
          },
          ColumnStyle {
            key: 'ps_cr'
            width: 120
          },
          ColumnStyle {
            key: 'ps_att'
            width: 110
          },
          ColumnStyle {
            key: 'ps_fapr'
            width: 130
          },
          ColumnStyle {
            key: 'ps_cred'
            width: 110
          },
          ColumnStyle {
            key: 'ps_sales'
            width: 110
          }
        ]
        wrap_header_text: true
      }
    }
  }

  block t_partner_board: VizBlock {
    label: 'Partner leaderboard - click a partner to open Partner Detail'
    description: 'Channel partners side by side. Pass Rate covers all attempts by the partner candidates. Deferred Revenue = vouchers the partner bought that are not used yet. Click a partner to open Partner Detail.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 'p_name'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_type)
          uname: 'p_type'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
          uname: 'p_region'
        },
        VizFieldFull {
          label: 'New Candidates'
          ref: r(rockinfo_credentialing.total_candidates)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'p_cand'
        },
        VizFieldFull {
          label: 'Pass Rate'
          ref: r(rockinfo_credentialing.pass_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'p_pass'
        },
        VizFieldFull {
          label: 'Vouchers Issued'
          ref: r(rockinfo_credentialing.vouchers_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'p_vi'
        },
        VizFieldFull {
          label: 'Redemption Rate'
          ref: r(rockinfo_credentialing.redemption_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'p_rr'
        },
        VizFieldFull {
          label: 'Voucher Sales'
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'p_sales'
        },
        VizFieldFull {
          label: 'Deferred Revenue'
          ref: r(rockinfo_credentialing.deferred_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'p_def'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'p_sales'
            direction: 'desc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'p_pass'
            format: ScaleFormat {
              min {
                value: 0.6
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.68
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.76
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          },
          ConditionalFormat {
            key: 'p_rr'
            format: ScaleFormat {
              min {
                value: 0.6
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.7
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.85
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'p_name'
            width: 230
          },
          ColumnStyle {
            key: 'p_type'
            width: 150
          },
          ColumnStyle {
            key: 'p_region'
            width: 130
          },
          ColumnStyle {
            key: 'p_cand'
            width: 110
          },
          ColumnStyle {
            key: 'p_pass'
            width: 100
          },
          ColumnStyle {
            key: 'p_vi'
            width: 110
          },
          ColumnStyle {
            key: 'p_rr'
            width: 110
          },
          ColumnStyle {
            key: 'p_sales'
            width: 110
          },
          ColumnStyle {
            key: 'p_def'
            width: 110
          }
        ]
        wrap_header_text: true
        pagination_size: 10
      }
    }
  }

  block k_completion_rate: VizBlock {
    label: 'Course Completion Rate'
    description: 'Course completions divided by course enrolments, for enrolments started in the period.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.completion_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_avg_score: VizBlock {
    label: 'Avg Course Score'
    description: 'Average final assessment score (out of 100) of completed courses.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.avg_course_score)
        format {
          type: 'number'
          pattern: '#,##0.0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_fapr: VizBlock {
    label: 'First-Attempt Pass Rate'
    description: 'Share of first exam attempts that passed. The cleanest read of how ready candidates are when they sit the exam.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.first_attempt_pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_number'
        alignment: 'left'
      }
    }
  }

  block k_recert_rate: VizBlock {
    label: 'Recertification Rate (all time)'
    description: 'Of credentials whose renewal is settled (renewed or lapsed), the share that were renewed. All time: ignores the Activity Date filter.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recertification_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }

  block t_course_funnel: VizBlock {
    label: 'Course completion by program and course'
    description: 'Each program learning path, course by course in order (Step). A sharp drop in Completion Rate at one step shows where candidates stall.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
          uname: 'c_prog'
        },
        VizFieldFull {
          label: 'Step'
          ref: r(rockinfo_courses.course_sequence)
          uname: 'c_step'
        },
        VizFieldFull {
          ref: r(rockinfo_courses.course_name)
          uname: 'c_name'
        },
        VizFieldFull {
          label: 'Enrolments'
          ref: r(rockinfo_credentialing.enrolments)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'c_enr'
        },
        VizFieldFull {
          label: 'Completions'
          ref: r(rockinfo_credentialing.course_completions)
          format {
            type: 'number'
            pattern: '#,###0'
          }
          uname: 'c_comp'
        },
        VizFieldFull {
          label: 'Completion Rate'
          ref: r(rockinfo_credentialing.completion_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
          uname: 'c_cr'
        },
        VizFieldFull {
          label: 'Avg Score'
          ref: r(rockinfo_credentialing.avg_course_score)
          format {
            type: 'number'
            pattern: '#,##0.0'
          }
          uname: 'c_score'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'c_prog'
            direction: 'asc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'c_cr'
            format: ScaleFormat {
              min {
                value: 0.75
                color: 'rgba(220, 31, 52, 0.22)'
              }
              mid {
                value: 0.84
                color: 'rgba(148, 163, 184, 0.06)'
              }
              max {
                value: 0.9
                color: 'rgba(46, 158, 91, 0.26)'
              }
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'c_prog'
            width: 270
          },
          ColumnStyle {
            key: 'c_step'
            width: 70
          },
          ColumnStyle {
            key: 'c_name'
            width: 360
          },
          ColumnStyle {
            key: 'c_enr'
            width: 110
          },
          ColumnStyle {
            key: 'c_comp'
            width: 110
          },
          ColumnStyle {
            key: 'c_cr'
            width: 120
          },
          ColumnStyle {
            key: 'c_score'
            width: 100
          }
        ]
        wrap_header_text: true
        pagination_size: 10
      }
    }
  }

  block c_pass_by_attempt: VizBlock {
    label: 'Pass rate by exam and attempt'
    description: 'Retakes pass more often. A low first-attempt bar points to a readiness gap in the course before the exam.'
    viz: BarChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_exams.exam_name)
      }
      legend: VizFieldFull {
        label: 'Attempt'
        ref: r(rockinfo_exam_attempts.attempt_number)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.pass_rate)
            format {
              type: 'number'
              pattern: '#,##0.0%'
            }
          }
          settings {
            point {
              value: 1
              color: '#3B82F6'
            }
            point {
              value: 2
              color: '#7C5CDB'
            }
            point {
              value: 3
              color: '#94A3B8'
            }
          }
        }
        settings {
          axis_min: 0
          axis_max: 1
        }
      }
      settings {
        legend_label: 'top'
      }
    }
  }

  block c_recert_trend: VizBlock {
    label: 'Credentials issued - new vs renewed'
    description: 'Credentials issued per month, split into first-time credentials and renewals of an earlier credential (recertifications).'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      y_axis {
        settings {
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.newly_certified)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#2E9E5B'
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.recertifications)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            color: '#3B82F6'
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }

  block c_expiry_forecast: VizBlock {
    label: 'Renewal pipeline - valid credentials by expiry month (next 6 months)'
    description: 'Credentials still valid today that expire in each coming month, by program. Ignores the Activity Date filter.'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentials.credential_status)
        operator: 'is'
        value: ['Active', 'Expiring within 90 days']
      }
      filter {
        field: r(rockinfo_credentials.expires_at)
        operator: 'matches'
        value: 'next 6 months'
      }
      x_axis: VizFieldFull {
        label: 'Expiry Month'
        ref: r(rockinfo_credentials.expires_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      legend: VizFieldFull {
        ref: r(rockinfo_programs.program_name)
      }
      y_axis {
        settings {
          stack_series_by: 'value'
          show_stack_total: true
        }
        series {
          field: VizFieldFull {
            label: 'Expiring'
            ref: r(rockinfo_credentialing.credentials_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'right'
        x_axis_label: ' '
      }
    }
  }

  block t_expiring: VizBlock {
    label: 'Recertification outreach - expiring in the next 90 days (click a candidate for the full record)'
    description: 'Candidates whose credential expires in the next 90 days and has not been renewed. Use it as your recertification outreach list. Ignores the Activity Date filter.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_credentials.credential_status)
        operator: 'is'
        value: 'Expiring within 90 days'
      }
      fields: [
        VizFieldFull {
          label: 'Candidate'
          ref: r(rockinfo_candidates.candidate_label)
          uname: 'e_name'
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.email)
          uname: 'e_email'
        },
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
          uname: 'e_prog'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 'e_partner'
        },
        VizFieldFull {
          label: 'Credential'
          ref: r(rockinfo_credentials.credential_code)
          uname: 'e_code'
        },
        VizFieldFull {
          label: 'Expires'
          ref: r(rockinfo_credentials.expires_at)
          uname: 'e_exp'
        },
        VizFieldFull {
          label: 'Days Left'
          ref: r(rockinfo_credentials.days_to_expiry)
          uname: 'e_days'
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'e_exp'
            direction: 'asc'
          }
        ]
        conditional_formats: [
          ConditionalFormat {
            key: 'e_days'
            format: SingleFormat {
              condition {
                operator: 'less_than_equal'
                value: 30
              }
              text_color: '#DC1F34'
              background_color: 'rgba(220, 31, 52, 0.22)'
            }
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'e_name'
            width: 210
          },
          ColumnStyle {
            key: 'e_email'
            width: 240
          },
          ColumnStyle {
            key: 'e_prog'
            width: 220
          },
          ColumnStyle {
            key: 'e_partner'
            width: 160
          },
          ColumnStyle {
            key: 'e_code'
            width: 130
          },
          ColumnStyle {
            key: 'e_exp'
            width: 110
          },
          ColumnStyle {
            key: 'e_days'
            width: 80
          }
        ]
        wrap_header_text: true
        pagination_size: 15
      }
    }
  }

  block k_sales: VizBlock {
    label: 'Voucher Sales'
    description: 'Net value of vouchers sold in the period, after discount, USD. Booked on the sale date.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.voucher_sales)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_recognised_v: VizBlock {
    label: 'Recognised Revenue'
    description: 'Net value (after discount, USD) of vouchers used to book an exam. Voucher revenue is earned when the candidate redeems the voucher, not when it is sold.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recognised_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_deferred: VizBlock {
    label: 'Deferred Revenue'
    description: 'Value (USD) of vouchers sold but not yet used or expired: money received for exams still owed to candidates.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.deferred_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }

  block k_breakage: VizBlock {
    label: 'Breakage'
    description: 'Value (USD) of vouchers that expired unused. Kept as revenue, but each one is a candidate who never sat the exam.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.breakage)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
        compare_value {
          reverse_color: true
        }
      }
    }
  }

  block k_issued: VizBlock {
    label: 'Vouchers Issued'
    description: 'Exam vouchers sold in the period, partner bulk orders and web store purchases.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_issued)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      compare_value: VizPopSettings {
        field: r(rockinfo_dates.date_day)
        value: RelativePopValue {
          duration: 1
          granularity: 'year'
        }
      }
      settings {
        display_mode: 'compare_by_percent'
        alignment: 'left'
      }
    }
  }

  block k_redeemed: VizBlock {
    label: 'Vouchers Redeemed'
    description: 'Vouchers sold in the period that have been used to book an exam.'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
