  block c_outstanding_age: VizBlock {
    label: 'Outstanding vouchers by age'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      filter {
        field: r(rockinfo_vouchers.voucher_status)
        operator: 'is'
        value: 'Unredeemed'
      }
      x_axis: VizFieldFull {
        ref: r(rockinfo_vouchers.outstanding_age_band)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.vouchers_outstanding)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.deferred_revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }

      }
    }
  }
  block t_voucher_partners: VizBlock {
    label: 'Voucher reconciliation by partner - click a partner to drill through'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_redeemed)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_outstanding)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_expired)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.redemption_rate)
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
          uname: 'vp_sales'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recognised_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.deferred_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.breakage)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'vp_sales'
            direction: 'desc'
          }
        ]
      }
    }
