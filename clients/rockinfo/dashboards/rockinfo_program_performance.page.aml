      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_issued)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_redeemed: VizBlock {
    label: 'Vouchers Redeemed'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_redeemed)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_outstanding: VizBlock {
    label: 'Vouchers Outstanding'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_outstanding)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_avg_disc: VizBlock {
    label: 'Avg Discount'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.avg_discount)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block c_voucher_trend: VizBlock {
    label: 'Voucher sales by month and status'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Issue Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(rockinfo_vouchers.voucher_status)
      }
      y_axis {
        settings {
          stack_series_by: 'value'
