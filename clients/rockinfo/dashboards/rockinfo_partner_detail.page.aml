Dashboard rockinfo_partner_detail {
  title: 'Partner Detail'
  description: 'Drill-through destination for one channel partner: vouchers, orders and candidates.'
  owner: 'vincent@holistics.io'

  block t_p_header: VizBlock {
    label: 'Client header'
    viz: MarkdownViz {
      dataset: rockinfo_credentialing
      calculation sel_partner {
        label: 'Selected Partner'
        formula: @aql case(
            when: count_distinct(rockinfo_partners.partner_id) == 1, then: max(rockinfo_partners.partner_name)
          , else: concat('All ', cast(count_distinct(rockinfo_partners.partner_id), 'text'), ' partners')
        );;
        calc_type: 'measure'
        data_type: 'text'
      }
      calculation sel_profile {
        label: 'Partner Profile'
        formula: @aql case(
            when: count_distinct(rockinfo_partners.partner_id) == 1, then: concat(max(rockinfo_partners.partner_type), ' · ', max(rockinfo_partners.partner_tier), ' tier · ', max(rockinfo_partners.partner_region), ' · ', max(rockinfo_partners.partner_country))
          , else: 'Pick a partner above, or click one on Program Performance, to see its vouchers, orders and candidates.'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          label: 'Partner'
          ref: 'sel_partner'
        },
        VizFieldFull {
          label: 'Profile'
          ref: 'sel_profile'
        },
        VizFieldFull {
          label: 'Client'
          ref: r(rockinfo_credentialing.portal_client_name)
        },
        VizFieldFull {
          label: 'Color'
          ref: r(rockinfo_credentialing.portal_brand_color)
        },
        VizFieldFull {
          label: 'Industry'
          ref: r(rockinfo_credentialing.portal_client_industry)
        },
        VizFieldFull {
          label: 'Candidates'
          ref: r(rockinfo_credentialing.total_candidates)
        }
      ]
      content: @md <div style="display:flex;align-items:center;gap:16px;height:100%;padding:4px 8px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;border-left:6px solid {{ rows[0].values.`Color`.raw }}">
      <div style="width:52px;height:52px;border-radius:12px;background:{{ rows[0].values.`Color`.raw }};color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;flex:none">&#127891;</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:inherit;opacity:.6;line-height:1.6">{{ rows[0].values.`Industry` }} · Partner Detail</div>
        <div style="font-size:24px;font-weight:700;color:inherit;font-family:'Inter Tight',Inter,sans-serif;line-height:1.25">{{ rows[0].values.`Client` }} <span style="color:{{ rows[0].values.`Color`.raw }}">&middot;</span> {{ rows[0].values.`Partner` }}</div>
        <div style="font-size:13px;color:inherit;opacity:.75;line-height:1.5">{{ rows[0].values.`Profile` }}</div>
      </div>
      <div style="font-size:11px;color:inherit;opacity:.55;text-align:right;flex:none">Powered by Rockinfo<br/>Analytics</div>
    </div>;;
    }
    settings {
      hide_label: true
    }
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'single'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block k_p_candidates: VizBlock {
    label: 'New Candidates'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.total_candidates)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
    }
  }
  block k_p_pass: VizBlock {
    label: 'Exam Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block k_p_sales: VizBlock {
    label: 'Voucher Sales'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.voucher_sales)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }
  block k_p_redemption: VizBlock {
    label: 'Voucher Redemption Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.redemption_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
    }
  }
  block k_p_deferred: VizBlock {
    label: 'Deferred Revenue'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.deferred_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }
  block k_p_risk: VizBlock {
    label: 'Breakage at Risk (90 days)'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.breakage_at_risk_90d)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
    }
  }
  block c_p_vouchers: VizBlock {
    label: 'Vouchers by issue month and current status'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Issue Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        ref: r(rockinfo_vouchers.voucher_status)
      }
      y_axis {
        settings {
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.vouchers_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
          settings {
            point {
              value: 'Redeemed'
              color: '#2E9E5B'
            }
            point {
              value: 'Unredeemed'
              color: '#F5A524'
            }
            point {
              value: 'Expired'
              color: '#DC1F34'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block t_p_orders: VizBlock {
    label: 'Voucher orders - for invoice reconciliation'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_vouchers.order_id)
          uname: 'o_id'
        },
        VizFieldFull {
          ref: r(rockinfo_vouchers.issued_date)
          uname: 'o_date'
        },
        VizFieldFull {
          ref: r(rockinfo_exams.exam_name)
          uname: 'o_exam'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_redeemed)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_outstanding)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_expired)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.voucher_sales)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recognised_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.deferred_revenue)
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'o_date'
            direction: 'desc'
          }
        ]
        column_styles: [
          ColumnStyle {
            key: 'o_id'
            width: 110
          },
          ColumnStyle {
            key: 'o_date'
            width: 120
          },
          ColumnStyle {
            key: 'o_exam'
            width: 320
          }
        ]
        wrap_header_text: true
        show_sum_row: true
        pagination_size: 10
      }
    }
  }
  block t_p_candidates: VizBlock {
    label: 'Candidates from this partner - click a candidate ID to open the Candidate Record'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_id)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_name)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.segment)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.country)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.registered_date)
          uname: 'pc_reg'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.course_completions)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exams_passed)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.credentials_issued)
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'pc_reg'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
        pagination_size: 10
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_date'
      to: [
        CustomMapping { block: ['k_p_risk'] disabled: true }
      ]
    }
  ]

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 1960
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
    block t_p_header {
      position: pos(20, 20, 1180, 120)
    }
    block f_partner {
      position: pos(20, 160, 380, 80)
    }
    block f_date {
      position: pos(420, 160, 280, 80)
    }
    block k_p_candidates {
      position: pos(20, 260, 380, 150)
    }
    block k_p_pass {
      position: pos(420, 260, 380, 150)
    }
    block k_p_sales {
      position: pos(820, 260, 380, 150)
    }
    block k_p_redemption {
      position: pos(20, 430, 380, 150)
    }
    block k_p_deferred {
      position: pos(420, 430, 380, 150)
    }
    block k_p_risk {
      position: pos(820, 430, 380, 150)
    }
    block c_p_vouchers {
      position: pos(20, 600, 1180, 340)
    }
    block t_p_orders {
      position: pos(20, 960, 1180, 460)
    }
    block t_p_candidates {
      position: pos(20, 1440, 1180, 480)
    }
    default_zoom: 'fit_to_width'
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    timezone: 'America/New_York'
  }
}
