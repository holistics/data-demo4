// Lenovo copies of the Rockinfo dashboards: same blocks and metrics, Lenovo theme.
// Data scope still comes only from the token's rockinfo_client_id (102).
Dashboard rockinfo_program_performance_lenovo = rockinfo_program_performance.extend({
  title: 'Lenovo - Certification Program Performance'
  theme: rockinfo_lenovo
})

Dashboard rockinfo_partner_detail_lenovo = rockinfo_partner_detail.extend({
  title: 'Lenovo - Partner Detail'
  theme: rockinfo_lenovo
})

Dashboard rockinfo_candidate_record_lenovo = rockinfo_candidate_record.extend({
  title: 'Lenovo - Candidate Record'
  theme: rockinfo_lenovo
})
