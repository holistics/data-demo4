// F5 copies of the Rockinfo dashboards: same blocks and metrics, F5 theme.
// Data scope still comes only from the token's rockinfo_client_id (106).
Dashboard rockinfo_program_performance_f5 = rockinfo_program_performance.extend({
  title: 'F5 - Certification Program Performance'
  theme: rockinfo_f5
})

Dashboard rockinfo_partner_detail_f5 = rockinfo_partner_detail.extend({
  title: 'F5 - Partner Detail'
  theme: rockinfo_f5
})

Dashboard rockinfo_candidate_record_f5 = rockinfo_candidate_record.extend({
  title: 'F5 - Candidate Record'
  theme: rockinfo_f5
})
