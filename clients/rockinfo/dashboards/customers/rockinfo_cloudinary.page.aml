// Cloudinary copies of the Rockinfo dashboards: same blocks and metrics, Cloudinary theme.
// Data scope still comes only from the token's rockinfo_client_id (109).
Dashboard rockinfo_program_performance_cloudinary = rockinfo_program_performance.extend({
  title: 'Cloudinary - Certification Program Performance'
  theme: rockinfo_cloudinary
})

Dashboard rockinfo_partner_detail_cloudinary = rockinfo_partner_detail.extend({
  title: 'Cloudinary - Partner Detail'
  theme: rockinfo_cloudinary
})

Dashboard rockinfo_candidate_record_cloudinary = rockinfo_candidate_record.extend({
  title: 'Cloudinary - Candidate Record'
  theme: rockinfo_cloudinary
})
