Dashboard rockinfo_candidate_record {
  title: 'Candidate Record'
  description: 'Drill-through destination: one candidate across learning, exams and credentials.'
  owner: 'vincent@holistics.io'

  block t_c_header: VizBlock {
    label: 'Client header'
    viz: MarkdownViz {
      dataset: rockinfo_credentialing
      values: [
        VizFieldFull {
          label: 'Client'
          ref: r(rockinfo_credentialing.portal_client_name)
        },
        VizFieldFull {
          label: 'Color'
          ref: r(rockinfo_credentialing.portal_brand_color)
        },
        VizFieldFull {
          label: 'Industry'
          ref: r(rockinfo_credentialing.portal_client_industry)
        },
        VizFieldFull {
          label: 'Candidates'
          ref: r(rockinfo_credentialing.total_candidates)
        }
      ]
      content: @md <div style="display:flex;align-items:center;gap:16px;height:100%;padding:4px 8px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;border-left:6px solid {{ rows[0].values.`Color`.raw }}">
      <div style="width:52px;height:52px;border-radius:12px;background:{{ rows[0].values.`Color`.raw }};color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;flex:none">&#127891;</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:inherit;opacity:.65">{{ rows[0].values.`Industry` }}</div>
        <div style="font-size:24px;font-weight:700;color:inherit;font-family:'Inter Tight',Inter,sans-serif;line-height:1.25">{{ rows[0].values.`Client` }} <span style="color:{{ rows[0].values.`Color`.raw }}">&middot;</span> Candidate Record</div>
        <div style="font-size:13px;color:inherit;opacity:.8">Learning, exams and credentials for one candidate on a single record.</div>
      </div>
      <div style="font-size:11px;color:inherit;opacity:.55;text-align:right;flex:none">Powered by Rockinfo<br/>Analytics</div>
    </div>;;
    }
    settings {
      hide_label: true
    }
  }
  block f_candidate: FilterBlock {
    label: 'Candidate ID'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.candidate_id)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'single'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block t_c_profile: VizBlock {
    label: 'Profile'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_id)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_name)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.email)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.segment)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.country)
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.registered_date)
        }
      ]
    }
  }
  block t_c_learning: VizBlock {
    label: 'Learning history'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_courses.course_name)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.enrolled_date)
          uname: 'l_d'
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.status)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.progress_pct)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.final_score)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.days_to_complete)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'l_d'
            direction: 'asc'
          }
        ]
      }
    }
  }
  block t_c_exams: VizBlock {
    label: 'Exam attempts'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_exams.exam_name)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.attempted_date)
          uname: 'x_d'
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.attempt_number)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.score)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.result)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.voucher_id)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'x_d'
            direction: 'asc'
          }
        ]
      }
    }
  }
  block t_c_credentials: VizBlock {
    label: 'Credentials'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.credential_code)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.issued_date)
          uname: 'cr_d'
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.expires_at)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.is_recertification)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.credential_status)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'cr_d'
            direction: 'asc'
          }
        ]
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 1020
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
    block t_c_header {
      position: pos(20, 20, 1180, 100)
    }
    block f_candidate {
      position: pos(20, 140, 380, 80)
    }
    block t_c_profile {
      position: pos(20, 240, 1180, 140)
    }
    block t_c_learning {
      position: pos(20, 400, 1180, 300)
    }
    block t_c_exams {
      position: pos(20, 720, 580, 260)
    }
    block t_c_credentials {
      position: pos(620, 720, 580, 260)
    }
    default_zoom: 'fit_to_width'
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    timezone: 'America/New_York'
  }
}
