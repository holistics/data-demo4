Dashboard rockinfo_candidate_record {
  title: 'Candidate Record'
  description: 'Drill-through destination: the candidates behind a program, course, partner, segment or region, and one candidate across learning, exams and credentials.'
  owner: 'vincent@holistics.io'

  block t_c_header: VizBlock {
    label: 'Client header'
    viz: MarkdownViz {
      dataset: rockinfo_credentialing
      calculation sel_candidate {
        label: 'Selected Candidate'
        formula: @aql case(
            when: count_distinct(rockinfo_candidates.candidate_id) == 1, then: concat(max(rockinfo_candidates.candidate_name), ' (', cast(max(rockinfo_candidates.candidate_id), 'text'), ')')
          , else: 'Candidate Record'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }
      calculation sel_profile {
        label: 'Candidate Profile'
        formula: @aql case(
            when: count_distinct(rockinfo_candidates.candidate_id) == 1, then: concat(max(rockinfo_candidates.segment), ' · ', max(rockinfo_candidates.country), ' · via ', max(rockinfo_partners.partner_name), ' · ', max(rockinfo_candidates.email))
          , else: 'Search a candidate by name or ID above, or click one in any list, to see their learning, exams and credentials.'
        );;
        calc_type: 'measure'
        data_type: 'text'
      }
      values: [
        VizFieldFull {
          label: 'Candidate'
          ref: 'sel_candidate'
        },
        VizFieldFull {
          label: 'Profile'
          ref: 'sel_profile'
        },
        VizFieldFull {
          label: 'Client'
          ref: r(rockinfo_credentialing.portal_client_name)
        },
        VizFieldFull {
          label: 'Color'
          ref: r(rockinfo_credentialing.portal_brand_color)
        },
        VizFieldFull {
          label: 'Industry'
          ref: r(rockinfo_credentialing.portal_client_industry)
        },
        VizFieldFull {
          label: 'Candidates'
          ref: r(rockinfo_credentialing.total_candidates)
        }
      ]
      content: @md <div style="display:flex;align-items:center;gap:16px;height:100%;padding:4px 8px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;border-left:6px solid {{ rows[0].values.`Color`.raw }}">
      <div style="width:52px;height:52px;border-radius:12px;background:{{ rows[0].values.`Color`.raw }};color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;flex:none">&#127891;</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:inherit;opacity:.6;line-height:1.6">{{ rows[0].values.`Industry` }} · Candidate Record</div>
        <div style="font-size:24px;font-weight:700;color:inherit;font-family:'Inter Tight',Inter,sans-serif;line-height:1.25">{{ rows[0].values.`Client` }} <span style="color:{{ rows[0].values.`Color`.raw }}">&middot;</span> {{ rows[0].values.`Candidate` }}</div>
        <div style="font-size:13px;color:inherit;opacity:.75;line-height:1.5">{{ rows[0].values.`Profile` }}</div>
      </div>
      <div style="font-size:11px;color:inherit;opacity:.55;text-align:right;flex:none">Powered by Rockinfo<br/>Analytics</div>
    </div>;;
    }
    settings {
      hide_label: true
    }
  }
  block f_candidate: FilterBlock {
    label: 'Candidate (search name or ID)'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.candidate_label)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'single'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_enr_status: FilterBlock {
    label: 'Enrolment Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_enrolments.status)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_enr_start: FilterBlock {
    label: 'Enrolment Start Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_enrolments.enrolled_date)
    }
  }
  block f_enr_end: FilterBlock {
    label: 'Enrolment End (Completed) Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_enrolments.completed_date)
    }
  }
  block f_exam_result: FilterBlock {
    label: 'Exam Result'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_exam_attempts.result)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_cred_status: FilterBlock {
    label: 'Credential Status'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_credentials.credential_status)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_partner_type: FilterBlock {
    label: 'Partner Type'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_type)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_segment: FilterBlock {
    label: 'Segment'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.segment)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_region: FilterBlock {
    label: 'Candidate Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.region)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block f_course: FilterBlock {
    label: 'Course'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_courses.course_name)
    }
    settings {
      input_type: 'multiple'
      drillthrough: Drillthrough {
        enabled: true
        sources: [
          AutoDrillthroughSource {
          }
        ]
      }
    }
  }
  block t_c_list: VizBlock {
    label: 'Matching candidates'
    description: 'Candidates that match the filters above, e.g. everyone behind the partner, program or segment you drilled from. Pick one in the Candidate filter to see their full record.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_candidates.candidate_label)
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.segment)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.country)
        },
        VizFieldFull {
          ref: r(rockinfo_candidates.registered_date)
          uname: 'cl_d'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.enrolments)
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.course_completions)
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exam_attempts)
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.credentials_issued)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'cl_d'
            direction: 'desc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block t_c_learning: VizBlock {
    label: 'Learning history'
    description: 'Every course this candidate enrolled in, with status, progress and final score.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_courses.course_name)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.enrolled_date)
          uname: 'l_d'
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.completed_date)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.status)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.progress_pct)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.final_score)
        },
        VizFieldFull {
          ref: r(rockinfo_enrolments.days_to_complete)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'l_d'
            direction: 'asc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block t_c_exams: VizBlock {
    label: 'Exam attempts'
    description: 'Every exam sitting: attempt number (1 = first attempt, 2+ = retake), score and result, and the voucher used to book it.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_exams.exam_name)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.attempted_date)
          uname: 'x_d'
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.attempt_number)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.score)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.result)
        },
        VizFieldFull {
          ref: r(rockinfo_exam_attempts.voucher_id)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'x_d'
            direction: 'asc'
          }
        ]
        wrap_header_text: true
      }
    }
  }
  block t_c_credentials: VizBlock {
    label: 'Credentials'
    description: 'Credentials earned, with status today and days until expiry. Renewal? shows whether a credential renews an earlier one.'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.credential_code)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.issued_date)
          uname: 'cr_d'
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.expires_at)
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.days_to_expiry)
          label: 'Days Left'
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.is_recertification)
          label: 'Renewal?'
        },
        VizFieldFull {
          ref: r(rockinfo_credentials.credential_status)
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 'cr_d'
            direction: 'asc'
          }
        ]
        wrap_header_text: true
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'f_partner'
      to: [
        CustomMapping { block: ['t_c_header'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_partner_type'
      to: [
        CustomMapping { block: ['t_c_header'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_segment'
      to: [
        CustomMapping { block: ['t_c_header'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_region'
      to: [
        CustomMapping { block: ['t_c_header'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_course'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_exams', 't_c_credentials'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_program'
      to: [
        CustomMapping { block: ['t_c_header'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_enr_status'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_exams', 't_c_credentials'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_enr_start'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_exams', 't_c_credentials'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_enr_end'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_exams', 't_c_credentials'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_exam_result'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_learning', 't_c_credentials'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_cred_status'
      to: [
        CustomMapping { block: ['t_c_header', 't_c_learning', 't_c_exams'] disabled: true }
      ]
    },
  ]

  view: CanvasLayout {
    label: 'View 1'
    width: 1220
    height: 2020
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
    block t_c_header {
      position: pos(20, 20, 1180, 120)
    }
    block f_candidate {
      position: pos(20, 160, 580, 80)
    }
    block f_program {
      position: pos(620, 160, 580, 80)
    }
    block f_partner {
      position: pos(20, 260, 280, 80)
    }
    block f_partner_type {
      position: pos(320, 260, 280, 80)
    }
    block f_segment {
      position: pos(620, 260, 280, 80)
    }
    block f_region {
      position: pos(920, 260, 280, 80)
    }
    block t_c_list {
      position: pos(20, 360, 1180, 360)
    }
    block f_course {
      position: pos(20, 740, 280, 80)
    }
    block f_enr_status {
      position: pos(320, 740, 280, 80)
    }
    block f_enr_start {
      position: pos(620, 740, 280, 80)
    }
    block f_enr_end {
      position: pos(920, 740, 280, 80)
    }
    block t_c_learning {
      position: pos(20, 840, 1180, 320)
    }
    block f_exam_result {
      position: pos(20, 1180, 380, 80)
    }
    block t_c_exams {
      position: pos(20, 1280, 1180, 300)
    }
    block f_cred_status {
      position: pos(20, 1600, 380, 80)
    }
    block t_c_credentials {
      position: pos(20, 1700, 1180, 300)
    }
    default_zoom: 'fit_to_width'
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    timezone: 'America/New_York'
  }
}
