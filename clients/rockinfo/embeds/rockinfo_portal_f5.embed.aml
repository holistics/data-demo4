// F5 (rockinfo_client_id 106) portal. Same governed dataset and permission as
// rockinfo_client_portal; only the theme differs. The token must still pass
// rockinfo_client_id: [106] - the portal choice never widens data access.
EmbedPortal rockinfo_portal_f5 {
  description: 'F5 certification analytics on Rockinfo, scoped by row-level permission.'
  objects: [
    rockinfo_program_performance_f5,
    rockinfo_partner_detail_f5,
    rockinfo_candidate_record_f5,
    rockinfo_credentialing,
  ]
  initial_object: rockinfo_program_performance_f5
  required_permissions: [
    rockinfo_credentialing.permission.client_access,
  ]
  default_user_attributes: {
    rockinfo_client_id: '106'
  }
  ai {
    customization {
      global {
        assistant_name: 'F5 Certification Insights'
      }
      chat_page {
        intro {
          header: 'Ask about your F5 candidates, exams, credentials and vouchers.'
          body: @md
            ## 🎓 Completion, pass rates and time-to-certify by program
            ## 🔁 Who is due for recertification, and who lapsed
            ## 🎟️ Voucher redemption, deferred revenue and breakage by partner
          ;;
        }
        prompt_placeholder: 'e.g. Which partners have the most unredeemed vouchers older than 6 months?'
      }
    }
  }
}
