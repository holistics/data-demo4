Model rockinfo_credentials {
  type: 'query'
  label: 'Credential'
  description: 'One row per credential issued (initial or recertification). Status is evaluated against today, so expiry windows stay live.'
  data_source_name: 'rockinfo_neon'
  query: @sql
    select c.*,
           r.credential_id as renewed_by_credential_id,
           row_number() over (partition by c.candidate_id order by c.issued_at, c.credential_id) = 1 as is_first_credential
    from "rockinfo_demo"."credentials" c
    left join "rockinfo_demo"."credentials" r on r.previous_credential_id = c.credential_id
  ;;
  models: []

  dimension credential_id {
    label: 'Credential ID'
    type: 'number'
    primary_key: true
    hidden: true
    definition: @sql {{ #SOURCE.credential_id }};;
    description: 'Credential key.'
  }
  dimension client_id {
    label: 'Client ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.client_id }};;
    description: 'Owning client. Join key only.'
  }
  dimension candidate_id {
    label: 'Candidate ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.candidate_id }};;
    description: 'Join key only.'
  }
  dimension program_id {
    label: 'Program ID'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.program_id }};;
    description: 'Join key only.'
  }
  dimension credential_code {
    label: 'Credential Code'
    type: 'text'
    definition: @sql {{ #SOURCE.credential_code }};;
    description: 'Public credential number, used for verification.'
  }
  dimension issued_at {
    label: 'Issued At'
    type: 'datetime'
    definition: @sql {{ #SOURCE.issued_at }};;
    description: 'When the credential was issued.'
  }
  dimension issued_date {
    label: 'Issued Date'
    type: 'date'
    definition: @sql {{ #SOURCE.issued_at }}::date;;
    description: 'Date the credential was issued. Activity date for credential metrics.'
  }
  dimension expires_at {
    label: 'Expires On'
    type: 'date'
    definition: @sql {{ #SOURCE.expires_at }};;
    description: 'Date the credential expires. Empty when it does not expire.'
  }
  dimension is_recertification {
    label: 'Is Recertification'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.is_recertification }};;
    description: 'True when this credential renews an earlier one.'
  }
  dimension is_first_credential {
    label: 'Is First Credential'
    type: 'truefalse'
    hidden: true
    definition: @sql {{ #SOURCE.is_first_credential }};;
    description: 'True for the first credential a candidate earned. Use to count newly certified candidates.'
  }
  dimension credential_status {
    label: 'Credential Status'
    type: 'text'
    definition: @sql case when {{ #SOURCE.revoked }} then 'Revoked'
      when {{ #SOURCE.renewed_by_credential_id }} is not null then 'Renewed'
      when {{ #SOURCE.expires_at }} is null then 'Active'
      when {{ #SOURCE.expires_at }} < current_date then 'Expired'
      when {{ #SOURCE.expires_at }} < current_date + 90 then 'Expiring within 90 days'
      else 'Active' end;;
    description: 'Status today: Active, Expiring within 90 days, Expired (lapsed without renewal), Renewed (superseded by a recertification) or Revoked.'
  }
  dimension days_to_expiry {
    label: 'Days to Expiry'
    type: 'number'
    definition: @sql ({{ #SOURCE.expires_at }} - current_date);;
    description: 'Days from today until the credential expires. Negative once expired.'
  }
}
