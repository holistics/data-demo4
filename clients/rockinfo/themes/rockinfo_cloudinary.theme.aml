// Cloudinary-branded theme for the Rockinfo PoC portal rockinfo_portal_cloudinary.
// Brand-inspired palette for demo purposes only.
ColorPalette rockinfo_cloudinary_palette {
  title: "Rockinfo - Cloudinary"
  categorical {
    colors: [
      "#3448C5",
      "#FF5050",
      "#0C163B",
      "#6FC1FF",
      "#FFB800",
      "#8A96E8",
      "#21B07A",
      "#B4BCEB"
    ]
  }
}

PageTheme rockinfo_cloudinary {
  title: "Rockinfo - Cloudinary"
  color {
    data: rockinfo_cloudinary_palette
  }
  background {
    bg_color: "#F5F7FF"
  }
  canvas {
    background {
      bg_color: "#F5F7FF"
    }
    border {
      border_width: 0
      border_radius: 0
      border_style: "none"
    }
  }
  block {
    label {
      font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
      font_size: 14
      font_color: "#0C163B"
      font_weight: "semibold"
    }
    text {
      font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
      font_size: 13
      font_color: "#5A6386"
      font_weight: "normal"
    }
    background {
      bg_color: "#FFFFFF"
    }
    border {
      border_width: 1
      border_radius: 8
      border_color: "#DDE2F5"
      border_style: "solid"
    }
    padding: 12
    shadow: "none"
  }
  viz {
    table {
      general {
        bg_color: "#FFFFFF"
        hover_color: "#E8EBFA"
        banding_color: "#F4F6FE"
        cell_padding: 8
        font_color: "#0C163B"
        font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
        font_size: 13
        border_color: "#DDE2F5"
        border_width: 1
        grid_color: "#DDE2F5"
      }
      header {
        bg_color: "#3448C5"
        font_color: "#FFFFFF"
        font_size: 12
        font_weight: "semibold"
      }
      sub_title {
        font_color: "#5A6386"
      }
    }
    metric_kpi {
      alignment: "center"
      value {
        font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
        font_size: 30
        font_color: "#3448C5"
        font_weight: "bold"
      }
    }
  }
}
