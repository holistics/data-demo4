// Nutanix-branded theme for the Rockinfo PoC portal rockinfo_portal_nutanix.
// Brand-inspired palette for demo purposes only.
ColorPalette rockinfo_nutanix_palette {
  title: "Rockinfo - Nutanix"
  categorical {
    colors: [
      "#024DA1",
      "#7855FA",
      "#1FDDE9",
      "#92DD23",
      "#3D8EF0",
      "#B9A6FF",
      "#0B2D5B",
      "#F5A623"
    ]
  }
}

PageTheme rockinfo_nutanix {
  title: "Rockinfo - Nutanix"
  color {
    data: rockinfo_nutanix_palette
  }
  background {
    bg_color: "#F6F8FC"
  }
  canvas {
    background {
      bg_color: "#F6F8FC"
    }
    border {
      border_width: 0
      border_radius: 0
      border_style: "none"
    }
  }
  block {
    label {
      font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
      font_size: 14
      font_color: "#131313"
      font_weight: "semibold"
    }
    text {
      font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
      font_size: 13
      font_color: "#5A6275"
      font_weight: "normal"
    }
    background {
      bg_color: "#FFFFFF"
    }
    border {
      border_width: 1
      border_radius: 8
      border_color: "#DCE3F0"
      border_style: "solid"
    }
    padding: 12
    shadow: "none"
  }
  viz {
    table {
      general {
        bg_color: "#FFFFFF"
        hover_color: "#E6EEFA"
        banding_color: "#F3F6FB"
        cell_padding: 8
        font_color: "#131313"
        font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
        font_size: 13
        border_color: "#DCE3F0"
        border_width: 1
        grid_color: "#DCE3F0"
      }
      header {
        bg_color: "#024DA1"
        font_color: "#FFFFFF"
        font_size: 12
        font_weight: "semibold"
      }
      sub_title {
        font_color: "#5A6275"
      }
    }
    metric_kpi {
      alignment: "center"
      value {
        font_family: "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
        font_size: 30
        font_color: "#024DA1"
        font_weight: "bold"
      }
    }
  }
}
