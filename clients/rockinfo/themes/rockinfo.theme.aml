// Rockinfo theme — derived from rockinfo.com (fetched 2026-11-22).
// One theme for every tenant; per-tenant accent stays data-driven (rockinfo_clients.brand_color).
//
// Sources:
// Palette order: blue first, Rockinfo red last, so a single-series chart never reads as an alert.
// - Logo red #DC1F34: https://www.rockinfo.com/wp-content/uploads/2024/11/cropped-logo-192x192.png
//   (dominant pixel), also .rkcta-btn in https://www.rockinfo.com/wp-content/et-cache/987498753/et-core-unified-987498753.min.css
// - CTA red #E11D2A / hover #B8141F: --rk-btn in https://www.rockinfo.com/wp-content/themes/rockwell/style.css
// - Dark surfaces, ink, accents, fonts, radius: --rk-bg #080C18, --rk-card #101625, --rk-bg-raise #0E1220,
//   --rk-ink #F2F5FA, --rk-ink2 #C3CAD8, --rk-muted #8A93A6, --rk-faint #5C6577, --rk-blue #3B82F6,
//   --rk-green #4CB851, --rk-border rgba(255,255,255,.12), --rk-r 14px,
//   --rk-display "Inter Tight", --rk-body "Inter" in et-core-unified-987498753.min.css (above)
// - Light-mode ink #25282A (h1–h6) / #424D54 (meta): https://www.rockinfo.com/wp-content/themes/rockwell/css/custom.css
// - Warning amber #F5A524 (--rkf-amber), error #FF6B6B (--rk-error): same et-core-unified CSS.

const rockinfo_brand = {
  primary: "oklch(0.575 0.218 23.2)"
  secondary: "oklch(0.623 0.188 259.8)"
  font_body: "Inter"
  font_display: "Inter Tight"
  corner_style: "rounded"
  density: "comfortable"
  elevation: "hairline"

  background_light: "oklch(0.970 0.005 260.0)"
  background_dark: "oklch(0.157 0.027 268.8)"
  canvas_bg_light: "oklch(0.985 0.003 260.0)"
  canvas_bg_dark: "oklch(0.186 0.029 271.2)"
  block_bg_light: "oklch(1.000 0.000 0.0)"
  block_bg_dark: "oklch(0.202 0.032 266.9)"
  text_primary_light: "oklch(0.205 0.030 267.0)"
  text_primary_dark: "oklch(0.969 0.007 260.7)"
  text_muted_light: "oklch(0.413 0.018 235.8)"
  text_muted_dark: "oklch(0.838 0.021 264.5)"
  text_subtle_light: "oklch(0.506 0.031 264.2)"
  text_subtle_dark: "oklch(0.662 0.030 265.3)"
  border_light: "oklch(0.910 0.010 260.0)"
  border_dark: "oklch(0.300 0.030 267.0)"
  focus_ring_light: "oklch(0.582 0.224 25.6)"
  focus_ring_dark: "oklch(0.640 0.200 25.6)"
  semantic_success_light: "oklch(0.560 0.150 144.2)"
  semantic_success_dark: "oklch(0.697 0.174 144.2)"
  semantic_warning_light: "oklch(0.640 0.150 65.0)"
  semantic_warning_dark: "oklch(0.782 0.158 72.3)"
  semantic_danger_light: "oklch(0.540 0.210 25.0)"
  semantic_danger_dark: "oklch(0.712 0.181 22.8)"
}

ColorPalette rockinfo_light_palette {
  title: "Rockinfo Light"
  categorical {
    colors: [
      "oklch(0.623 0.188 259.8)",
      "oklch(0.620 0.160 150.0)",
      "oklch(0.660 0.150 65.0)",
      "oklch(0.560 0.180 300.0)",
      "oklch(0.640 0.120 200.0)",
      "oklch(0.620 0.140 115.0)",
      "oklch(0.660 0.190 342.0)",
      "oklch(0.575 0.218 23.2)"
    ]
  }
}

PageTheme rockinfo_light_theme {
  title: "Rockinfo Light"
  color {
    data: rockinfo_light_palette
  }
  background {
    bg_color: rockinfo_brand("background_light")
  }
  canvas {
    background {
      bg_color: rockinfo_brand("canvas_bg_light")
    }
    border {
      border_width: 0
      border_radius: 14
      border_color: rockinfo_brand("border_light")
      border_style: "none"
    }
    shadow: "none"
    opacity: 1
  }
  block {
    background {
      bg_color: rockinfo_brand("block_bg_light")
    }
    border {
      border_width: 1
      border_style: "solid"
      border_radius: 14
      border_color: rockinfo_brand("border_light")
    }
    shadow: "none"
    padding: 16
    opacity: 1
    label {
      font_family: rockinfo_brand("font_display")
      font_size: 14
      font_color: rockinfo_brand("text_primary_light")
      font_weight: "semibold"
      font_style: "normal"
      letter_spacing: "0"
    }
    text {
      font_family: rockinfo_brand("font_body")
      font_size: 13
      font_color: rockinfo_brand("text_muted_light")
      font_weight: "normal"
      font_style: "normal"
    }
  }
  viz {
    table {
      general {
        bg_color: rockinfo_brand("block_bg_light")
        font_color: rockinfo_brand("text_muted_light")
        font_family: rockinfo_brand("font_body")
        font_size: 13
        border_color: rockinfo_brand("border_light")
        grid_color: rockinfo_brand("border_light")
        border_width: 1
        hover_color: "oklch(1.000 0.003 260.0)"
        banding_color: "oklch(0.985 0.004 260.0)"
        cell_padding: DetailedSpacing {
          top: 10
          right: 16
          bottom: 10
          left: 16
        }
        borders {
          outer: true
          vertical: false
          horizontal: true
          header: true
          row_header: false
        }
      }
      header {
        bg_color: rockinfo_brand("background_light")
        font_color: rockinfo_brand("text_primary_light")
        font_size: 13
        font_weight: "semibold"
      }
      sub_header {
        bg_color: "oklch(0.985 0.004 260.0)"
        font_color: rockinfo_brand("text_muted_light")
        font_size: 13
        font_weight: "medium"
      }
      sub_title {
        font_color: rockinfo_brand("text_subtle_light")
        font_size: 12
        font_weight: "medium"
      }
      sparkline {
        line {
          color: rockinfo_brand("primary")
        }
        column {
          color: rockinfo_brand("primary")
        }
      }
    }
    metric_kpi {
      alignment: "left"
      label {
        font_family: rockinfo_brand("font_body")
        font_size: 20
        font_color: rockinfo_brand("text_muted_light")
      }
      value {
        font_family: rockinfo_brand("font_display")
        font_size: 48
        font_color: rockinfo_brand("text_primary_light")
      }
      progress {
        indicator {
          bg_color: rockinfo_brand("primary")
        }
        track {
          bg_color: rockinfo_brand("border_light")
        }
        text {
          font_color: rockinfo_brand("text_muted_light")
        }
      }
      trend {
        positive {
          text {
            font_color: rockinfo_brand("semantic_success_light")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.940 0.040 144.2)"
          }
        }
        negative {
          text {
            font_color: rockinfo_brand("semantic_danger_light")
            font_weight: "medium"
          }
          background {
            bg_color: "oklch(0.930 0.040 25.0)"
          }
        }
        neutral {
          text {
            font_color: rockinfo_brand("text_muted_light")
            font_weight: "normal"
          }
          background {
            bg_color: "oklch(0.930 0.008 260.0)"
          }
        }
      }
    }
  }
  custom_css: @css
    @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap');
    .dac-text-block {
      font-family: Inter;
      font-size: 14px;
      color: oklch(0.413 0.018 235.8);
      line-height: 1.6;
    }
    .dac-text-block h1, .dac-text-block h2, .dac-text-block h3, .dac-text-block h4, .dac-text-block h5, .dac-text-block h6 {
      font-family: 'Inter Tight';
      color: oklch(0.205 0.030 267.0);
      line-height: 1.3;
      margin-top: 0;
      margin-bottom: 0.5em;
      font-weight: 600;
    }
  ;;
}

ColorPalette rockinfo_dark_palette {
  title: "Rockinfo Dark"
  categorical {
    colors: [
      "oklch(0.660 0.170 259.8)",
      "oklch(0.690 0.150 150.0)",
      "oklch(0.730 0.140 65.0)",
      "oklch(0.620 0.160 300.0)",
      "oklch(0.710 0.110 200.0)",
      "oklch(0.690 0.130 115.0)",
      "oklch(0.710 0.170 342.0)",
      "oklch(0.640 0.200 23.2)"
    ]
  }
}

