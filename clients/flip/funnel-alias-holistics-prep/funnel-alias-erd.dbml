Ref: flip_funnel_allocation.primary_key < flip_deals_closed_won.foreign_key_closed_won_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_closed_lost.foreign_key_closed_lost_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_close_date.foreign_key_close_date_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_expected_sd_date.foreign_key_expected_sd_date_marketing_filters_allocation

// Current allocation Explore non-deal joins.
Ref: flip_funnel_allocation.(date_date, deal_source_channel_department_hubspot, deal_allocation) > flip_gtm_targets_by_department.(date_date, department, deal_allocation)
Ref: flip_funnel_allocation.(date_date, deal_allocation) <> flip_gtm_sales_pipeline_snapshot.(period_date, deal_allocation)
Ref: flip_funnel_allocation.(date_date, deal_allocation) <> flip_gtm_partner_pipeline_snapshot.(period_week_date, deal_allocation)
Ref: flip_funnel_allocation.foreign_key_contacts_table < flip_contacts_lead.foreign_key_lead_marketing_filters_allocation
Ref: flip_funnel_allocation.foreign_key_contacts_table < flip_contacts_mql.foreign_key_mql_marketing_filters_allocation
Ref: flip_funnel_allocation.foreign_key_contacts_table < flip_contacts_sql.foreign_key_sql_marketing_filters_allocation
Ref: flip_funnel_allocation.foreign_key_contacts_table < flip_contacts_opportunity.foreign_key_opportunity_marketing_filters_allocation
Ref: flip_funnel_allocation.foreign_key_contacts_table < flip_contacts_created_at.foreign_key_created_at_date_marketing_filters_allocation
Ref: flip_funnel_allocation.foreign_key_bdr_targets <> flip_hubspot_calls_sales.joining_key_date_owner
Ref: flip_funnel_allocation.foreign_key_bdr_targets <> flip_hubspot_emails_sales.joining_key_date_owner
Ref: flip_funnel_allocation.foreign_key_bdr_targets <> flip_hubspot_meetings_by_meeting_date.joining_key_date_owner
Ref: flip_funnel_allocation.foreign_key_bdr_targets <> flip_hubspot_meetings_by_create_date.joining_key_create_date_owner
Ref: flip_funnel_allocation.foreign_key_bdr_targets <> flip_salesloft_meetings_held.foreign_key_date_name
Ref: flip_deals_sao.deal_id <> flip_marketing_influence_for_sao.deal_id
Ref: flip_deals_closed_won.deal_id <> flip_marketing_influence_for_closed_won.deal_id
