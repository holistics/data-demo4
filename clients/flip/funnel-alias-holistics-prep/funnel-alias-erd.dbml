// Flip GmbH — focused ERD for source-lookml/internal_marketing.model.lkml.
// Scope: current Looker Explore `marketing_funnel_allocation` from the funnel-alias prep bundle.
// This is logical ERD documentation, not warehouse DDL. It preserves Looker role-playing aliases as
// separate DBML tables even when they point to the same physical BigQuery table.
//
// Fully inspected local source files:
// - source-lookml/model/internal_marketing.model.lkml
// - source-lookml/base_views/Reports/marketing_filters_allocation_base.view.lkml
// - source-lookml/extended_views/Reports/marketing_filters_allocation_ext.view.lkml
// - source-lookml/base_views/Datamarts/hubspot_deals_all_base.view.lkml
// - source-lookml/extended_views/Datamarts/hubspot_deals_all_ext.view.lkml
//
// External/stub entities below are referenced by the model file but their view definitions are not
// present in this narrow prep source-lookml folder.

// COLOR LEGEND BY ORIGINAL SOURCE
// #1E88E5 marketing_filters_allocation_ext / reports_poc.marketing_filters_allocation
// #43A047 hubspot_deals_all_ext / datamarts_poc.hubspot_deals_all role aliases
// #FB8C00 gtm_targets_by_department_ext
// #F9A825 gtm_sales_pipeline_over_time_ext
// #FBC02D gtm_partner_pipeline_over_time_ext
// #8E24AA hubspot_contacts_all_ext role aliases
// #6D4C41 hubspot_engagement_calls_sales_ext
// #546E7A hubspot_engagement_emails_sales_ext
// #00ACC1 hubspot_engagement_meetings_sales_ext role aliases
// #3949AB salesloft_meetings_held_ext
// #E53935 hubspot_deal_marketing_influence_touchpoint_ext role aliases

Project flip_funnel_alias_erd {
  database_type: 'BigQuery'
  Note: 'Logical ERD for Flip Looker marketing_funnel_allocation. Root table is reports_poc.marketing_filters_allocation. Deal stage aliases all use datamarts_poc.hubspot_deals_all with different stage/date foreign keys. Looker join types are mostly FULL OUTER; DBML arrows document field equality/cardinality only, while join type and predicates are kept in notes.'
}

Table flip_funnel_allocation [headercolor: #1E88E5, note: 'LookML view: marketing_filters_allocation_ext extends marketing_filters_allocation_base. Physical table: `fl-bi-p-poc.reports_poc.marketing_filters_allocation`. Explore alias/root: marketing_funnel_allocation. Grain appears to be one row per date/source/allocation/target key via primary_key, but warehouse uniqueness was not verified.'] {
  primary_key varchar [pk, note: 'Source: marketing_filters_allocation.primary_key. Main join key for deal stage aliases.']
  date_date date [note: 'LookML dimension_group date, date timeframe. Used to join target and pipeline snapshot facts.']
  deal_allocation varchar [note: 'Used with date_date to join pipeline snapshots and department targets.']
  deal_source_channel_department_hubspot varchar [note: 'Used with date_date and deal_allocation to join department targets.']
  deal_source_channel_cluster_hubspot varchar
  deal_source_channel_inbound_vs_outbound_hubspot varchar
  asset_name varchar
  sales_region varchar
  bdr_team varchar
  bdr_teamlead varchar
  foreign_key_contacts_table varchar [note: 'Contact lifecycle aliases join through this key. Contact view definitions are outside this prep bundle.']
  foreign_key_bdr_targets varchar [note: 'Sales activity aliases join through this key. Activity view definitions are outside this prep bundle.']
  foreign_key_date_source_channel varchar [note: 'Distinct key for daily spend measures.']
  foreign_key_date_trunc_quarter_source_channel varchar [note: 'Distinct key for quarterly planned spend measures.']
  unique_key_targets_in_looker varchar [note: 'Distinct key used by target sum_distinct measures.']
  lead_count_base_target decimal
  mql_count_base_target decimal
  sql_count_base_target decimal
  sal_count_base_target decimal
  sao_count_base_target decimal
  sao_volume_euros_base_target decimal
  closed_won_count_base_target decimal
  closed_won_volume_euros_base_target decimal
  channel_daily_total_spend_euros decimal
  channel_planned_quarterly_spend_euros decimal
}

Table flip_deals_sal [headercolor: #43A047, note: 'Role alias: hubspot_sal. Physical table: `fl-bi-p-poc.datamarts_poc.hubspot_deals_all`. Looker join: FULL OUTER one_to_many. Additional local predicates: is_license_overrun_deal IS false AND exclude_flip_flow_sals IS true.'] {
  deal_id varchar [pk]
  primary_key varchar [note: 'Source view primary_key, not the funnel-allocation key used by this role.']
  foreign_key_sal_marketing_filters_allocation varchar [note: 'Joins to flip_funnel_allocation.primary_key.']
  dmt_sal_date date [note: 'Role date for SAL counting.']
  is_license_overrun_deal boolean [note: 'SAL-local filter requires false.']
  exclude_flip_flow_sals boolean [note: 'SAL-local filter requires true.']
  deal_name varchar
  deal_allocation varchar
  deal_source_channel_department_hubspot varchar
  new_business_vs_upsell varchar
  current_amount_euros decimal
}

Table flip_deals_sao [headercolor: #43A047, note: 'Role alias: hubspot_sao. Physical table: `fl-bi-p-poc.datamarts_poc.hubspot_deals_all`. Looker join: FULL OUTER one_to_many. Marketing-influence touchpoints join downstream from this role by deal_id.'] {
  deal_id varchar [pk]
  primary_key varchar
  foreign_key_sao_marketing_filters_allocation varchar [note: 'Joins to flip_funnel_allocation.primary_key.']
