// Current allocation Explore role-playing deal aliases.
Ref: flip_funnel_allocation.primary_key < flip_deals_sal.foreign_key_sal_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_sao.foreign_key_sao_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_solution_design.foreign_key_solution_design_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_evaluation.foreign_key_evaluation_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_proposal.foreign_key_proposal_marketing_filters_allocation
Ref: flip_funnel_allocation.primary_key < flip_deals_negotiation.foreign_key_negotiations_marketing_filters_allocation
