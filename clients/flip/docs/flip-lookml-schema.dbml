  "number_of_transformation_meddic_scores" decimal [note: 'Column-backed; SQL: ${TABLE}.number_of_transformation_meddic_scores; hidden: yes']
  "one_off_deal_amount" decimal [note: 'Column-backed; SQL: ${TABLE}.one_off_deal_amount; label: Deal Amount - One Off']
  "one_off_total_amount" decimal [note: 'Column-backed; SQL: ${TABLE}.one_off_total_amount; label: Deal Amount - One Off Total']
  "open_pipe_volume_euros" decimal [note: 'Column-backed; SQL: ${TABLE}.open_pipe_volume_euros; hidden: yes']
  "open_pipe_volume_in_record_currency" decimal [note: 'Column-backed; SQL: ${TABLE}.open_pipe_volume_in_record_currency']
  "is_partnerships_involved" boolean [note: 'Column-backed; SQL: ${TABLE}.is_partnerships_involved; label: Is Partner involved']
  "pipeline_label" varchar [note: 'Column-backed; SQL: ${TABLE}.pipeline_label; description: Name of the pipeline which the Deal belong to in HubSpot.; label: Pipeline']
  "presales_1__pre_project_pitched" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.presales_1__pre_project_pitched_date", "name": "presales_1__pre_project_pitched"}']
  "presales_1__pre_project_won" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.presales_1__pre_project_won_date", "name": "presales_1__pre_project_won"}']
  "presales_3_with_integrations" boolean [note: 'Column-backed; SQL: ${TABLE}.presales_3_with_integrations']
  "presales_name" varchar [note: 'Column-backed; SQL: ${TABLE}.presales_name; description: Current Presales Name associated to the Deal.; label: Presales Name']
  "previous_amount_in_record_currency" decimal [note: 'Column-backed; SQL: ${TABLE}.previous_amount_in_record_currency']
  "primary_key" varchar [note: 'Column-backed; SQL: ${TABLE}.primary_key']
  "sales_region" varchar [note: 'Column-backed; SQL: ${TABLE}.sales_region; label: Sales Region']
  "setup_amount" decimal [note: 'Column-backed; SQL: ${TABLE}.setup_amount; label: Deal Amount - Setup']
  "source_channel_hubspot" varchar [note: 'Column-backed; SQL: ${TABLE}.source_channel_hubspot; label: Source Channel Hubspot OLD']
  "stage_label" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_label; description: Name of the current pipeline stage which the Deal belong to in HubSpot.; label: Deal Stage: current']
  "standardised_deal_value_euros" decimal [note: 'Column-backed; SQL: ${TABLE}.standardised_deal_value_euros; hidden: yes']
  "standardised_deal_value_in_record_currency" decimal [note: 'Column-backed; SQL: ${TABLE}.standardised_deal_value_in_record_currency; hidden: yes']
  "territory_id" varchar [note: 'Column-backed; SQL: ${TABLE}.territory_id; description: ID of the Territory which the Company associated to the Deal belong to.; label: Territory ID']
  "total_contract_value_euros" decimal [note: 'Column-backed; SQL: ${TABLE}.total_contract_value_euros; label: € Total Contract Value; hidden: yes']
  "trade_show" varchar [note: 'Column-backed; SQL: ${TABLE}.trade_show; description: Name of the Trade Show in case the Lead of the Deal was a Trade Show sourced Lead.; label: Trade Show']
  "transformation_meddic_co_competition_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_co_competition_score; hidden: yes']
  "transformation_meddic_dc_decision_criteria_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_dc_decision_criteria_score; hidden: yes']
  "transformation_meddic_deal_champion_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_deal_champion_score; hidden: yes']
  "transformation_meddic_dp_decision_path_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_dp_decision_path_score; hidden: yes']
  "transformation_meddic_e_economic_buyers_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_e_economic_buyers_score; hidden: yes']
  "transformation_meddic_i_implicated_pain_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_i_implicated_pain_score; hidden: yes']
  "transformation_meddic_m_metrics_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_m_metrics_score; hidden: yes']
  "transformation_meddic_p_paper_process_score" decimal [note: 'Column-backed; SQL: ${TABLE}.transformation_meddic_p_paper_process_score; hidden: yes']
  "weeks_in_current_stage" decimal [note: 'Column-backed; SQL: ${TABLE}.weeks_in_current_stage; label: Weeks in current stage']
  "foreign_key_rd_sao" varchar [note: 'Column-backed; SQL: ${TABLE}.foreign_key_rd_sao; hidden: yes']
  "foreign_key_rd_closed_won" varchar [note: 'Column-backed; SQL: ${TABLE}.foreign_key_rd_closed_won; hidden: yes']
  "foreign_key_revenue_rd_copied_at" varchar [note: 'Column-backed; SQL: ${TABLE}.foreign_key_revenue_rd_copied_at; hidden: yes']
  "lost_amount_euros" varchar [note: 'Column-backed; SQL: ${TABLE}.lost_amount_euros; label: Lost Amount']
  "one_off_cost" decimal [note: 'Column-backed; SQL: ${TABLE}.one_off_cost']
  "stage_after_sao" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_after_sao; label: Stage after SAO']
  "stage_after_solution_design" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_after_solution_design; label: Stage after Solution Design']
  "stage_after_evaluation" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_after_evaluation; label: Stage after Evaluation']
  "stage_after_proposal" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_after_proposal; label: Stage after Proposal']
  "stage_after_negotiation" varchar [note: 'Column-backed; SQL: ${TABLE}.stage_after_negotiation; label: Stage after Negotiation']
  "revenue_signed_date" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${is_lost_revenue} is TRUE THEN COALESCE (${churn_date}, ${dmt_closed_won_date}) ELSE ${dmt_closed_won_date} END; description: This date indicates the latest significant signed date (either Closed Won or when Churn Date); hidden: no']
  "is_mtd" boolean [note: 'Calculated LookML dimension; SQL: EXTRACT(MONTH from DATE(${revenue_signed_date})) = EXTRACT(MONTH from CURRENT_DATE()); label: is MTD (signed)']
  "is_ytd" boolean [note: 'Calculated LookML dimension; SQL: EXTRACT(YEAR from DATE(${revenue_signed_date})) = EXTRACT(YEAR from CURRENT_DATE()); label: is YTD (signed)']
  "dynamic_date_sao" varchar [note: 'Calculated LookML dimension; SQL: {% if date_granularity._parameter_value == \'month\' %} ${dmt_sao_month} {% elsif date_granularity._parameter_value == \'quarter\' %} CONCAT(${dmt_sao_year},"-",${dmt_sao_quarter_of_year}) {% elsif date_granularity._parameter_value == \'year\' %} LEFT(CAST(DATE_TRUNC(${dmt_sao_date},YEAR) AS STRING),4) {% else %} ${dmt_sao_date} {% endif %}']
  "dynamic_close_date" varchar [note: 'Calculated LookML dimension; SQL: {% if date_granularity._parameter_value == \'month\' %} ${close_month} {% elsif date_granularity._parameter_value == \'quarter\' %} CONCAT(${close_year},"-",${close_quarter_of_year}) {% elsif date_granularity._parameter_value == \'year\' %} LEFT(CAST(DATE_TRUNC(${close_date},YEAR) AS STRING),4) {% else %} ${close_date} {% endif %}']
  "dynamic_date_closed_won" varchar [note: 'Calculated LookML dimension; SQL: {% if date_granularity._parameter_value == \'month\' %} ${dmt_closed_won_month} {% elsif date_granularity._parameter_value == \'quarter\' %} CONCAT(${dmt_closed_won_year},"-",${dmt_closed_won_quarter_of_year}) {% elsif date_granularity._parameter_value == \'year\' %} LEFT(CAST(DATE_TRUNC(${dmt_closed_won_date},YEAR) AS STRING),4) {% else %} ${dmt_closed_won_date} {% endif %}']
  "dynamic_date_closed_lost" varchar [note: 'Calculated LookML dimension; SQL: {% if date_granularity._parameter_value == \'month\' %} ${dmt_closed_lost_month} {% elsif date_granularity._parameter_value == \'quarter\' %} CONCAT(${dmt_closed_lost_year},"-",${dmt_closed_lost_quarter_of_year}) {% elsif date_granularity._parameter_value == \'year\' %} LEFT(CAST(DATE_TRUNC(${dmt_closed_lost_date},YEAR) AS STRING),4) {% else %} ${dmt_closed_lost_date} {% endif %}']
  "dynamic_date_customer_signed_hc" varchar [note: 'Calculated LookML dimension; SQL: {% if date_granularity._parameter_value == \'month\' %} ${dmt_closed_won_group_month} {% elsif date_granularity._parameter_value == \'quarter\' %} CONCAT(${dmt_closed_won_group_year},"-",${dmt_closed_won_group_quarter_of_year}) {% elsif date_granularity._parameter_value == \'year\' %} LEFT(CAST(DATE_TRUNC(${dmt_closed_won_group_date},YEAR) AS STRING),4) {% else %} ${dmt_closed_won_group_year} {% endif %}']
  "dynamic_join_condition" varchar [note: 'Calculated LookML dimension; SQL: {% if exclude_flip_flow_sals_param._parameter_value == \'all\' %} (1=1) {% elsif exclude_flip_flow_sals_param._parameter_value == \'yes\' %} (${TABLE}.exclude_flip_flow_sals) {% elsif exclude_flip_flow_sals_param._parameter_value == \'no\' %} (NOT ${TABLE}.exclude_flip_flow_sals) {% else %} (1=1) {% endif %}; hidden: yes']
  "is_recurring" boolean [note: 'Calculated LookML dimension; SQL: ${current_amount_euros} IS NOT NULL']
  "is_churned" boolean [note: 'Calculated LookML dimension; SQL: ${churn_raw} IS NOT NULL; description: Signed Perspective: indicates if the deal was cancelled by the customer (but mustn\'t be expired yet).; label: Is churned (signed)']
  "is_churned_today" boolean [note: 'Calculated LookML dimension; SQL: ${churn_raw} <= current_date(); description: Recognized Perspective: indicates if the deal (was cancelled and) is already expired as of today.; label: Is churned (today)']
  "negative_positive_amounts" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${current_amount_euros} < 0 THEN "negative" WHEN ${current_amount_euros} > 0 THEN "positive" WHEN ${current_amount_euros} = 0 THEN "zero" ELSE NULL END']
  "deals_relevant_for_cs" boolean [note: 'Calculated LookML dimension; SQL: (${deal_type} IN ("New Business","New Business EDEKA","Upsell","Upsell EDEKA", "Renewal") AND ${stage_label} = "Closed Won") OR (${deal_type} = "POV")']
  "deals_relevant_for_cs_nrr" boolean [note: 'Calculated LookML dimension; SQL: (${deal_type} IN ("New Business EDEKA","Upsell","Upsell EDEKA","POV", "Renewal") AND ${stage_label} = "Closed Won")']
  "is_sao" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${dmt_sao_date} IS NOT NULL THEN "yes" ELSE "no" END; label: Opp progressed to SAO']
  "funnel_stages_ordered" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${stage_label} = "SAL" THEN "1. SAL" WHEN ${stage_label} = "SAO" THEN "2. SAO" WHEN ${stage_label} = "Solution Design" THEN "3. Solution Design" WHEN ${stage_label} = "Evaluation" THEN "4. Evaluation" WHEN ${stage_label} = "Proposal" THEN "5. Proposal" WHEN ${stage_label} = "Negotiation" THEN "6. Negotiations" WHEN ${stage_label} = "Closing Validation" THEN "7. Closing Validation" WHEN ${stage_label} = "Closed Won" THEN "8. Closed Won" WHEN ${stage_label} = "Closed Lost" THEN "9. Closed Lost" ELSE NULL END; label: Deal Stages: current, numerated']
  "company_name" varchar [note: 'Calculated LookML dimension; SQL: ${company_name_groups}; label: Company Name']
  "created_at_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${created_at_date}; label: Created At Date; hidden: yes']
  "close_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${close_date}; label: Close Date']
  "contact_dmt_lead_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${contact_dmt_lead_date}; label: Contact DMT Lead']
  "contact_dmt_mql_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${contact_dmt_mql_date}; label: Contact DMT MQL']
  "contact_dmt_sql_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${contact_dmt_sql_date}; label: Contact DMT SQL']
  "presales_1_pre_project_delivery_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${presales_1_pre_project_delivery_date}; label: PreSales 1. Pre-Project Delivery Date']
  "presales_2_discovery_delivery_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${presales_2_discovery_delivery_date}; label: PreSales 2. Discovery Delivery Date']
  "presales_3_demo_delivery_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${presales_3_demo_delivery_date}; label: PreSales 3. Demo Delivery Date']
  "presales_4_pov_delivery_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${presales_4_pov_delivery_date}; label: PreSales 4. POV Delivery Date']
  "presales_1__pre_project_won_yn" boolean [note: 'Calculated LookML dimension; SQL: CASE WHEN ${presales_1__pre_project_won} = "true" THEN true ELSE false END; label: PreSales 1. Pre-Project is Won']
  "next_step_date_corrected" varchar [note: 'Calculated LookML dimension; SQL: IFNULL(CAST(${next_step_date} AS string),"-"); hidden: yes']
  "next_step_date_formatted" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${next_step_date} < CURRENT_DATE() THEN 2 WHEN ${next_step_date} IS NULL THEN 1 ELSE 0 END; label: Next Step Date - formatted']
  "days_in_current_stage_formatted" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${days_in_current_stage} > 15 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "SAL" THEN 1 WHEN ${days_in_current_stage} > 30 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "SAL" THEN 1 WHEN ${days_in_current_stage} > 30 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "SAL" THEN 1 WHEN ${days_in_current_stage} > 15 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "SAO" THEN 1 WHEN ${days_in_current_stage} > 30 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "SAO" THEN 1 WHEN ${days_in_current_stage} > 45 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "SAO" THEN 1 WHEN ${days_in_current_stage} > 15 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "Solution Design" THEN 1 WHEN ${days_in_current_stage} > 45 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "Solution Design" THEN 1 WHEN ${days_in_current_stage} > 75 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "Solution Design" THEN 1 WHEN ${days_in_current_stage} > 10 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "Evaluation" THEN 1 WHEN ${days_in_current_stage} > 45 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "Evaluation" THEN 1 WHEN ${days_in_current_stage} > 60 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "Evaluation" THEN 1 WHEN ${days_in_current_stage} > 2 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "Proposal" THEN 1 WHEN ${days_in_current_stage} > 7 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "Proposal" THEN 1 WHEN ${days_in_current_stage} > 10 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "Proposal" THEN 1 WHEN ${days_in_current_stage} > 2 AND ${deal_segment} = "1. Smart" AND ${stage_label} = "Negotiation" THEN 1 WHEN ${days_in_current_stage} > 30 AND ${deal_segment} = "2. Enterprise" AND ${stage_label} = "Negotiation" THEN 1 WHEN ${days_in_current_stage} > 30 AND ${deal_segment} = "4. Strategic" AND ${stage_label} = "Negotiation" THEN 1 ELSE 0 END; description: If the Days in current Stage are above the benchmark, the field is highlighted in red. Benchmarks owned by Qazi; label: Days in current stage - formatted']
  "closed_date_formatted" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${close_date} < CURRENT_DATE() THEN 2 WHEN ${close_date} IS NULL THEN 1 ELSE 0 END; label: Close Date - formatted']
  "dmt_sal_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_sal_date}; label: DMT SAL; hidden: yes']
  "dmt_sao_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_sao_date}; label: DMT SAO; hidden: yes']
  "dmt_solution_design_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_solution_design_date}; label: DMT Solution Design; hidden: yes']
  "dmt_evaluation_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_evaluation_date}; label: DMT Evaluation; hidden: yes']
  "dmt_proposal_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_proposal_date}; label: DMT Proposal; hidden: yes']
  "dmt_negotiation_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_negotiations_date}; label: DMT Negotiation; hidden: yes']
  "dmt_closing_validation_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_closed_won_validation_date}; label: DMT Closing Validation; hidden: yes']
  "dmt_closed_won_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_closed_won_date}; label: DMT Closed Won; hidden: yes']
  "dmt_closed_lost_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${dmt_closed_lost_date}; label: DMT Closed Lost; hidden: yes']
  "expected_sd_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${expected_sd_date}; label: Expected SD Date; hidden: yes']
  "date_left_sao_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${date_left_sao_date}; label: Date left SAO; hidden: yes']
  "date_left_solution_design_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${date_left_solution_design_date}; label: Date left Solution Design; hidden: yes']
  "date_left_evaluation_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${date_left_evaluation_date}; label: Date left Evaluation; hidden: yes']
  "date_left_proposal_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${date_left_proposal_date}; label: Date left Proposal; hidden: yes']
  "date_left_negotiation_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${date_left_negotiation_date}; label: Date left Negotiation; hidden: yes']
  "contract_start_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${contract_start_date}; label: Customer Start Date; hidden: yes']
  "next_step_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${next_step_date}; label: Next Step Date']
  "days_since_go_live_date" decimal [note: 'Calculated LookML dimension; SQL: DATE_DIFF(${go_live_date}, current_date(), DAY); hidden: yes']
  "months_since_go_live_floor" decimal [note: 'Calculated LookML dimension; SQL: FLOOR(${days_since_go_live_date}/(30)); description: Number of months since the Customer went live; label: Months since GoLive']
  "number_of_employees_tiers" varchar [note: 'Calculated LookML dimension; SQL: ${number_of_employees}; label: Tier # Employees (250-500-1k-2.5k-5k-10k-25k)']
  "number_of_employees_tiers_2" varchar [note: 'Calculated LookML dimension; SQL: ${number_of_employees}; label: Tier # Employees (100-300-500-750-1.5k-3k)']
  "number_of_employees_tiers_maxi" varchar [note: 'Calculated LookML dimension; SQL: ${number_of_employees}; label: Tier # Employees (500-2.5k-5k-25k)']
  "number_of_employees_tiers_coenraad" varchar [note: 'Calculated LookML dimension; SQL: ${number_of_employees}; label: Tier # Employees (500-1k-3k-10k)']
  "dynamic_channel" varchar [note: 'Calculated LookML dimension; SQL: {% if dynamic_channel_parameter._parameter_value == \'sub_category\' %} (${deal_source_channel_drilldown_hubspot}) {% else %} ${deal_source_channel_department_hubspot} -- (CASE WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IN ("management/investor referral") THEN "Mgmt/Inv" -- WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IN ("cs referral") THEN "CS" -- WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IN ("partner") THEN "Partner" -- WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IN ("bdr outbound") THEN "BDR Out" -- WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IN ("ae outbound") THEN "AE Out" -- WHEN LOWER(${deal_source_channel_drilldown_hubspot}) IS NULL OR LOWER(${deal_source_channel_drilldown_hubspot}) IN ("w/o","-") THEN "w/o" -- ELSE "Marketing" END -- ) {% endif %}']
  "churn" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.churn_date", "name": "churn", "label": "Date - Churn (DMT)"}']
  "churned_date_customer" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.churned_date_customer", "name": "churned_date_customer", "label": "Date - DMT Churned Customer Date"}']
  "churned_date_group" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.churned_date_group", "name": "churned_date_group", "label": "Date - DMT Churned Customer Group Date"}']
  "close" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "quarter_of_year", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.close_date", "name": "close", "label": "Date - (expected) Close", "description": "Date which the Deal is supposed to be closed: either Won or Lost."}']
  "contact_dmt_lead" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.contact_dmt_lead", "name": "contact_dmt_lead", "label": "Date - Contact DMT Lead"}']
  "contact_dmt_mql" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.contact_dmt_mql", "name": "contact_dmt_mql", "hidden": "yes"}']
  "contact_dmt_sql" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.contact_dmt_sql", "name": "contact_dmt_sql", "hidden": "yes"}']
  "contract_start" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.contract_start_date", "name": "contract_start", "label": "Date - Contract Start (recognized)"}']
  "copied_at" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.copied_at_date", "name": "copied_at", "label": "Date - Copied at"}']
  "copied_at_timestamp" timestamp [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "time", "date", "week", "month", "quarter", "year"], "sql": "${TABLE}.copied_at_timestamp", "name": "copied_at_timestamp", "hidden": "yes"}']
  "created_at" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.created_at_date", "name": "created_at", "label": "Date - Created at", "description": "The date the Deal was created at."}']
