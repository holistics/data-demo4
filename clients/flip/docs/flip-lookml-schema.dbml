  "sl_created_at_berlin_timestamp" timestamp [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "time", "date", "week", "month", "quarter", "year"], "sql": "${TABLE}.sl_created_at_berlin_timestamp", "name": "sl_created_at_berlin_timestamp"}']
