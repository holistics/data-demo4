  "sl_imported_at_berlin_timestamp" timestamp [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "time", "date", "week", "month", "quarter", "year"], "sql": "${TABLE}.sl_imported_at_berlin_timestamp", "name": "sl_imported_at_berlin_timestamp"}']
