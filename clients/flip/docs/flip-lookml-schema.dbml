  "hs_associated_deal_name" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_associated_deal_name; label: Associated Deal']
  "hs_meeting_held_id" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_meeting_held_id']
  "hs_meeting_outcome" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_meeting_outcome']
  "hs_meeting_owner_team" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_meeting_owner_team; label: Meeting Owner']
