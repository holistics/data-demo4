Table "salesloft_meetings_held_ext" {
  "foreign_key_date_name" varchar [note: 'Column-backed; SQL: ${TABLE}.foreign_key_date_name']
  "hs_meeting_activity_type" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_meeting_activity_type']
  "hs_associated_company_id" varchar [note: 'Column-backed; SQL: ${TABLE}.hs_associated_company_id']
