  "sl_meeting_owner" varchar [note: 'Column-backed; SQL: ${TABLE}.sl_meeting_owner; label: User Name']
  "hs_meeting_category" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${hs_meeting_activity_type} = "Qualification Call" THEN "initial meeting" WHEN ${hs_meeting_activity_type} = "First Discovery Call" THEN "outbound" WHEN ${hs_meeting_activity_type} = "Demo Call" THEN "inbound" WHEN ${hs_meeting_activity_type} IN ("AE supporting BDR", "Value Proposition", "Fixed Phone Call", "Check-In/General Call", "Progression Call", "Negotiation Call") THEN "follow-up meetings" ELSE null END']
