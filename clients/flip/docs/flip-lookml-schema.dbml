  "create_date_drilldown" varchar [note: 'Calculated LookML dimension; SQL: ${meeting_create_date}; label: Meeting created at Date; hidden: yes']
  "meeting_category" varchar [note: 'Calculated LookML dimension; SQL: CASE WHEN ${meeting_activity_type} = "Qualification Call" THEN "initial meeting" WHEN ${meeting_activity_type} = "First Discovery Call" THEN "outbound" WHEN ${meeting_activity_type} = "Demo Call" THEN "inbound" WHEN ${meeting_activity_type} IN ("AE supporting BDR", "Value Proposition", "Fixed Phone Call", "Check-In/General Call", "Progression Call", "Negotiation Call") THEN "follow-up meetings" ELSE null END']
  "meeting_create" date [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "date", "week", "month", "quarter", "year"], "convert_tz": "no", "datatype": "date", "sql": "${TABLE}.meeting_create_date", "name": "meeting_create"}']
  "meeting" timestamp [note: 'LookML dimension_group (not a standalone physical column); {"type": "time", "timeframes": ["raw", "time", "date", "week", "month", "quarter", "year"], "sql": "${TABLE}.meeting_time", "name": "meeting"}']
  Note: 'LookML view: hubspot_engagement_meetings_sales_ext | Sources: base_views/Datamarts/hubspot_engagement_meetings_sales_base.view.lkml, extended_views/Datamarts/hubspot_engagement_meetings_sales_ext.view.lkml | Warehouse source: `fl-bi-p-poc.datamarts_poc.hubspot_engagement_meetings_sales` | Measure (not a column): count; type=count | Measure (not a column): duration_min; type=sum_distinct; sql_distinct_key=${meeting_id}'
}

