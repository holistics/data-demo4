// =====================================================================
// Seed Company - Solution B: fiscal periods as labels.
//
// Same +3 month shift underneath, but it is never shown as a date. The
// user picks 'FY2026', 'FY2026-Q1', 'Oct FY2026' from three dropdowns.
// Nothing on screen is three months late, and nobody has to know which
// date filter is the honest one.
//
// Self-contained: everything this page needs is in this folder
// (`seed_b_orders`, `seed_b`). Solution A exposes the same shift as a
// visible date; C and D move it off the fact table entirely.
//
// KNOWN LIMIT, and it is not a bug in this file: parent-child filters
// (Fiscal Year narrowing the Fiscal Quarter list) are a DASHBOARD UI
// setting in Holistics. There is no AML property for them - see this
// folder's AGENTS.md. Turn the cascade on after deploying, by editing the
// Fiscal Year filter and enabling Fiscal Quarter as a child filter.
// Without it the dashboard still works, the child dropdowns are just
// longer; the labels are unambiguous, so nothing is wrong, only noisier.
// =====================================================================
Dashboard seed_fy_solution_b {
  title: 'Seed Company - Solution B (Fiscal Period Labels)'
  description: 'Fiscal Year / Quarter / Month as text labels driving three dropdowns. Nothing reads as a shifted calendar date.'

  block t_intro: TextBlock {
    content: @md
### Solution B - the fiscal calendar as labels, not as a date

Three dropdowns: **Fiscal Year**, **Fiscal Quarter**, **Fiscal Month**. The
values read the way Seed's finance team says them out loud - `FY2026`,
`FY2026-Q1`, `Oct FY2026` - and `Oct FY2026` means orders that really closed
in **October 2025**. No date on this dashboard is three months late.

`FY2026` and `FY2026-Q1` sort correctly on their own, because alphabetical and
chronological happen to agree. `Oct FY2026` does not, so the month table
carries the numeric sort keys next to it and sorts on those.

The two right-hand KPIs run off `Fiscal Year Offset` 0 and -1, so they name no
year: they resolve to the latest fiscal year in the data and the one before it,
and they roll over on 1 October with nothing to edit. That is the reusable
"current fiscal year" Seed asked for.

**Leave the Fiscal Year dropdown on `All` for those two to mean what they say.**
The offset is built on `max(fiscal_year_num)`, and `max()` is evaluated inside
the filter scope - the generated SQL puts the dashboard filter in the first CTE
and every later CTE reads from it. Pick a single year and the two cards re-base
onto that year, so `Prior FY` empties out. Making a block genuinely ignore a filter
means unmapping it in the dashboard UI - or moving the fiscal calendar onto the
date dimension, where `of_all()` does it in the metric with nothing to click
after deploy; that is Solution C in this folder. The
dropdown therefore ships with no default, and the cards are labelled *in view*
rather than *current* so the screen never claims more than it does.
    ;;
  }
  block f_fiscal_year: FilterBlock {
    label: 'Fiscal Year'
    type: 'field'
    source: FieldFilterSource {
      dataset: seed_b
      field: r(seed_b_orders.fiscal_year)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }

  block f_fiscal_quarter: FilterBlock {
    label: 'Fiscal Quarter'
    type: 'field'
    source: FieldFilterSource {
      dataset: seed_b
      field: ref('seed_b_orders', 'fiscal_quarter')
    }
    default {
      operator: 'is'
      value: []
    }
  }

  block f_fiscal_month: FilterBlock {
    label: 'Fiscal Month'
    type: 'field'
    source: FieldFilterSource {
      dataset: seed_b
      field: ref('seed_b_orders', 'fiscal_month')
    }
    default {
      operator: 'is'
      value: []
    }
  }

  block kpi_gmv: VizBlock {
    label: 'GMV (Selected Fiscal Period)'
    viz: MetricKpi {
      dataset: seed_b
      value: VizFieldFull {
        ref: r(seed_b.gmv)
        label: 'GMV (Selected)'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_orders: VizBlock {
    label: 'Orders (Selected Fiscal Period)'
    viz: MetricKpi {
      dataset: seed_b
      value: VizFieldFull {
        ref: r(seed_b.total_orders)
        label: 'Orders (Selected)'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_current: VizBlock {
    label: 'GMV (Latest FY in view)'
    viz: MetricKpi {
      dataset: seed_b
      value: VizFieldFull {
        ref: r(seed_b.gmv_current_fy)
        label: 'GMV (Latest FY in view)'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block kpi_prior: VizBlock {
    label: 'GMV (Prior FY in view)'
    viz: MetricKpi {
      dataset: seed_b
      value: VizFieldFull {
        ref: r(seed_b.gmv_prior_fy)
        label: 'GMV (Prior FY in view)'
        format {
          type: 'number'
          pattern: '#,##0'
        }
      }
      settings {
        alignment: 'left'
        metric_value {
          font_size: 30
        }
        label {
          font_size: 12
        }
      }
    }
  }

  block v_by_year: VizBlock {
    label: 'GMV by Fiscal Year'
    viz: ColumnChart {
      dataset: seed_b
      x_axis: VizFieldFull {
        ref: r(seed_b_orders.fiscal_year)
        label: 'Fiscal Year'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(seed_b.gmv)
            label: 'GMV'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color_palette: 1
          }
        }
      }
      settings {
        row_limit: 5000
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
      }
    }
  }

  block v_by_quarter: VizBlock {
    label: 'GMV by Fiscal Quarter'
    viz: ColumnChart {
      dataset: seed_b
      x_axis: VizFieldFull {
        ref: r(seed_b_orders.fiscal_quarter)
        label: 'Fiscal Quarter'
        format {
          type: 'text'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(seed_b.gmv)
            label: 'GMV'
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color_palette: 0
          }
        }
      }
      settings {
        row_limit: 5000
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
      }
    }
  }

  block v_months: VizBlock {
    label: 'Fiscal Months in Order (Oct = 1)'
    viz: DataTable {
      dataset: seed_b
      fields: [
        VizFieldFull {
          ref: r(seed_b_orders.fiscal_month)
          label: 'Fiscal Month'
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(seed_b_orders.fiscal_year_num)
          label: 'FY #'
          format {
            type: 'number'
            pattern: '0'
          }
        },
        VizFieldFull {
          ref: r(seed_b_orders.fiscal_month_num)
          label: 'Month # (Oct = 1)'
          format {
            type: 'number'
            pattern: '0'
          }
        },
        VizFieldFull {
          ref: r(seed_b.gmv)
          label: 'GMV'
          format {
            type: 'number'
            pattern: '#,##0'
          }
        }
      ]
      settings {
        row_limit: 500
        show_row_number: false
        sorts: [
          SortSetting {
            field_index: 1
            direction: 'asc'
          },
          SortSetting {
            field_index: 2
            direction: 'asc'
          }
        ]
      }
    }
  }

  block t_limits: TextBlock {
    content: @md
### What Solution B still does not give you

- **No MTD / QTD / YTD against the fiscal calendar.** These are text labels,
  not dates. `previous period`, `same period last year` and running totals all
  need a real date field, and the only real date here is the calendar one.
- **No date drill.** You cannot click `Oct FY2026` and drill to days.
- **Still per fact table.** Every fact table Seed wants a fiscal view on needs
  these fields added to it. Extending the standard orders model to build this
  demo meant re-declaring **eleven** inherited fields just to compile - that
  cost repeats on every fact table, forever. The alternative is to put fiscal
  year on the **date dimension** instead - that is **Solution C** in this
  folder, where the fact tables carry no fiscal columns at all.
- **The cascade is a UI toggle, not AML.** Fiscal Year narrowing the Fiscal
  Quarter dropdown is set on the dashboard, not in this file.
    ;;
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1440
    height: 1360
    grid_size: 20
    block t_intro {
      position: pos(20, 20, 920, 340)
    }
    block f_fiscal_year {
      position: pos(980, 20, 440, 80)
    }
    block f_fiscal_quarter {
      position: pos(980, 100, 440, 80)
    }
    block f_fiscal_month {
      position: pos(980, 200, 440, 80)
    }
    block kpi_gmv {
      position: pos(20, 380, 340, 120)
    }
    block kpi_orders {
      position: pos(380, 380, 340, 120)
    }
    block kpi_current {
      position: pos(740, 380, 340, 120)
    }
    block kpi_prior {
      position: pos(1100, 380, 320, 120)
    }
    block v_by_year {
      position: pos(20, 520, 460, 360)
    }
    block v_by_quarter {
      position: pos(500, 520, 920, 360)
    }
    block v_months {
      position: pos(20, 900, 700, 380)
    }
    block t_limits {
      position: pos(740, 900, 700, 380)
    }
    mobile {
      mode: 'auto'
    }
  }
}