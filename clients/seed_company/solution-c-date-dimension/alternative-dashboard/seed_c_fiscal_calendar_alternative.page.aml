@tag('Endorsed')
Dashboard seed_c_fiscal_calendar_alternative {
  title: 'Seed Company Fiscal Calendar — Alternative'
  description: @md
An isolated PoC showing safe Oct–Sep fiscal windows and native fiscal rollups without a shifted-date calendar control.
  ;;
  theme: seed_company

  block t_windows_intro: TextBlock {
    content: @md
# Fiscal windows that read like the business

Seed's fiscal year runs **1 October–30 September** and is named by the year in which it ends. Pick a familiar business period below—the date dimension resolves every start date from today and keeps today as the end date.
    ;;
  }

  block v_window_selector: VizBlock {
    label: 'Choose a date-relative window'
    viz: MarkdownViz {
      dataset: seed_c_fiscal_windows
      rows: [
        VizFieldFull { ref: r(seed_c_dates_alternative.in_previous_fy_to_today) label: 'Previous FY Start to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.in_current_fy_to_today) label: 'Current FY to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.in_previous_fq_to_today) label: 'Previous FQ Start to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.in_current_fq_to_today) label: 'Current FQ to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.in_previous_month_to_today) label: 'Previous Month Start to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.in_current_month_to_today) label: 'Current Month Start to Today' },
        VizFieldFull { ref: r(seed_c_dates_alternative.previous_fy_start) label: 'Previous FY Start' format { type: 'date' pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: r(seed_c_dates_alternative.current_fy_start) label: 'Current FY Start' format { type: 'date' pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: r(seed_c_dates_alternative.previous_fq_start) label: 'Previous FQ Start' format { type: 'date' pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: r(seed_c_dates_alternative.current_fq_start) label: 'Current FQ Start' format { type: 'date' pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: r(seed_c_dates_alternative.previous_month_start) label: 'Previous Month Start' format { type: 'date' pattern: 'LLL dd, yyyy' } },
        VizFieldFull { ref: r(seed_c_dates_alternative.current_month_start) label: 'Current Month Start' format { type: 'date' pattern: 'LLL dd, yyyy' } }
      ]
      content: @md
<style>
  .fiscal-presets { display:flex; flex-wrap:nowrap; gap:12px; width:100%; overflow:hidden; }
  .fiscal-preset { display:flex; flex:1 1 0; min-width:0; min-height:92px; box-sizing:border-box; flex-direction:column; justify-content:center; padding:14px 16px; border:2px solid #CDC3B0; border-radius:12px; background:#FFFFFF; color:#323232; text-decoration:none; cursor:pointer; transition:all 160ms ease; }
  .fiscal-preset:hover { border-color:#E35C2A; background:#FBF8F2; transform:translateY(-2px); box-shadow:0 6px 16px rgba(65,69,43,.12); }
  .fiscal-preset.h-drill-selected, .h-drill-selected.fiscal-preset, .fiscal-preset:has(.h-drill-selected) { border-color:#41452B; background:#41452B; color:#FFFFFF; transform:translateY(-1px); box-shadow:0 6px 18px rgba(65,69,43,.20); }
  .fiscal-preset-title { font-size:14px; font-weight:700; line-height:1.25; white-space:nowrap; }
  .fiscal-preset-date { margin-top:7px; font-family:'Red Hat Mono',ui-monospace,monospace; font-size:10px; line-height:1.35; white-space:normal; color:#636466; }
  .fiscal-preset.h-drill-selected .fiscal-preset-date, .h-drill-selected.fiscal-preset .fiscal-preset-date, .fiscal-preset:has(.h-drill-selected) .fiscal-preset-date { color:#F7F1E7; }
  .fiscal-preset:has(.h-drill-selected) .fiscal-preset-title { color:#FFFFFF; }
</style>
<div class="fiscal-presets">
  <h-drill row="0" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last FY</div><div class="fiscal-preset-date">{{ rows[0].`Previous FY Start` }} to today</div></h-drill>
  <h-drill row="1" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This FY</div><div class="fiscal-preset-date">{{ rows[0].`Current FY Start` }} to today</div></h-drill>
  <h-drill row="2" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last FQ</div><div class="fiscal-preset-date">{{ rows[0].`Previous FQ Start` }} to today</div></h-drill>
  <h-drill row="3" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This FQ</div><div class="fiscal-preset-date">{{ rows[0].`Current FQ Start` }} to today</div></h-drill>
  <h-drill row="4" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last month</div><div class="fiscal-preset-date">{{ rows[0].`Previous Month Start` }} to today</div></h-drill>
  <h-drill row="5" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This month</div><div class="fiscal-preset-date">{{ rows[0].`Current Month Start` }} to today</div></h-drill>
</div>
      ;;
      settings { row_limit: 1 }
    }
    settings { hide_controls: true }
  }

  block k_selected_gmv: VizBlock {
    label: 'Selected-period GMV'
    settings { hide_label: true }
    viz: MetricKpi {
      dataset: seed_c_fiscal_windows
      value: VizFieldFull {
        ref: r(seed_c_fiscal_windows.gmv)
        label: 'GMV'
        format { type: 'number' pattern: '[$$]#,###0' }
      }
      settings { display_mode: 'single' alignment: 'center' }
    }
  }

  block v_window_monthly: VizBlock {
    label: 'Daily GMV through today'
    viz: CombinationChart {
      dataset: seed_c_fiscal_windows
      x_axis: VizFieldFull {
        ref: r(seed_c_dates_alternative.date_key)
        label: 'Date'
        format { type: 'date' pattern: 'LLL dd, yyyy' }
      }
      y_axis {
        label: 'GMV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(seed_c_fiscal_windows.gmv)
            label: 'GMV'
            format { type: 'number' pattern: '[$$]#,###0' }
          }
        }
      }
      settings {
        show_data_points: true
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  block t_month_note: TextBlock {
    content: @md
**How to read the calendar:** fiscal logic changes which **year** and **quarter** a date belongs to. It does not rename months—October remains October.
    ;;
  }

  block t_rollups_intro: TextBlock {
    content: @md
# Fiscal rollups

**One fiscal definition, three trustworthy reporting grains.** Use the dropdown to switch the same GMV trend between real calendar months, Seed fiscal quarters, and Seed fiscal years.
    ;;
  }

  block f_rollup_grain: FilterBlock {
    label: 'Reporting grain'
    type: 'field'
    source: FieldFilterSource {
      dataset: seed_c_fiscal_rollups
      field: r(seed_c_fiscal_rollup_series.grain)
    }
    default {
      operator: 'is'
      value: 'Month'
    }
    settings {
      input_type: 'single'
    }
  }

  block v_rollup_trend: VizBlock {
    label: 'GMV by selected reporting grain'
    viz: CombinationChart {
      dataset: seed_c_fiscal_rollups
      x_axis: VizFieldFull {
        ref: r(seed_c_fiscal_rollup_series.period_label)
        label: 'Period'
        format { type: 'text' }
      }
      y_axis {
        label: 'GMV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(seed_c_fiscal_rollup_series.gmv)
            label: 'GMV'
            format { type: 'number' pattern: '[$$]#,###0' }
          }
        }
      }
      settings {
        x_axis_label: 'Period'
        show_data_points: true
        sort: LineFamilySort { type: 'xaxis' direction: 'asc' }
      }
    }
  }

  interactions: [
    FilterInteraction {
      from: 'v_window_selector'
      to: [
        CustomMapping { block: ['f_rollup_grain', 'v_rollup_trend'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'k_selected_gmv'
      to: [
        CustomMapping { block: ['v_window_selector', 'f_rollup_grain', 'v_rollup_trend'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'v_window_monthly'
      to: [
        CustomMapping { block: ['v_window_selector', 'f_rollup_grain', 'v_rollup_trend'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'f_rollup_grain'
      to: [
        CustomMapping { block: 'v_rollup_trend' field: r(seed_c_fiscal_rollup_series.grain) },
        CustomMapping { block: ['v_window_selector', 'k_selected_gmv', 'v_window_monthly'] disabled: true }
      ]
    },
    FilterInteraction {
      from: 'v_rollup_trend'
      to: [
        CustomMapping { block: ['f_rollup_grain', 'v_window_selector', 'k_selected_gmv', 'v_window_monthly'] disabled: true }
      ]
    }
  ]

  view: TabLayout {
    tab fiscal_windows: CanvasLayout {
      label: 'Fiscal Windows'
      width: 1060
      height: 940
      grid_size: 20
      auto_expand_vertically: true
      block t_windows_intro { position: pos(20, 20, 1020, 140) layer: 1 }
      block v_window_selector { position: pos(20, 180, 1020, 160) layer: 1 }
      block k_selected_gmv { position: pos(20, 360, 320, 160) layer: 1 }
      block v_window_monthly { position: pos(360, 360, 680, 440) layer: 1 }
      block t_month_note { position: pos(20, 820, 1020, 100) layer: 1 }
      mobile { mode: 'auto' }
    }

    tab fiscal_rollups: CanvasLayout {
      label: 'Fiscal Rollups'
      width: 1060
      height: 860
      grid_size: 20
      auto_expand_vertically: true
      block t_rollups_intro { position: pos(20, 20, 1020, 120) layer: 1 }
      block f_rollup_grain { position: pos(20, 160, 360, 100) layer: 1 }
      block v_rollup_trend { position: pos(20, 280, 1020, 540) layer: 1 }
      mobile { mode: 'auto' }
    }
  }
}
