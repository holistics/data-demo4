// Alternative-dashboard-only daily spine with relative fiscal presets.
//
// The left join deliberately retains one row for every date through CURRENT_DATE.
// That makes a selected chart begin on the resolved preset boundary and visibly
// end today, even when the synthetic order data has no facts on either endpoint.
Model seed_c_dates_alternative {
  type: 'query'
  label: 'Seed Dates — Relative Windows (Alternative)'
  description: 'Daily GMV spine through today with six CURRENT_DATE-relative Seed fiscal and calendar windows.'
  data_source_name: 'demodb'

  models: [
    ecommerce_orders,
    ecommerce_order_items,
    ecommerce_products,
  ]

  query: @sql
    WITH daily_gmv AS (
      SELECT
        CAST({{ #o.created_at }} AS DATE) AS order_date,
        SUM({{ #oi.quantity }} * {{ #p.price }}) AS gmv
      FROM {{ #ecommerce_order_items AS oi }}
      LEFT JOIN {{ #ecommerce_orders AS o }}
        ON {{ #oi.order_id }} = {{ #o.id }}
      LEFT JOIN {{ #ecommerce_products AS p }}
        ON {{ #oi.product_id }} = {{ #p.id }}
      GROUP BY 1
    )

    SELECT
      CAST(date_spine.date_key AS DATE) AS date_key,
      COALESCE(daily_gmv.gmv, 0) AS gmv
    FROM generate_series(
      '2013-01-01'::date,
      CURRENT_DATE,
      '1 day'::interval
    ) AS date_spine(date_key)
    LEFT JOIN daily_gmv
      ON CAST(date_spine.date_key AS DATE) = daily_gmv.order_date
  ;;

  dimension date_key {
    label: 'Date'
    type: 'date'
    definition: @sql {{ #SOURCE.date_key }} ;;
  }

  dimension gmv_value {
    label: 'GMV Value'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.gmv }} ;;
  }

  dimension previous_fy_start {
    label: 'Previous FY Starts'
    type: 'date'
    definition: @sql
      MAKE_DATE(
        CASE
          WHEN EXTRACT(MONTH FROM CURRENT_DATE) >= 10
            THEN CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 1
          ELSE CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 2
        END,
        10,
        1
      ) ;;
  }

  dimension current_fy_start {
    label: 'Current FY Starts'
    type: 'date'
    definition: @sql
      MAKE_DATE(
        CASE
          WHEN EXTRACT(MONTH FROM CURRENT_DATE) >= 10
            THEN CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT)
          ELSE CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 1
        END,
        10,
        1
      ) ;;
  }

  dimension previous_fq_start {
    label: 'Previous FQ Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('quarter', CURRENT_DATE) - INTERVAL '3 months' AS DATE) ;;
  }

  dimension current_fq_start {
    label: 'Current FQ Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('quarter', CURRENT_DATE) AS DATE) ;;
  }

  dimension previous_month_start {
    label: 'Previous Month Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1 month' AS DATE) ;;
  }

  dimension current_month_start {
    label: 'Current Month Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('month', CURRENT_DATE) AS DATE) ;;
  }

  dimension in_previous_fy_to_today {
    label: 'Previous FY Start to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_fy_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_current_fy_to_today {
    label: 'Current FY to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_fy_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_previous_fq_to_today {
    label: 'Previous FQ Start to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_fq_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_current_fq_to_today {
    label: 'Current FQ to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_fq_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_previous_month_to_today {
    label: 'Previous Month Start to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_month_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_current_month_to_today {
    label: 'Current Month to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_month_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }
}
