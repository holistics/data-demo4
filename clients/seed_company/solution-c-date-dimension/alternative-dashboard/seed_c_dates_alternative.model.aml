// Alternative-dashboard-only daily spine with relative fiscal presets and a grain series.
//
// The left join deliberately retains one row for every date through CURRENT_DATE.
// That makes a selected chart span the full resolved preset window, and visibly
// reach its last day, even when the synthetic order data has no facts on either
// endpoint. Every window resolves both edges from CURRENT_DATE: the three
// "previous" presets are complete closed periods (a finished FY ends 30 September),
// while the three "current" presets run to today.
//
// The spine is then CROSS JOINed onto five reporting grains so one chart can serve
// both controls on the single tab: the preset window filters `date_key`, and the
// "Aggregate by" dropdown filters `grain`. Because every fact is repeated once per
// grain, `grain` MUST be filtered on any block that reads a measure — the dashboard's
// grain filter carries an explicit default of 'Month' so the opening state is correct.
Model seed_c_dates_alternative {
  type: 'query'
  label: 'Seed Dates — Relative Windows (Alternative)'
  description: 'Daily GMV spine through today, repeated across five reporting grains, with six CURRENT_DATE-relative Seed fiscal and calendar windows.'
  data_source_name: 'demodb'

  models: [
    ecommerce_orders,
    ecommerce_order_items,
    ecommerce_products,
  ]

  query: @sql
    WITH daily_gmv AS (
      SELECT
        CAST({{ #o.created_at }} AS DATE) AS order_date,
        SUM({{ #oi.quantity }} * {{ #p.price }}) AS gmv
      FROM {{ #ecommerce_order_items AS oi }}
      LEFT JOIN {{ #ecommerce_orders AS o }}
        ON {{ #oi.order_id }} = {{ #o.id }}
      LEFT JOIN {{ #ecommerce_products AS p }}
        ON {{ #oi.product_id }} = {{ #p.id }}
      GROUP BY 1
    ),

    spine AS (
      SELECT
        CAST(date_spine.date_key AS DATE) AS date_key,
        COALESCE(daily_gmv.gmv, 0) AS gmv
      FROM generate_series(
        -- Start the spine at the previous fiscal year's opening day. That is the
        -- earliest date any preset can reach, so nothing older is ever selectable
        -- and the unclicked chart opens on two fiscal years instead of all history.
        MAKE_DATE(
          CASE
            WHEN EXTRACT(MONTH FROM CURRENT_DATE) >= 10
              THEN CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 1
            ELSE CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 2
          END,
          10,
          1
        ),
        CURRENT_DATE,
        '1 day'::interval
      ) AS date_spine(date_key)
      LEFT JOIN daily_gmv
        ON CAST(date_spine.date_key AS DATE) = daily_gmv.order_date
    ),

    grains AS (
      SELECT *
      FROM (VALUES
        (1, 'Day'),
        (2, 'Week'),
        (3, 'Month'),
        (4, 'Fiscal quarter'),
        (5, 'Fiscal year')
      ) AS g(grain_order, grain)
    )

    SELECT
      spine.date_key,
      spine.gmv,
      grains.grain,
      grains.grain_order,
      CASE grains.grain
        WHEN 'Day' THEN
          TO_CHAR(spine.date_key, 'YYYY-MM-DD')
        WHEN 'Week' THEN
          TO_CHAR(spine.date_key, 'IYYY') || '-W' || TO_CHAR(spine.date_key, 'IW')
        WHEN 'Month' THEN
          TO_CHAR(spine.date_key, 'YYYY-MM') || ' (' || TO_CHAR(spine.date_key, 'Mon') || ')'
        WHEN 'Fiscal quarter' THEN
          'FY ' || CAST(EXTRACT(YEAR FROM spine.date_key + INTERVAL '3 months') AS INT)
            || '-Q' || CAST(EXTRACT(QUARTER FROM spine.date_key + INTERVAL '3 months') AS INT)
            || CASE CAST(EXTRACT(QUARTER FROM spine.date_key + INTERVAL '3 months') AS INT)
                 WHEN 1 THEN ' (Oct-Dec)'
                 WHEN 2 THEN ' (Jan-Mar)'
                 WHEN 3 THEN ' (Apr-Jun)'
                 ELSE ' (Jul-Sep)'
               END
        ELSE
          'FY ' || CAST(EXTRACT(YEAR FROM spine.date_key + INTERVAL '3 months') AS INT)
      END AS period_label
    FROM spine
    CROSS JOIN grains
    ORDER BY grains.grain_order, spine.date_key
  ;;

  dimension date_key {
    label: 'Date'
    type: 'date'
    definition: @sql {{ #SOURCE.date_key }} ;;
  }

  dimension gmv_value {
    label: 'GMV Value'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.gmv }} ;;
  }

  dimension gmv_value_once {
    label: 'GMV Value (One Grain Copy)'
    type: 'number'
    hidden: true
    description: 'GMV attributed to the Day copy only, so a window total can be summed without picking up the five-fold grain fan-out.'
    definition: @sql
      CASE WHEN {{ #SOURCE.grain }} = 'Day' THEN {{ #SOURCE.gmv }} ELSE 0 END ;;
  }

  dimension grain {
    label: 'Aggregate By'
    type: 'text'
    description: 'Reporting grain the period label is cut at: Day, Week, Month, Seed fiscal quarter, or Seed fiscal year.'
    definition: @sql {{ #SOURCE.grain }} ;;
  }

  dimension grain_order {
    label: 'Aggregate By Order'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.grain_order }} ;;
  }

  dimension period_label {
    label: 'Period'
    type: 'text'
    description: 'Chronologically sortable display label at the selected grain. Fiscal grains are named by the year the Oct-Sep fiscal year ends in.'
    definition: @sql {{ #SOURCE.period_label }} ;;
  }

  dimension previous_fy_start {
    label: 'Previous FY Starts'
    type: 'date'
    definition: @sql
      MAKE_DATE(
        CASE
          WHEN EXTRACT(MONTH FROM CURRENT_DATE) >= 10
            THEN CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 1
          ELSE CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 2
        END,
        10,
        1
      ) ;;
  }

  dimension current_fy_start {
    label: 'Current FY Starts'
    type: 'date'
    definition: @sql
      MAKE_DATE(
        CASE
          WHEN EXTRACT(MONTH FROM CURRENT_DATE) >= 10
            THEN CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT)
          ELSE CAST(EXTRACT(YEAR FROM CURRENT_DATE) AS INT) - 1
        END,
        10,
        1
      ) ;;
  }

  dimension previous_fy_end {
    label: 'Previous FY Ends'
    type: 'date'
    description: '30 September — the day before the current fiscal year opens. The completed previous FY, not a start-to-today window.'
    definition: @sql CAST({{ current_fy_start }} - INTERVAL '1 day' AS DATE) ;;
  }

  dimension previous_fq_start {
    label: 'Previous FQ Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('quarter', CURRENT_DATE) - INTERVAL '3 months' AS DATE) ;;
  }

  dimension current_fq_start {
    label: 'Current FQ Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('quarter', CURRENT_DATE) AS DATE) ;;
  }

  dimension previous_fq_end {
    label: 'Previous FQ Ends'
    type: 'date'
    description: 'Last day of the completed previous fiscal quarter. Seed ends its FY on a calendar quarter boundary, so fiscal and calendar quarter edges coincide.'
    definition: @sql CAST({{ current_fq_start }} - INTERVAL '1 day' AS DATE) ;;
  }

  dimension previous_month_start {
    label: 'Previous Month Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('month', CURRENT_DATE) - INTERVAL '1 month' AS DATE) ;;
  }

  dimension current_month_start {
    label: 'Current Month Starts'
    type: 'date'
    definition: @sql CAST(DATE_TRUNC('month', CURRENT_DATE) AS DATE) ;;
  }

  dimension previous_month_end {
    label: 'Previous Month Ends'
    type: 'date'
    description: 'Last day of the completed previous calendar month.'
    definition: @sql CAST({{ current_month_start }} - INTERVAL '1 day' AS DATE) ;;
  }

  // The three "previous" windows are complete, closed periods — a finished FY ends on
  // 30 September, not today. Only the three "current" windows run to CURRENT_DATE.

  dimension in_previous_fy {
    label: 'Previous FY (Complete)'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_fy_start }}
      AND {{ #SOURCE.date_key }} <= {{ previous_fy_end }} ;;
  }

  dimension in_current_fy_to_today {
    label: 'Current FY to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_fy_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_previous_fq {
    label: 'Previous FQ (Complete)'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_fq_start }}
      AND {{ #SOURCE.date_key }} <= {{ previous_fq_end }} ;;
  }

  dimension in_current_fq_to_today {
    label: 'Current FQ to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_fq_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }

  dimension in_previous_month {
    label: 'Previous Month (Complete)'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ previous_month_start }}
      AND {{ #SOURCE.date_key }} <= {{ previous_month_end }} ;;
  }

  dimension in_current_month_to_today {
    label: 'Current Month to Today'
    type: 'truefalse'
    definition: @sql
      {{ #SOURCE.date_key }} >= {{ current_month_start }}
      AND {{ #SOURCE.date_key }} <= CURRENT_DATE ;;
  }
}
