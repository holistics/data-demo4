Dataset seed_c_fiscal_windows {
  label: 'Seed Company Fiscal Windows (Alternative)'
  description: 'Isolated dataset for six button-driven, date-relative Seed fiscal/calendar windows. Uses synthetic ecommerce GMV.'
  data_source_name: 'demodb'

  models: [seed_c_dates_alternative]

  relationships: []

  metric gmv {
    label: 'GMV'
    type: 'number'
    description: 'Period GMV for the trend chart. The model fans every fact out across five reporting grains, so any block reading this metric must also be filtered on `grain` — grouping by `period_label` does that implicitly, a bare total does not.'
    definition: @aql seed_c_dates_alternative | sum(seed_c_dates_alternative.gmv_value) ;;
    format: '#,###0'
  }

  metric gmv_window {
    label: 'GMV'
    type: 'number'
    description: 'Window GMV for the KPI. Reads the Day copy only, so it stays correct no matter which reporting grain the dropdown holds — never wire the grain filter to a block using this metric.'
    definition: @aql seed_c_dates_alternative | sum(seed_c_dates_alternative.gmv_value_once) ;;
    format: '#,###0'
  }
}
