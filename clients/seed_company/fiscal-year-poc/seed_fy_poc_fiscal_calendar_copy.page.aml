  .fiscal-dropdown:has([row="2"].h-drill-selected) .fiscal-current-date[data-row="2"],
  .fiscal-dropdown:has([row="2"] .h-drill-selected) .fiscal-current-date[data-row="2"],
  .fiscal-dropdown:has([row="3"].h-drill-selected) .fiscal-current-date[data-row="3"],
  .fiscal-dropdown:has([row="3"] .h-drill-selected) .fiscal-current-date[data-row="3"],
  .fiscal-dropdown:has([row="4"].h-drill-selected) .fiscal-current-date[data-row="4"],
  .fiscal-dropdown:has([row="4"] .h-drill-selected) .fiscal-current-date[data-row="4"],
  .fiscal-dropdown:has([row="5"].h-drill-selected) .fiscal-current-date[data-row="5"],
  .fiscal-dropdown:has([row="5"] .h-drill-selected) .fiscal-current-date[data-row="5"] { display:block; }
</style>
<div class="fiscal-dropdown" tabindex="0">
  <div class="fiscal-dropdown-summary">
    <span class="fiscal-current">
      <span class="fiscal-current-label"></span>
      <span class="fiscal-current-date" data-row="0">complete prior FY</span>
      <span class="fiscal-current-date" data-row="1">1 Oct &rarr; today</span>
      <span class="fiscal-current-date" data-row="2">complete prior FQ</span>
      <span class="fiscal-current-date" data-row="3">FQ start &rarr; today</span>
      <span class="fiscal-current-date" data-row="4">complete prior month</span>
      <span class="fiscal-current-date" data-row="5">month start &rarr; today</span>
    </span>
  </div>
  <div class="fiscal-panel" tabindex="-1">
    <details class="fiscal-group" open>
      <summary class="fiscal-group-summary">Fiscal Year</summary>
      <div class="fiscal-children">
        <h-drill row="0" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last FY</div><div class="fiscal-preset-date">complete prior FY</div></h-drill>
        <h-drill row="1" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This FY</div><div class="fiscal-preset-date">1 Oct &rarr; today</div></h-drill>
      </div>
    </details>
    <details class="fiscal-group">
      <summary class="fiscal-group-summary">Fiscal Quarter</summary>
      <div class="fiscal-children">
        <h-drill row="2" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last FQ</div><div class="fiscal-preset-date">complete prior FQ</div></h-drill>
        <h-drill row="3" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This FQ</div><div class="fiscal-preset-date">FQ start &rarr; today</div></h-drill>
      </div>
    </details>
    <details class="fiscal-group">
      <summary class="fiscal-group-summary">Month</summary>
      <div class="fiscal-children">
        <h-drill row="4" value="true" class="fiscal-preset"><div class="fiscal-preset-title">Last month</div><div class="fiscal-preset-date">complete prior month</div></h-drill>
        <h-drill row="5" value="true" class="fiscal-preset"><div class="fiscal-preset-title">This month</div><div class="fiscal-preset-date">month start &rarr; today</div></h-drill>
      </div>
    </details>
  </div>
</div> ;;
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_controls: true
    }
  }

  // The resolved edges, read back live from the selection instead of
  // printed on each card. AQL cannot build a boundary date from @today,
  // so min/max over the current filter does the job — and it proves the
  // window rather than restating it.
  block k_aql_window_start: VizBlock {
    label: 'Window starts'
    viz: MetricKpi {
      dataset: seed_fy_poc_windows_aql
      value: VizFieldFull {
        ref: r(seed_fy_poc_windows_aql.window_start)
        label: ' '
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block k_aql_window_end: VizBlock {
    label: 'Window ends'
    viz: MetricKpi {
      dataset: seed_fy_poc_windows_aql
      value: VizFieldFull {
        ref: r(seed_fy_poc_windows_aql.window_end)
        label: ' '
        format {
          type: 'date'
          pattern: 'LLL dd, yyyy'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  // A param filter, not a field filter. `allowed_values` on the param
  // fixes the dropdown order the @sql tab cannot control — coarsest last,
  // instead of alphabetical.
  block f_aql_grain: FilterBlock {
    label: 'Aggregate by'
    type: 'field'
    source: FieldFilterSource {
      dataset: seed_fy_poc_windows_aql
      field: r(seed_fy_poc_dates_aql.grain)
    }
    default {
      operator: 'is'
      value: 'Month'
    }
    settings {
      input_type: 'single'
    }
  }

  // Reads plain `gmv`. No de-duplicated twin is needed: the dynamic
  // dimension keeps one row per date, so there is no fan-out to undo.
  block k_aql_gmv: VizBlock {
    label: 'Selected-period GMV'
    viz: MetricKpi {
      dataset: seed_fy_poc_windows_aql
      value: VizFieldFull {
        ref: r(seed_fy_poc_windows_aql.gmv)
        label: ' '
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        display_mode: 'single'
        alignment: 'center'
      }
    }
  }

  block v_aql_series: VizBlock {
    label: 'GMV across the selected window, at the selected grain'
    viz: CombinationChart {
      dataset: seed_fy_poc_windows_aql
      x_axis: VizFieldFull {
        ref: r(seed_fy_poc_dates_aql.period_label)
        label: 'Period'
        format {
          type: 'text'
        }
      }
      y_axis {
        label: 'GMV'
        series {
          mark_type: 'line'
          field: VizFieldFull {
            ref: r(seed_fy_poc_windows_aql.gmv)
            label: 'GMV'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        x_axis_label: 'Period'
        show_data_points: true
        sort: LineFamilySort {
          type: 'xaxis'
          direction: 'asc'
        }
      }
    }
  }

  block t_aql_note: TextBlock {
    content: @md
### What AQL replaced

**The fiscal calendar.** `fiscal_year` is a `case()` on the month number, not SQL.

**The windows.** A finished period is an equality on a period index—`fiscal_year == this FY - 1`—so it needs no end date at all.

**The grain.** A `param` plus one `case()`. No `UNION`, no `CROSS JOIN`, one row per date.
    ;;
  }

  block t_aql_limits: TextBlock {
    content: @md
**Where AQL stops.** Three honest limits, all measured rather than assumed. **Rows cannot be manufactured**—a calendar needs a row per day whether or not a fact lands on it, so `seed_fy_poc_date_spine` is the one `@sql` file: a `generate_series` and seven `to_char()` columns, with no fiscal logic in it. Most customers already own that model. **There is no `CURRENT_DATE`**, so today is the `@today` literal; it resolves to a date, so the SQL text stays stable for the day and the cache still hits, unlike the `@now` this folder's siblings ban. **Boundary dates cannot be built**—`date_trunc` takes a dimension but not `@today`, and there is no `date_add`, so "first day of the previous quarter" has no AQL form. Hence the two KPIs above: the window is read back from the selection instead of printed on each card.
    ;;
  }

  interactions: [
    FilterInteraction {
      from: 'f_grain'
      to: [
        CustomMapping {
          block: 'v_window_series'
          field: r(seed_fy_poc_dates_sql.grain)
        },
        CustomMapping {
          block: [
            'v_window_selector',
            'k_selected_gmv'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_window_selector'
      to: [
        CustomMapping {
          block: 'f_grain'
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'k_selected_gmv'
      to: [
        CustomMapping {
          block: [
            'v_window_selector',
            'f_grain',
            'v_window_series'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_window_series'
      to: [
        CustomMapping {
          block: [
            'v_window_selector',
            'f_grain',
            'k_selected_gmv'
          ]
          disabled: true
        }
      ]
    },

    // Tab 2. The grain param reaches only the series: `gmv` does not read
    // the param, so pointing it at the KPI would be a no-op either way.
    FilterInteraction {
      from: 'f_aql_grain'
      to: [
        CustomMapping {
          block: 'v_aql_series'
          field: r(seed_fy_poc_dates_aql.grain)
        },
        CustomMapping {
          block: [
            'v_aql_selector',
            'k_aql_gmv',
            'k_aql_window_start',
            'k_aql_window_end'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_aql_selector'
      to: [
        CustomMapping {
          block: 'f_aql_grain'
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'k_aql_gmv'
      to: [
        CustomMapping {
          block: [
            'v_aql_selector',
            'f_aql_grain',
            'v_aql_series',
            'k_aql_window_start',
            'k_aql_window_end'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'v_aql_series'
      to: [
        CustomMapping {
          block: [
            'v_aql_selector',
            'f_aql_grain',
            'k_aql_gmv',
            'k_aql_window_start',
            'k_aql_window_end'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'k_aql_window_start'
      to: [
        CustomMapping {
          block: [
            'v_aql_selector',
            'f_aql_grain',
            'k_aql_gmv',
            'v_aql_series',
            'k_aql_window_end'
          ]
          disabled: true
        }
      ]
    },
    FilterInteraction {
      from: 'k_aql_window_end'
      to: [
        CustomMapping {
          block: [
            'v_aql_selector',
            'f_aql_grain',
            'k_aql_gmv',
            'v_aql_series',
            'k_aql_window_start'
          ]
          disabled: true
        }
      ]
    }
  ]

  view: TabLayout {
    tab sql_version: CanvasLayout {
      label: 'Built in SQL'
      width: 1060
      height: 1180
      grid_size: 20
      auto_expand_vertically: true
      block t_windows_intro {
        position: pos(20, 20, 1020, 160)
        layer: 1
      }
      block v_window_selector {
        position: pos(20, 200, 1020, 180)
        layer: 1
      }
      block f_grain {
        position: pos(20, 400, 340, 100)
        layer: 1
      }
      block k_selected_gmv {
        position: pos(20, 520, 320, 200)
        layer: 1
      }
      block t_grain_note {
        position: pos(20, 740, 320, 240)
        layer: 1
      }
      block v_window_series {
        position: pos(360, 520, 680, 460)
        layer: 1
      }
      block t_month_note {
        position: pos(20, 1000, 1020, 140)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }

    tab aql_version: CanvasLayout {
      label: 'Built in AQL'
      width: 1060
      height: 1320
      grid_size: 20
      auto_expand_vertically: true
      block t_aql_intro {
        position: pos(20, 20, 1020, 180)
        layer: 1
      }
      block v_aql_selector {
        position: pos(20, 220, 1020, 180)
        layer: 1
      }
      block f_aql_grain {
        position: pos(20, 420, 340, 160)
        layer: 1
      }
      block k_aql_window_start {
        position: pos(380, 420, 320, 160)
        layer: 1
      }
      block k_aql_window_end {
        position: pos(720, 420, 320, 160)
        layer: 1
      }
      block k_aql_gmv {
        position: pos(20, 600, 320, 200)
        layer: 1
      }
      block t_aql_note {
        position: pos(20, 820, 320, 240)
        layer: 1
      }
      block v_aql_series {
        position: pos(360, 600, 680, 460)
        layer: 1
      }
      block t_aql_limits {
        position: pos(20, 1080, 1020, 220)
        layer: 1
      }
      mobile {
        mode: 'auto'
      }
    }
  }

  settings {
    autorun_on_open: true
    autorun_on_changes: true
  }
}