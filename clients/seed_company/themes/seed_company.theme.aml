// =====================================================================
// Seed Company — reusable brand theme
// Source: "Seed Company Brand Guide 2026" (GB+C), Downloads.
//
// Brand: international Bible-translation non-profit. Warm, earthy, editorial.
// Primary palette is deliberately NEUTRAL (cream / stone / gray / black);
// all colour comes from the five REGIONAL secondary palettes, which map to
// the world regions Seed Company organises its translation work around.
//
// Typography per the guide:
//   PP Rader / Regular  -> display titles only, caps, "10-20% of the time"
//                          (commercial font, no web substitute here — skipped)
//   Sentinel / Light    -> main header font (slab serif)     -> Zilla Slab fallback
//   Gotham / Book       -> PRIMARY font, "when in doubt use Gotham" -> Montserrat fallback
//   Red Hat Mono        -> descriptions, credits, STATISTICS -> available on Google Fonts
// Licensed fonts are listed FIRST in each stack so anyone with Gotham or
// Sentinel installed gets the real thing; web fallbacks catch everyone else.
//
// Apply from a dashboard with:  theme: seed_company
// =====================================================================

// --- Primary palette (guide p.23, "NATURAL") -------------------------
const sc_natural     = "#F7F1E7"   // Natural   Pantone Cool Gray 1U
const sc_stone       = "#CDC3B0"   // Stone     Pantone Cool Gray 3U
const sc_white       = "#FFFFFF"   // White
const sc_light_gray  = "#EBEBEC"   // Light Gray  427U
const sc_dark_gray   = "#636466"   // Dark Gray   433U
const sc_black       = "#323232"   // Black       447U

// --- Regional secondary palettes (guide p.24-28) ---------------------
// Africa
const sc_burnt       = "#812F13"
const sc_sun         = "#E35C2A"
const sc_desert      = "#F7AE6C"
// Americas
const sc_forest      = "#41452B"
const sc_terracotta  = "#A8654C"
const sc_granite     = "#C1B1A8"
// Asia
const sc_depth       = "#414E46"
const sc_coral       = "#E96C50"
const sc_peach       = "#F8AE85"
// Europe and the Middle East
const sc_shadow      = "#5C3D34"
const sc_dusk        = "#C08863"
const sc_dawn        = "#D2CFAF"
// Pacific
const sc_sea         = "#02424B"
const sc_gold        = "#B68B55"
const sc_sand        = "#D4BC9D"

// --- Derived tints (NOT in the guide — only for KPI up/down chips) ---
const sc_pos_tint    = "#ECEFE2"
const sc_neg_tint    = "#F7E7E0"

// --- Type stacks -----------------------------------------------------
const sc_font        = "Gotham, Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif"
const sc_mono        = "Red Hat Mono, ui-monospace, SFMono-Regular, Menlo, monospace"

// Default categorical palette. Ordered for maximum separation rather than
// by region, because the regional triads are intentionally harmonious and
// adjacent hues are hard to tell apart in a legend.
ColorPalette seed_company_palette {
  title: "Seed Company"
  categorical {
    colors: [
      "#41452B", // Forest      (Americas)
      "#E35C2A", // Sun         (Africa)
      "#02424B", // Sea         (Pacific)
      "#C08863", // Dusk        (Europe & ME)
      "#812F13", // Burnt       (Africa)
      "#B68B55", // Gold        (Pacific)
      "#5C3D34", // Shadow      (Europe & ME)
      "#CDC3B0"  // Stone       (neutral)
    ]
  }
}

// Use this one whenever a chart breaks down BY WORLD REGION, so the colour
// carries meaning: one region, one brand colour, consistent across every
// dashboard. Order follows the guide: Africa, Americas, Asia, Europe & ME, Pacific.
ColorPalette seed_company_regions_palette {
  title: "Seed Company — Regions"
  categorical {
    colors: [
      "#E35C2A", // Africa            — Sun
      "#41452B", // Americas          — Forest
      "#E96C50", // Asia              — Coral
      "#C08863", // Europe & ME       — Dusk
      "#02424B"  // Pacific           — Sea
    ]
  }
}

// Bare block: no card, no border, no shadow. For page furniture (footers,
// dividers, section labels) that should sit directly on the Natural page
// background rather than reading as another content card.
// Usage:  TextBlock { theme: seed_company_bare ... }
BlockTheme seed_company_bare {
  background {
    bg_color: 'transparent'
  }
  border {
    border_style: 'none'
    border_width: 0
  }
  padding: 8
  shadow: 'none'
}

PageTheme seed_company {
  title: 'Seed Company'

  color {
    data: seed_company_palette
  }

  background {
    bg_color: sc_natural
  }

  canvas {
    background {
      bg_color: sc_natural
    }
    border {
      border_radius: 6
      border_color: sc_stone
    }
    shadow: 'sm'
  }

  block {
    background {
      bg_color: sc_white
    }
    label {
      font_family: sc_font
      font_color: sc_black
      font_weight: 'bold'
      font_size: 14
    }
    text {
      font_family: sc_font
      font_color: sc_dark_gray
      font_size: 13
    }
    border {
      border_width: 1
      border_radius: 8
      border_color: sc_stone
      border_style: 'solid'
    }
    padding: 20
    shadow: 'sm'
  }

  viz {
    table {
      general {
        hover_color: sc_natural
        banding_color: "#FBF8F2"
        font_color: sc_black
        font_size: 13
        font_family: sc_font
        border_color: sc_stone
        grid_color: sc_light_gray
      }
      header {
        bg_color: sc_black
        font_color: sc_natural
        font_weight: 'bold'
      }
      sub_header {
        bg_color: sc_light_gray
        font_color: sc_black
        font_weight: 'semibold'
      }
      sub_title {
        font_color: sc_dark_gray
        font_size: 11
      }
    }
  }

  custom_css: @css
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Red+Hat+Mono:wght@300;400;500;600&display=swap');

    /* KPI period-over-period chips, in brand colours */
    .h-kpi-metric-diff .friendly-diff:not(.negative) {
      background: #ECEFE2;
      color: #41452B;
    }
    .h-kpi-metric-diff .friendly-diff.negative {
      background: #F7E7E0;
      color: #812F13;
    }

    /* The guide assigns Red Hat Mono to statistics, so KPI figures use it */
    .h-kpi-metric-value {
      font-family: 'Red Hat Mono', ui-monospace, Menlo, monospace !important;
      letter-spacing: -0.01em;
    }
  ;;
}
