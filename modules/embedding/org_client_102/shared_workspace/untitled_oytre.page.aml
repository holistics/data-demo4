Dashboard untitled_oytre {
  title: 'Partner Enablement Scorecard'
  description: 'Lenovo partner team: how far each channel partner has taken its people through learning, exams and certification.'
  owner: 'embed_3eb2305ed7a52bf14e@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">Lenovo team report &middot; Shared workspace</div>

      # Partner Enablement Scorecard

      Ranks every Lenovo channel partner on enablement: learners, completion, exam success and credentials earned.
    ;;
  }
  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block f_tier: FilterBlock {
    label: 'Partner Tier'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_tier)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_pregion: FilterBlock {
    label: 'Partner Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_region)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Active Learners'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.active_learners)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Completion Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.completion_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'Exam Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k4: VizBlock {
    label: 'Credentials Issued'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.credentials_issued)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'Credentials issued by partner region'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_region)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.credentials_issued)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block c2: VizBlock {
    label: 'Pass rate by partner tier'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_tier)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.pass_rate)
            format {
              type: 'number'
              pattern: '#,##0.0%'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block t1: VizBlock {
    label: 'Partner scorecard'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
          uname: 't1_d2'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.enrolments)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.completion_rate)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exam_attempts)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.pass_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.credentials_issued)
          uname: 't1_m4'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m4'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1280
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_date {
      position: pos(20, 140, 300, 80)
    }
    block f_tier {
      position: pos(340, 140, 300, 80)
    }
    block f_pregion {
      position: pos(660, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 300, 120)
    }
    block k2 {
      position: pos(340, 240, 300, 120)
    }
    block k3 {
      position: pos(660, 240, 300, 120)
    }
    block k4 {
      position: pos(980, 240, 300, 120)
    }
    block c1 {
      position: pos(20, 380, 620, 380)
    }
    block c2 {
      position: pos(660, 380, 620, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 480)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
