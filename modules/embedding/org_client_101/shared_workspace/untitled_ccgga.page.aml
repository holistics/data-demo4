Dashboard untitled_ccgga {
  title: 'Recertification Pipeline'
  description: 'Adobe credential team: who is due to recertify, recertification rate by program and the monthly trend of new versus renewed credentials.'
  owner: 'embed_159eb364d1d34d6fb1@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">Adobe team report &middot; Shared workspace</div>

      # Recertification Pipeline

      Credentials coming up for renewal and how well each program keeps certified people certified.
    ;;
  }
  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_region: FilterBlock {
    label: 'Candidate Region'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_candidates.region)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Active Credentials'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.active_credentials)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Due for Recertification (90 days)'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.expiring_90d)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'Recertifications'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recertifications)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k4: VizBlock {
    label: 'Recertification Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recertification_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'New versus renewed credentials by month'
    viz: LineChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.newly_certified)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.recertifications)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
        show_data_points: true
      }
    }
  }
  block t1: VizBlock {
    label: 'Programs by renewal risk'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_programs.program_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_programs.recert_cycle_months)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.active_credentials)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.expiring_90d)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recertifications)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recertification_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m1'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1280
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_date {
      position: pos(20, 140, 300, 80)
    }
    block f_program {
      position: pos(340, 140, 300, 80)
    }
    block f_region {
      position: pos(660, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 300, 120)
    }
    block k2 {
      position: pos(340, 240, 300, 120)
    }
    block k3 {
      position: pos(660, 240, 300, 120)
    }
    block k4 {
      position: pos(980, 240, 300, 120)
    }
    block c1 {
      position: pos(20, 380, 1260, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 480)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
