Dashboard untitled_ykyrv {
  title: 'Partner Voucher Watchlist'
  description: 'Adobe channel team: unredeemed exam vouchers by partner, how old they are and how much revenue will break in the next 90 days. Point in time; no date filter.'
  owner: 'embed_159eb364d1d34d6fb1@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">Adobe team report &middot; Shared workspace</div>

      # Partner Voucher Watchlist

      Which partners are sitting on unused exam vouchers, and where to chase before they expire. Point in time.
    ;;
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_tier: FilterBlock {
    label: 'Partner Tier'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_tier)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Vouchers Outstanding'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_outstanding)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Expiring in 90 days'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_expiring_90d)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'Breakage at Risk (90 days)'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.breakage_at_risk_90d)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k4: VizBlock {
    label: 'Deferred Revenue'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.deferred_revenue)
        format {
          type: 'number'
          pattern: '[$$]#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'Outstanding vouchers by age'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_vouchers.outstanding_age_band)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.vouchers_outstanding)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block c2: VizBlock {
    label: 'Breakage at risk by partner tier'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_tier)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.breakage_at_risk_90d)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block t1: VizBlock {
    label: 'Partner watchlist'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
          uname: 't1_d2'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_outstanding)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_expiring_90d)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.breakage_at_risk_90d)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.redemption_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.deferred_revenue)
          uname: 't1_m4'
          format {
            type: 'number'
            pattern: '[$$]#,###0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m2'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1280
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_partner {
      position: pos(20, 140, 300, 80)
    }
    block f_tier {
      position: pos(340, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 300, 120)
    }
    block k2 {
      position: pos(340, 240, 300, 120)
    }
    block k3 {
      position: pos(660, 240, 300, 120)
    }
    block k4 {
      position: pos(980, 240, 300, 120)
    }
    block c1 {
      position: pos(20, 380, 620, 380)
    }
    block c2 {
      position: pos(660, 380, 620, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 480)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
