Dashboard untitled_tsvmb {
  title: 'My Partners: Exam Readiness'
  description: 'Daniel Okafor (Adobe partner manager), private: which channel partners are getting candidates through exams, and who is sitting on vouchers. Point in time.'
  owner: 'embed_159eb364d1d34d6fb1@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">My report &middot; Personal workspace &middot; only Daniel Okafor can see this</div>

      # My Partners: Exam Readiness

      The partners I look after: who is passing, who is stalling, and who still holds unused vouchers.
    ;;
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_tier: FilterBlock {
    label: 'Partner Tier'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_tier)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Candidates'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.total_candidates)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Exam Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'First-Attempt Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.first_attempt_pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k4: VizBlock {
    label: 'Vouchers Outstanding'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.vouchers_outstanding)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'Pass rate by partner tier'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_tier)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.pass_rate)
            format {
              type: 'number'
              pattern: '#,##0.0%'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        x_axis_label: ' '
        sort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block c2: VizBlock {
    label: 'Vouchers outstanding by partner region'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_region)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.vouchers_outstanding)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        x_axis_label: ' '
        sort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block t1: VizBlock {
    label: 'Partner readiness'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_region)
          uname: 't1_d2'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.total_candidates)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exam_attempts)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.pass_rate)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.first_attempt_pass_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.vouchers_outstanding)
          uname: 't1_m4'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.redemption_rate)
          uname: 't1_m5'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m0'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1240
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_partner {
      position: pos(20, 140, 300, 80)
    }
    block f_tier {
      position: pos(340, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 300, 120)
    }
    block k2 {
      position: pos(340, 240, 300, 120)
    }
    block k3 {
      position: pos(660, 240, 300, 120)
    }
    block k4 {
      position: pos(980, 240, 300, 120)
    }
    block c1 {
      position: pos(20, 380, 620, 380)
    }
    block c2 {
      position: pos(660, 380, 620, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 440)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
