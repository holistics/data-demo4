Dashboard custom_dashboard_for_client_a_ptilv {
  title: 'Custom dashboard for client A'
  owner: 'embed_88b5d83f859ce8205e@holistics.io'
  block title: TextBlock {
    content: @md # Custom dashboard for client A;;
  }
  block v_mprw: VizBlock {
    label: 'Total Orders Count'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(ecommerce_orders.total_order)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_mprw {
      position: pos(20, 80, 260, 180)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
  settings {
    autorun_on_open: true
  }
}