Dashboard new_shared_dash_pclfw {
  title: 'New shared dash'
  owner: 'embed_6638d2851b1964335c@holistics.io'
  block title: TextBlock {
    content: @md # Created by the BI owner (Merca team);;
  }
  block v_in2p: VizBlock {
    label: 'Total Orders Count'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      value: VizFieldFull {
        ref: r(ecommerce_orders.total_order)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 280
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 60)
    }
    block v_in2p {
      position: pos(20, 80, 260, 180)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
  settings {
    autorun_on_open: true
  }
}