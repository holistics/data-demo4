Dashboard untitled_qurjm {
  title: 'Recertification Follow-ups'
  description: 'Sofia Rossi (Nutanix partner manager), private: credentials expiring in the next 90 days and recertification rate by program and partner. Point in time.'
  owner: 'embed_865a453e3d3ec6a882@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">My report &middot; Personal workspace &middot; only Sofia Rossi can see this</div>

      # Recertification Follow-ups

      Who I need to nudge this quarter before their credential lapses.
    ;;
  }
  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_partner: FilterBlock {
    label: 'Partner'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_partners.partner_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Active Credentials'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.active_credentials)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Expiring in 90 days'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.expiring_90d)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'Recertification Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.recertification_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'Expiring in 90 days by program'
    viz: BarChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_programs.program_name)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.expiring_90d)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        x_axis_label: ' '
        sort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block c2: VizBlock {
    label: 'Expiring in 90 days by partner tier'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_partners.partner_tier)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.expiring_90d)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        settings {
          show_data_label_by: 'value'
        }
      }
      settings {
        legend_label: 'hidden'
        x_axis_label: ' '
        sort {
          type: 'yaxis'
          field_index: 0
          direction: 'desc'
        }
      }
    }
  }
  block t1: VizBlock {
    label: 'Follow-up list by partner'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_partners.partner_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_partners.partner_tier)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.active_credentials)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.expiring_90d)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recertifications)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.recertification_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m1'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1240
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_program {
      position: pos(20, 140, 300, 80)
    }
    block f_partner {
      position: pos(340, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 406, 120)
    }
    block k2 {
      position: pos(446, 240, 406, 120)
    }
    block k3 {
      position: pos(872, 240, 406, 120)
    }
    block c1 {
      position: pos(20, 380, 620, 380)
    }
    block c2 {
      position: pos(660, 380, 620, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 440)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
