Dashboard untitled_erdvz {
  title: 'Exam Performance'
  description: 'Nutanix exam team: attempts, pass rates and scores for every exam, split by delivery mode, to spot exams that need content or prep changes.'
  owner: 'embed_865a453e3d3ec6a882@holistics.io'
  block title: TextBlock {
    content: @md
      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6">Nutanix team report &middot; Shared workspace</div>

      # Exam Performance

      Which Nutanix exams candidates struggle with, and whether delivery mode makes a difference.
    ;;
  }
  block f_date: FilterBlock {
    label: 'Activity Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_dates.date_day)
    }
    default {
      operator: 'matches'
      value: 'last 12 months'
    }
  }
  block f_program: FilterBlock {
    label: 'Program'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_programs.program_name)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_mode: FilterBlock {
    label: 'Delivery Mode'
    type: 'field'
    source: FieldFilterSource {
      dataset: rockinfo_credentialing
      field: r(rockinfo_exams.delivery_mode)
    }
    settings {
      input_type: 'multiple'
    }
  }
  block k1: VizBlock {
    label: 'Exam Attempts'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.exam_attempts)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k2: VizBlock {
    label: 'Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k3: VizBlock {
    label: 'First-Attempt Pass Rate'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.first_attempt_pass_rate)
        format {
          type: 'number'
          pattern: '#,##0.0%'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block k4: VizBlock {
    label: 'Average Exam Score'
    viz: MetricKpi {
      dataset: rockinfo_credentialing
      value: VizFieldFull {
        label: ' '
        ref: r(rockinfo_credentialing.avg_exam_score)
        format {
          type: 'number'
          pattern: '#,##0.0'
        }
      }
      settings {
        alignment: 'left'
      }
    }
  }
  block c1: VizBlock {
    label: 'Pass rate by delivery mode'
    viz: ColumnChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        ref: r(rockinfo_exams.delivery_mode)
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.pass_rate)
            format {
              type: 'number'
              pattern: '#,##0.0%'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.first_attempt_pass_rate)
            format {
              type: 'number'
              pattern: '#,##0.0%'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
      }
    }
  }
  block c2: VizBlock {
    label: 'Exam attempts by month'
    viz: LineChart {
      dataset: rockinfo_credentialing
      x_axis: VizFieldFull {
        label: 'Month'
        ref: r(rockinfo_dates.date_day)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yy'
        }
      }
      y_axis {
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.exam_attempts)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
        series {
          field: VizFieldFull {
            ref: r(rockinfo_credentialing.exams_passed)
            format {
              type: 'number'
              pattern: '#,###0'
            }
          }
        }
      }
      settings {
        legend_label: 'top'
        x_axis_label: ' '
        show_data_points: true
      }
    }
  }
  block t1: VizBlock {
    label: 'Exam detail'
    viz: DataTable {
      dataset: rockinfo_credentialing
      fields: [
        VizFieldFull {
          ref: r(rockinfo_exams.exam_name)
          uname: 't1_d0'
        },
        VizFieldFull {
          ref: r(rockinfo_exams.exam_code)
          uname: 't1_d1'
        },
        VizFieldFull {
          ref: r(rockinfo_exams.delivery_mode)
          uname: 't1_d2'
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exam_attempts)
          uname: 't1_m0'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.exams_passed)
          uname: 't1_m1'
          format {
            type: 'number'
            pattern: '#,###0'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.pass_rate)
          uname: 't1_m2'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.first_attempt_pass_rate)
          uname: 't1_m3'
          format {
            type: 'number'
            pattern: '#,##0.0%'
          }
        },
        VizFieldFull {
          ref: r(rockinfo_credentialing.avg_exam_score)
          uname: 't1_m4'
          format {
            type: 'number'
            pattern: '#,##0.0'
          }
        }
      ]
      settings {
        sorts: [
          SortSetting {
            key: 't1_m0'
            direction: 'desc'
          }
        ]
        row_limit: 5000
        show_row_number: true
      }
    }
  }

  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 1280
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1260, 100)
    }
    block f_date {
      position: pos(20, 140, 300, 80)
    }
    block f_program {
      position: pos(340, 140, 300, 80)
    }
    block f_mode {
      position: pos(660, 140, 300, 80)
    }
    block k1 {
      position: pos(20, 240, 300, 120)
    }
    block k2 {
      position: pos(340, 240, 300, 120)
    }
    block k3 {
      position: pos(660, 240, 300, 120)
    }
    block k4 {
      position: pos(980, 240, 300, 120)
    }
    block c1 {
      position: pos(20, 380, 620, 380)
    }
    block c2 {
      position: pos(660, 380, 620, 380)
    }
    block t1 {
      position: pos(20, 780, 1260, 480)
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: rockinfo_light_theme
    dark: rockinfo_dark_theme
  }
  settings {
    autorun_on_open: true
  }
}
