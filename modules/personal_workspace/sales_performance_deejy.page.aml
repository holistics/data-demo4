Dashboard sales_performance_deejy {
  title: 'Sales Performance'
  owner: 'di.hoang@holistics.io'
  block title: TextBlock {
    content: @md # Sales Performance
Track realized **NMV**—fulfilled sales after discounts, excluding cancelled and refunded orders—and platform **Revenue**, the commission earned on NMV. ;;
    theme {
      text {
        font_family: 'Segoe UI, Arial, sans-serif'
        font_color: '#FFFFFF'
      }
      border {
        border_width: 1
        border_radius: 4
        border_color: '#0078D4'
        border_style: 'solid'
      }
      background {
        bg_color: '#0078D4'
      }
    }
  }
  block f_order_date: FilterBlock {
    label: 'Order Date'
    type: 'field'
    source: FieldFilterSource {
      dataset: demo_ecommerce_version_2
      field: r(ecommerce_orders.created_at)
    }
    default {
      operator: 'matches'
      value: '$H_NIL$'
    }
  }
  block f_country: FilterBlock {
    label: 'Country'
    type: 'field'
    source: FieldFilterSource {
      dataset: demo_ecommerce_version_2
      field: r(ecommerce_countries.name)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }
  block f_category: FilterBlock {
    label: 'Category'
    type: 'field'
    source: FieldFilterSource {
      dataset: demo_ecommerce_version_2
      field: r(map_categories.category)
    }
    default {
      operator: 'is'
      value: '$H_NIL$'
    }
    settings {
      input_type: 'multiple'
    }
  }
  block kpi_nmv: VizBlock {
    label: 'NMV'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      theme {
        metric_kpi {
          label {
            font_color: '#0F548C'
            font_weight: 'semibold'
          }
          value {
            font_color: '#0078D4'
            font_weight: 'semibold'
          }
        }
      }
      value: VizFieldFull {
        label: 'NMV'
        ref: r(demo_ecommerce_version_2.nmv)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      border {
        border_width: 1
        border_radius: 4
        border_color: '#B3D6F2'
        border_style: 'solid'
      }
      background {
        bg_color: '#E6F2FB'
      }
    }
  }
  block kpi_revenue: VizBlock {
    label: 'Revenue'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      theme {
        metric_kpi {
          label {
            font_color: '#5C2D91'
            font_weight: 'semibold'
          }
          value {
            font_color: '#7719AA'
            font_weight: 'semibold'
          }
        }
      }
      value: VizFieldFull {
        label: 'Total Revenue'
        ref: r(demo_ecommerce_version_2.revenue)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      border {
        border_width: 1
        border_radius: 4
        border_color: '#D9B8F2'
        border_style: 'solid'
      }
      background {
        bg_color: '#F3E8FF'
      }
    }
  }
  block kpi_orders: VizBlock {
    label: 'Orders'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      theme {
        metric_kpi {
          label {
            font_color: '#006F65'
            font_weight: 'semibold'
          }
          value {
            font_color: '#007C70'
            font_weight: 'semibold'
          }
        }
      }
      value: VizFieldFull {
        label: 'Total Orders'
        ref: r(demo_ecommerce_version_2.total_orders)
        format {
          type: 'number'
          pattern: '#,###0'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      border {
        border_width: 1
        border_radius: 4
        border_color: '#A7DED6'
        border_style: 'solid'
      }
      background {
        bg_color: '#E0F5F1'
      }
    }
  }
  block kpi_gmv: VizBlock {
    label: 'GMV'
    viz: MetricKpi {
      dataset: demo_ecommerce_version_2
      theme {
        metric_kpi {
          label {
            font_color: '#8A5A00'
            font_weight: 'semibold'
          }
          value {
            font_color: '#C19C00'
            font_weight: 'semibold'
          }
        }
      }
      value: VizFieldFull {
        label: 'GMV'
        ref: r(demo_ecommerce_version_2.gmv)
        format {
          type: 'number'
          pattern: 'inherited'
        }
      }
      settings {
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
    settings {
      hide_label: true
    }
    theme {
      border {
        border_width: 1
        border_radius: 4
        border_color: '#F2D98B'
        border_style: 'solid'
      }
      background {
        bg_color: '#FFF4CE'
      }
    }
  }
  block heading_trend: TextBlock {
    content: @md ## Sales trend
Follow fulfilled sales and platform earnings over time. ;;
  }
  block heading_drivers: TextBlock {
    content: @md ## Sales drivers
Compare revenue by category and identify the merchants generating fulfilled sales. ;;
  }
  block v_sales_trend: VizBlock {
    label: 'Sales Trend'
    viz: CombinationChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        label: 'Order Month'
        ref: r(ecommerce_orders.created_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      y_axis {
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'NMV'
            ref: r(demo_ecommerce_version_2.nmv)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Total Revenue'
            ref: r(demo_ecommerce_version_2.revenue)
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'asc'
          type: 'xaxis'
        }
        x_axis_label: 'Order Month'
      }
    }
  }
  block v_category_revenue: VizBlock {
    label: 'Revenue by Category'
    viz: CombinationChart {
      dataset: demo_ecommerce_version_2
      x_axis: VizFieldFull {
        label: 'Category'
        ref: r(map_categories.category)
      }
      y_axis {
        series {
          mark_type: 'column'
          field: VizFieldFull {
            label: 'Total Revenue'
            ref: r(demo_ecommerce_version_2.revenue)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
        }
      }
      settings {
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
        x_axis_label: 'Category'
      }
    }
  }
  block v_merchant_nmv: VizBlock {
    label: 'Merchant NMV'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      fields: [
        VizFieldFull {
          label: 'Merchant Name'
          ref: r(ecommerce_merchants.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'NMV'
          ref: r(demo_ecommerce_version_2.nmv)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'nmv'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'nmv'
            direction: 'desc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        single_cell_display: 'normal'
      }
    }
  }
  explicit_interactions: [
    FilterInteraction {
      from: 'f_order_date'
      to: [
        'kpi_nmv',
        'kpi_revenue',
        'kpi_orders',
        'kpi_gmv',
        'v_sales_trend',
        'v_category_revenue',
        'v_merchant_nmv'
      ]
      field: r(ecommerce_orders.created_at)
    },
    FilterInteraction {
      from: 'f_country'
      to: [
        'kpi_nmv',
        'kpi_revenue',
        'kpi_orders',
        'kpi_gmv',
        'v_sales_trend',
        'v_category_revenue',
        'v_merchant_nmv'
      ]
      field: r(ecommerce_countries.name)
    },
    FilterInteraction {
      from: 'f_category'
      to: [
        'kpi_nmv',
        'kpi_revenue',
        'kpi_orders',
        'kpi_gmv',
        'v_sales_trend',
        'v_category_revenue',
        'v_merchant_nmv'
      ]
      field: r(map_categories.category)
    }
  ]
  view: CanvasLayout {
    label: 'Sales Performance'
    width: 1300
    height: 1320
    grid_size: 20
    auto_expand_vertically: true
    block title {
      position: pos(20, 20, 1240, 120)
      layer: 1
    }
    block kpi_gmv {
      position: pos(1040, 160, 220, 120)
      layer: 1
    }
    block kpi_nmv {
      position: pos(320, 160, 220, 120)
      layer: 1
    }
    block f_country {
      position: pos(20, 280, 280, 100)
      layer: 1
    }
    block f_category {
      position: pos(20, 400, 280, 100)
      layer: 1
    }
    block kpi_orders {
      position: pos(800, 160, 220, 120)
      layer: 1
    }
    block kpi_revenue {
      position: pos(560, 160, 220, 120)
      layer: 1
    }
    block f_order_date {
      position: pos(20, 160, 280, 100)
      layer: 1
    }
    block heading_trend {
      position: pos(320, 300, 940, 100)
      layer: 1
    }
    block v_sales_trend {
      position: pos(320, 420, 940, 320)
      layer: 1
    }
    block v_merchant_nmv {
      position: pos(800, 880, 460, 420)
      layer: 1
    }
    block heading_drivers {
      position: pos(320, 760, 940, 100)
      layer: 1
    }
    block v_category_revenue {
      position: pos(320, 880, 460, 420)
      layer: 1
    }
    mobile {
      mode: 'auto'
    }
  }
  theme {
    background {
      bg_color: '#F5F5F5'
    }
    canvas {
      border {
        border_width: 1
        border_radius: 2
        border_color: '#E1E1E1'
        border_style: 'solid'
      }
      background {
        bg_color: '#FFFFFF'
      }
      shadow: 'none'
      opacity: 1
    }
    block {
      label {
        font_family: 'Segoe UI, Arial, sans-serif'
        font_color: '#242424'
        font_size: 14
        font_weight: 'semibold'
        font_style: 'normal'
      }
      text {
        font_family: 'Segoe UI, Arial, sans-serif'
        font_color: '#242424'
        font_size: 14
        font_weight: 'normal'
        font_style: 'normal'
      }
      border {
        border_width: 1
        border_radius: 4
        border_color: '#E1E1E1'
        border_style: 'solid'
      }
      background {
        bg_color: '#FFFFFF'
      }
      padding: 16
      shadow: 'sm'
      opacity: 1
    }
    viz {
      table {
        general {
          bg_color: '#FFFFFF'
          hover_color: '#F3F9FD'
          banding_color: '#F8F8F8'
          font_size: 14
          font_color: '#242424'
          font_family: 'Segoe UI, Arial, sans-serif'
          border_color: '#E1E1E1'
          border_width: 1
          grid_color: '#E1E1E1'
        }
        header {
          bg_color: '#0078D4'
          font_size: 14
          font_weight: 'semibold'
          font_color: '#FFFFFF'
        }
        sub_header {
          bg_color: '#F3F9FD'
          font_size: 14
          font_weight: 'semibold'
          font_color: '#242424'
        }
        sub_title {
          font_size: 14
          font_weight: 'normal'
          font_color: '#616161'
        }
      }
      metric_kpi {
        label {
          font_family: 'Segoe UI, Arial, sans-serif'
          font_color: '#616161'
          font_size: 13
          font_weight: 'semibold'
        }
        value {
          font_family: 'Segoe UI, Arial, sans-serif'
          font_color: '#0078D4'
          font_size: 28
          font_weight: 'semibold'
        }
      }
    }
  }
  settings {
    autorun_on_open: true
  }
}