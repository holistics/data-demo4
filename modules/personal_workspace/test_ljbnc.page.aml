Dashboard test_ljbnc {
  title: 'test'
  owner: 'nam.tran@holistics.io'
  block v_rq1a: VizBlock {
    label: 'Product Id, Product Name and 2 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation product_rank_by_revenue {
        label: 'Product Rank By Revenue'
        formula: @aql rank(order: revenue | desc());;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: 'product_rank_by_revenue'
        operator: 'less_than'
        value: '6'
      }
      fields: [
        VizFieldFull {
          label: 'Product Id'
          ref: r(ecommerce_products.id)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Revenue'
          ref: r(demo_ecommerce_version_2.revenue)
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Product Rank By Revenue'
          ref: 'product_rank_by_revenue'
          format {
            type: 'number'
            pattern: '#,###'
          }
        }
      ]
      settings {
        show_row_number: true
        sorts: [
          SortSetting {
            field_index: 2
            direction: 'desc'
          },
          SortSetting {
            field_index: 0
            direction: 'asc'
          }
        ]
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block v_rq1a {
      position: pos(20, 20, 620, 420)
      layer: 1
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}