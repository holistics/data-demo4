Dashboard test_ljbnc {
  title: 'Business User Metrics'
  owner: 'nam.tran@holistics.io'
  block v_tnht: VizBlock {
    label: 'Classification of Users Age, Users Ag... and Count of Id'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation classification_of_users_age_users_age_users_a {
        label: 'Classification of Users Age, Users Age, Users Age'
        formula: @aql case(
  when: ecommerce_users.age < 30,
  then: "Under 30",
  when: ecommerce_users.age > 30 and ecommerce_users.age <= 60,
  then: "30 to 60",
  else: "Over 60"
);;
        calc_type: 'dimension'
        data_type: 'text'
        model: ecommerce_users
      }
      fields: [
        VizFieldFull {
          ref: ref('ecommerce_users', 'classification_of_users_age_users_age_users_a')
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_users.id)
          aggregation: 'count'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: TabLayout {
    label: 'View 1'
    tab view_1: CanvasLayout {
      label: 'Metric Submission'
      width: 1300
      height: 800
      grid_size: 20
      auto_expand_vertically: true
      block v_tnht {
        position: pos(20, 20, 620, 420)
      }
      mobile {
        mode: 'auto'
      }
    }
    tab tab_rmma: CanvasLayout {
      label: 'Metric Approved'
      width: 1300
      height: 800
      grid_size: 20
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
    }
    tab tab_lon6: CanvasLayout {
      label: 'Metric Denied'
      width: 1300
      height: 800
      grid_size: 20
      auto_expand_vertically: true
      mobile {
        mode: 'auto'
      }
    }
  }
  theme: H.themes.vanilla
  settings {
    timezone: 'America/Los_Angeles'
    cache_duration: 4320
    autorun_on_open: true
  }
}