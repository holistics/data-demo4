Dashboard demo_ai_bknqx {
  title: 'Demo AI'
  owner: 'duong.ht@holistics.io'
  block v_fq7v: VizBlock {
    label: '''GMV growth decomposition: new vs repeat buyers
'''
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation current_month_gmv {
        label: 'Current Month Gmv'
        formula: @aql gmv | where(ecommerce_orders.created_at is @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation previous_month_gmv {
        label: 'Previous Month Gmv'
        formula: @aql gmv | where(ecommerce_orders.created_at is @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation gmv_growth {
        label: 'Gmv Growth'
        formula: @aql current_month_gmv - previous_month_gmv;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current_month_gmv_new_buyers {
        label: 'Current Month Gmv New Buyers'
        formula: @aql gmv
  | where(ecommerce_orders.created_at is @(last month))
  | where(ecommerce_users.first_order_date is @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current_month_gmv_repeat_buyers {
        label: 'Current Month Gmv Repeat Buyers'
        formula: @aql gmv
  | where(ecommerce_orders.created_at is @(last month))
  | where(ecommerce_users.first_order_date < @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current_month_new_buyers {
        label: 'Current Month New Buyers'
        formula: @aql total_users
  | where(ecommerce_users.first_order_date is @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation current_month_repeat_buyers {
        label: 'Current Month Repeat Buyers'
        formula: @aql total_users
  | where(ecommerce_orders.created_at is @(last month))
  | where(ecommerce_users.first_order_date < @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation avg_gmv_per_new_buyer {
        label: 'Avg Gmv Per New Buyer'
        formula: @aql current_month_gmv_new_buyers * 1.0 / current_month_new_buyers;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation avg_gmv_per_repeat_buyer {
        label: 'Avg Gmv Per Repeat Buyer'
        formula: @aql current_month_gmv_repeat_buyers * 1.0 / current_month_repeat_buyers;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation new_buyer_gmv_growth_contribution_percentage {
        label: 'New Buyer Gmv Growth Contribution Percentage'
        formula: @aql current_month_gmv_new_buyers * 100.0 / gmv_growth;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation repeat_buyer_gmv_growth_contribution_percentage {
        label: 'Repeat Buyer Gmv Growth Contribution Percentage'
        formula: @aql (current_month_gmv_repeat_buyers - (gmv | where(ecommerce_orders.created_at is @(2 months ago)) | where(ecommerce_users.first_order_date < @(last month)))) * 100.0 / gmv_growth;;
        calc_type: 'measure'
        data_type: 'number'
      }
      values: [
        VizFieldFull {
          label: 'Current Month Gmv'
          ref: 'current_month_gmv'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_current_month_gmv_1'
        },
        VizFieldFull {
          label: 'Previous Month Gmv'
          ref: 'previous_month_gmv'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Gmv Growth'
          ref: 'gmv_growth'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Gmv From New Buyers Current Month'
          ref: 'current_month_gmv_new_buyers'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Gmv From Repeat Buyers Current Month'
          ref: 'current_month_gmv_repeat_buyers'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Count Of New Buyers Current Month'
          ref: 'current_month_new_buyers'
          format {
            type: 'number'
            pattern: '#,###'
          }
        },
        VizFieldFull {
          label: 'Count Of Repeat Buyers Current Month'
          ref: 'current_month_repeat_buyers'
          format {
            type: 'number'
            pattern: '#,###'
          }
        },
        VizFieldFull {
          label: 'Avg Gmv Per New Buyer Current Month'
          ref: 'avg_gmv_per_new_buyer'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Avg Gmv Per Repeat Buyer Current Month'
          ref: 'avg_gmv_per_repeat_buyer'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'New Buyer Growth Contribution Percentage'
          ref: 'new_buyer_gmv_growth_contribution_percentage'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Repeat Buyer Growth Contribution Percentage'
          ref: 'repeat_buyer_gmv_growth_contribution_percentage'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'custom_current_month_gmv_1'
            direction: 'desc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_75nx: VizBlock {
    label: 'Absolute GMV Growth, Current Month GMV and 2 more by Parent Category'
    viz: BarChart {
      dataset: demo_ecommerce_version_2
      calculation current_month_gmv {
        label: 'Current Month Gmv'
        formula: @aql gmv | where(ecommerce_orders.created_at is @(last month));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation previous_month_gmv {
        label: 'Previous Month Gmv'
        formula: @aql gmv | where(ecommerce_orders.created_at is @(2 months ago));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation absolute_gmv_growth {
        label: 'Absolute Gmv Growth'
        formula: @aql current_month_gmv - previous_month_gmv;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation total_absolute_gmv_growth {
        label: 'Total Absolute Gmv Growth'
        formula: @aql absolute_gmv_growth | keep_grains();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation growth_contribution_percentage {
        label: 'Growth Contribution Percentage'
        formula: @aql absolute_gmv_growth * 100.0 / total_absolute_gmv_growth;;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      x_axis: VizFieldFull {
        label: 'Parent Category'
        ref: r(map_categories.parent_category)
        format {
          type: 'text'
        }
        uname: 'map_categories_parent_category'
      }
      y_axis {
        series {
          field: VizFieldFull {
            label: 'Absolute GMV Growth'
            ref: 'absolute_gmv_growth'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
            uname: 'custom_absolute_gmv_growth_1'
          }
          settings {
            color: '#07326C'
          }
        }
      }
      tooltips: [
        VizTooltip {
          field: VizFieldFull {
            label: 'Current Month GMV'
            ref: 'current_month_gmv'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Previous Month GMV'
            ref: 'previous_month_gmv'
            format {
              type: 'number'
              pattern: '[$$]#,###0'
            }
          }
        },
        VizTooltip {
          field: VizFieldFull {
            label: 'Growth Contribution %'
            ref: 'growth_contribution_percentage'
            format {
              type: 'number'
              pattern: '#,###0.00\\%'
            }
          }
        }
      ]
      settings {
        row_limit: 5
        sort {
          field_index: 0
          direction: 'desc'
          type: 'yaxis'
        }
        x_axis_label: 'Parent Category'
        x_axis_show_null_datetime: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 900
    grid_size: 20
    auto_expand_vertically: true
    block v_fq7v {
      position: pos(20, 20, 620, 420)
      layer: 1
    }
    block v_75nx {
      position: pos(20, 460, 720, 420)
      layer: 2
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}