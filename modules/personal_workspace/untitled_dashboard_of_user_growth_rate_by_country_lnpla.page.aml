Dashboard untitled_dashboard_of_user_growth_rate_by_country_lnpla {
  title: '''Untitled Dashboard of User growth rate by country
'''
  owner: 'chinh.dm+demo4@holistics.io'
  block v_m69a: VizBlock {
    label: '''User growth rate by country
'''
    viz: CombinationChart {
      dataset: demo_ecommerce_version_2
      calculation previous_month_user_count {
        label: 'Previous Month User Count'
        formula: @aql ecommerce_users | count(ecommerce_users.id) | previous(order: ecommerce_users.sign_up_at | month(), partition: ecommerce_countries.name);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation user_count {
        label: 'User Count'
        formula: @aql ecommerce_users | count(ecommerce_users.id);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation user_growth_rate {
        label: 'User Growth Rate'
        formula: @aql user_count * 100.0 / previous_month_user_count;;
        calc_type: 'measure'
        data_type: 'number'
      }
      x_axis: VizFieldFull {
        label: 'Sign Up Month'
        ref: r(ecommerce_users.sign_up_at)
        transformation: 'datetrunc month'
        format {
          type: 'date'
          pattern: 'LLL yyyy'
        }
      }
      legend: VizFieldFull {
        label: 'Country'
        ref: r(ecommerce_countries.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          group_values_into: 10
          show_data_label_by: 'value'
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'User Count'
            ref: 'user_count'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'Previous Month User Count'
            ref: 'previous_month_user_count'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
          settings {
            line_style: 'dashed'
          }
        }
      }
      y_axis {
        settings {
          alignment: 'right'
          group_values_into: 10
          show_data_label_by: 'value'
        }
        series {
          mark_type: 'line'
          field: VizFieldFull {
            label: 'User Growth Rate'
            ref: 'user_growth_rate'
            format {
              type: 'number'
              pattern: '#,###0.00'
            }
          }
        }
      }
      settings {
        row_limit: 100
        x_axis_label: 'Sign Up Month'
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block v_m69a {
      position: pos(20, 20, 620, 420)
      layer: 1
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}