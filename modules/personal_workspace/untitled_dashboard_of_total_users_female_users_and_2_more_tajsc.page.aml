Dashboard untitled_dashboard_of_total_users_female_users_and_2_more_tajsc {
  title: 'Vincent Personal Dashboard'
  owner: 'vincent@holistics.io'
  block v_4mie: VizBlock {
    label: 'Total Users, Female Users and 2 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation metric_25472cf {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_aea2b3d {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_30de1b2 {
        label: 'Untitled Metric'
        formula: @aql metric_aea2b3d/metric_25472cf;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_25472cf'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_aea2b3d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Ratio of M:F Users'
          ref: 'metric_30de1b2'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        }
      ]
      settings {
        wrap_header_text: true
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_5euh: VizBlock {
    label: 'Total Orders'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_j5tp: VizBlock {
    label: '''Top 5 products by GMV (sales)
'''
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      theme {
      }
      fields: [
        VizFieldFull {
          label: 'Product Id'
          ref: r(ecommerce_products.id)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ecommerce_products_id_1'
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Gmv'
          ref: r(demo_ecommerce_version_2.gmv)
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_gmv_1'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'custom_gmv_1'
            direction: 'desc'
          },
          SortSetting {
            key: 'ecommerce_products_id_1'
            direction: 'asc'
          }
        ]
        row_limit: 5
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        single_cell_display: 'normal'
      }
    }
  }
  block v_uuh3: VizBlock {
    label: 'Total Orders, Orders from Female Users and 4 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation metric_175a1ec {
        label: 'Orders from Female Users'
        formula: @aql total_orders
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_4463d10 {
        label: 'Orders from Asia'
        formula: @aql total_orders
| where(ecommerce_countries.continent_name == "Asia");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_cd4ce13 {
        label: 'Ratio of Asia Orders to Female Orders'
        formula: @aql metric_4463d10/metric_175a1ec;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_0f2cf34 {
        label: 'Mobile Phone Orders'
        formula: @aql total_users
| where(map_categories.parent_category == "Mobiles & Tablets");;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_175a1ec'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_4463d10'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_cd4ce13'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_0f2cf34'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_pmqy: VizBlock {
    label: 'Total Users, Female Users (Previous Month) and 3 more by Month Created At'
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation metric_098ccda {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_af06340 {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_549b3f1 {
        label: 'Cumulative Male Users Count'
        formula: @aql metric_af06340 | running_total();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_6223e4d {
        label: 'Female Users (Previous Month)'
        formula: @aql metric_098ccda | relative_period(ecommerce_orders.created_at, interval(-1 month), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_6223e4d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_098ccda'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_af06340'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_549b3f1'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_total: true
        show_column_total: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        frozen_columns: 0
      }
    }
  }
  block v_zudj: VizBlock {
    label: 'Month Created At, Total Users and 5 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation metric_098ccda {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_af06340 {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_549b3f1 {
        label: 'Cumulative Male Users Count'
        formula: @aql metric_af06340 | running_total();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_6223e4d {
        label: 'Female Users (Previous Month)'
        formula: @aql metric_098ccda | relative_period(ecommerce_orders.created_at, interval(-1 month), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_92e29d6 {
        label: 'Ratio of Male to Female'
        formula: @aql metric_af06340/metric_098ccda;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter_groups: [
        AndFilters {
          filters: [
            VizFilter {
              field: r(ecommerce_orders.status)
              operator: 'is_not'
              value: [
                'cancelled',
                'refunded'
              ]
            },
            OrFilters {
              filters: [
                VizFilter {
                  field: r(ecommerce_products.price)
                  operator: 'greater_than'
                  value: '50'
                },
                VizFilter {
                  field: r(map_categories.category)
                  operator: 'is'
                  value: [
                    'Face',
                    'Gaming'
                  ]
                }
              ]
            }
          ]
        }
      ]
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_6223e4d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_098ccda'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_af06340'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_549b3f1'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_92e29d6'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        frozen_columns: 0
      }
    }
  }
  block v_9ika: VizBlock {
    label: 'GMV (Gross Merchandise Value) by City Name'
    viz: BarChart {
      dataset: demo_ecommerce_version_2
      filter {
        field: r(ecommerce_countries.name)
        operator: 'is'
        value: 'France'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last 24 months'
      }
      filter {
        field: r(param_model_demo.metric_selections_currency)
        operator: 'is'
        value: 'platform revenue'
      }
      theme {
      }
      x_axis: VizFieldFull {
        ref: r(ecommerce_cities.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_total_in_tooltip: true
          show_data_label_by: 'value'
          hidden: true
        }
        series {
          field: VizFieldFull {
            ref: r(demo_ecommerce_version_2.gmv)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#05264CFF'
            point {
              value: 'India'
              color: '#AF7DED'
            }
            point {
              value: 'Korea'
              color: '#F2B602'
            }
            point {
              value: 'France'
              color: '#18A59E'
            }
            point {
              value: 'Germany'
              color: '#07326C'
            }
            point {
              value: 'Vietnam'
              color: '#07326C'
            }
            point {
              value: 'Australia'
              color: '#255DD4'
            }
            point {
              value: 'Indonesia'
              color: '#A50E43'
            }
            point {
              value: 'Singapore'
              color: '#E27712'
            }
            point {
              value: 'United States'
              color: '#18A59E'
            }
            point {
              value: 'United Kingdom'
              color: '#255DD4'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        legend_label: 'hidden'
        x_axis_label: 'Cities.City Name'
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_uyom: VizBlock {
    label: '''Top 5 products by order volume last quarter
'''
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation total_order_quantity {
        label: 'Total Order Quantity'
        formula: @aql ecommerce_order_items | sum(ecommerce_order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last quarter'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
          uname: 'ecommerce_products_name'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Total Order Quantity'
          ref: 'total_order_quantity'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_total_order_quantity_1'
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'custom_total_order_quantity_1'
            direction: 'desc'
          },
          SortSetting {
            key: 'ecommerce_products_name'
            direction: 'asc'
          }
        ]
        row_limit: 5
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_z8ed: VizBlock {
    label: 'Total Order Quantity and Percent of total of Total Order Quantity by Product Name'
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation total_order_quantity {
        label: 'Total Order Quantity'
        formula: @aql ecommerce_order_items | sum(ecommerce_order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_7a41194 {
        label: 'Percent of total of Total Order Quantity'
        formula: @aql total_order_quantity | percent_of_total('column_total');;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last quarter'
      }
      theme {

      }
      rows: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
          uname: 'ecommerce_products_name'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Total Order Quantity'
          ref: 'total_order_quantity'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_total_order_quantity_1'
        },
        VizFieldFull {
          ref: 'metric_7a41194'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'custom_total_order_quantity_1'
            direction: 'desc'
          },
          SortSetting {
            key: 'ecommerce_products_name'
            direction: 'asc'
          }
        ]
        row_limit: 5
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 880
    grid_size: 20
    auto_expand_vertically: true
