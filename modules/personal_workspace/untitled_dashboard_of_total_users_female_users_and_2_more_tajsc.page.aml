  block v_rauk: VizBlock {
    label: 'Total Users, Female Users and 5 more by Sign Up Quarter'
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation female_users {
        label: 'Female Users'
        formula: @aql total_users | where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation female_ratio {
        label: 'Female Ratio'
        formula: @aql female_users / total_users;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation cumulative_female_users {
        label: 'Cumulative Female Users'
        formula: @aql female_users | running_total();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation last_quarter_cumulative_female {
        label: 'Last Quarter Cumulative Female'
        formula: @aql cumulative_female_users | relative_period(ecommerce_users.sign_up_date, interval(-1 quarter), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation male_users {
        label: 'Male Users'
        formula: @aql total_users | where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation male_ratio {
        label: 'Male Ratio'
        formula: @aql male_users / total_users;;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Sign Up Quarter'
          ref: r(ecommerce_users.sign_up_date)
          transformation: 'datetrunc quarter'
          format {
            type: 'date'
            pattern: 'yyyy Qq'
          }
          uname: 'datetrunc_quarter_sign_up_date'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Total Users'
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Female Users'
          ref: 'female_users'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Cumulative Female Users'
          ref: 'cumulative_female_users'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Last Quarter Cumulative Female'
          ref: 'last_quarter_cumulative_female'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Female Ratio'
          ref: 'female_ratio'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Male Users'
          ref: 'male_users'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Male Ratio'
          ref: 'male_ratio'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'datetrunc_quarter_sign_up_date'
            direction: 'asc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_1hno: VizBlock {
    label: 'Test Report 01'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation female_users {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation ratio_of_female_users {
        label: 'Ratio Of Female Users'
        formula: @aql female_users/total_users;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation last_period_female_users {
        label: 'Last Period Female Users'
        formula: @aql female_users | relative_period(ecommerce_users.sign_up_date, interval(-1 quarter), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation percent_change_quarter {
        label: 'Percent Change over Quarter'
        formula: @aql safe_divide(female_users, female_users | relative_period(ecommerce_users.sign_up_date, interval(-1 quarter), strict: true)) - 1;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_f9271ad {
        label: 'Classification of Growth'
        formula: @aql case(
  when: percent_change_quarter > 1,
  then: "Great",
  else: "Normal"
);;
        calc_type: 'measure'
        data_type: 'text'
      }
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_users.sign_up_date)
          transformation: 'datetrunc quarter'
          format {
            type: 'date'
            pattern: 'yyyy Qq'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_countries.continent_name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'last_period_female_users'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'female_users'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_f9271ad'
          format {
            type: 'text'
            pattern: '#,###%'
          }
          uname: 'custom_metric_f9271ad'
        },
        VizFieldFull {
          ref: 'percent_change_quarter'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        },
        VizFieldFull {
          ref: 'ratio_of_female_users'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        conditional_formats: [
          ConditionalFormat {
            key: 'custom_metric_f9271ad'
            format: SingleFormat {
              condition {
                operator: 'is'
                value: 'Great'
              }
              text_color: '#328159'
              background_color: '#B5E3CD'
            }
          }
        ]
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        frozen_columns: 0
      }
    }
  }
  block v_25bw: VizBlock {
    label: 'Total Users, Percent Growth, and Absolute Growth Qoq by Quarter Sign Up At'
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation absolute_growth_qoq {
        label: 'Absolute Growth Qoq'
        formula: @aql total_users - (total_users | relative_period(ecommerce_users.sign_up_at, interval(-1 quarter)));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation percent_growth {
        label: 'Percent Growth'
        formula: @aql safe_divide(total_users, total_users | relative_period(ecommerce_users.sign_up_at, interval(-1 quarter))) - 1;;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Quarter Sign Up At'
          ref: r(ecommerce_users.sign_up_at)
          transformation: 'datetrunc quarter'
          format {
            type: 'date'
            pattern: 'yyyy Qq'
          }
          uname: 'datetrunc_quarter_sign_up_at'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Total Users'
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Percent Growth'
          ref: 'percent_growth'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Absolute Growth Qoq'
          ref: 'absolute_growth_qoq'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'datetrunc_quarter_sign_up_at'
            direction: 'asc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_g99o: VizBlock {
    label: 'Quarter Created At and Total Revenue'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      fields: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc quarter'
          format {
