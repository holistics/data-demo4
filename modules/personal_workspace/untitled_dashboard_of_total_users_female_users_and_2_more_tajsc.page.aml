  block v_pmqy: VizBlock {
    label: 'Total Users, Female Users (Previous Month) and 3 more by Month Created At'
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation metric_098ccda {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_af06340 {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_549b3f1 {
        label: 'Cumulative Male Users Count'
        formula: @aql metric_af06340 | running_total();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_6223e4d {
        label: 'Female Users (Previous Month)'
        formula: @aql metric_098ccda | relative_period(ecommerce_orders.created_at, interval(-1 month), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        }
      ]
      values: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_6223e4d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_098ccda'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_af06340'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_549b3f1'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_total: true
        show_column_total: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        frozen_columns: 0
      }
    }
  }
  block v_zudj: VizBlock {
    label: 'Month Created At, Total Users and 5 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation metric_098ccda {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_af06340 {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_549b3f1 {
        label: 'Cumulative Male Users Count'
        formula: @aql metric_af06340 | running_total();;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_6223e4d {
        label: 'Female Users (Previous Month)'
        formula: @aql metric_098ccda | relative_period(ecommerce_orders.created_at, interval(-1 month), strict: true);;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_92e29d6 {
        label: 'Ratio of Male to Female'
        formula: @aql metric_af06340/metric_098ccda;;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter_groups: [
        AndFilters {
          filters: [
            VizFilter {
              field: r(ecommerce_orders.status)
              operator: 'is_not'
              value: [
                'cancelled',
                'refunded'
              ]
            },
            OrFilters {
              filters: [
                VizFilter {
                  field: r(ecommerce_products.price)
                  operator: 'greater_than'
                  value: '50'
                },
                VizFilter {
                  field: r(map_categories.category)
                  operator: 'is'
                  value: [
                    'Face',
                    'Gaming'
                  ]
                }
              ]
            }
          ]
        }
      ]
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
        },
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_6223e4d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_098ccda'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_af06340'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_549b3f1'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_92e29d6'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        frozen_columns: 0
      }
    }
  }
  block v_9ika: VizBlock {
    label: 'GMV (Gross Merchandise Value) by City Name'
    viz: BarChart {
      dataset: demo_ecommerce_version_2
      filter {
        field: r(ecommerce_countries.name)
        operator: 'is'
        value: 'France'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last 24 months'
      }
      filter {
        field: r(param_model_demo.metric_selections_currency)
        operator: 'is'
        value: 'platform revenue'
      }
      theme {
      }
      x_axis: VizFieldFull {
        ref: r(ecommerce_cities.name)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          show_total_in_tooltip: true
          show_data_label_by: 'value'
          hidden: true
        }
        series {
          field: VizFieldFull {
            ref: r(demo_ecommerce_version_2.gmv)
            format {
              type: 'number'
              pattern: 'inherited'
            }
          }
          settings {
            color: '#05264CFF'
            point {
              value: 'India'
              color: '#AF7DED'
            }
            point {
              value: 'Korea'
              color: '#F2B602'
            }
            point {
              value: 'France'
              color: '#18A59E'
            }
            point {
              value: 'Germany'
              color: '#07326C'
            }
            point {
              value: 'Vietnam'
              color: '#07326C'
            }
            point {
              value: 'Australia'
              color: '#255DD4'
            }
            point {
              value: 'Indonesia'
              color: '#A50E43'
            }
            point {
              value: 'Singapore'
              color: '#E27712'
            }
            point {
              value: 'United States'
              color: '#18A59E'
            }
            point {
              value: 'United Kingdom'
              color: '#255DD4'
            }
          }
        }
      }
      settings {
        row_limit: 5000
        legend_label: 'hidden'
        x_axis_label: 'Cities.City Name'
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_uyom: VizBlock {
    label: '''Top 5 products by order volume last quarter
'''
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation total_order_quantity {
        label: 'Total Order Quantity'
        formula: @aql ecommerce_order_items | sum(ecommerce_order_items.quantity);;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last quarter'
      }
      theme {
      }
      rows: [
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
          uname: 'ecommerce_products_name'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Total Order Quantity'
          ref: 'total_order_quantity'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_total_order_quantity_1'
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'custom_total_order_quantity_1'
            direction: 'desc'
          },
          SortSetting {
            key: 'ecommerce_products_name'
            direction: 'asc'
          }
        ]
        row_limit: 5
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
