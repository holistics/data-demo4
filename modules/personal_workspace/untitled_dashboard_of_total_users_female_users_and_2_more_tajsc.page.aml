            color_palette: 0
          }
        }
      }
      settings {
        row_limit: 5000
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_u7e8: VizBlock {
    label: '''Cohort report of orders count by parent categories over the past 6 quarters
'''
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      filter {
        field: r(ecommerce_orders.created_at)
