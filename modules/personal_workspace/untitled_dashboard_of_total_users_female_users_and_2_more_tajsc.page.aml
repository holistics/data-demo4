Dashboard untitled_dashboard_of_total_users_female_users_and_2_more_tajsc {
  title: 'Vincent Personal Dashboard'
  owner: 'vincent@holistics.io'
  block v_4mie: VizBlock {
    label: 'Total Users, Female Users and 2 more'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      calculation metric_25472cf {
        label: 'Female Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Female");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_aea2b3d {
        label: 'Male Users'
        formula: @aql total_users
| where(ecommerce_users.gender == "Male");;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation metric_30de1b2 {
        label: 'Untitled Metric'
        formula: @aql metric_aea2b3d/metric_25472cf;;
        calc_type: 'measure'
        data_type: 'number'
      }
      fields: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_users)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_25472cf'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          ref: 'metric_aea2b3d'
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Ratio of M:F Users'
          ref: 'metric_30de1b2'
          format {
            type: 'number'
            pattern: '#,###%'
          }
        }
      ]
      settings {
        wrap_header_text: true
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_5euh: VizBlock {
    label: 'Total Orders'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      theme {
      }
      fields: [
        VizFieldFull {
          ref: r(demo_ecommerce_version_2.total_orders)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        row_limit: 5000
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_j5tp: VizBlock {
    label: '''Top 5 products by GMV (sales)
'''
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      theme {

      }
      fields: [
        VizFieldFull {
          label: 'Product Id'
          ref: r(ecommerce_products.id)
          format {
            type: 'number'
            pattern: 'inherited'
          }
          uname: 'ecommerce_products_id_1'
        },
        VizFieldFull {
          label: 'Product Name'
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          label: 'Gmv'
          ref: r(demo_ecommerce_version_2.gmv)
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
          uname: 'custom_gmv_1'
        }
      ]
      settings {
        pagination_size: 100
        show_row_number: true
        sorts: [
          SortSetting {
            key: 'custom_gmv_1'
            direction: 'desc'
          },
          SortSetting {
            key: 'ecommerce_products_id_1'
            direction: 'asc'
          }
        ]
        row_limit: 5
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
        single_cell_display: 'normal'
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block v_4mie {
      position: pos(20, 20, 620, 140)
      layer: 1
    }
    block v_5euh {
      position: pos(640, 20, 240, 140)
      layer: 1
    }
    block v_j5tp {
      position: pos(20, 180, 620, 420)
      layer: 2
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}