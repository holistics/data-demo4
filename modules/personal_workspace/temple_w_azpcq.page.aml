Dashboard temple_w_azpcq {
  title: 'Temple & W'
  owner: 'dong.ln@holistics.io'
  explicit_interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    mobile {
      mode: 'auto'
    }
  }
  theme: DynamicPageTheme {
    light: H.themes.vanilla
    dark: H.themes.charcoal
  }
  settings {
    autorun_on_open: true
  }
}