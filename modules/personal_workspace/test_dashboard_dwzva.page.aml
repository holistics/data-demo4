Dashboard test_dashboard_dwzva {
  title: 'Test Dashboard'
  owner: 'vincent@holistics.io'
  block v_pzrl: VizBlock {
    label: 'Top Female Customers'
    viz: DataTable {
      dataset: demo_ecommerce_version_2
      filter {
        field: r(ecommerce_countries.name)
        operator: 'is'
        value: 'Australia'
      }
      filter {
        field: r(ecommerce_users.gender)
        operator: 'is'
        value: 'Female'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last 24 months'
      }
      filter {
        field: r(param_model_demo.metric_selections_currency)
        operator: 'is'
        value: 'platform revenue'
      }
      filter {
        field: r(ecommerce_users.age_group)
        operator: 'is'
        value: '2. From 20 to 29'
      }
      fields: [
        VizFieldFull {
          ref: r(ecommerce_users.id)
          format {
            type: 'number'
          }
        },
        r(ecommerce_users.full_name),
        r(ecommerce_users.gender),
        r(ecommerce_cities.name),
        VizFieldFull {
          ref: r(ecommerce_products.name)
          format {
            type: 'text'
          }
        },
        VizFieldFull {
          ref: r(ecommerce_order_items.quantity)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        }
      ]
      settings {
        show_row_number: true
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  block v_5zbg: VizBlock {
    label: 'Order Count Last Quarter and Order Count Same Quarter Last Year by Product Name and Status'
    viz: ColumnChart {
      dataset: demo_ecommerce_version_2
      calculation order_count_last_quarter {
        label: 'Order Count Last Quarter'
        formula: @aql total_orders;;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation order_count_same_quarter_last_year {
        label: 'Order Count Same Quarter Last Year'
        formula: @aql total_orders | relative_period(ecommerce_orders.created_at, interval(-1 year));;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: 'last quarter'
      }
      theme {

      }
      x_axis: VizFieldFull {
        label: 'Product Name'
        ref: r(ecommerce_products.name)
        format {
          type: 'text'
        }
      }
      legend: VizFieldFull {
        ref: r(ecommerce_orders.status)
        format {
          type: 'text'
        }
      }
      y_axis {
        settings {
          stack_series_by: 'value'
        }
        series {
          field: VizFieldFull {
            label: 'Order Count Last Quarter'
            ref: 'order_count_last_quarter'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
          settings {
            color_palette: 0
          }
        }
        series {
          field: VizFieldFull {
            label: 'Order Count Same Quarter Last Year'
            ref: 'order_count_same_quarter_last_year'
            format {
              type: 'number'
              pattern: '#,###'
            }
          }
          settings {
            color_palette: 0
          }
        }
      }
      settings {
        row_limit: 5
        x_axis_show_null_datetime: false
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block v_pzrl {
      position: pos(20, 20, 620, 420)
      layer: 1
    }
    block v_5zbg {
      position: pos(660, 20, 620, 420)
      layer: 2
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
}