Dashboard test_xrwjo {
  title: 'Test'
  owner: 'nam.tran@holistics.io'
  block v_m84l: VizBlock {
    label: '''2026 YTD versus 2025 GMV by month
'''
    viz: PivotTable {
      dataset: demo_ecommerce_version_2
      calculation prior_year_gmv {
        label: 'Prior Year Gmv'
        formula: @aql gmv | relative_period(ecommerce_orders.created_at, interval(-1 year));;
        calc_type: 'measure'
        data_type: 'number'
      }
      calculation yoy_percentage_change {
        label: 'Yoy Percentage Change'
        formula: @aql safe_divide(
      gmv - (gmv | relative_period(ecommerce_orders.created_at, interval(-1 year))),
      gmv | relative_period(ecommerce_orders.created_at, interval(-1 year)),
    );;
        calc_type: 'measure'
        data_type: 'number'
      }
      filter {
        field: r(ecommerce_orders.created_at)
        operator: 'matches'
        value: '2026-01-01 until 2026-08-25'
      }
      rows: [
        VizFieldFull {
          label: 'Calendar Month'
          ref: r(ecommerce_orders.created_at)
          transformation: 'datetrunc month'
          format {
            type: 'date'
            pattern: 'LLL yyyy'
          }
          uname: 'datetrunc_month_created_at'
        }
      ]
      values: [
        VizFieldFull {
          label: 'Current Year Gmv'
          ref: r(demo_ecommerce_version_2.gmv)
          format {
            type: 'number'
            pattern: 'inherited'
          }
        },
        VizFieldFull {
          label: 'Prior Year Gmv'
          ref: 'prior_year_gmv'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        },
        VizFieldFull {
          label: 'Yoy Percentage Change'
          ref: 'yoy_percentage_change'
          format {
            type: 'number'
            pattern: '#,###0.00'
          }
        }
      ]
      settings {
        pagination_size: 100
        show_row_total: true
        show_column_total: true
        show_sub_total: true
        sorts: [
          SortSetting {
            key: 'datetrunc_month_created_at'
            direction: 'asc'
          }
        ]
        aggregate_awareness {
          enabled: true
          debug_comments: true
        }
      }
    }
  }
  interactions: []
  view: CanvasLayout {
    label: 'View 1'
    width: 1300
    height: 800
    grid_size: 20
    auto_expand_vertically: true
    block v_m84l {
      position: pos(20, 20, 620, 420)
      layer: 1
    }
    mobile {
      mode: 'auto'
    }
  }
  theme: H.themes.vanilla
  settings {
    autorun_on_open: true
  }
}