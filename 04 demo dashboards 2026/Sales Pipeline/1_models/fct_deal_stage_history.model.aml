Model fct_deal_stage_history {
  type: 'table'
  label: 'Deal Stage History'
  description: ''
  data_source_name: 'demodb'
  dimension id {
    label: 'Id'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.id }};;
    primary_key: true
  }
  dimension deal_id {
    label: 'Deal Id'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.deal_id }};;
  }
  dimension stage {
    label: 'Stage'
    type: 'text'
    hidden: false
    definition: @sql {{ #SOURCE.stage }};;
  }
  dimension entered_at {
    label: 'Entered At'
    type: 'datetime'
    hidden: false
    definition: @sql {{ #SOURCE.entered_at }};;
  }
  dimension exited_at {
    label: 'Exited At'
    type: 'datetime'
    hidden: false
    definition: @sql {{ #SOURCE.exited_at }};;
  }

  // Referenced by the sales_pipeline dataset's avg_time_in_stage metric but never
  // defined. Days spent in the stage; NULL while the deal is still in it.
  dimension days_in_stage {
    label: 'Days In Stage'
    type: 'number'
    hidden: false
    definition: @sql extract(epoch from ({{ #SOURCE.exited_at }}::timestamp - {{ #SOURCE.entered_at }}::timestamp)) / 86400.0;;
  }

  owner: 'hien.nt@holistics.io'
  table_name: '"demo_sales_pipeline"."deal_stage_history"'
}
